{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "incremental": true,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": { "@/*": ["./*"] },
    "plugins": [{ "name": "next" }],
    "strict": true,
    "target": "ES2024"
  },
  "include": [".next/types/**/*.ts", ".source/**/*.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
