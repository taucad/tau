<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Experiment only: allow the WebKit sandbox-extension issuance the macOS 15 QL profile denies. -->
  <key>com.apple.security.temporary-exception.sbpl</key>
  <array>
    <string>(allow generic-issue-extension (extension-class "com.apple.webkit.mach-bootstrap"))</string>
    <string>(allow mach-issue-extension (extension-class "com.apple.webkit.extension.mach"))</string>
    <string>(allow iokit-issue-extension (extension-class "com.apple.webkit.extension.iokit"))</string>
    <string>(allow mach-lookup (global-name "com.apple.PowerManagement.control"))</string>
  </array>
</dict>
</plist>
