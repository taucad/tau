# General
PORT=4000
TAU_FRONTEND_URL=http://localhost:3000
TAU_API_URL=http://localhost:4000
NODE_ENV=development
LOG_LEVEL=info

# LLMs
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=tau-local
LANGSMITH_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
SAMBA_API_KEY=
ANTHROPIC_API_KEY=
# Cloud LLM credential — required by env schema even when Vertex is unused.
GOOGLE_VERTEX_AI_CREDENTIALS={"type":"stub","project_id":"stub","private_key_id":"stub","private_key":"-----BEGIN PRIVATE KEY-----\\nstub\\n-----END PRIVATE KEY-----\\n","client_email":"stub@stub","client_id":"stub","auth_uri":"https://stub","token_uri":"https://stub","auth_provider_x509_cert_url":"https://stub","client_x509_cert_url":"https://stub","universe_domain":"stub"}
GOOGLE_VERTEX_AI_CREDENTIALS=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
MORPH_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
TAU_PROVIDER_DIAGNOSTICS_VERBOSE=false

# Database
# Local Docker Postgres (`pnpm infra:up postgres`).
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/tau_dev


# Object storage (MinIO via infra/docker-compose.yml in dev; R2 in staging/prod)
# Namespace prefixes (blobs/, derivatives/, etc.) are compile-time constants —
# see apps/api/app/storage/storage.constants.ts
TAU_S3_ENDPOINT=http://localhost:9000
TAU_S3_REGION=us-east-1
TAU_S3_ACCESS_KEY_ID=tau-api
TAU_S3_SECRET_ACCESS_KEY=tau-api-dev-secret
TAU_S3_FORCE_PATH_STYLE=true
TAU_S3_BUCKET=tau-content
TAU_S3_PUBLIC_BASE_URL=http://localhost:9000/tau-content

# MinIO root creds (compose/bootstrap only; API uses TAU_S3_ACCESS_KEY_ID)
MINIO_ROOT_USER=tauminio
MINIO_ROOT_PASSWORD=tauminio-dev-secret

# Authentication
AUTH_URL=http://localhost:4000
AUTH_SECRET=
# First-party publication view cookie signing (min 32 characters)
TAU_VIEW_COOKIE_SECRET=dev-tau-view-cookie-secret-min-32-chars
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public-repo reads for the repositories API (repo metadata, git trees, zipball).
# Required by GET /v1/repositories/branches, which 401s without it; archive
# imports degrade to GitHub's unauthenticated rate limit instead of failing.
# Issue a fine-grained PAT with "Public repositories, read-only" and no account
# permissions — not a classic PAT.
GITHUB_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (disabled locally when RESEND_API_KEY is empty; staging/prod values come from Terraform-managed Fly secrets)
RESEND_API_KEY=
TAU_EMAIL_FROM=Tau <identity@taucad.dev>
TAU_EMAIL_REPLY_TO=identity@taucad.dev

# Kernels
ZOO_API_KEY=
ZOO_WEBSOCKET_URL=wss://api.zoo.dev

# Redis
REDIS_URL=redis://localhost:6379

# Durable jobs (self-hosted Hatchet or Hatchet Cloud; empty token disables dispatch)
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_NAMESPACE=tau-local


# Extra CORS origins, as a JSON array. Exact origins or glob patterns
# (e.g. ["https://deploy-preview-*--tau.netlify.app"]). Optional — defaults to [].
# TAU_FRONTEND_URL and the desktop app's own `app://tau` origin are always
# allowed; `http://localhost:3001` (nx dev:desktop ui) is added outside
# production. This is a CORS list only; it is NOT Better Auth's trustedOrigins.
ADDITIONAL_CORS_ORIGINS=[]
