# General
PORT=4000
TAU_FRONTEND_URL=http://localhost:3000
TAU_API_URL=http://localhost:4000
NODE_ENV=development
TAU_CLOUD_ENABLED=false
LOG_LEVEL=info

# LLMs
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=tau-local
LANGSMITH_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_VERTEX_AI_CREDENTIALS=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
MORPH_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=

# Database
# Local Docker Postgres (`pnpm infra:up postgres`). A linked git worktree automatically
# uses (and on first start forks) its own copy, `tau_dev_<worktree>`; see apps/api/app/database/README.md.
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/tau_dev
# Bounded runtime pool and per-connection deadlines (B8 R3). Each API process opens at
# most DATABASE_POOL_MAX backends; replicas × this value plus the billing-recovery
# worker (1) plus a migration allowance must fit the database's usable capacity.
# Out-of-range or non-numeric values refuse startup.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=60
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# De-privileged role assumed at connect so the request path cannot run DDL or edit
# immutable financial evidence. Empty locally until the protected migration job has
# installed `tau_api_runtime`; required in production.
DATABASE_RUNTIME_ROLE=


# Object storage (MinIO via infra/docker-compose.yml in dev; R2 in staging/prod)
# Namespace prefixes (blobs/, derivatives/, etc.) are compile-time constants —
# see apps/api/app/storage/storage.constants.ts
TAU_S3_ENDPOINT=http://localhost:9000
TAU_S3_REGION=us-east-1
TAU_S3_ACCESS_KEY_ID=tau-api
TAU_S3_SECRET_ACCESS_KEY=tau-api-dev-secret
TAU_S3_FORCE_PATH_STYLE=true
TAU_S3_BUCKET=tau-content
TAU_S3_PUBLIC_BASE_URL=http://localhost:9000/tau-content

# MinIO root creds (compose/bootstrap only; API uses TAU_S3_ACCESS_KEY_ID)
MINIO_ROOT_USER=tauminio
MINIO_ROOT_PASSWORD=tauminio-dev-secret

# Authentication
AUTH_URL=http://localhost:4000
AUTH_SECRET=
# First-party publication view cookie signing (min 32 characters)
TAU_VIEW_COOKIE_SECRET=dev-tau-view-cookie-secret-min-32-chars
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public-repo reads for the repositories API (repo metadata, git trees, zipball).
# Required by GET /v1/repositories/branches, which 401s without it; archive
# imports degrade to GitHub's unauthenticated rate limit instead of failing.
# Issue a fine-grained PAT with "Public repositories, read-only" and no account
# permissions — not a classic PAT.
GITHUB_API_TOKEN=
# First-class repository browsing and linked revision sync. Register a separate
# GitHub App per environment with Contents and Workflows read/write, then enable
# expiring user tokens. Generate the key with: openssl rand -base64 32
GITHUB_REPOSITORY_APP_CLIENT_ID=
GITHUB_REPOSITORY_APP_CLIENT_SECRET=
GITHUB_REPOSITORY_APP_SLUG=
GITHUB_REPOSITORY_APP_CALLBACK_URL=http://localhost:4000/v1/github/callback
GITHUB_REPOSITORY_CONNECTION_KEY=
GITHUB_REPOSITORY_CONNECTION_KEY_VERSION=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (disabled locally when RESEND_API_KEY is empty; staging/prod values come from Terraform-managed Fly secrets)
RESEND_API_KEY=
TAU_EMAIL_FROM=Tau <identity@taucad.dev>
TAU_EMAIL_REPLY_TO=help@taucad.dev

# Tau Hosted Remote (git server). Repositories live in the private object store
# under `tenants/<ownerId>/repos/<projectId>/`; every request builds a throwaway
# lease in the OS temp directory. There is no root directory to configure, and
# boot refuses a leftover TAU_GIT_ROOT (charter D1).
# Dev/e2e only (ruling P50): let the git proxy reach http:// and private or
# loopback addresses, so a local `git http-backend` can be connected. Refused
# outright in production. Default 0 keeps every such address refused.
# TAU_GIT_REMOTE_ALLOW_PRIVATE=0

# Redis
REDIS_URL=redis://localhost:6379

# Durable jobs (self-hosted Hatchet or Hatchet Cloud; empty token disables dispatch)
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_NAMESPACE=tau-local
# Paid job supplier gate (B7 R10). Unset = enabled in development, refused elsewhere.
# TAU_JOBS_ENABLED=true

# Extra CORS origins, as a JSON array. Exact origins or glob patterns
# (e.g. ["https://deploy-preview-*--tau.netlify.app"]). Optional — defaults to [].
# TAU_FRONTEND_URL and the desktop app's own `app://tau` origin are always
# allowed; `http://localhost:3001` (nx dev:desktop ui) is added outside
# production. This is a CORS list only; it is NOT Better Auth's trustedOrigins.
ADDITIONAL_CORS_ORIGINS=[]

# Tau Cloud billing. Ignored while TAU_CLOUD_ENABLED=false.
BILLING_ENVIRONMENT=development
# Live keys collect nothing until this is true (prod-* with STRIPE_LIVEMODE=true only).
BILLING_LIVE_COLLECTION_ENABLED=false
# Provider id -> credential account label the funded model resolver requires
# (app/api/billing/billing.module.ts). Any stable label works locally; Cloud startup
# refuses a configured provider missing from this map.
BILLING_PROVIDER_ACCOUNTS={"anthropic":"dev-anthropic","openai":"dev-openai","vertexai":"dev-vertexai","together":"dev-together","morph":"dev-morph","xai":"dev-xai","zoo":"dev-zoo"}
ZOO_API_KEY=
ZOO_WEBSOCKET_URL=wss://api.zoo.dev
# Request-pin digest key; the funded invocation throws below 32 characters.
BILLING_REQUEST_DIGEST_SECRET=dev-billing-request-digest-secret-min-32-chars
# Usage/balance cursor signing key; /v1/billing/credits 503s below 32 characters.
BILLING_USAGE_CURSOR_SECRET=dev-billing-usage-cursor-secret-min-32-chars
# Owner connection for the protected billing command
# (`pnpm nx run api:billing-policy:publish:development`), which installs the
# billing protections and publishes infra/billing/development.billing-policy.json.
BILLING_DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/tau_dev
