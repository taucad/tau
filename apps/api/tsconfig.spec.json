{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ESNext",
    "outDir": "./out-tsc/spec",
    "erasableSyntaxOnly": false, // Incompatible with NestJS dependency injection.
    "types": ["node", "vitest/importMeta", "vite-plugin-node", "vitest"],
    "paths": {
      "libcascade": ["../libs/api-extractor/src/generated/opencascade/modules/libcascade/index.d.ts"]
    }
  },
  "include": [
    "vite.config.ts",
    "vite.billing-command.config.ts",
    "vite.maintenance-command.config.ts",
    "vite.mirror-command.config.ts",
    "vite.storage-worker.config.ts",
    "vitest.billing.config.ts",
    "vitest.setup.ts",
    "vitest.integration.config.ts",
    "vitest.live.config.ts",
    "scripts/**/*.mts",
    "app/**/*.test.ts",
    "app/**/*.spec.ts",
    "app/**/*.test-d.ts",
    "app/**/*.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    // The API server libraries are source-consumed. Child processes the suites spawn through tsx read
    // this config, and tsx applies its decorator settings only to the files it includes.
    "../libs/api-core/src/**/*.ts",
    "../libs/api-observability/src/**/*.ts",
    "../libs/api-lifecycle/src/**/*.ts",
    "../libs/api-database/src/**/*.ts",
    "../libs/api-redis/src/**/*.ts",
    "../libs/api-email/src/**/*.ts",
    "../libs/api-auth/src/**/*.ts",
    "../libs/api-hosts/src/**/*.ts",
    "../libs/api-llm-gateway/src/**/*.ts",
    "../libs/api-billing/src/**/*.ts",
    "../libs/api-object-storage/src/**/*.ts",
    "../libs/api-git-core/src/**/*.ts",
    "../libs/api-git-mirror/src/**/*.ts",
    "../libs/api-agent-observability/src/**/*.ts",
    "../libs/api-chat/src/**/*.ts",
    "../libs/api-projects/src/**/*.ts",
    "../libs/api-testing/src/**/*.ts"
  ],
  "exclude": ["../libs/*/src/**/*.test.ts", "../libs/*/src/**/*.spec.ts", "../libs/*/src/**/*.test-d.ts"]
}
