{
  "name": "cli-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cli-e2e/src",
  "tags": ["scope:shared", "type:e2e"],
  "implicitDependencies": ["cli"],
  "targets": {
    "test:scenarios": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "The CLI's end-to-end suites (tiers 4 and 5): the built `tau` binary, `tau serve`, `tau mcp` and `tau agent` as real child processes against real kernels. Kept out of `cli:test` and the affected test shards: CI runs it in its own lane, `CLI end-to-end`, when this project is affected."
      },
      "dependsOn": [
        "^copy-assets",
        {
          "projects": ["cli"],
          "target": "build"
        },
        {
          "projects": ["build123d"],
          "target": "seed"
        }
      ],
      "inputs": ["default", "^production", "serviceEnvironment"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "../../node_modules/.bin/vitest run --config vitest.scenarios.config.ts"
      }
    },
    "test:native-darwin": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.github/workflows/native-darwin.yml",
        "{workspaceRoot}/.github/workflows/native-hosts.yml"
      ],
      "dependsOn": [
        "^copy-assets",
        {
          "projects": ["cli"],
          "target": "build"
        },
        {
          "projects": ["build123d"],
          "target": "seed"
        }
      ],
      "metadata": {
        "description": "Tier 4b of the native kernels on darwin-arm64 (charter D30, the native-darwin CI job): from an empty store, tau mcp and tau serve each prepare Build123d and PicoGK with real bytes and evaluate a real .py and .cs model to geometry, and the built tau exports main.cs with no Tau variable set. Kept off `test:scenarios` because it downloads about 210 MB and needs a darwin-arm64 host."
      },
      "options": {
        "cwd": "{projectRoot}",
        "command": "../../node_modules/.bin/vitest run --config vitest.scenarios.config.ts src/commands/mcp.integration.test.ts src/commands/serve.integration.test.ts src/cli-distribution.test.ts --testNamePattern 'tier 4b'",
        "env": {
          "TAU_NATIVE_DARWIN": "1",
          "TAU_E2E_CLI_BUILT": "true"
        }
      }
    },
    "test:ds3": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "../../node_modules/.bin/vitest run --config vitest.scenarios.config.ts src/tail-relay.integration.test.ts",
        "env": {
          "TAU_DS3_TAIL_RELAY": "1"
        }
      }
    }
  }
}
