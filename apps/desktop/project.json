{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "tags": ["scope:ui", "type:app"],
  "implicitDependencies": ["desktop-quick-look"],
  "targets": {
    "prepare-build123d-python": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/resources/python"],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/prepare-build123d-python.mts"
      }
    },
    "prepare-build123d-python-macos": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/resources/python/darwin-arm64"],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/prepare-build123d-python.mts --target darwin-arm64"
      }
    },
    "prepare-picogk-dotnet": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/resources/picogk"],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/prepare-picogk-dotnet.mts"
      }
    },
    "prepare-picogk-dotnet-macos": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/resources/picogk/darwin-arm64"],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/prepare-picogk-dotnet.mts --target darwin-arm64"
      }
    },
    "build": {
      "cache": true,
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "inputs": ["production", "^production", { "env": "TAU_CLOUD_ENABLED" }],
      "dependsOn": [{ "projects": ["ui"], "target": "build:desktop" }],
      "options": {
        "cwd": "{projectRoot}",
        "command": "electron-vite build"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        "prepare-build123d-python",
        "prepare-picogk-dotnet",
        { "projects": ["scripts"], "target": "populate-ui-env" },
        { "projects": ["ui"], "target": "dev:desktop" }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --import @oxc-node/core/register ../../scripts/src/wait-for-url.ts http://localhost:3001 && node --env-file=../ui/.env scripts/run-electron-vite.mts dev",
        "env": {
          "ELECTRON_RENDERER_URL": "http://localhost:3001"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        "build",
        "prepare-build123d-python",
        "prepare-picogk-dotnet",
        { "projects": ["scripts"], "target": "populate-ui-env" }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --env-file=../ui/.env scripts/run-electron-vite.mts preview --skipBuild",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "package-macos": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "check-renderer-payload",
        { "projects": ["desktop-quick-look"], "target": "build-extensions" },
        "prepare-build123d-python-macos",
        "prepare-picogk-dotnet-macos"
      ],
      "outputs": ["{projectRoot}/package-out"],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/package-macos.mts"
      }
    },
    "package-macos-release": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "check-renderer-payload",
        { "projects": ["desktop-quick-look"], "target": "build-extensions" },
        "prepare-build123d-python-macos",
        "prepare-picogk-dotnet-macos"
      ],
      "outputs": ["{projectRoot}/package-out"],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/package-macos.mts --release"
      }
    },
    "package-macos-unsigned": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "check-renderer-payload",
        { "projects": ["desktop-quick-look"], "target": "build-extensions" },
        "prepare-build123d-python-macos",
        "prepare-picogk-dotnet-macos"
      ],
      "outputs": ["{projectRoot}/package-out"],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/package-macos.mts --unsigned"
      }
    },
    "test-macos-package-mode": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/macos-package-mode.test.mts"
      }
    },
    "verify-macos-package": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/verify-macos-package.mts"
      }
    },
    "verify-macos-release": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/verify-macos-package.mts --release"
      }
    },
    "verify-macos-unsigned": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/verify-macos-package.mts --unsigned"
      }
    },
    "check-renderer-payload": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Renderer ownership gate: fails when the renderer bundle carries kernel, converter or host payloads (only KCL and Clipper WASM are allowed). Every package target depends on it. Cached on the bytes it checks, the renderer build and the main and preload bundles; `dist/dev-electron`, the branded Electron that `dev` and `serve` create, is left out of the key."
      },
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/scripts/check-renderer-payload.mts",
        {
          "dependentTasksOutputFiles": "{apps/ui/desktop/build,apps/desktop/dist/main,apps/desktop/dist/preload}/**",
          "transitive": true
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/check-renderer-payload.mts"
      }
    }
  }
}
