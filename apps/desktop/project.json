      }
    },
    "check-renderer-payload": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Renderer ownership gate: fails when the renderer bundle carries kernel, converter or host payloads (only KCL and Clipper WASM are allowed). Every package target depends on it. Cached on the bytes it checks, the renderer build and the main and preload bundles; `dist/dev-electron`, the branded Electron that `dev` and `serve` create, is left out of the key."
      },
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/scripts/check-renderer-payload.mts",
        {
          "dependentTasksOutputFiles": "{apps/ui/desktop/build,apps/desktop/dist/main,apps/desktop/dist/preload}/**",
          "transitive": true
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/check-renderer-payload.mts"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @oxc-node/core/register apps/desktop/scripts/publish-desktop.mts"
