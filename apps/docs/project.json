{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs",
  "projectType": "application",
  "tags": ["scope:ui", "type:app", "layer:feature", "deploy:staging"],
  "targets": {
    "generate-fumadocs": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/node_modules/.cache/fumadocs/apps/docs"],
      "options": {
        "command": "fumadocs-mdx app/lib/fumadocs/source.config.ts ../../node_modules/.cache/fumadocs/apps/docs",
        "cwd": "apps/docs"
      }
    },
    "typecheck": {
      "dependsOn": ["generate-fumadocs"]
    },
    "build": {
      "dependsOn": [],
      "options": {
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "lint": {
      "dependsOn": ["generate-fumadocs"],
      "options": {
        "files": "app *.test.ts vite.config.ts vitest.config.ts react-router.config.ts vite-environment.d.ts scripts/*.mts"
      }
    },
    "check-server-output": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Server-output gate (React Router 8 migration RR0, ruling RD8), with the web UI's script: fails when build/server is present. The site is ssr: false: React Router 8 leaves build/server after prerendering, the site's buildEnd removes it, and the check passes only on its absence. CI's build lane runs it whenever this site is affected."
      },
      "dependsOn": ["build"],
      "inputs": [
        "{workspaceRoot}/apps/ui/scripts/check-server-output.mts",
        {
          "dependentTasksOutputFiles": "apps/docs/build/{server,client/assets}/**"
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node apps/ui/scripts/check-server-output.mts --spa apps/docs/build"
      }
    },
    "verify-deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/docs/scripts/verify-deploy.mts"
      },
      "inputs": ["default", "^default", "{workspaceRoot}/pnpm-lock.yaml"]
    },
    "verify-browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/docs/scripts/verify-browser.mts"
      }
    },
    "deploy-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "test",
        "lint",
        "typecheck",
        {
          "target": "validate-prose",
          "projects": ["scripts"]
        }
      ],
      "options": {
        "commands": [
          "pnpm nx run docs:verify-deploy",
          "if [ -z \"$CHROMIUM_EXECUTABLE_PATH\" ]; then pnpm exec playwright install chromium; fi",
          "node apps/docs/scripts/verify-browser.mts"
        ],
        "parallel": false
      }
    }
  }
}
