{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs",
  "projectType": "application",
  "tags": ["scope:ui", "type:app", "layer:feature"],
  "targets": {
    "generate-fumadocs": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/node_modules/.cache/fumadocs/apps/docs"],
      "options": {
        "command": "fumadocs-mdx apps/docs/app/lib/fumadocs/source.config.ts node_modules/.cache/fumadocs/apps/docs"
      }
    },
    "typecheck": {
      "dependsOn": ["generate-fumadocs"]
    },
    "build": {
      "dependsOn": [],
      "options": {
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "lint": {
      "options": {
        "files": "app *.test.ts vite.config.ts vitest.config.ts react-router.config.ts vite-environment.d.ts"
      }
    }
  }
}
