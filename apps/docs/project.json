{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs",
  "projectType": "application",
  "tags": ["scope:ui", "type:app", "layer:feature"],
  "targets": {
    "generate-fumadocs": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/node_modules/.cache/fumadocs/apps/docs"],
      "options": {
        "command": "fumadocs-mdx app/lib/fumadocs/source.config.ts ../../node_modules/.cache/fumadocs/apps/docs",
        "cwd": "apps/docs"
      }
    },
    "typecheck": {
      "dependsOn": ["generate-fumadocs"]
    },
    "build": {
      "dependsOn": [],
      "options": {
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "lint": {
      "dependsOn": ["generate-fumadocs"],
      "options": {
        "files": "app *.test.ts vite.config.ts vitest.config.ts react-router.config.ts vite-environment.d.ts scripts/*.mts"
      }
    },
    "verify-deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/docs/scripts/verify-deploy.mts"
      }
    },
    "verify-browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/docs/scripts/verify-browser.mts"
      }
    },
    "deploy-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "test",
        "lint",
        "typecheck",
        {
          "target": "validate-prose",
          "projects": ["scripts"]
        }
      ],
      "options": {
        "commands": [
          "pnpm nx run docs:verify-deploy",
          "if [ -z \"$CHROMIUM_EXECUTABLE_PATH\" ]; then pnpm exec playwright install chromium; fi",
          "node apps/docs/scripts/verify-browser.mts"
        ],
        "parallel": false
      }
    }
  }
}
