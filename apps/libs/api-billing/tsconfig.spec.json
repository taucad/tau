{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["node", "vitest/importMeta", "vitest", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "target": "ESNext",
    "erasableSyntaxOnly": false
  },
  "include": [
    "vitest.config.ts",
    "vitest.setup.ts",
    "tsdown.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test-d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "scripts/**/*.mts",
    "vitest.billing.config.ts",
    "vitest.integration.config.ts",
    "../api-core/src/types/environment.d.ts",
    // Child processes the foundation suites fork through tsx read this config, and tsx applies its
    // decorator settings only to the files it includes: list the source-consumed libraries billing loads.
    "../api-core/src/**/*.ts",
    "../api-observability/src/**/*.ts",
    "../api-lifecycle/src/**/*.ts",
    "../api-database/src/**/*.ts",
    "../api-redis/src/**/*.ts",
    "../api-email/src/**/*.ts",
    "../api-auth/src/**/*.ts",
    "../api-hosts/src/**/*.ts",
    "../api-llm-gateway/src/**/*.ts"
  ],
  "exclude": [
    "../api-core/src/**/*.test.ts",
    "../api-core/src/**/*.spec.ts",
    "../api-core/src/**/*.test-d.ts",
    "../api-observability/src/**/*.test.ts",
    "../api-observability/src/**/*.spec.ts",
    "../api-observability/src/**/*.test-d.ts",
    "../api-lifecycle/src/**/*.test.ts",
    "../api-lifecycle/src/**/*.spec.ts",
    "../api-lifecycle/src/**/*.test-d.ts",
    "../api-database/src/**/*.test.ts",
    "../api-database/src/**/*.spec.ts",
    "../api-database/src/**/*.test-d.ts",
    "../api-redis/src/**/*.test.ts",
    "../api-redis/src/**/*.spec.ts",
    "../api-redis/src/**/*.test-d.ts",
    "../api-email/src/**/*.test.ts",
    "../api-email/src/**/*.spec.ts",
    "../api-email/src/**/*.test-d.ts",
    "../api-auth/src/**/*.test.ts",
    "../api-auth/src/**/*.spec.ts",
    "../api-auth/src/**/*.test-d.ts",
    "../api-hosts/src/**/*.test.ts",
    "../api-hosts/src/**/*.spec.ts",
    "../api-hosts/src/**/*.test-d.ts",
    "../api-llm-gateway/src/**/*.test.ts",
    "../api-llm-gateway/src/**/*.spec.ts",
    "../api-llm-gateway/src/**/*.test-d.ts"
  ]
}
