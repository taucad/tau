  },
  "homepage": "https://github.com/taucad/tau/tree/main/apps/libs/api-core#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "keywords": [
    "cad",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
