{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/importMeta", "vitest"],
    "target": "ESNext"
  },
  "include": ["vitest.config.ts", "scripts/**/*.mts", "src/**/*.ts"]
}
