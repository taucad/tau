{
  "extends": "../../../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../support/**/*.ts",
    "../../support/**/*.tsx",
    "../../../src/**/*.ts",
    ".next/types/**/*.ts"
  ]
}
