          "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-isolated",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-non-isolated",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-example"
        ]
      }
    },
    "test:e2e:react-router:isolated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-isolated"
      }
    },
    "test:e2e:react-router:non-isolated": {
