{
  "name": "react-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/react-e2e",
  "tags": ["scope:shared", "type:e2e"],
  "implicitDependencies": ["react", "runtime"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": true,
        "commands": [
          "tsgo -p apps/react-e2e/tsconfig.json --noEmit",
          "tsgo -p apps/react-e2e/apps/electron/tsconfig.json --noEmit",
          "tsgo -p apps/react-e2e/apps/nextjs/tsconfig.json --noEmit",
          "tsgo -p apps/react-e2e/apps/react-router/tsconfig.json --noEmit"
        ]
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "playwright test --config apps/react-e2e/playwright.config.ts --project=electron",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=electron-example",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-isolated",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-non-isolated",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-example",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-isolated",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-non-isolated",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-example"
        ]
      }
    },
    "test:e2e:development": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-development",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-example-development",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-development",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-example-development"
        ]
      }
    },
    "test:e2e:electron:development": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "playwright test --config apps/react-e2e/playwright.config.ts --project=electron-development",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=electron-example-development"
        ]
      }
    },
    "test:e2e:nextjs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-isolated",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-non-isolated",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-example"
        ]
      }
    },
    "test:e2e:nextjs:isolated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-isolated"
      }
    },
    "test:e2e:nextjs:non-isolated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test --config apps/react-e2e/playwright.config.ts --project=nextjs-non-isolated"
      }
    },
    "test:e2e:nextjs:example": {
