      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test --config apps/react-e2e/playwright.config.ts --project=react-router-example"
      }
    },
    "test:e2e:electron": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "playwright test --config apps/react-e2e/playwright.config.ts --project=electron",
          "playwright test --config apps/react-e2e/playwright.config.ts --project=electron-example"
        ]
      }
    },
    "test:e2e:electron:legacy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test --config apps/react-e2e/playwright.config.ts --project=electron"
      }
    },
    "test:e2e:electron-example": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "playwright test --config apps/react-e2e/playwright.config.ts --project=electron-example"
      }
    }
  }
}
