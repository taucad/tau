{
  "name": "runtime-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/runtime-e2e/src",
  "projectType": "application",
  "tags": ["scope:shared", "type:e2e", "host:darwin-arm64", "ci:quarantined"],
  "implicitDependencies": ["runtime", "tau-examples", "geospec", "geospec-engine", "scripts"],
  "targets": {
    "test:e2e": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Check installed public runtime, tscircuit, esbuild and React inference and rendering against the packed browser-only closure."
      },
      "cache": false,
      "inputs": ["default", "^production", "{workspaceRoot}/scripts/src/check-pack-install.ts"],
      "dependsOn": [
        {
          "projects": [
            "runtime",
            "tscircuit",
            "esbuild",
            "react",
            "bundler-core",
            "cache-core",
            "filesystem",
            "geometry-core",
            "kinematics",
            "parameters",
            "project-core",
            "revisions",
            "rpc",
            "spatial",
            "units"
          ],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node scripts/src/check-pack-install.ts packages/runtime packages/plugins/tscircuit packages/plugins/esbuild packages/react"
      }
    },
    "test": {
      "dependsOn": ["^copy-assets"],
      "inputs": [
        "default",
        "^default",
        {
          "env": "TAU_EXAMPLE_PATTERN"
        },
        {
          "env": "TAU_PICOGK_RESOURCE_ROOT"
        },
        {
          "env": "GEOSPEC_TURBOFAN_NATIVE"
        }
      ]
    },
    "native-turbofan": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        { "projects": ["desktop"], "target": "prepare-picogk-dotnet-macos" },
        { "projects": ["geospec-engine-native"], "target": "prepare-geospec-ci-artifacts" }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "GEOSPEC_TURBOFAN_NATIVE=1 TAU_PICOGK_RESOURCE_ROOT=\"$PWD/../../apps/desktop/resources/picogk\" vitest run src/picogk-turbofan-native.test.ts"
      }
    },
    "example-health": {
      "command": "vitest run src/tau-examples-health.test.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "default",
        "^default",
        {
          "env": "TAU_EXAMPLE_PATTERN"
        }
      ]
    },
    "benchmark-example-health": {
      "command": "tsx scripts/benchmark-example-health.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "performance-gate": {
      "command": "vitest run src/benchmarks/wasm-size.test.ts src/benchmarks/benchmark-comparator.test.ts src/benchmarks/native-speedup.bench.test.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "compute-baseline": {
      "command": "node --import @oxc-node/core/register src/compute-baseline/harness/driver.mts --models parity-box,hollow-box,stress-test,v8-block-late --arms bypass,durable,memory --pairs 5 --steps cold,warm,late,early,unrelated --restart --brepDigest --tag pinning",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "compute-baseline-summarize": {
      "command": "node --import @oxc-node/core/register src/compute-baseline/harness/summarize.mts ../../out/reports/compute-baseline/*-pinning-*.json",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "benchmark": {
      "command": "tsx --require ./scripts/cjs-compat.cjs scripts/benchmark-kernels.mts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "benchmark-bundlers": {
      "command": "node scripts/benchmark-bundlers.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        {
          "projects": ["bundler-core", "esbuild", "rolldown"],
          "target": "build"
        }
      ]
    },
    "benchmark-bundler-products": {
      "command": "node scripts/benchmark-bundler-products.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime", "middleware", "replicad", "bundler-core", "esbuild", "rolldown"],
          "target": "build"
        }
      ]
    },
    "build-matrix": {
      "command": "tsx scripts/build-matrix-report.mts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "compare-benchmarks": {
      "command": "tsx scripts/compare-benchmarks.mts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "readme-quickstart": {
      "command": "node --import tsx scripts/check-runtime-readme-quick-start.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/runtime/README.md",
        "{projectRoot}/scripts/check-runtime-readme-quick-start.mts"
      ]
    }
  }
}
