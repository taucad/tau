{
  "name": "runtime-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/runtime-e2e/src",
  "projectType": "application",
  "tags": ["scope:shared", "type:e2e", "ci:quarantined", "ci:standalone"],
  "implicitDependencies": ["runtime", "tau-examples"],
  "targets": {
    "test:e2e:queue": {
      "executor": "nx:noop",
      "dependsOn": ["test:e2e"],
      "metadata": {
        "description": "The merge-queue e2e ratchet: the suites of this project that passed five consecutive e2e-nightly runs (two before 2026-11-17). ci.yml's e2e-queue lane runs each one as its own job in the merge queue whenever this project is affected, and e2e-nightly.yml leaves every suite listed here out of its matrix. A suite joins by being added to dependsOn (a target of this project) once green on five consecutive nightlies, and never moves back. Running this target runs them all."
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Check installed public runtime, tscircuit, esbuild and React inference and rendering against the packed browser-only closure."
      },
      "cache": false,
      "inputs": ["default", "^production", "{workspaceRoot}/scripts/src/check-pack-install.ts"],
      "dependsOn": [
        {
          "projects": [
            "runtime",
            "tscircuit",
            "esbuild",
            "react",
            "bundler-core",
            "cache-core",
            "filesystem",
            "geometry-core",
            "kinematics",
            "parameters",
            "project-core",
            "revisions",
            "rpc",
            "spatial",
            "units"
          ],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node scripts/src/check-pack-install.ts packages/runtime packages/plugins/tscircuit packages/plugins/esbuild packages/react"
      }
    },
    "test": {
      "dependsOn": ["^copy-assets"],
      "inputs": [
        "default",
        "^default",
        {
          "env": "TAU_EXAMPLE_PATTERN"
        },
        {
          "env": "TAU_CONFIG_DIR"
        },
        {
          "env": "GEOSPEC_TURBOFAN_NATIVE"
        }
      ]
    },
    "native-turbofan": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["cli"],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --import @oxc-node/core/register ../../packages/cli/dist/bin/tau.mjs prepare picogk && vitest run src/picogk-turbofan-native.test.ts",
        "env": {
          "GEOSPEC_TURBOFAN_NATIVE": "1"
        }
      }
    },
    "example-health": {
      "command": "vitest run src/tau-examples-health.test.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "default",
        "^default",
        {
          "env": "TAU_EXAMPLE_PATTERN"
        }
      ]
    },
    "benchmark-example-health": {
      "command": "tsx scripts/benchmark-example-health.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "performance-gate": {
      "command": "vitest run src/benchmarks/wasm-size.test.ts src/benchmarks/benchmark-comparator.test.ts src/benchmarks/native-speedup.bench.test.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "compute-baseline": {
      "command": "node --import @oxc-node/core/register src/compute-baseline/harness/driver.mts --models parity-box,hollow-box,stress-test,v8-block-late --arms bypass,durable,memory --pairs 5 --steps cold,warm,late,early,unrelated --restart --brepDigest --tag pinning",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "compute-baseline-summarize": {
      "command": "node --import @oxc-node/core/register src/compute-baseline/harness/summarize.mts ../../out/reports/compute-baseline/*-pinning-*.json",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "compute-qualify-ci": {
      "command": "vitest run src/compute-baseline/compute-qualification.test.ts src/compute-baseline/identity-tracer.test.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "metadata": {
        "description": "Compute reuse qualification, CI subset (audit R5): reuse-off GLB hashes and per-step counts against the pins, byte parity with reuse on, ten cache histories, multi-thread parity and the identity tracer's effect model."
      }
    },
    "compute-qualify": {
      "command": "node --import @oxc-node/core/register src/compute-baseline/harness/qualify-driver.mts --pairs 2",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "metadata": {
        "description": "Full compute reuse qualification campaign: seven models, matrix, scrub, agent loop, history gate and stop latency, arms alternated in pairs. Writes out/reports/compute-qualify/<stamp>."
      }
    },
    "compute-qualify-summarize": {
      "command": "node --import @oxc-node/core/register src/compute-baseline/harness/qualify-summarize.mts --pins src/compute-baseline/qualification-baselines.json",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "metadata": {
        "description": "Summarize a qualification campaign directory (pass it after --): parity, history gate, counts, stop latency, timings and drift against the pins."
      }
    },
    "benchmark": {
      "command": "tsx --require ./scripts/cjs-compat.cjs scripts/benchmark-kernels.mts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "benchmark-bundlers": {
      "command": "node scripts/benchmark-bundlers.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        {
          "projects": ["bundler-core", "esbuild", "rolldown"],
          "target": "build"
        }
      ]
    },
    "benchmark-bundler-products": {
      "command": "node scripts/benchmark-bundler-products.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime", "middleware", "replicad", "bundler-core", "esbuild", "rolldown"],
          "target": "build"
        }
      ]
    },
    "build-matrix": {
      "command": "tsx scripts/build-matrix-report.mts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "compare-benchmarks": {
      "command": "tsx scripts/compare-benchmarks.mts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "readme-quickstart": {
      "command": "node --import tsx scripts/check-runtime-readme-quick-start.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/runtime/README.md",
        "{projectRoot}/scripts/check-runtime-readme-quick-start.mts"
      ]
    }
  }
}
