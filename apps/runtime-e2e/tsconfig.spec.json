{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "./out-tsc/spec",
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/importMeta", "vitest"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.mts", "vitest.config.ts", "scripts/cjs-compat.cjs"]
}
