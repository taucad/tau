{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/importMeta", "vitest"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "paths": {
      "#*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.mts", "vitest.config.ts"]
}
