{
  "name": "ui-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ui-e2e/src",
  "tags": ["scope:ui", "type:e2e"],
  "implicitDependencies": ["ui"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vitest run apps/ui-e2e/src/global-setup-preflight.spec.ts --environment=node"
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["ui"], "target": "build" }],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vitest run --config apps/ui-e2e/vitest.config.ts"
      }
    },
    "test:e2e:development": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vitest run --config apps/ui-e2e/vitest.config.ts --project chromium src/preview.spec.ts src/geospec-runner.spec.ts src/headless-chat-image-capture.development.spec.ts",
        "env": {
          "PORT": "3012",
          "TAU_E2E_SERVER_MODE": "development"
        }
      }
    }
  }
}
