{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "outDir": "./out-tsc/spec",
    "types": ["node", "vitest", "vitest/browser", "@vitest/browser-playwright"],
    "paths": {
      "#*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.mts", "global-setup.ts", "production-server.ts", "vitest.config.ts"]
}
