TAU_API_URL=http://localhost:4000
TAU_WEBSOCKET_URL=ws://localhost:4001
TAU_FRONTEND_URL=http://localhost:3000

# Server-only. Never added to `clientEnvironmentKeys` in app/environment.config.ts —
# it must not reach the browser. Only read by server routes (/api/github-branches,
# /api/import, /api/github-stars, /api/github-avatar).
#
# Used for public-repo reads only (repo metadata, git trees, branch refs, zipball).
# Issue a fine-grained PAT with "Public repositories, read-only" and no account
# permissions — not a classic PAT. Optional: without it, GitHub imports fall back to
# the unauthenticated rate limit and the branch list is unavailable.
GITHUB_API_TOKEN=
