{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui",
  "projectType": "application",
  "tags": ["scope:ui", "type:app", "layer:feature", "release:app", "deploy:staging", "ci:browser", "ci:standalone"],
  "targets": {
    "render-calibration": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite --config vite.calibration.config.ts --mode test"
      }
    },
    "render-calibration-generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/ui/scripts/render-calibration/generate.mts"
      }
    },
    "render-calibration-compare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/ui/scripts/render-calibration/compare.mts"
      }
    },
    "render-calibration-nano": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/ui/scripts/render-calibration/render-nano.mts"
      }
    },
    "render-calibration-check-server": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/ui/scripts/render-calibration/check-server.mts"
      }
    },
    "build": {
      "cache": true,
      "dependsOn": ["copy-assets", "^copy-assets", "csharp-language:prepare", "openscad-language:prepare"],
      "outputs": ["{projectRoot}/build"],
      "inputs": [
        "production",
        "^production",
        {
          "env": "TAU_API_URL"
        },
        {
          "env": "TAU_WEBSOCKET_URL"
        },
        {
          "env": "TAU_FRONTEND_URL"
        },
        {
          "env": "PORTLESS_URL"
        },
        {
          "env": "TAU_CLOUD_ENABLED"
        },
        {
          "env": "TAU_DESKTOP_RELEASED"
        },
        {
          "env": "TAU_SERVICE_WORKER_KILL_SWITCH"
        },
        {
          "env": "TAU_BILLING_ENVIRONMENT"
        },
        {
          "env": "NETLIFY"
        },
        {
          "env": "NETLIFY_LOCAL"
        },
        {
          "env": "CONTEXT"
        },
        {
          "env": "DEPLOY_PRIME_URL"
        },
        {
          "env": "DEPLOY_URL"
        },
        {
          "env": "NETLIFY_AI_GATEWAY_URL"
        },
        {
          "env": "TAU_DEBUG"
        },
        {
          "env": "SENTRY_ENVIRONMENT"
        },
        {
          "env": "GEOSPEC_MT_STAGED_PACKAGE_ROOT"
        },
        {
          "env": "PICOGK_BROWSER_ASSETS_ROOT"
        },
        {
          "env": "PICOGK_BROWSER_MIRROR_BASE"
        },
        {
          "env": "CADMPEG_ENGINES_BASE"
        },
        {
          "runtime": "node apps/ui/geospec-mt-assets-cache-key.ts"
        },
        {
          "runtime": "node apps/ui/picogk-browser-assets-cache-key.ts"
        },
        {
          "runtime": "node apps/ui/csharp-language-assets-cache-key.ts"
        },
        {
          "env": "POSTHOG_CLIENT_KEY"
        },
        {
          "env": "POSTHOG_API_HOST"
        },
        {
          "env": "POSTHOG_UI_HOST"
        },
        {
          "env": "POSTHOG_ASSET_HOST"
        },
        {
          "env": "STATS"
        }
      ],
      "command": "node ../../tools/build-lock.mjs build -- \"react-router build --sourcemapClient hidden --sourcemapServer hidden && node scripts/compress-static-assets.mts && node scripts/split-server-sourcemaps.mts\"",
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "build-adaptive": {
      "cache": true,
      "dependsOn": ["copy-assets", "^copy-assets", "csharp-language:prepare", "openscad-language:prepare"],
      "outputs": ["{projectRoot}/build-adaptive"],
      "inputs": [
        "production",
        "^production",
        {
          "env": "TAU_API_URL"
        },
        {
          "env": "TAU_WEBSOCKET_URL"
        },
        {
          "env": "TAU_FRONTEND_URL"
        },
        {
          "env": "PORTLESS_URL"
        },
        {
          "env": "TAU_DESKTOP_RELEASED"
        },
        {
          "env": "TAU_SERVICE_WORKER_KILL_SWITCH"
        },
        {
          "env": "TAU_BILLING_ENVIRONMENT"
        },
        {
          "env": "NETLIFY"
        },
        {
          "env": "NETLIFY_LOCAL"
        },
        {
          "env": "CONTEXT"
        },
        {
          "env": "DEPLOY_PRIME_URL"
        },
        {
          "env": "DEPLOY_URL"
        },
        {
          "env": "NETLIFY_AI_GATEWAY_URL"
        },
        {
          "env": "TAU_DEBUG"
        },
        {
          "env": "SENTRY_ENVIRONMENT"
        },
        {
          "env": "GEOSPEC_MT_STAGED_PACKAGE_ROOT"
        },
        {
          "env": "PICOGK_BROWSER_ASSETS_ROOT"
        },
        {
          "env": "PICOGK_BROWSER_MIRROR_BASE"
        },
        {
          "env": "CADMPEG_ENGINES_BASE"
        },
        {
          "runtime": "node apps/ui/geospec-mt-assets-cache-key.ts"
        },
        {
          "runtime": "node apps/ui/picogk-browser-assets-cache-key.ts"
        },
        {
          "runtime": "node apps/ui/csharp-language-assets-cache-key.ts"
        },
        {
          "env": "POSTHOG_CLIENT_KEY"
        },
        {
          "env": "POSTHOG_API_HOST"
        },
        {
          "env": "POSTHOG_UI_HOST"
        },
        {
          "env": "POSTHOG_ASSET_HOST"
        },
        {
          "env": "STATS"
        }
      ],
      "command": "node ../../tools/build-lock.mjs build -- \"react-router build --sourcemapClient hidden --sourcemapServer hidden\"",
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192",
          "TAU_CLOUD_ENABLED": "adaptive",
          "TAU_UI_BUILD_DIRECTORY": "build-adaptive"
        }
      },
      "metadata": {
        "description": "The adaptive web build (adaptive app deployment mode charter W2, gate G1): `TAU_CLOUD_ENABLED=adaptive` into `build-adaptive/`, beside `ui:build`, so `ui:check-critical-budget-adaptive` can hold it to the self-host budget. Not deployed."
      }
    },
    "build:desktop": {
      "cache": true,
      "dependsOn": ["copy-assets", "^copy-assets", "csharp-language:prepare", "openscad-language:prepare"],
      "outputs": ["{projectRoot}/desktop/build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/apps/desktop/package.json",
        {
          "env": "TAU_CLOUD_ENABLED"
        },
        {
          "env": "TAU_TELEMETRY_HOST"
        },
        {
          "env": "GEOSPEC_MT_STAGED_PACKAGE_ROOT"
        },
        {
          "env": "PICOGK_BROWSER_ASSETS_ROOT"
        },
        {
          "runtime": "node apps/ui/geospec-mt-assets-cache-key.ts"
        },
        {
          "runtime": "node apps/ui/picogk-browser-assets-cache-key.ts"
        },
        {
          "runtime": "node apps/ui/csharp-language-assets-cache-key.ts"
        }
      ],
      "command": "node ../../../tools/build-lock.mjs build -- react-router build --config vite.config.ts --sourcemapClient hidden",
      "options": {
        "cwd": "{projectRoot}/desktop",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192",
          "REACT_ROUTER_ROOT": "."
        }
      }
    },
    "check-desktop-payload": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Desktop renderer ownership gate: fails when the desktop renderer bundle (this app's `build:desktop` output) carries kernel, converter or host payloads (only the KCL editor, Clipper section-cap and Terminal ghostty-vt WASM are allowed, one copy each, with producer provenance, plus the C# and OpenSCAD editor language servers byte-matched to their prepared stage manifests). Every `desktop` package target depends on it, and CI's build lane runs it whenever this app is affected. Cached on the bytes it checks, the renderer build and the desktop main and preload bundles; `dist/dev-electron`, the branded Electron that `desktop:dev` and `desktop:serve` create, is left out of the key."
      },
      "dependsOn": [
        "build:desktop",
        {
          "projects": ["desktop"],
          "target": "build"
        }
      ],
      "inputs": [
        "{projectRoot}/scripts/check-desktop-payload.mts",
        {
          "dependentTasksOutputFiles": "{apps/ui/desktop/build,apps/desktop/dist/main,apps/desktop/dist/preload,out/csharp-language/stage,out/openscad-language/stage}/**",
          "transitive": true
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register apps/ui/scripts/check-desktop-payload.mts"
      }
    },
    "check-critical-budget": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Critical-path budget gate (progressive loading guard G3 and shell invariant 7): measures each route class's interactive tier in the web client build (brotli bytes, requests, largest chunk) against critical-budget.json, names any heavy module family (AI SDK, three.js, kernels, editor, telemetry) among the tier's module ids, and fails when a document may preload a kernel, wasm or worker asset. Reads the module-id manifest `ui:build` writes to build/client-module-ids.json. CI's build lane runs it whenever this app is affected."
      },
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/scripts/check-critical-budget.mts",
        "{projectRoot}/scripts/critical-path.mts",
        "{projectRoot}/critical-budget.json",
        "{projectRoot}/scripts/precache-list.ts",
        "{projectRoot}/build-environment.ts",
        {
          "env": "TAU_SERVICE_WORKER_KILL_SWITCH"
        },
        {
          "dependentTasksOutputFiles": "apps/ui/build/{client-module-ids.json,service-worker-precache.json,client/.vite/manifest.json,client/assets/**,client/**/*.html}"
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node apps/ui/scripts/check-critical-budget.mts"
      }
    },
    "check-critical-budget-adaptive": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Gate G1 (adaptive app deployment mode charter I10, I11): the adaptive build in build-adaptive/ against the checked-in self-host entry of critical-budget.json and the same run's self-host build in build/, within +2 requests, 1 % of total bytes and 1 % of the largest chunk per route class; also every check check-critical-budget makes. --write is refused for it. CI's build lane runs it whenever this app is affected."
      },
      "dependsOn": ["build", "build-adaptive"],
      "inputs": [
        "{projectRoot}/scripts/check-critical-budget.mts",
        "{projectRoot}/scripts/critical-path.mts",
        "{projectRoot}/critical-budget.json",
        "{projectRoot}/scripts/precache-list.ts",
        "{projectRoot}/build-environment.ts",
        {
          "env": "TAU_SERVICE_WORKER_KILL_SWITCH"
        },
        {
          "dependentTasksOutputFiles": "apps/ui/{build,build-adaptive}/{client-module-ids.json,service-worker-precache.json,client/.vite/manifest.json,client/assets/**,client/**/*.html}"
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node apps/ui/scripts/check-critical-budget.mts --build build-adaptive --baseline build"
      }
    },
    "check-static-shells": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Static-shell gate (progressive loading PL3, shell invariants 1, 2, 5 and 6): for each static-shell class of app/lib/route-classes.ts, renders the shell through the web server build for two different visitors a day apart and requires the prerendered bytes, the function's own document for a real URL of the class, the build id /health/build answers, the function document's isolation, CSP, reporting and document policies on the static headers (netlify.toml and the _headers the build writes), every inline script either listed with its CSP hash in app/lib/inline-script-hashes.ts or recognised as one whose source is not fixed (the client environment, the icon sprite loader, React Router's and React's own scripts), and no rendered placeholder. Runs with the build's environment (TAU_API_URL, TAU_WEBSOCKET_URL, TAU_FRONTEND_URL, as ci.yml sets them workflow-wide). CI's build lane runs it whenever this app is affected."
      },
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/scripts/check-static-shells.mts",
        "{projectRoot}/scripts/write-content-security-policy-headers.mts",
        "{projectRoot}/app/lib/route-classes.ts",
        "{projectRoot}/app/lib/content-security-policy.server.ts",
        "{projectRoot}/app/lib/inline-script-hashes.ts",
        "{projectRoot}/netlify.toml",
        {
          "env": "TAU_API_URL"
        },
        {
          "env": "TAU_WEBSOCKET_URL"
        },
        {
          "env": "TAU_FRONTEND_URL"
        },
        {
          "dependentTasksOutputFiles": "apps/ui/build/{server/**,client/**/*.html}"
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node apps/ui/scripts/check-static-shells.mts"
      }
    },
    "size": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "SSR bundle budget (SSR bundle policy): fails when the web build's server output (`du -sk build/server`, after ui:build moved the server source maps out) or its index.js exceeds the budget in scripts/check-ssr-bundle-budget.mts, or when a server file deep-imports @react-three/drei/core. Re-based in RR0 on the output check-server-output keeps clean. CI's build lane runs it whenever this app is affected."
      },
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/scripts/check-ssr-bundle-budget.mts",
        {
          "dependentTasksOutputFiles": "apps/ui/build/server/**"
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node apps/ui/scripts/check-ssr-bundle-budget.mts"
      }
    },
    "check-server-output": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Server-output gate (React Router 8 migration RR0, ruling RD8): fails when a server output holds a .wasm file, a worker bundle or a file also in its client/assets, or names an asset URL that resolves in neither output; and when the web server build no longer imports @taucad/openrscad by name (the server environment's resolve.external, RR5). Checks the web build (ssr: true, so build/server must exist), the desktop renderer build and the `tau serve` build (both ssr: false: React Router 8 leaves build/server, their configs' buildEnd removes it, and one left behind fails). The docs site has its own docs:check-server-output. CI's build lane runs it whenever this app is affected; build and build:desktop are already in that lane, build:serve is added by this target."
      },
      "dependsOn": ["build", "build:desktop", "build:serve"],
      "inputs": [
        "{projectRoot}/scripts/check-server-output.mts",
        {
          "dependentTasksOutputFiles": "apps/ui/{build,desktop/build,serve/build}/{server,client/assets}/**"
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node apps/ui/scripts/check-server-output.mts --server apps/ui/build --spa apps/ui/desktop/build --spa apps/ui/serve/build --external @taucad/openrscad"
      }
    },
    "check-cadmpeg-engine-absence": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "cadmpeg engine-absence gate (cadmpeg engine delivery charter D16, I1): fails when the web, desktop renderer or `tau serve` build holds a file whose SHA-256 is the raw or gzip digest of any engine in the installed `cadmpeg-ts/digests`, under any name, and names the file and the engine. The browser loads one engine per opened format by digest at run time, so no build carries one. A missing build directory fails. CI's build lane runs it whenever this app is affected; its builds are already in that lane."
      },
      "dependsOn": ["build", "build:desktop", "build:serve"],
      "inputs": [
        "{projectRoot}/scripts/check-cadmpeg-engine-absence.mts",
        {
          "externalDependencies": ["cadmpeg-ts"]
        },
        {
          "dependentTasksOutputFiles": "apps/ui/{build,desktop/build,serve/build}/**"
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node apps/ui/scripts/check-cadmpeg-engine-absence.mts apps/ui/build apps/ui/desktop/build apps/ui/serve/build"
      }
    },
    "check-serve-ui-layer": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Serve UI layer size gate (X2; cadmpeg engine delivery charter D16, I11): builds the `tau serve` UI layer from the `tau serve` build with packages/cli/scripts/serve-ui-layer.mts, the release's own deterministic tar and gzip, and fails when it is over 150,000,000 B gzipped. It prints the layer's size on a pass and on a refusal. The release build's serve-ui-layer job still applies the same line. CI's build lane runs it whenever this app is affected; build:serve is already in that lane."
      },
      "dependsOn": ["build:serve"],
      "inputs": [
        "{workspaceRoot}/packages/cli/scripts/serve-ui-layer.mts",
        {
          "dependentTasksOutputFiles": "apps/ui/serve/build/client/**"
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node --import @oxc-node/core/register packages/cli/scripts/serve-ui-layer.mts build --client apps/ui/serve/build/client --out out/serve-ui-layer"
      }
    },
    "check-route-module-patch": {
      "executor": "nx:run-commands",
      "cache": true,
      "metadata": {
        "description": "Route-module patch gate (React Router 8 migration RR8, ruling RD4): fails when the web, desktop renderer or `tau serve` client build ships React Router's loadRouteModule without Tau's local patch (tools/pnpm/patches/react-router@<version>.patch, TAU-UI-S), which loads a push navigation's destination instead of reloading the page being left when its route module fails to import. Every React Router bump re-keys the patch; a patch pnpm stops applying would otherwise ship unnoticed. CI's build lane runs it whenever this app is affected; its builds are already in that lane."
      },
      "dependsOn": ["build", "build:desktop", "build:serve"],
      "inputs": [
        "{projectRoot}/scripts/check-route-module-patch.mts",
        {
          "dependentTasksOutputFiles": "apps/ui/{build,desktop/build,serve/build}/client/assets/**/*.js"
        }
      ],
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "node apps/ui/scripts/check-route-module-patch.mts apps/ui/build apps/ui/desktop/build apps/ui/serve/build"
      }
    },
    "build:serve": {
      "cache": true,
      "dependsOn": ["copy-assets", "^copy-assets", "csharp-language:prepare", "openscad-language:prepare"],
      "outputs": ["{projectRoot}/serve/build"],
      "inputs": [
        "production",
        "^production",
        {
          "env": "TAU_CLOUD_ENABLED"
        },
        {
          "env": "GEOSPEC_MT_STAGED_PACKAGE_ROOT"
        },
        {
          "env": "PICOGK_BROWSER_ASSETS_ROOT"
        },
        {
          "runtime": "node apps/ui/geospec-mt-assets-cache-key.ts"
        },
        {
          "runtime": "node apps/ui/picogk-browser-assets-cache-key.ts"
        },
        {
          "runtime": "node apps/ui/csharp-language-assets-cache-key.ts"
        }
      ],
      "command": "node ../../../tools/build-lock.mjs build -- react-router build --config vite.config.ts --sourcemapClient hidden",
      "options": {
        "cwd": "{projectRoot}/serve",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192",
          "REACT_ROUTER_ROOT": "."
        }
      }
    },
    "dev": {
      "dependsOn": ["copy-assets", "^copy-assets", "csharp-language:prepare"]
    },
    "dev:desktop": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["copy-assets", "^copy-assets", "csharp-language:prepare", "openscad-language:prepare"],
      "options": {
        "cwd": "{projectRoot}/desktop",
        "command": "react-router dev --config vite.config.ts",
        "env": {
          "REACT_ROUTER_ROOT": "."
        }
      }
    },
    "dev:portless": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["copy-assets", "^copy-assets", "csharp-language:prepare", "openscad-language:prepare"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "portless run --name tau-ui react-router dev",
        "env": {
          "TAU_API_URL": "http://127.0.0.1:4000",
          "TAU_WEBSOCKET_URL": "ws://127.0.0.1:4001",
          "TAU_DEBUG": "true"
        }
      }
    },
    "build:verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["copy-assets", "^copy-assets", "csharp-language:prepare", "openscad-language:prepare"],
      "outputs": ["{projectRoot}/build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../tools/build-lock.mjs build -- \"react-router build && node scripts/check-ssr-bundle-budget.mts --client && node scripts/compress-static-assets.mts\"",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192",
          "TAU_API_URL": "http://localhost:4000",
          "TAU_WEBSOCKET_URL": "ws://localhost:4001",
          "TAU_FRONTEND_URL": "http://localhost:3000"
        }
      }
    },
    "bench-section-cap-boolean-backends": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --import @oxc-node/core/register scripts/bench-section-cap-boolean-backends.mts"
      }
    },
    "generate-configuration-icons": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/generate-configuration-icons.mts"
      }
    },
    "bootstrap-https-certs": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/scripts/bootstrap-https-certs.ts",
        "{projectRoot}/app/lib/certificates/https-certs-path.ts",
        "{projectRoot}/app/lib/certificates/mkcert-storage.ts",
        {
          "runtime": "node {workspaceRoot}/tools/runtime-lan-ips.mjs"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --import @oxc-node/core/register scripts/bootstrap-https-certs.ts",
        "env": {
          "MKCERT_TRUST_INSTALL": "false"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --env-file-if-exists=.env --import @oxc-node/core/register server.ts",
        "env": {
          "NODE_ENV": "production",
          "TAU_API_URL": "http://localhost:4000",
          "TAU_WEBSOCKET_URL": "ws://localhost:4001",
          "TAU_FRONTEND_URL": "http://localhost:3000"
        }
      },
      "configurations": {},
      "parallelism": true
    },
    "typegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/app/**/*.tsx", "{projectRoot}/app/**/*.ts", "{projectRoot}/react-router.config.ts"],
      "outputs": ["{projectRoot}/.react-router/types/**"],
      "options": {
        "command": "react-router typegen",
