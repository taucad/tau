{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui",
  "projectType": "application",
  "tags": ["scope:ui", "type:app", "layer:feature"],
  "targets": {
    "bake-design-story": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --import @oxc-node/core/register scripts/bake-design-story.mts"
      }
    },
    "build": {
      "dependsOn": ["copy-assets", "^copy-assets"],
      "outputs": ["{projectRoot}/build"],
      "inputs": [
        "production",
        "^production",
        {
          "env": "TAU_API_URL"
        },
        {
          "env": "TAU_WEBSOCKET_URL"
        },
        {
          "env": "TAU_FRONTEND_URL"
        },
        {
          "env": "NETLIFY"
        },
        {
          "env": "CONTEXT"
        },
        {
          "env": "DEPLOY_PRIME_URL"
        },
        {
          "env": "DEPLOY_URL"
        },
        {
          "env": "NETLIFY_AI_GATEWAY_URL"
        },
        {
          "env": "TAU_DEBUG"
        },
        {
          "env": "POSTHOG_CLIENT_KEY"
        },
        {
          "env": "POSTHOG_API_HOST"
        },
        {
          "env": "POSTHOG_UI_HOST"
        },
        {
          "env": "POSTHOG_ASSET_HOST"
        },
        {
          "env": "STATS"
        }
      ],
      "command": "node ../../tools/build-lock.mjs build -- react-router build --sourcemapClient hidden",
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "build:desktop": {
      "dependsOn": ["copy-assets", "^copy-assets"],
      "outputs": ["{projectRoot}/desktop/build"],
      "inputs": ["production", "^production"],
      "command": "node ../../../tools/build-lock.mjs build -- react-router build --config vite.config.ts --sourcemapClient hidden",
      "options": {
        "cwd": "{projectRoot}/desktop",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192",
          "REACT_ROUTER_ROOT": "."
        }
      }
    },
    "build:serve": {
      "dependsOn": ["copy-assets", "^copy-assets"],
      "outputs": ["{projectRoot}/serve/build"],
      "inputs": ["production", "^production"],
      "command": "node ../../../tools/build-lock.mjs build -- react-router build --config vite.config.ts --sourcemapClient hidden",
      "options": {
        "cwd": "{projectRoot}/serve",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192",
          "REACT_ROUTER_ROOT": "."
        }
      }
    },
    "dev:desktop": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["copy-assets", "^copy-assets"],
      "options": {
        "cwd": "{projectRoot}/desktop",
        "command": "react-router dev --config vite.config.ts",
        "env": {
          "REACT_ROUTER_ROOT": "."
        }
      }
    },
    "build:verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["copy-assets", "^copy-assets"],
      "outputs": ["{projectRoot}/build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../tools/build-lock.mjs build -- react-router build",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192",
          "TAU_API_URL": "http://localhost:4000",
          "TAU_WEBSOCKET_URL": "ws://localhost:4001",
          "TAU_FRONTEND_URL": "http://localhost:3000"
        }
      }
    },
    "bench-section-cap-boolean-backends": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --import @oxc-node/core/register scripts/bench-section-cap-boolean-backends.mts"
      }
    },
    "generate-svg-sprite": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --import @oxc-node/core/register scripts/generate-svg-sprite.mts"
      }
    },
    "generate-configuration-icons": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/generate-configuration-icons.mts"
      }
    },
    "bootstrap-https-certs": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/scripts/bootstrap-https-certs.ts",
        "{projectRoot}/app/lib/certificates/https-certs-path.ts",
        "{projectRoot}/app/lib/certificates/mkcert-storage.ts",
        {
          "runtime": "node {workspaceRoot}/tools/runtime-lan-ips.mjs"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --import @oxc-node/core/register scripts/bootstrap-https-certs.ts",
        "env": {
          "MKCERT_TRUST_INSTALL": "false"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --env-file-if-exists=.env --import @oxc-node/core/register server.ts",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "configurations": {},
      "parallelism": true
    },
    "typegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/app/**/*.tsx", "{projectRoot}/app/**/*.ts", "{projectRoot}/react-router.config.ts"],
      "outputs": ["{projectRoot}/.react-router/types/**"],
      "options": {
        "command": "react-router typegen",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "dependsOn": ["typegen"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "The worker-tier browser suites the jsdom sweep excludes (OPFS, Web Locks, WebGPU): app/workers/agent-host.vitest.browser.config.ts. Named test:e2e so `nx affected -t test:e2e` selects it on the only CI lane that installs Chromium, exactly as apps/desktop-e2e does. G-ACP-REFUSE0's sole check lives here."
      },
      "dependsOn": ["copy-assets", "^copy-assets"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "../../node_modules/.bin/vitest run --config app/workers/agent-host.vitest.browser.config.ts"
      }
    },
    "sourcemaps": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx -y @posthog/cli sourcemap inject --directory {projectRoot}/build/client --project tau-ui",
          "npx -y @posthog/cli sourcemap upload --directory {projectRoot}/build/client --delete-after"
        ],
        "parallel": false
      }
    }
  }
}
