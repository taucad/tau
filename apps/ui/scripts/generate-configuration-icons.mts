#!/usr/bin/env node
/**
 * Project the form renderer's selected Lucide icons into runtime's data-only allowlist.
 * Keeps configuration admission independent of React and the application package.
 * Environment: none. Usage: pnpm nx run ui:generate-configuration-icons [--check].
 * Exit codes: 0 success; 1 invalid arguments, stale output, or generation failure.
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';
import process from 'node:process';
// oxlint-disable-next-line no-restricted-imports -- Native Node generation reads the owning app mapping without its bundler aliases.
import { configurationIcons } from '../app/lib/configuration-icons.ts';

const main = (): void => {
  const arguments_ = process.argv.slice(2);
  if (arguments_.some((argument) => argument !== '--check') || arguments_.length > 1) {
    throw new Error('Usage: generate-configuration-icons.mts [--check]');
  }
  const ids = Object.keys(configurationIcons).sort();
  const target = resolve(
    import.meta.dirname,
    '../../../packages/runtime/src/configuration/configuration-icons.generated.ts',
  );
  const source = [
    '// Generated by ui:generate-configuration-icons from the form renderer mapping. Do not edit.',
    '',
    '/** Cosmetic icon IDs bundled by the first-party configuration renderer. @public */',
    `export const configurationIconIds = Object.freeze([${ids.map((id) => `'${id}'`).join(', ')}] as const);`,
    '',
    '/** A supported first-party configuration icon. @public */',
    'export type ConfigurationIconId = (typeof configurationIconIds)[number];',
    '',
  ].join('\n');
  if (arguments_.includes('--check')) {
    if (readFileSync(target, 'utf8') !== source) {
      throw new Error('Configuration icon IDs are stale; run ui:generate-configuration-icons.');
    }
  } else {
    writeFileSync(target, source);
  }
};

try {
  main();
} catch (error) {
  console.error('Configuration icon generation failed:', error);
  process.exit(1);
}
