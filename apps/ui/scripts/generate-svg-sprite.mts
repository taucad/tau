/** Regenerates the checked-in UI SVG sprite and its icon-id type. */
import { globSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join, relative } from 'node:path';
import process from 'node:process';
import SVGSprite from 'svg-sprite';

const uiDirectory = join(import.meta.dirname, '..');
const rawDirectory = join(uiDirectory, 'app', 'components', 'icons', 'raw');
const generatedDirectory = join(uiDirectory, 'app', 'components', 'icons', 'generated');

const generateSvgSprite = async (): Promise<void> => {
  const spriter = new SVGSprite({
    dest: generatedDirectory,
    mode: { symbol: { sprite: '../sprite.svg' } },
    shape: {},
    svg: { xmlDeclaration: false },
  });
  const iconPaths = globSync(join(rawDirectory, '**', '*.svg')).sort();

  for (const iconPath of iconPaths) {
    spriter.add(iconPath, relative(rawDirectory, iconPath), readFileSync(iconPath, 'utf8'));
  }

  const { data, result } = await spriter.compileAsync();
  const iconIds = data.symbol.shapes.map(({ base }) => `'${base}'`);
  const typeDeclaration = [
    '/* this file was generated by generate-svg-sprite.mts */',
    `export type SvgIcons = ${iconIds.join(' | ')}`,
    '',
  ].join('\n');
  const { sprite } = result.symbol;

  mkdirSync(generatedDirectory, { recursive: true });
  writeFileSync(sprite.path, sprite.contents.toString());
  writeFileSync(join(generatedDirectory, 'svg-icons.d.ts'), typeDeclaration);

  console.info(`✓ generated ${relative(uiDirectory, sprite.path)}`);
  console.info(`✓ generated ${relative(uiDirectory, join(generatedDirectory, 'svg-icons.d.ts'))}`);
};

try {
  await generateSvgSprite();
} catch (error) {
  console.error('SVG sprite generation failed:', error);
  process.exit(1);
}
