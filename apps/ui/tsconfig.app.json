{
  "extends": "./tsconfig.json",
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    "desktop/**/*.ts",
    "desktop/**/*.tsx",
    "server.ts",
    "react-router.config.ts",
    "vite-environment.d.ts",
    "types/**/*.d.ts",
    ".react-router/types/**/*",
    "package.json"
  ],
  "compilerOptions": {
    "outDir": "./out-tsc/lib",
    "rootDirs": [".", "./.react-router/types"],
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "types": ["@react-router/node", "vite/client", "node"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2024",
    "paths": {
      "package.json": ["./package.json"],
      // `#*` is greedy across the whole program: a workspace package compiled
      // from source here resolves its own `#index.js` against `packages/ui`
      // first, which is not its barrel. Only `@taucad/runtime` spells that
      // specifier in this program (its electron modules, reached from the
      // desktop kernel preset), so it is named exactly rather than by pattern.
      "#index.js": ["../../packages/runtime/src/index.ts"],
      "#*": ["../../packages/ui/src/*", "./app/*"]
    }
  },
  "exclude": [
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.tsx",
    "tests/**/*.test.tsx",
    "tests/**/*.spec.js",
    "tests/**/*.test.js",
    "tests/**/*.spec.jsx",
    "tests/**/*.test.jsx",
    "app/**/*.test.ts",
    "app/**/*.spec.ts",
    "app/**/*.test.tsx",
    "app/**/*.spec.tsx",
    "app/**/*.test.js",
    "app/**/*.spec.js",
    "app/**/*.test.jsx",
    "app/**/*.spec.jsx"
  ]
}
