{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "outDir": "./out-tsc/spec",
    "rootDirs": [".", "./.react-router/types"],
    "types": ["vitest/importMeta", "vite/client", "node", "vitest"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "chat-revision-marker.vitest.browser.config.ts",
    "vitest.setup.ts",
    "react-router.config.ts",
    "./.react-router/types/**/*",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    "build-environment.ts",
    "build-environment.test.ts",
    "geospec-mt-assets.vite-plugin.test.ts",
    "desktop/**/*.ts",
    "serve/**/*.ts",
    "serve/**/*.tsx",
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.tsx",
    "tests/**/*.test.tsx",
    "server.ts",
    "server.test.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "vite-environment.d.ts",
    "package.json"
  ]
}
