{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "paths": {
      "package.json": ["./package.json"],
      // `#*` is greedy across the whole program: a workspace package compiled
      // from source here resolves its own `#index.js` against `packages/ui`
      // first, which is not its barrel. Only `@taucad/runtime` spells that
      // specifier in this program (its electron modules, reached from the
      // desktop kernel preset), so it is named exactly rather than by pattern.
      "#index.js": ["../../packages/runtime/src/index.ts"],
      "#*": ["../../packages/ui/src/*", "./app/*"],
      "#scripts/*": ["./scripts/*"]
    },
    "outDir": "./out-tsc/spec",
    "rootDirs": [".", "./.react-router/types"],
    "types": ["vitest/importMeta", "vite/client", "node", "vitest"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "react-router.config.ts",
    "./.react-router/types/**/*",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.tsx",
    "tests/**/*.test.tsx",
    "server.ts",
    "server.test.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "vite-environment.d.ts",
    "package.json"
  ]
}
