{
  "title": "tau-critical",
  "interval": 60,
  "rules": [
    {
      "uid": "redis-connection-lost",
      "title": "P0: Redis Connection Lost",
      "condition": "redis_down",
      "data": [
        {
          "refId": "redis_down",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "redis_connection_state{service_name=\"tau-api\"} == 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "redis_down"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "1m",
      "annotations": {
        "summary": "Redis connection is down. Host relay presence, session routing and adapter services are degraded.",
        "runbook_url": "docs/handbooks/cloud/playbooks/redis-loss.md"
      },
      "labels": {
        "severity": "critical",
        "service": "tau-api",
        "component": "redis"
      }
    },
    {
      "uid": "database-startup-failure",
      "title": "P0: Database Startup Failure",
      "condition": "db_startup_threshold",
      "data": [
        {
          "refId": "db_startup_logs",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "loki",
          "model": {
            "expr": "sum(count_over_time({service_name=\"tau-api\"} |~ \"Database (connectivity probe|schema compatibility check) failed\" [5m]))",
            "intervalMs": 15000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "db_startup_logs"
          }
        },
        {
          "refId": "db_startup_reduce",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "type": "reduce",
            "reducer": "last",
            "expression": "db_startup_logs",
            "refId": "db_startup_reduce"
          }
        },
        {
          "refId": "db_startup_threshold",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "db_startup_reduce",
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [0]
                },
                "operator": {
                  "type": "and"
                }
              }
            ],
            "refId": "db_startup_threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "annotations": {
        "summary": "Database probe or schema compatibility check failed during API startup. Inspect Loki for `Database connectivity probe failed` / `Database schema compatibility check failed` lines and act on the structured `hint` field (paused provider, DNS, TCP timeout, role rotation, pooler exhaustion, privilege).",
        "runbook_url": "docs/handbooks/cloud/playbooks/postgres-saturation.md"
      },
      "labels": {
        "severity": "critical",
        "service": "tau-api",
        "component": "database"
      }
    },
    {
      "uid": "billing-ledger-drift",
      "title": "P0: Billing Ledger Drift",
      "condition": "drift_threshold",
      "data": [
        {
          "refId": "drift",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "max(max_over_time(tau_billing_ledger_drift{service_name=\"tau-api\"}[15m]))",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "drift"
          }
        },
        {
          "refId": "drift_threshold",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "drift",
            "refId": "drift_threshold",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [0]
                }
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "5m",
      "annotations": {
        "summary": "SUM(credit_transaction.deltaMicro) disagrees with materialised balances (C12). Money invariant broken \u2014 treat as a page, not a log line. Runbook: repos/tau-cloud/docs/stripe-iac-runbook.md.",
        "runbook_url": "docs/handbooks/cloud/playbooks/ledger-drift.md"
      },
      "labels": {
        "severity": "critical",
        "service": "tau-api",
        "component": "billing"
      }
    },
    {
      "uid": "supplier-auth-failure",
      "title": "P0: Supplier Rejected Tau's Key",
      "condition": "supplier_auth",
      "data": [
        {
          "refId": "supplier_auth",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "sum by (app, gen_ai_provider_name) (increase(gen_ai_client_operation_duration_count{service_name=\"tau-api\",error_type=\"upstream_auth\"}[5m])) > 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "supplier_auth"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/supplier-outage.md",
        "summary": "A supplier answered a funded call with 401/403 (F-11). The key is Tau's, so every funded call to that supplier fails as PROVIDER_UNAVAILABLE until the key is replaced. A new process fires from its second rejection: increase() cannot see a series' first sample. Grouped by Fly `app`, so staging (tau-api-staging) and prod (tau-api) fire separately. Same event as tau_billing_provider_account_refusals_total{reason=\"credential_rejected\"}."
      },
      "labels": {
        "severity": "critical",
        "service": "tau-api",
        "component": "billing"
      }
    },
    {
      "uid": "supplier-credit-exhausted",
      "title": "P0: Supplier Account Out of Credit",
      "condition": "supplier_credit",
      "data": [
        {
          "refId": "supplier_credit",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "sum by (app, providerId) (increase(tau_billing_provider_account_refusals_total{service_name=\"tau-api\",reason!=\"credential_rejected\"}[5m])) > 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "supplier_credit"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/supplier-outage.md",
        "summary": "A supplier refused a funded call because Tau's account with it is out of credit (BIL-11). Funded calls to that supplier fail until it is topped up. Credential rejections are excluded here; supplier-auth-failure pages for them."
      },
      "labels": {
        "severity": "critical",
        "service": "tau-api",
        "component": "billing"
      }
    },
    {
      "uid": "billing-worker-stalled",
      "title": "P0: Billing Worker Stalled",
      "condition": "worker_stalled",
      "data": [
        {
          "refId": "worker_stalled",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "sum by (app, tau_worker) (max_over_time(tau_billing_worker_passes_total{service_name=\"tau-api\"}[24h])) unless sum by (app, tau_worker) (increase(tau_billing_worker_passes_total{service_name=\"tau-api\",outcome=\"ok\"}[15m]) > 0)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "worker_stalled"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "5m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/paid-not-credited.md",
        "summary": "A billing worker seen in the last 24 h has completed no successful pass in 15 min: hung, dead or failing every pass (F-10). operations stalled means paid purchases are not credited; recovery stalled means no API replica is completing its in-process recovery pass, so funded operations stay held (see chat-llm-failing.md). Grouped by Fly `app` and `tau_worker`. A worker scaled to 0 on purpose also fires until 24 h pass, so silence it."
      },
      "labels": {
        "severity": "critical",
        "service": "tau-api",
        "component": "billing"
      }
    }
  ]
}
