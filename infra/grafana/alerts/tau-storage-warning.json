{
  "title": "tau-storage-warning",
  "interval": 60,
  "rules": [
    {
      "uid": "storage-push-slo-slow-burn",
      "title": "P1: Push Error Budget Burning",
      "condition": "push_slow_burn",
      "data": [
        {
          "refId": "push_slow_burn",
          "queryType": "",
          "relativeTimeRange": { "from": 21600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(((sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"push\",outcome=\"error\"}[6h]))) or vector(0)) / clamp_min(sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"push\"}[6h])), 1e-10) > 6 * 0.001) and (((sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"push\",outcome=\"error\"}[30m]))) or vector(0)) / clamp_min(sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"push\"}[30m])), 1e-10) > 6 * 0.001) and (sum(increase(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"push\"}[6h])) > 20)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "push_slow_burn"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "Pushes ending outcome=error are burning SLO-1's budget at 6x over 6 h and 30 m, with at least 20 pushes in 6 h."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-fetch-slo-slow-burn",
      "title": "P1: Fetch Error Budget Burning",
      "condition": "fetch_slow_burn",
      "data": [
        {
          "refId": "fetch_slow_burn",
          "queryType": "",
          "relativeTimeRange": { "from": 21600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(((sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"fetch\",outcome=\"error\"}[6h]))) or vector(0)) / clamp_min(sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"fetch\"}[6h])), 1e-10) > 6 * 0.001) and (((sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"fetch\",outcome=\"error\"}[30m]))) or vector(0)) / clamp_min(sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"fetch\"}[30m])), 1e-10) > 6 * 0.001) and (sum(increase(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"fetch\"}[6h])) > 20)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "fetch_slow_burn"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "Fetches ending outcome=error are burning SLO-2's budget at 6x over 6 h and 30 m, with at least 20 fetches in 6 h."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-retryable-refusals",
      "title": "P1: Git Retryable Refusals Above 2%",
      "condition": "retryable_refusals",
      "data": [
        {
          "refId": "retryable_refusals",
          "queryType": "",
          "relativeTimeRange": { "from": 900, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(((sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",outcome=~\"busy|conflict\"}[15m]))) or vector(0)) / clamp_min(sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\"}[15m])), 1e-10) > 0.02) and (sum(increase(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\"}[15m])) > 50)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "retryable_refusals"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "More than 2% of git requests were answered busy or conflict over 15 min, with at least 50 requests (SLO-3, W6 X3)."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-lease-refusals",
      "title": "P1: Git Lease Refusals (TAU-API-5 Class)",
      "condition": "lease_refusals",
      "data": [
        {
          "refId": "lease_refusals",
          "queryType": "",
          "relativeTimeRange": { "from": 900, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(((sum(rate(tau_sync_refusals_total{app=~\".*\",service_name=\"tau-api\",tau_sync_refusal_code=~\"GIT_LEASE_.*|GIT_HYDRATE_BUDGET_EXHAUSTED\"}[15m]))) or vector(0)) / clamp_min(sum(rate(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\"}[15m])), 1e-10) > 0.005) and (sum(increase(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\"}[15m])) > 50)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "lease_refusals"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "GIT_LEASE_* and GIT_HYDRATE_BUDGET_EXHAUSTED refusals above 0.5% of git requests over 15 min, with at least 50 requests: capacity refusals below documented capacity (TAU-API-5, STO-20)."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-push-latency-high",
      "title": "P1: Push p95 Above 2 s",
      "condition": "push_latency",
      "data": [
        {
          "refId": "push_latency",
          "queryType": "",
          "relativeTimeRange": { "from": 900, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(histogram_quantile(0.95, sum by (le) (rate(tau_sync_operation_duration_bucket{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"push\",outcome!~\"unauthorized|quota_refused\"}[15m]))) > 2) and (sum(increase(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"push\"}[15m])) > 20)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "push_latency"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "Push p95 at the API edge is above 2 s over 15 min with at least 20 requests (SLO-4)."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-fetch-latency-high",
      "title": "P1: Fetch p95 Above 5 s",
      "condition": "fetch_latency",
      "data": [
        {
          "refId": "fetch_latency",
          "queryType": "",
          "relativeTimeRange": { "from": 900, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(histogram_quantile(0.95, sum by (le) (rate(tau_sync_operation_duration_bucket{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"fetch\",outcome!~\"unauthorized|quota_refused\"}[15m]))) > 5) and (sum(increase(tau_sync_operations_total{app=~\".*\",service_name=\"tau-api\",tau_sync_operation=\"fetch\"}[15m])) > 20)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "fetch_latency"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "Fetch p95 at the API edge is above 5 s over 15 min with at least 20 requests (SLO-5)."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "project-open-cold-slow",
      "title": "P1: Cold Project Open p75 Above 5 s",
      "condition": "open_slow",
      "data": [
        {
          "refId": "open_slow",
          "queryType": "",
          "relativeTimeRange": { "from": 3600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(histogram_quantile(0.75, sum by (le) (rate(tau_project_open_duration_bucket{app=~\".*\",service_name=\"tau-api\",phase=\"first_view\",cache=\"cold\"}[1h]))) > 5) and (sum(increase(tau_project_open_duration_count{app=~\".*\",service_name=\"tau-api\",phase=\"first_view\",cache=\"cold\"}[1h])) >= 5)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "open_slow"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "Cold hosted project opens reach a first usable view in more than 5 s at p75 over 1 h, with at least 5 cold opens (go-live STO-25, research AC-1)."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-spill-high",
      "title": "P1: Affinity Spill Above 5%",
      "condition": "spill_high",
      "data": [
        {
          "refId": "spill_high",
          "queryType": "",
          "relativeTimeRange": { "from": 900, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(((sum(increase(tau_git_spills_total{app=~\".*\",service_name=\"tau-api\"}[15m]))) or vector(0)) / clamp_min(sum(increase(tau_sync_operation_duration_count{app=~\".*\",service_name=\"tau-api\",tau_git_execution=\"forwarded\"}[15m])), 1e-10) > 0.05) and (sum(increase(tau_sync_operation_duration_count{app=~\".*\",service_name=\"tau-api\",tau_git_execution=\"forwarded\"}[15m])) > 50)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "spill_high"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/operate/scaling.md",
        "summary": "More than 5% of forwarded git requests went past their rendezvous-preferred tau-storage member over 15 min, with at least 50 forwarded. tau_git_forwards_total is not emitted, so forwarded requests are counted from tau_sync_operation_duration with tau_git_execution=\"forwarded\"."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-proxy-hard-limit",
      "title": "P1: tau-storage Hit Fly hard_limit",
      "condition": "proxy_hard_limit",
      "data": [
        {
          "refId": "proxy_hard_limit",
          "queryType": "",
          "relativeTimeRange": { "from": 600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "sum(increase(fly_app_hard_limit_reached_count{app=~\".*storage.*\"}[10m])) > 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "proxy_hard_limit"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/operate/scaling.md",
        "summary": "Fly's proxy refused tau-storage connections at hard_limit in the last 10 min."
      },
      "labels": { "severity": "warning", "service": "tau-storage", "component": "git" }
    },
    {
      "uid": "storage-worker-cpu-high",
      "title": "P1: tau-storage CPU Above 70%",
      "condition": "worker_cpu_high",
      "data": [
        {
          "refId": "worker_cpu_high",
          "queryType": "",
          "relativeTimeRange": { "from": 900, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "avg(1 - (sum by (instance) (rate(fly_instance_cpu{app=~\".*storage.*\",mode=\"idle\"}[15m])) / sum by (instance) (rate(fly_instance_cpu{app=~\".*storage.*\"}[15m])))) > 0.7",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "worker_cpu_high"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/operate/scaling.md",
        "summary": "Mean busy CPU across tau-storage Machines is above 70% over 15 min."
      },
      "labels": { "severity": "warning", "service": "tau-storage", "component": "git" }
    },
    {
      "uid": "storage-commit-indeterminate",
      "title": "P1: Indeterminate Manifest Writes",
      "condition": "commit_indeterminate",
      "data": [
        {
          "refId": "commit_indeterminate",
          "queryType": "",
          "relativeTimeRange": { "from": 600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "sum(increase(tau_git_commit_attempts_total{app=~\".*\",service_name=\"tau-api\",outcome=\"indeterminate\"}[10m]) or increase(tau_git_commit_attempts_total{app=~\".*storage.*\",service_name=\"tau-storage\",outcome=\"indeterminate\"}[10m])) > 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "commit_indeterminate"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "A conditional manifest write ended indeterminate in the last 10 min: the client was told nothing certain, so verify the repository."
      },
      "labels": { "severity": "warning", "service": "tau-storage", "component": "git" }
    },
    {
      "uid": "storage-forward-errors",
      "title": "P1: API to tau-storage Hop Failing",
      "condition": "forward_errors",
      "data": [
        {
          "refId": "forward_errors",
          "queryType": "",
          "relativeTimeRange": { "from": 600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(((sum(increase(tau_git_forward_errors_total{app=~\".*\",service_name=\"tau-api\"}[10m]))) or vector(0)) / clamp_min(sum(increase(tau_sync_operation_duration_count{app=~\".*\",service_name=\"tau-api\",tau_git_execution=\"forwarded\"}[10m])), 1e-10) > 0.01) and (sum(increase(tau_sync_operation_duration_count{app=~\".*\",service_name=\"tau-api\",tau_git_execution=\"forwarded\"}[10m])) > 20)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "forward_errors"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "10m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "More than 1% of forwarded git requests failed at the hop over 10 min, with at least 20 forwarded."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-grants-rejected",
      "title": "P1: tau-storage Rejecting Grants",
      "condition": "grants_rejected",
      "data": [
        {
          "refId": "grants_rejected",
          "queryType": "",
          "relativeTimeRange": { "from": 600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "sum(increase(tau_git_grants_rejected_total{app=~\".*storage.*\",service_name=\"tau-storage\"}[10m])) > 10",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "grants_rejected"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "tau-storage refused more than 10 storage grants in 10 min (W14 OB4, review FR3/FR5): a key rotation out of order, clock skew or a forged grant."
      },
      "labels": { "severity": "warning", "service": "tau-storage", "component": "git" }
    },
    {
      "uid": "storage-receipts-failing",
      "title": "P1: Push Receipts Failing",
      "condition": "receipts_failing",
      "data": [
        {
          "refId": "receipts_failing",
          "queryType": "",
          "relativeTimeRange": { "from": 1800, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(((sum(increase(tau_git_receipts_total{app=~\".*\",service_name=\"tau-api\",outcome=~\"rejected|manifest_mismatch\"}[30m]))) or vector(0)) / clamp_min(sum(increase(tau_git_receipts_total{app=~\".*\",service_name=\"tau-api\"}[30m])), 1e-10) > 0.01) and (sum(increase(tau_git_receipts_total{app=~\".*\",service_name=\"tau-api\"}[30m])) > 20)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "receipts_failing"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "30m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "More than 1% of storage receipts were rejected or did not match the manifest over 30 min, with at least 20 receipts: derived state is left to repair."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-freeze-stuck",
      "title": "P1: Repository Frozen Longer Than 60 s",
      "condition": "freeze_stuck",
      "data": [
        {
          "refId": "freeze_stuck",
          "queryType": "",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "max(tau_git_route_frozen_oldest{app=~\".*\",service_name=\"tau-api\"}) > 60",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "freeze_stuck"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "2m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/operate/storage-maintenance.md",
        "summary": "A freeze has held for more than 60 s; a migration freeze is a 20 s lease, so a migrator likely died holding it."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "migration" }
    },
    {
      "uid": "storage-freeze-timeouts",
      "title": "P1: Freeze Holds Timing Out",
      "condition": "freeze_timeouts",
      "data": [
        {
          "refId": "freeze_timeouts",
          "queryType": "",
          "relativeTimeRange": { "from": 900, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "sum(increase(tau_git_route_holds_total{app=~\".*\",service_name=\"tau-api\",outcome=\"timed_out\"}[15m])) > 10",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "freeze_timeouts"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/operate/storage-maintenance.md",
        "summary": "More than 10 git requests timed out waiting for a frozen repository in 15 min."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "migration" }
    },
    {
      "uid": "storage-b2-lag",
      "title": "P1: B2 Second Copy Over 15 min Behind",
      "condition": "b2_lag",
      "data": [
        {
          "refId": "b2_lag",
          "queryType": "",
          "relativeTimeRange": { "from": 600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "max(tau_mirror_copy_lag_seconds{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\"}) > 900",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "b2_lag"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "10m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/system/services/second-copy-b2.md",
        "summary": "The second copy's recovery point is more than 15 min behind (W13 B5 warning line, SLO-6)."
      },
      "labels": { "severity": "warning", "service": "tau-mirror", "component": "mirror" }
    },
    {
      "uid": "storage-mirror-failure-rate",
      "title": "P1: B2 Copy Rounds Failing",
      "condition": "mirror_failure_rate",
      "data": [
        {
          "refId": "mirror_failure_rate",
          "queryType": "",
          "relativeTimeRange": { "from": 900, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(((sum(increase(tau_mirror_rounds_total{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\",outcome=\"failed\"}[15m]))) or vector(0)) / clamp_min(sum(increase(tau_mirror_rounds_total{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\"}[15m])), 1e-10) > 0.05) and (sum(increase(tau_mirror_rounds_total{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\"}[15m])) > 10)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "mirror_failure_rate"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/system/services/second-copy-b2.md",
        "summary": "More than 5% of copy rounds failed over 15 min, with at least 10 rounds."
      },
      "labels": { "severity": "warning", "service": "tau-mirror", "component": "mirror" }
    },
    {
      "uid": "storage-b2-dest-down",
      "title": "P1: B2 Unreachable",
      "condition": "b2_dest_down",
      "data": [
        {
          "refId": "b2_dest_down",
          "queryType": "",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "max(tau_mirror_destination_up{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\"}) == 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "b2_dest_down"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "10m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/system/services/second-copy-b2.md",
        "summary": "The copier's probe of the B2 destination has failed for 10 min; pages at 60 min."
      },
      "labels": { "severity": "warning", "service": "tau-mirror", "component": "mirror" }
    },
    {
      "uid": "storage-b2-recon-stale",
      "title": "P1: B2 Reconciler Stale",
      "condition": "recon_stale",
      "data": [
        {
          "refId": "recon_stale",
          "queryType": "",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "time() - max(tau_mirror_reconcile_last_success_timestamp_seconds{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\",scope=\"active\"}) > 129600",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "recon_stale"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "10m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/system/services/second-copy-b2.md",
        "summary": "The active-repository reconcile has not completed for 36 h."
      },
      "labels": { "severity": "warning", "service": "tau-mirror", "component": "mirror" }
    },
    {
      "uid": "storage-b2-recon-missing",
      "title": "P1: B2 Missing Objects Across Two Reconciles",
      "condition": "recon_missing",
      "data": [
        {
          "refId": "recon_missing",
          "queryType": "",
          "relativeTimeRange": { "from": 93600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "min_over_time(sum(tau_mirror_reconcile_missing_objects{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\"})[26h:10m]) > 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "recon_missing"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/system/services/second-copy-b2.md",
        "summary": "Objects R2 holds and the second copy lacks were found at two consecutive daily reconciles."
      },
      "labels": { "severity": "warning", "service": "tau-mirror", "component": "mirror" }
    },
    {
      "uid": "storage-b2-retention-failing",
      "title": "P1: B2 Retention Extensions Failing",
      "condition": "retention_failing",
      "data": [
        {
          "refId": "retention_failing",
          "queryType": "",
          "relativeTimeRange": { "from": 3600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(((sum(increase(tau_mirror_retention_extensions_total{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\",outcome=\"failed\"}[1h]))) or vector(0)) / clamp_min(sum(increase(tau_mirror_retention_extensions_total{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\"}[1h])), 1e-10) > 0.01) and (sum(increase(tau_mirror_retention_extensions_total{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\"}[1h])) > 5)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "retention_failing"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "15m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/system/services/second-copy-b2.md",
        "summary": "More than 1% of Object Lock extensions failed in the last hour, with at least 5 attempted (W13 B6)."
      },
      "labels": { "severity": "warning", "service": "tau-mirror", "component": "mirror" }
    },
    {
      "uid": "storage-b2-lock-floor",
      "title": "P1: B2 Lock Headroom Below 10 Days",
      "condition": "lock_floor",
      "data": [
        {
          "refId": "lock_floor",
          "queryType": "",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "min(tau_mirror_retention_min_remaining_seconds{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\"}) < 864000",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "lock_floor"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "1h",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/system/services/second-copy-b2.md",
        "summary": "The newest snapshot of some live repository is locked for less than 10 more days: the daily retention sweep is not running (W13 B6)."
      },
      "labels": { "severity": "warning", "service": "tau-mirror", "component": "mirror" }
    },
    {
      "uid": "storage-b2-drill-stale",
      "title": "P1: B2 Restore Drill Older Than 8 Days",
      "condition": "drill_stale",
      "data": [
        {
          "refId": "drill_stale",
          "queryType": "",
          "relativeTimeRange": { "from": 777600, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(time() - max(max_over_time(tau_mirror_drill_last_success_timestamp_seconds{app=~\".*mirror.*\",service_name=\"tau-mirror\"}[9d])) > 691200) or (count(tau_mirror_rounds_total{app=~\".*mirror.*\",service_name=\"tau-mirror\",destination=\"b2\"}) unless on() count(last_over_time(tau_mirror_drill_last_success_timestamp_seconds{app=~\".*mirror.*\",service_name=\"tau-mirror\"}[9d])))",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "drill_stale"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "1h",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/system/services/second-copy-b2.md",
        "summary": "No second-copy drill has passed in 8 days, or a live copier has exported no passing drill in 9 days (D23, STO-1). Written without absent() so an environment with no copier is silent."
      },
      "labels": { "severity": "warning", "service": "tau-mirror", "component": "mirror" }
    },
    {
      "uid": "storage-accounting-stale",
      "title": "P1: Storage Accounting Task Stale",
      "condition": "accounting_stale",
      "data": [
        {
          "refId": "accounting_stale",
          "queryType": "",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "time() - max by (tau_storage_accounting_task) (tau_storage_accounting_last_success{app=~\".*\",service_name=\"tau-api\"}) > 7200 unless on (tau_storage_accounting_task) (sum by (tau_storage_accounting_task) (increase(tau_storage_accounting_passes_total{app=~\".*\",service_name=\"tau-api\",outcome=\"skipped\"}[2h])) > 0)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "accounting_stale"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "10m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/observe/signals.md",
        "summary": "A storage accounting task (usage, R2 analytics, Postgres connections, hot projects, route) has not succeeded for 2 h, so its gauges are stale (OB3). A task its configuration skips (R2 analytics without the Cloudflare analytics token) is not stale."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "storage" }
    },
    {
      "uid": "storage-r2-request-spike",
      "title": "P1: R2 Class A Requests Spike",
      "condition": "r2_request_spike",
      "data": [
        {
          "refId": "r2_request_spike",
          "queryType": "",
          "relativeTimeRange": { "from": 691200, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "(sum(max by (tau_r2_bucket, tau_r2_class, tau_r2_action, tau_r2_status, tau_r2_window) (tau_r2_requests{app=~\".*\",service_name=\"tau-api\",tau_r2_window=\"hour\",tau_r2_class=\"A\"})) > 3 * avg_over_time(sum(max by (tau_r2_bucket, tau_r2_class, tau_r2_action, tau_r2_status, tau_r2_window) (tau_r2_requests{app=~\".*\",service_name=\"tau-api\",tau_r2_window=\"hour\",tau_r2_class=\"A\"}))[7d:1h])) and (sum(max by (tau_r2_bucket, tau_r2_class, tau_r2_action, tau_r2_status, tau_r2_window) (tau_r2_requests{app=~\".*\",service_name=\"tau-api\",tau_r2_window=\"hour\",tau_r2_class=\"A\"})) > 100000)",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "r2_request_spike"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "1h",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "The last hour's R2 Class A requests are more than 3x the 7-day hourly mean and above 100k (Z8): a cost or amplification regression."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "r2" }
    },
    {
      "uid": "storage-repository-at-ceiling",
      "title": "P1: Repositories at 95% of 1 GiB",
      "condition": "repository_at_ceiling",
      "data": [
        {
          "refId": "repository_at_ceiling",
          "queryType": "",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "max(tau_git_repository_ceiling_proximity{app=~\".*\",service_name=\"tau-api\",threshold=\"0.95\"}) > 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "repository_at_ceiling"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "1h",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/storage-failure.md",
        "summary": "At least one repository is at 95% of D20's 1 GiB ceiling; its next large push will be refused GIT_REPOSITORY_CEILING_EXCEEDED."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "git" }
    },
    {
      "uid": "storage-db-connections-high",
      "title": "P1: Postgres Connections Above 80% of Pooler",
      "condition": "db_connections_high",
      "data": [
        {
          "refId": "db_connections_high",
          "queryType": "",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "prometheus",
          "model": {
            "instant": true,
            "range": false,
            "expr": "sum(max by (tau_db_application, state) (tau_db_connections{app=~\".*\",service_name=\"tau-api\"})) / max(tau_db_connection_budget{app=~\".*\",service_name=\"tau-api\"}) > 0.8",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "db_connections_high"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "10m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/postgres-saturation.md",
        "summary": "Postgres connections on the write path are above 80% of the pooler budget (OB3)."
      },
      "labels": { "severity": "warning", "service": "tau-api", "component": "storage" }
    }
  ]
}
