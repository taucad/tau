{
  "title": "tau-warning",
  "interval": 60,
  "rules": [
    {
      "uid": "rpc-failure-rate",
      "title": "P1: RPC Failure Rate Spike",
      "condition": "rpc_errors_high",
      "data": [
        {
          "refId": "rpc_errors_high",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "sum(rate(rpc_server_call_duration_count{service_name=\"tau-api\",rpc_status=\"error\"}[5m])) / sum(rate(rpc_server_call_duration_count{service_name=\"tau-api\"}[5m])) > 0.1",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "rpc_errors_high"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "5m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/api-5xx.md",
        "summary": "RPC error rate exceeds 10% over 5 minutes."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "rpc"
      }
    },
    {
      "uid": "ws-disconnect-storm",
      "title": "P1: WebSocket Disconnect Storm",
      "condition": "ws_disconnect_spike",
      "data": [
        {
          "refId": "ws_disconnect_spike",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "rate(ws_disconnections_total{service_name=\"tau-api\",ws_close_reason=~\"transport close|transport error|ping timeout\"}[5m]) > 1",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "ws_disconnect_spike"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "2m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/api-5xx.md",
        "summary": "High rate of abnormal WebSocket disconnections detected."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "websocket"
      }
    },
    {
      "uid": "llm-error-rate",
      "title": "P1: LLM API Error Rate",
      "condition": "llm_errors",
      "data": [
        {
          "refId": "llm_errors",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "sum(rate(gen_ai_client_operation_duration_count{service_name=\"tau-api\",error_type!=\"\"}[10m])) / sum(rate(gen_ai_client_operation_duration_count{service_name=\"tau-api\"}[10m])) > 0.05",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "llm_errors"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "5m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/chat-llm-failing.md",
        "summary": "LLM API error rate exceeds 5%."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "ai"
      }
    },
    {
      "uid": "high-5xx-rate",
      "title": "P1: High 5xx Error Rate",
      "condition": "http_5xx_high",
      "data": [
        {
          "refId": "http_5xx_high",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "sum(rate(http_server_duration_count{service_name=\"tau-api\",http_status_code=~\"5..\"}[5m])) / sum(rate(http_server_duration_count{service_name=\"tau-api\"}[5m])) > 0.05",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "http_5xx_high"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "5m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/api-5xx.md",
        "summary": "HTTP 5xx error rate exceeds 5% over 5 minutes."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "api"
      }
    },
    {
      "uid": "gen-ai-prompt-cache-hit-rate-low",
      "title": "GenAiPromptCacheHitRateLow: Prompt cache hit rate below 40% (cost bleed)",
      "condition": "cache_hit_rate_low",
      "data": [
        {
          "refId": "cache_hit_rate_low",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "(\n  sum by (gen_ai_request_model, gen_ai_provider_name) (rate(gen_ai_client_token_usage_sum{service_name=\"tau-api\", gen_ai_token_type=\"cache_read\"}[30m]))\n  /\n  (\n    sum by (gen_ai_request_model, gen_ai_provider_name) (rate(gen_ai_client_token_usage_sum{service_name=\"tau-api\", gen_ai_token_type=\"cache_read\"}[30m]))\n    +\n    sum by (gen_ai_request_model, gen_ai_provider_name) (rate(gen_ai_client_token_usage_sum{service_name=\"tau-api\", gen_ai_token_type=\"input\"}[30m]))\n  )\n) < 0.4\nand\nsum by (gen_ai_request_model, gen_ai_provider_name) (increase(gen_ai_client_token_usage_sum{service_name=\"tau-api\", gen_ai_token_type=\"input\"}[30m])) >= 200000",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "cache_hit_rate_low"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "30m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/budget-exhausted.md",
        "summary": "Prompt cache hit rate <40% sustained for 30m on a model with non-trivial volume.",
        "description": "Provider-side prompt caches (Gemini implicit, Anthropic incremental, OpenAI prompt) are not hitting on {{ $labels.gen_ai_provider_name }}/{{ $labels.gen_ai_request_model }} despite >=200K input tokens billed in the last 30m. This is a cost-bleed signal, not a user-facing failure. Common causes: per-turn-mutating prefix bytes (token-usage reminders, dynamic system-prompt fields), tool-list churn, or LangChain integration regressions. See docs/research/gemini-prompt-cache-busting.md for the diagnosis playbook."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "ai"
      }
    },
    {
      "uid": "billing-funded-operation-occupancy",
      "title": "P1: Funded LLM Pool Near Failsafe",
      "condition": "billing_funded_operation_occupancy",
      "data": [
        {
          "refId": "billing_funded_operation_occupancy",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "max(tau_billing_funded_operation_current{service_name=\"tau-api\",tau_billing_pending_state=\"pending\"}) >= 56",
            "intervalMs": 15000,
            "maxDataPoints": 60,
            "refId": "billing_funded_operation_occupancy"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "10m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/chat-llm-failing.md",
        "summary": "A funded LLM capacity pool has remained above 87.5% of its 64-operation abuse failsafe."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "billing"
      }
    },
    {
      "uid": "billing-funded-operation-limit",
      "title": "P1: Funded LLM Failsafe Reached",
      "condition": "billing_funded_operation_limit",
      "data": [
        {
          "refId": "billing_funded_operation_limit",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "sum(increase(tau_billing_funded_operation_denials_total{service_name=\"tau-api\",tau_billing_capacity_pool=\"primary\",tau_billing_denial_reason=\"genuine_saturation\"}[5m])) > 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "billing_funded_operation_limit"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/chat-llm-failing.md",
        "summary": "A primary funded LLM request reached the account abuse failsafe after recovery."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "billing"
      }
    },
    {
      "uid": "billing-funded-operation-recovery-failed",
      "title": "P1: Funded LLM Recovery Failed",
      "condition": "billing_funded_operation_recovery_failed",
      "data": [
        {
          "refId": "billing_funded_operation_recovery_failed",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "sum(increase(tau_billing_funded_operation_recoveries_total{service_name=\"tau-api\",tau_billing_recovery_outcome=\"failed\"}[5m])) > 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "billing_funded_operation_recovery_failed"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/chat-llm-failing.md",
        "summary": "Funded LLM recovery failed; admission remains fail-closed without changing customer money."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "billing"
      }
    },
    {
      "uid": "billing-funded-operation-due-age",
      "title": "P1: Funded LLM Recovery SLO Breach",
      "condition": "billing_funded_operation_due_age",
      "data": [
        {
          "refId": "billing_funded_operation_due_age",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "max by (deployment_environment, tau_billing_capacity_pool) (tau_billing_funded_operation_oldest_due_age{service_name=\"tau-api\"}) > 30000",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "billing_funded_operation_due_age"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "1m",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/chat-llm-failing.md",
        "summary": "The oldest due funded LLM operation has exceeded the 30-second healthy recovery SLO."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "billing"
      }
    },
    {
      "uid": "billing-funded-operation-recovery-provider-execution",
      "title": "P1: Provider Execution During Recovery",
      "condition": "billing_funded_operation_recovery_provider_execution",
      "data": [
        {
          "refId": "billing_funded_operation_recovery_provider_execution",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "prometheus",
          "model": {
            "expr": "max(tau_billing_funded_operation_recovery_provider_executions{service_name=\"tau-api\"}) > 0",
            "intervalMs": 15000,
            "maxDataPoints": 20,
            "refId": "billing_funded_operation_recovery_provider_execution"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "OK",
      "for": "0s",
      "annotations": {
        "runbook_url": "docs/handbooks/cloud/playbooks/ledger-drift.md",
        "summary": "DB-only funded LLM recovery observed a provider execution; the invariant is zero."
      },
      "labels": {
        "severity": "warning",
        "service": "tau-api",
        "component": "billing"
      }
    }
  ]
}
