{
  "uid": "tau-ai-agent",
  "title": "AI Agent",
  "tags": ["tau", "ai", "llm", "genai"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "constant",
        "query": ".*",
        "description": "Local default matches unlabeled series. Hosted provisioning binds this to exactly one application.",
        "current": { "text": ".*", "value": ".*" },
        "hide": 2
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "tau-api",
        "description": "Tau runs one service. A constant, so panels never lose their filter when the API's own series go stale during an outage.",
        "current": { "text": "tau-api", "value": "tau-api" },
        "options": [{ "text": "tau-api", "value": "tau-api", "selected": true }],
        "includeAll": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(process_uptime{app=~\"$app\",service_name=\"$service\"}, instance)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "title": "Token Usage (Input / Output / Cache Read)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gen_ai_client_token_usage_sum{app=~\"$app\",service_name=~\"$service\"}[5m])) by (gen_ai_token_type, gen_ai_request_model)",
          "legendFormat": "{{gen_ai_request_model}} {{gen_ai_token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "id": 1
    },
    {
      "title": "Prompt cache hit rate",
      "type": "timeseries",
      "description": "Provider-agnostic prompt-cache hit rate computed as cache_read / (input + cache_read + cache_write). The funded invocation records `input` as uncached input only, so the denominator is the whole prompt: billed in full, written to cache, or served from it. Tracks the goal in docs/research/gemini-prompt-cache-busting.md (target: >=80% steady-state on multi-turn chats).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model, gen_ai_provider_name) (rate(gen_ai_client_token_usage_sum{app=~\"$app\",gen_ai_token_type=\"cache_read\", service_name=~\"$service\"}[5m]))\n/\n(\n  sum by (gen_ai_request_model, gen_ai_provider_name) (rate(gen_ai_client_token_usage_sum{app=~\"$app\",gen_ai_token_type=\"cache_read\", service_name=~\"$service\"}[5m]))\n  +\n  sum by (gen_ai_request_model, gen_ai_provider_name) (rate(gen_ai_client_token_usage_sum{app=~\"$app\",gen_ai_token_type=~\"input|cache_write\", service_name=~\"$service\"}[5m]))\n)",
          "legendFormat": "{{gen_ai_provider_name}}/{{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.4, "color": "yellow" },
              { "value": 0.8, "color": "green" }
            ]
          }
        }
      },
      "id": 2
    },
    {
      "title": "User-Charged LLM Spend (USD/h)",
      "description": "User-charged: what Tau bills the user for the call (priced from the model catalog), not the supplier invoice.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gen_ai_client_cost_total{app=~\"$app\",service_name=~\"$service\"}[1h]))",
          "legendFormat": "$/hr"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 5, "color": "yellow" },
              { "value": 20, "color": "red" }
            ]
          }
        }
      },
      "id": 3
    },
    {
      "title": "Model Usage Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(gen_ai_client_token_usage_sum{app=~\"$app\",service_name=~\"$service\"}) by (gen_ai_request_model)",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "id": 4
    },
    {
      "title": "Operation Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gen_ai_client_operation_duration_bucket{app=~\"$app\",service_name=~\"$service\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gen_ai_client_operation_duration_bucket{app=~\"$app\",service_name=~\"$service\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "id": 5
    },
    {
      "title": "Tool Invocations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (agent_id, tool_kind) (rate(tau_agent_tool_calls_total{app=~\"$app\",service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{agent_id}} {{tool_kind}}"
        }
      ],
      "id": 6
    },
    {
      "title": "TTFT (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gen_ai_client_time_to_first_token_bucket{app=~\"$app\",service_name=~\"$service\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gen_ai_client_time_to_first_token_bucket{app=~\"$app\",service_name=~\"$service\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "id": 7
    },
    {
      "title": "Agent Turns by Agent and Outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (agent_id, outcome) (rate(tau_agent_turns_total{app=~\"$app\",service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{agent_id}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "id": 8
    },
    {
      "title": "Agent evidence: admission, delivery, backlog and erasure (counts and bounded codes only)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "panels": [],
      "id": 11
    },
    {
      "title": "Evidence Admissions by Outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "targets": [
        {
          "expr": "sum by (tau_agent_evidence_authority, outcome) (rate(tau_agent_evidence_admissions_total{app=~\"$app\",service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{tau_agent_evidence_authority}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "id": 12,
      "description": "Parsed submissions. policy_stale is a superseded epoch, refused a withheld purpose, fenced a deleted or erased subject, capacity the backlog budget."
    },
    {
      "title": "Evidence Deliveries by Outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(tau_agent_evidence_deliveries_total{app=~\"$app\",service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "id": 13,
      "description": "acknowledged and uncertain are sends not yet proven visible; confirmed was read back; gap never became visible and is not resent; key_unavailable is held for a missing payload key."
    },
    {
      "title": "Evidence Backlog Rows by State",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "targets": [
        {
          "expr": "max by (tau_agent_evidence_state) (tau_agent_evidence_backlog_rows{app=~\"$app\",service_name=~\"$service\"})",
          "legendFormat": "{{tau_agent_evidence_state}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "id": 14,
      "description": "Shared figure: every replica reports the same rows, so read with max."
    },
    {
      "title": "Evidence Payload Bytes Held",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "targets": [
        {
          "expr": "max(tau_agent_evidence_backlog_held_bytes{app=~\"$app\",service_name=~\"$service\"})",
          "legendFormat": "held"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "id": 15,
      "description": "Sealed payload bytes awaiting delivery, against TAU_OBSERVABILITY_BACKLOG_BYTES."
    },
    {
      "title": "Langfuse Erasure Steps by Outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(tau_agent_evidence_erasure_traces_total{app=~\"$app\",service_name=~\"$service\"}[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "id": 16,
      "description": "Only absent settles a trace; present and retry are requested again with backoff."
    },
    {
      "title": "Evidence Lifecycle and Worker Passes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "targets": [
        {
          "expr": "sum by (action) (increase(tau_agent_evidence_lifecycle_records_total{app=~\"$app\",service_name=~\"$service\"}[1h]))",
          "legendFormat": "{{action}}"
        },
        {
          "expr": "sum by (tau_worker, outcome) (increase(tau_agent_evidence_passes_total{app=~\"$app\",service_name=~\"$service\"}[1h]))",
          "legendFormat": "pass {{tau_worker}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "id": 17,
      "description": "purged payloads past retention, reaped receipts a day past it, erased subjects completed; and each worker's passes, the liveness signal."
    },
    {
      "title": "Error Logs",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 100 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} | detected_level=~\"error|fatal|critical\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "id": 9
    },
    {
      "title": "Recent Traces",
      "type": "traces",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 108 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "query": "{resource.service.name=~\"$service\"}",
          "refId": "A",
          "queryType": "traceqlSearch"
        }
      ],
      "id": 10
    }
  ],
  "schemaVersion": 39
}
