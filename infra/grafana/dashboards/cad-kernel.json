{
  "uid": "tau-cad-kernel",
  "title": "CAD Kernel",
  "tags": ["tau", "kernel", "cad"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "constant",
        "query": ".*",
        "description": "Local default matches unlabeled series. Hosted provisioning binds this to exactly one application.",
        "current": { "text": ".*", "value": ".*" },
        "hide": 2
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "tau-api",
        "description": "Tau runs one service. A constant, so panels never lose their filter when the API's own series go stale during an outage.",
        "current": { "text": "tau-api", "value": "tau-api" },
        "options": [{ "text": "tau-api", "value": "tau-api", "selected": true }],
        "includeAll": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(process_uptime{app=~\"$app\",service_name=\"$service\"}, instance)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "title": "Kernel Execution Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (tau_runtime_outcome) (rate(tau_runtime_operations_total{app=~\"$app\",service_name=~\"$service\",tau_runtime_operation=~\"evaluate|render\",tau_runtime_outcome=~\"succeeded|issue|failed|timed-out|terminated|discarded\"}[5m]))",
          "legendFormat": "{{tau_runtime_outcome}}"
        }
      ],
      "id": 1
    },
    {
      "title": "Kernel Execution Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(tau_runtime_operation_duration_bucket{app=~\"$app\",service_name=~\"$service\",tau_runtime_operation=~\"evaluate|render\",tau_runtime_outcome=~\"succeeded|issue|failed|timed-out|terminated|discarded\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tau_runtime_operation_duration_bucket{app=~\"$app\",service_name=~\"$service\",tau_runtime_operation=~\"evaluate|render\",tau_runtime_outcome=~\"succeeded|issue|failed|timed-out|terminated|discarded\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "id": 2
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(tau_runtime_operations_total{app=~\"$app\",service_name=~\"$service\",tau_runtime_operation=~\"evaluate|render\",tau_runtime_outcome=~\"issue|failed|timed-out|terminated|discarded\"}[5m])) / sum(rate(tau_runtime_operations_total{app=~\"$app\",service_name=~\"$service\",tau_runtime_operation=~\"evaluate|render\",tau_runtime_outcome=~\"succeeded|issue|failed|timed-out|terminated|discarded\"}[5m])) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 5, "color": "yellow" },
              { "value": 20, "color": "red" }
            ]
          }
        }
      },
      "id": 3
    },
    {
      "title": "Export Duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tau_runtime_operation_duration_bucket{app=~\"$app\",service_name=~\"$service\",tau_runtime_operation=\"export\",tau_runtime_outcome=~\"succeeded|issue|failed|timed-out|terminated|discarded\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "noValue": "No export data" }
      },
      "id": 4
    },
    {
      "title": "Error Logs",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 100 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} | detected_level=~\"error|fatal|critical\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "id": 5
    },
    {
      "title": "Recent Traces",
      "type": "traces",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 108 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "query": "{resource.service.name=~\"$service\"}",
          "refId": "A",
          "queryType": "traceqlSearch"
        }
      ],
      "id": 6
    }
  ],
  "schemaVersion": 39
}
