{
  "uid": "tau-infrastructure",
  "title": "Infrastructure",
  "tags": ["tau", "infra", "redis", "postgres"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "tau-api",
        "description": "Tau runs one service. A constant, so panels never lose their filter when the API's own series go stale during an outage.",
        "current": { "text": "tau-api", "value": "tau-api" },
        "options": [{ "text": "tau-api", "value": "tau-api", "selected": true }],
        "includeAll": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(process_uptime{service_name=\"$service\"}, instance)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "title": "Redis Connection State",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "redis_connection_state{service_name=~\"$service\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "text": "Disconnected", "color": "red" },
                "1": { "text": "Connected", "color": "green" }
              },
              "type": "value"
            }
          ]
        }
      }
    },
    {
      "title": "PostgreSQL Backends",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(postgresql_backends)" }]
    },
    {
      "title": "Node.js Heap Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(v8js_memory_heap_used{service_name=~\"$service\"})",
          "legendFormat": "heap used"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "PostgreSQL Row Operations by Kind",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (operation) (rate(postgresql_operations_total[5m]))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Redis Commands per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum(rate(redis_commands_processed_total[5m]))", "legendFormat": "commands" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Object Storage Requests by Operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (tau_storage_operation) (rate(tau_storage_operation_duration_count{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{tau_storage_operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Event Loop Delay (p50 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "nodejs_eventloop_delay_p50{service_name=~\"$service\"}",
          "legendFormat": "p50"
        },
        {
          "expr": "nodejs_eventloop_delay_p99{service_name=~\"$service\"}",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "V8 GC Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(v8js_gc_duration_bucket{service_name=~\"$service\"}[5m])) by (le, v8js_gc_type))",
          "legendFormat": "{{v8js_gc_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "V8 Heap Space Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "v8js_memory_heap_space_physical_size{service_name=~\"$service\"}",
          "legendFormat": "{{v8js_heap_space_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "title": "PostgreSQL Connections Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 28 },
      "targets": [{ "expr": "sum(postgresql_backends) / max(postgresql_connection_max)" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 0.7, "color": "yellow" },
              { "value": 0.9, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "PostgreSQL Rollbacks (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 28 },
      "targets": [{ "expr": "sum(increase(postgresql_rollbacks_total[5m])) or vector(0)" }]
    },
    {
      "title": "Fly.io Machine Metrics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "collapsed": true,
      "panels": [
        {
          "title": "CPU Usage (Fly.io)",
          "description": "Available in production via Fly.io Prometheus federation",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
          "targets": [{ "expr": "fly_instance_cpu{app=\"tau-api\"}", "legendFormat": "{{instance}}", "refId": "A" }],
          "fieldConfig": { "defaults": { "unit": "percentunit" } }
        },
        {
          "title": "Memory Usage (Fly.io)",
          "description": "Available in production via Fly.io Prometheus federation",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
          "targets": [
            {
              "expr": "fly_instance_memory_mem_total{app=\"tau-api\"} - fly_instance_memory_mem_available{app=\"tau-api\"}",
              "legendFormat": "{{instance}}",
              "refId": "A"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "decbytes" } }
        },
        {
          "title": "Network I/O (Fly.io)",
          "description": "Available in production via Fly.io Prometheus federation",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
          "targets": [
            {
              "expr": "rate(fly_instance_net_sent_bytes{app=\"tau-api\"}[5m])",
              "legendFormat": "sent {{instance}}",
              "refId": "A"
            },
            {
              "expr": "rate(fly_instance_net_recv_bytes{app=\"tau-api\"}[5m])",
              "legendFormat": "recv {{instance}}",
              "refId": "B"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "Bps" } }
        }
      ]
    },
    {
      "title": "Error Logs",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 100 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service_name=~\"$service\"} | detected_level=~\"error|fatal|critical\"", "refId": "A" }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "title": "Recent Traces",
      "type": "traces",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 108 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "query": "{resource.service.name=~\"$service\"}", "refId": "A", "queryType": "traceqlSearch" }]
    }
  ],
  "schemaVersion": 39
}
