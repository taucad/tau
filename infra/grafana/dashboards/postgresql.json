{
  "uid": "tau-postgresql",
  "title": "PostgreSQL",
  "tags": ["tau", "postgresql"],
  "timezone": "browser",
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "tau-api",
        "description": "Tau runs one service. A constant, so panels never lose their filter when the API's own series go stale during an outage.",
        "current": { "text": "tau-api", "value": "tau-api" },
        "options": [{ "text": "tau-api", "value": "tau-api", "selected": true }],
        "includeAll": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(process_uptime{service_name=~\"$service\"}, instance)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgresql" },
      "targets": [
        {
          "rawSql": "SELECT count(*) as active FROM pg_stat_activity WHERE state = 'active'",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Transactions per Second",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(postgresql_commits_total[5m])) + sum(rate(postgresql_rollbacks_total[5m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Transaction Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgresql" },
      "targets": [
        {
          "rawSql": "SELECT xact_commit + xact_rollback as total FROM pg_stat_database WHERE datname = current_database()",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Row Operations by Kind",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum by (operation) (rate(postgresql_operations_total[5m]))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Deadlocks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgresql" },
      "targets": [
        {
          "rawSql": "SELECT deadlocks FROM pg_stat_database WHERE datname = current_database()",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Table Sizes",
      "type": "table",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgresql" },
      "targets": [
        {
          "rawSql": "SELECT schemaname, tablename, pg_total_relation_size(quote_ident(schemaname) || '.' || quote_ident(tablename)) as size FROM pg_tables WHERE schemaname NOT IN ('pg_catalog', 'information_schema') ORDER BY size DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "size" }, "properties": [{ "id": "unit", "value": "decbytes" }] }
        ]
      }
    },
    {
      "title": "Index Usage",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgresql" },
      "targets": [
        {
          "rawSql": "SELECT schemaname, relname as tablename, indexrelname, idx_scan, idx_tup_read FROM pg_stat_user_indexes ORDER BY idx_scan DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "title": "PostgreSQL Connections Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "targets": [{ "expr": "sum(postgresql_backends) / max(postgresql_connection_max)" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 0.7, "color": "yellow" },
              { "value": 0.9, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "Error Logs",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service_name=~\"$service\"} | detected_level=~\"error|fatal|critical\"", "refId": "A" }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "title": "Recent Traces",
      "type": "traces",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "query": "{resource.service.name=~\"$service\"}", "refId": "A", "queryType": "traceqlSearch" }]
    }
  ],
  "schemaVersion": 39
}
