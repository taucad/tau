{
  "uid": "tau-runtime",
  "title": "Runtime & Processes",
  "tags": ["tau", "runtime", "fly", "infrastructure"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "constant",
        "query": ".*",
        "description": "Local default matches unlabeled series. Hosted provisioning binds this to exactly one application.",
        "current": { "text": ".*", "value": ".*" },
        "hide": 2
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "tau-api",
        "description": "Tau runs one service. A constant, so panels never lose their filter when the API's own series go stale during an outage.",
        "current": { "text": "tau-api", "value": "tau-api" },
        "options": [{ "text": "tau-api", "value": "tau-api", "selected": true }],
        "includeAll": false
      }
    ]
  },
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Processes Up",
      "type": "stat",
      "description": "Scrape health of each Tau process: the local stand-in for Fly's health checks. Expected 2 (app, billing-operations), 3 if the optional billing-recovery target runs.",
      "targets": [
        {
          "expr": "count(process_uptime{app=~\"$app\",service_name=~\"$service\"}) or vector(0)"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 1
    },
    {
      "title": "Restarts (1h)",
      "type": "stat",
      "description": "A process restart resets its CPU counter.",
      "targets": [
        {
          "expr": "sum(resets(process_cpu_time_total{app=~\"$app\",service_name=~\"$service\",cpu_mode=\"user\"}[1h])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 2
    },
    {
      "title": "Min Uptime",
      "type": "stat",
      "targets": [
        {
          "expr": "min(process_uptime{app=~\"$app\",service_name=~\"$service\"})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 3
    },
    {
      "title": "API RSS",
      "type": "stat",
      "targets": [
        {
          "expr": "max(process_memory_usage{app=~\"$app\",service_name=~\"$service\",tau_process=\"app\"})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 4
    },
    {
      "title": "API CPU",
      "type": "stat",
      "description": "Cores busy; 1.0 = one full core (Fly shared-cpu-1x)",
      "targets": [
        {
          "expr": "sum(rate(process_cpu_time_total{app=~\"$app\",service_name=~\"$service\",tau_process=\"app\"}[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "id": 5
    },
    {
      "title": "HTTP 5xx (5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(http_server_request_duration_count{app=~\"$app\",service_name=~\"$service\",http_response_status_code=~\"5..\"}[5m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 6
    },
    {
      "title": "CPU by Process (cores)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tau_process) (rate(process_cpu_time_total{app=~\"$app\",service_name=~\"$service\"}[1m]))",
          "legendFormat": "{{tau_process}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7
    },
    {
      "title": "Memory (RSS) by Process",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max by (tau_process) (process_memory_usage{app=~\"$app\",service_name=~\"$service\"})",
          "legendFormat": "{{tau_process}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8
    },
    {
      "title": "HTTP Requests by Status Class",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_count{app=~\"$app\",service_name=~\"$service\",http_response_status_code=~\"2..\"}[5m])) or vector(0)",
          "legendFormat": "2xx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_request_duration_count{app=~\"$app\",service_name=~\"$service\",http_response_status_code=~\"3..\"}[5m])) or vector(0)",
          "legendFormat": "3xx",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_server_request_duration_count{app=~\"$app\",service_name=~\"$service\",http_response_status_code=~\"4..\"}[5m])) or vector(0)",
          "legendFormat": "4xx",
          "refId": "C"
        },
        {
          "expr": "sum(rate(http_server_request_duration_count{app=~\"$app\",service_name=~\"$service\",http_response_status_code=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": { "mode": "normal" },
            "fillOpacity": 20
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 9
    },
    {
      "title": "HTTP Response Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_bucket{app=~\"$app\",service_name=~\"$service\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_bucket{app=~\"$app\",service_name=~\"$service\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_bucket{app=~\"$app\",service_name=~\"$service\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 10
    },
    {
      "title": "Heap Used by Process",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tau_process) (v8js_memory_heap_used{app=~\"$app\",service_name=~\"$service\"})",
          "legendFormat": "{{tau_process}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 11
    },
    {
      "title": "Event Loop Utilization by Process",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max by (tau_process) (nodejs_eventloop_utilization{app=~\"$app\",service_name=~\"$service\"})",
          "legendFormat": "{{tau_process}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 12
    },
    {
      "title": "CPU Busy",
      "type": "stat",
      "targets": [
        {
          "expr": "1 - sum(rate(system_cpu_time_seconds_total{app=~\"$app\",state=\"idle\"}[1m])) / sum(rate(system_cpu_time_seconds_total[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 31 },
      "id": 13
    },
    {
      "title": "Memory Used",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(system_memory_usage_bytes{app=~\"$app\",state=\"used\"}) / sum(system_memory_usage_bytes)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 31 },
      "id": 14
    },
    {
      "title": "Load (1m)",
      "type": "stat",
      "targets": [{ "expr": "max(system_cpu_load_average_1m)" }],
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 31 },
      "id": 15
    },
    {
      "title": "Disk I/O",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(system_disk_io_bytes_total[1m]))" }],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 31 },
      "id": 16
    },
    {
      "title": "Load Average",
      "type": "timeseries",
      "targets": [
        { "expr": "max(system_cpu_load_average_1m)", "legendFormat": "1m" },
        { "expr": "max(system_cpu_load_average_5m)", "legendFormat": "5m" },
        { "expr": "max(system_cpu_load_average_15m)", "legendFormat": "15m" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "id": 17
    },
    {
      "title": "Network I/O",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (direction) (rate(system_network_io_bytes_total{app=~\"$app\",device!=\"lo\"}[1m]))",
          "legendFormat": "{{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 36 },
      "id": 18
    },
    {
      "title": "Disk I/O",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (direction) (rate(system_disk_io_bytes_total[1m]))",
          "legendFormat": "{{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "id": 19
    }
  ]
}
