      "type": "stat",
      "description": "List price: Class A US$4.50/M, Class B US$0.36/M, storage US$0.015/GB-month, from the accounting scheduler's Cloudflare analytics (OB3). Free tiers are not subtracted.",
      "targets": [
        {
          "expr": "sum(max by (tau_r2_bucket, tau_r2_class, tau_r2_action, tau_r2_status, tau_r2_window) (tau_r2_requests{app=~\"$app\",service_name=~\"$service\",tau_r2_window=\"month\",tau_r2_class=\"A\"})) * 4.5e-06 + sum(max by (tau_r2_bucket, tau_r2_class, tau_r2_action, tau_r2_status, tau_r2_window) (tau_r2_requests{app=~\"$app\",service_name=~\"$service\",tau_r2_window=\"month\",tau_r2_class=\"B\"})) * 3.6e-07 + sum(max by (tau_r2_bucket) (tau_r2_stored_bytes{app=~\"$app\",service_name=~\"$service\"})) / 1e9 * 0.015",
          "refId": "A"
