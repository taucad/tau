{
  "uid": "tau-websocket-rpc",
  "title": "WebSocket Gateways",
  "tags": ["tau", "websocket", "rpc", "red"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "tau-api",
        "description": "Tau runs one service. A constant, so panels never lose their filter when the API's own series go stale during an outage.",
        "current": { "text": "tau-api", "value": "tau-api" },
        "options": [{ "text": "tau-api", "value": "tau-api", "selected": true }],
        "includeAll": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(process_uptime{service_name=\"$service\"}, instance)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "title": "Active WS Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(ws_connections_active{service_name=~\"$service\"})" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Upgrade Rejections (1h)",
      "description": "WebSocket upgrades refused before a gateway admitted them (session, device credential, credit, route).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(ws_upgrade_rejections_total{service_name=~\"$service\"}[1h])) or vector(0)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Disconnection Rate",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (ws_gateway) (rate(ws_disconnections_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{ws_gateway}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "title": "Frames by Gateway and Direction",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (ws_gateway, ws_direction) (rate(ws_message_size_count{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{ws_gateway}} {{ws_direction}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "title": "Upgrade Rejections by Reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (ws_gateway, reason) (rate(ws_upgrade_rejections_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{ws_gateway}} {{reason}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "title": "Connections by Gateway",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (ws_gateway) (ws_connections_active{service_name=~\"$service\"})",
          "legendFormat": "{{ws_gateway}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Disconnections by Reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (ws_gateway, ws_close_reason) (rate(ws_disconnections_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{ws_gateway}} {{ws_close_reason}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "title": "WS Message Size (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, ws_gateway, ws_direction) (rate(ws_message_size_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "{{ws_gateway}} {{ws_direction}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "Error Logs",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 100 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service_name=~\"$service\"} | detected_level=~\"error|fatal|critical\"", "refId": "A" }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "title": "Recent Traces",
      "type": "traces",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 108 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "query": "{resource.service.name=~\"$service\"}", "refId": "A", "queryType": "traceqlSearch" }]
    }
  ],
  "schemaVersion": 39
}
