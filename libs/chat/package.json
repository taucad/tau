{
  "name": "@taucad/chat",
  "version": "0.1.0",
  "description": "Tau AI-SDK chat tools",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "import": "./src/constants/index.ts",
      "default": "./src/constants/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "import": "./src/prompts/index.ts",
      "default": "./src/prompts/index.ts"
    },
    "./rpc": {
      "types": "./src/rpc/index.ts",
      "import": "./src/rpc/index.ts",
      "default": "./src/rpc/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "import": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    },
    "./schemas/tools/test-model": {
      "types": "./src/schemas/tools/test-model.tool.schema.ts",
      "import": "./src/schemas/tools/test-model.tool.schema.ts",
      "default": "./src/schemas/tools/test-model.tool.schema.ts"
    },
    "./schemas/tools/get-kernel-result": {
      "types": "./src/schemas/tools/get-kernel-result.tool.schema.ts",
      "import": "./src/schemas/tools/get-kernel-result.tool.schema.ts",
      "default": "./src/schemas/tools/get-kernel-result.tool.schema.ts"
    },
    "./schemas/tools/screenshot": {
      "types": "./src/schemas/tools/screenshot.tool.schema.ts",
      "import": "./src/schemas/tools/screenshot.tool.schema.ts",
      "default": "./src/schemas/tools/screenshot.tool.schema.ts"
    },
    "./schemas/tools/export-geometry": {
      "types": "./src/schemas/tools/export-geometry.tool.schema.ts",
      "import": "./src/schemas/tools/export-geometry.tool.schema.ts",
      "default": "./src/schemas/tools/export-geometry.tool.schema.ts"
    },
    "./schemas/rpc": {
      "types": "./src/schemas/rpc.schema.ts",
      "import": "./src/schemas/rpc.schema.ts",
      "default": "./src/schemas/rpc.schema.ts"
    },
    "./schemas/tools/test-model-input-normalizer": {
      "types": "./src/schemas/tools/test-model-input-normalizer.ts",
      "import": "./src/schemas/tools/test-model-input-normalizer.ts",
      "default": "./src/schemas/tools/test-model-input-normalizer.ts"
    },
    "./schemas/tools/project-path-input-normalizer": {
      "types": "./src/schemas/tools/project-path-input-normalizer.ts",
      "import": "./src/schemas/tools/project-path-input-normalizer.ts",
      "default": "./src/schemas/tools/project-path-input-normalizer.ts"
    }
  },
  "dependencies": {
    "@taucad/types": "workspace:*",
    "@taucad/utils": "workspace:*",
    "zod": "catalog:"
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  }
}
