{
  "name": "@taucad/grammars",
  "version": "0.0.1",
  "description": "Lezer grammars and the shared syntax highlighting registry for Tau code surfaces",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "libs/grammars"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/libs/grammars#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cad",
    "lezer",
    "codemirror",
    "syntax-highlighting"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bash": "./src/bash/index.ts",
    "./csharp": "./src/csharp/index.ts",
    "./jsonc": "./src/jsonc/index.ts",
    "./kcl": "./src/kcl/index.ts",
    "./openscad": "./src/openscad/index.ts",
    "./stepfile": "./src/stepfile/index.ts",
    "./stl": "./src/stl/index.ts",
    "./sysml": "./src/sysml/index.ts",
    "./usd": "./src/usd/index.ts",
    "./fixtures": "./src/fixtures.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./bash": {
        "types": "./dist/bash/index.d.mts",
        "import": "./dist/bash/index.mjs",
        "default": "./dist/bash/index.mjs"
      },
      "./csharp": {
        "types": "./dist/csharp/index.d.mts",
        "import": "./dist/csharp/index.mjs",
        "default": "./dist/csharp/index.mjs"
      },
      "./jsonc": {
        "types": "./dist/jsonc/index.d.mts",
        "import": "./dist/jsonc/index.mjs",
        "default": "./dist/jsonc/index.mjs"
      },
      "./kcl": {
        "types": "./dist/kcl/index.d.mts",
        "import": "./dist/kcl/index.mjs",
        "default": "./dist/kcl/index.mjs"
      },
      "./openscad": {
        "types": "./dist/openscad/index.d.mts",
        "import": "./dist/openscad/index.mjs",
        "default": "./dist/openscad/index.mjs"
      },
      "./stepfile": {
        "types": "./dist/stepfile/index.d.mts",
        "import": "./dist/stepfile/index.mjs",
        "default": "./dist/stepfile/index.mjs"
      },
      "./stl": {
        "types": "./dist/stl/index.d.mts",
        "import": "./dist/stl/index.mjs",
        "default": "./dist/stl/index.mjs"
      },
      "./sysml": {
        "types": "./dist/sysml/index.d.mts",
        "import": "./dist/sysml/index.mjs",
        "default": "./dist/sysml/index.mjs"
      },
      "./usd": {
        "types": "./dist/usd/index.d.mts",
        "import": "./dist/usd/index.mjs",
        "default": "./dist/usd/index.mjs"
      },
      "./fixtures": {
        "types": "./dist/fixtures.d.mts",
        "import": "./dist/fixtures.mjs",
        "default": "./dist/fixtures.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/lang-python": "catalog:",
    "@codemirror/lang-yaml": "catalog:",
    "@codemirror/language": "catalog:",
    "@lezer/common": "catalog:",
    "@lezer/highlight": "catalog:",
    "@lezer/lr": "catalog:",
    "@taucad/types": "workspace:*"
  },
  "scripts": {
    "generate": "node src/generate-parsers.ts"
  },
  "devDependencies": {
    "@lezer/generator": "catalog:"
  }
}
