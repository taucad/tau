{
  "name": "@taucad/oxlint",
  "version": "0.1.0",
  "description": "Shared oxlint plugins and lint configurations for the Tau monorepo",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "dependencies": {
    "@typescript-eslint/types": "^8.61.1",
    "typescript": "catalog:"
  },
  "devDependencies": {
