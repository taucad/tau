{
  "name": "@taucad/sandbox",
  "version": "0.1.0-beta.0",
  "description": "Tau's OS sandbox launcher, process tree and contained shell provider, bundled into @taucad/native-process-core",
  "type": "module",
  "sideEffects": [
    "./src/shell/srt-supervisor.ts"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "libs/sandbox"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/libs/sandbox#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cad",
    "sandbox",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./shell": "./src/shell.ts",
    "./shell/srt-supervisor": "./src/shell/srt-supervisor.ts",
    "./shell/baseline": "./src/shell/shell-baseline.ts",
    "./shell/environment": "./src/shell/shell-environment.ts",
    "./shell/identity": "./src/shell/shell-identity.ts",
    "./shell/provider": "./src/shell/shell-provider.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "catalog:"
  },
  "optionalDependencies": {
    "node-pty": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "zod": "catalog:"
  }
}
