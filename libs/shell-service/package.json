{
  "name": "@taucad/shell-service",
  "version": "0.1.0-beta.0",
  "description": "Tau's rooted shell service: bounded agent shell calls and interactive Terminal sessions over a sandbox shell provider, bundled into @taucad/host",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "libs/shell-service"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/libs/shell-service#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cad",
    "shell",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/agent-host": "workspace:*",
    "@taucad/filesystem": "workspace:*",
    "@taucad/sandbox": "workspace:*"
  }
}
