{
  "name": "@taucad/tau-examples",
  "version": "0.1.0",
  "description": "Tau examples",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./builtin": "./src/builtin.ts",
    "./fixtures": "./src/fixture-loader.ts",
    "./manifest": "./src/manifest.ts",
