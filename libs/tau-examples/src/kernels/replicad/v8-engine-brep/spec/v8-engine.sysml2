package V8EngineBrepReference {
  doc /* Intent: production-ready static 90 degree cross-plane V8 engine reference for Tau GeoSpec validation. */

  part def V8Engine {
    part block: EngineBlock;
    part crankshaft: Crankshaft;
    part piston[8]: Piston;
    part pistonRing[24]: PistonRing;
    part wristPin[8]: WristPin;
    part connectingRod[8]: ConnectingRod;
    part mainBearing[5]: MainBearing;
    part mainBearingCap[5]: MainBearingCap;
    part rodBearing[4]: RodBearing;
    part cylinderHead[2]: CylinderHead;
    part headGasket[2]: HeadGasket;
    part valveCover[2]: ValveCover;
    part valveCoverGasket[2]: ValveCoverGasket;
    part camshaft: Camshaft;
    part lifter[16]: Lifter;
    part pushrod[16]: Pushrod;
    part rockerArm[16]: RockerArm;
    part valve[16]: Valve;
    part valveSpring[16]: ValveSpring;
    part intakeRunner[8]: IntakeRunner;
    part exhaustRunner[8]: ExhaustRunner;
    part fuelInjector[8]: FuelInjector;
    part sparkPlug[8]: SparkPlug;
    part oilPan: OilPan;
    part oilPump: OilPump;
    part pickupTube: OilPickupTube;
    part waterPump: WaterPump;
    part harmonicDamper: HarmonicDamper;
    part flywheel: Flywheel;
    part fastener[*]: Fastener;
  }

  part def EngineBlock;
  part def Crankshaft;
  part def Piston;
  part def PistonRing;
  part def WristPin;
  part def ConnectingRod;
  part def MainBearing;
  part def MainBearingCap;
  part def RodBearing;
  part def CylinderHead;
  part def HeadGasket;
  part def ValveCover;
  part def ValveCoverGasket;
  part def Camshaft;
  part def Lifter;
  part def Pushrod;
  part def RockerArm;
  part def Valve;
  part def ValveSpring;
  part def IntakeRunner;
  part def ExhaustRunner;
  part def FuelInjector;
  part def SparkPlug;
  part def OilPan;
  part def OilPump;
  part def OilPickupTube;
  part def WaterPump;
  part def HarmonicDamper;
  part def Flywheel;
  part def Fastener;

  requirement REQ_V8_STRUCT_001 {
    doc /* Whole assembly includes all required production V8 subsystem families and named parts. */
    subject engine: V8Engine;
  }

  requirement REQ_V8_BREP_001 {
    doc /* Manufactured part exports provide valid BRep and watertight mesh evidence where applicable. */
    subject engine: V8Engine;
  }

  requirement REQ_V8_CLEAR_001 {
    doc /* Separate assembly components avoid unintended positive-volume overlap and preserve explicit clearances. */
    subject engine: V8Engine;
  }

  requirement REQ_V8_ROT_001 {
    doc /* Cross-plane crankshaft exposes main journals, rod journals, counterweights, flange, oil galleries, and timing interfaces. */
    subject crankshaft: Crankshaft;
  }

  requirement REQ_V8_RECIP_001 {
    doc /* Pistons, rings, wrist pins, rods, and bearings are present and mechanically aligned to the crankshaft. */
    subject engine: V8Engine;
  }

  requirement REQ_V8_VALVE_001 {
    doc /* OHV valvetrain includes camshaft, timing drive, lifters, pushrods, rocker arms, valves, springs, and retainers. */
    subject engine: V8Engine;
  }

  requirement REQ_V8_INDUCTION_001 {
    doc /* Intake, fuel, and exhaust systems include runners, plenum, throttle body, fuel rails, injectors, collectors, and port connections. */
    subject engine: V8Engine;
  }

  requirement REQ_V8_LUBE_001 {
    doc /* Lubrication and cooling systems include pan, pump, pickup, filter, front cover, water pump, thermostat housing, and coolant outlet. */
    subject engine: V8Engine;
  }

  requirement REQ_V8_FASTEN_001 {
    doc /* Fastened interfaces include gaskets, bolt patterns, and visible fastener bodies for heads, covers, pan, rods, mains, and flywheel. */
    subject engine: V8Engine;
  }

  verification case GeoSpecAssembly verifies REQ_V8_STRUCT_001 {
    doc /* Implemented by geospec/assembly.geospec.ts. */
  }

  verification case GeoSpecBrep verifies REQ_V8_BREP_001 {
    doc /* Implemented by geospec/brep-features.geospec.ts. */
  }

  verification case GeoSpecClearance verifies REQ_V8_CLEAR_001 {
    doc /* Implemented by geospec/assembly.geospec.ts and geospec/parameters.geospec.ts. */
  }

  verification case GeoSpecSubsystems verifies REQ_V8_ROT_001, REQ_V8_RECIP_001, REQ_V8_VALVE_001, REQ_V8_INDUCTION_001, REQ_V8_LUBE_001, REQ_V8_FASTEN_001 {
    doc /* Implemented by geospec/subsystems.geospec.ts, geospec/brep-features.geospec.ts, and geospec/parameters.geospec.ts. */
  }
}
