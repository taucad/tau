@settings(defaultLengthUnit = mm, kclVersion = 3.0)

// A plain block: planar faces only, so every mesher encloses the same volume.
width = 20mm
depth = 10mm
height = 5mm

profile = sketch(on = XY) {
  bottom = line(start = [var 0mm, var 0mm], end = [var 20mm, var 0mm])
  right = line(start = [var 20mm, var 0mm], end = [var 20mm, var 10mm])
  top = line(start = [var 20mm, var 10mm], end = [var 0mm, var 10mm])
  left = line(start = [var 0mm, var 10mm], end = [var 0mm, var 0mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  coincident([bottom.start, ORIGIN])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, bottom.end]) == width
  verticalDistance([right.start, right.end]) == depth
}

block = extrude(region(segments = [profile.bottom, profile.right]), length = height)
hide(profile)
