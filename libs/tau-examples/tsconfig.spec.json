{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["node", "vitest/importMeta", "vitest", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "target": "ESNext",
    "paths": {
      "#scripts/*": ["./scripts/*"],
      "#*": ["./src/*"],
      "libcascade": ["../api-extractor/src/generated/opencascade/modules/libcascade/index.d.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.test.ts",
    ".agents/skills/*/scripts/*.mts",
    ".agents/skills/*/scripts/*.test.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test-d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx"
  ]
}
