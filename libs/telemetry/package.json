{
  "name": "@taucad/telemetry",
  "version": "0.1.0-beta.0",
  "description": "Private telemetry metric registry, reporter, and ingest contracts for Tau applications",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "libs/telemetry"
  },
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./node": "./src/node.ts",
    "./node-host": "./src/node-host.ts"
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/events": "workspace:*"
  },
  "devDependencies": {
    "@taucad/types": "workspace:*",
    "zod": "catalog:"
  }
}
