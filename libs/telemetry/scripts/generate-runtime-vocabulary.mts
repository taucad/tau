/**
 * Write `src/runtime-vocabulary.ts` from the plugin registry (`runtime-registry.mts`).
 *
 * Run `pnpm nx run telemetry:generate-runtime-vocabulary` after adding or renaming a kernel, middleware, bundler,
 * transcoder, conversion edge, job or machine provider, standard machine action or failure code. The T30 contract test
 * (`src/runtime-vocabulary.test.ts`) fails until the generated file matches the registry again.
 */
import { writeFileSync } from 'node:fs';
import path from 'node:path';
/* oxlint-disable eslint/no-restricted-imports -- `scripts/` has no `#` import map; the derivation is a sibling module. */
import { deriveRuntimeVocabulary } from './runtime-registry.mts';
import type { RuntimeRegistryVocabulary } from './runtime-registry.mts';
/* oxlint-enable eslint/no-restricted-imports */

const target = path.resolve(import.meta.dirname, '../src/runtime-vocabulary.ts');

const documentation: Readonly<Record<keyof RuntimeRegistryVocabulary, string>> = {
  runtimeKernelIds:
    'Runtime plugin-kernel ids (`KernelPlugin.id`), the `kernel.id` of runtime entries. Not the product `kernelIds`.',
  middlewareIds: 'First-party middleware names (`middleware.name`), as `middleware.wrap(<name>)` spans carry them.',
  bundlerIds: 'Bundler plugin ids (`BundlerPlugin.id`).',
  transcoderIds: 'Transcoder plugin ids (`TranscoderPlugin.id`).',
  jobProviderIds: 'Job provider ids (`JobProviderIdentity.id`).',
  machineProviderIds: 'Machine provider ids (`MachineProvider.id`).',
  exportFormats: 'Export formats: every kernel export-map extension and every transcoder edge target.',
  fileFormats: 'File formats: every kernel extension, every transcoder edge source and every export format.',
  conversionEdges: 'Distinct transcoder conversion edges as `from→to` pairs.',
  machineActions: 'Standard machine action families (`standardMachineActions` keys).',
  machineKinds: 'Journaled machine operation kinds (`MachineOperationKind`).',
  kernelIssueCodes: 'Runtime issue codes (`kernelIssueCodeValues`).',
  preparationCodes: 'Preparation blocked reasons and error codes.',
  admissionCodes: 'Host admission refusal codes.',
  machineFailureCodes: 'Machine failure codes (`machineFailureCodes`).',
  jobCodes: 'Job store and job provider refusal codes.',
};

const vocabulary = await deriveRuntimeVocabulary();
const blocks = Object.entries(vocabulary).map(
  ([key, values]) =>
    `/** ${documentation[key as keyof RuntimeRegistryVocabulary]} @public */\nexport const ${key} = [\n${values
      .map((value) => `  '${value}',`)
      .join('\n')}\n] as const;`,
);
writeFileSync(
  target,
  [
    '// AUTO-GENERATED by scripts/generate-runtime-vocabulary.mts from the plugin registry. DO NOT EDIT.',
    '// Run `pnpm nx run telemetry:generate-runtime-vocabulary` to regenerate; `runtime-vocabulary.test.ts` (T30) checks it.',
    '',
    ...blocks.flatMap((block) => [block, '']),
  ].join('\n'),
);
