{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "./tools/tsdown.plugin.ts"
    },
    {
      "plugin": "./tools/copy-files-from-to.plugin.ts"
    },
    {
      "plugin": "./tools/pkgcheck.plugin.ts"
    },
    {
      "plugin": "@nx/react/router-plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "startTargetName": "serve",
        "watchDepsTargetName": "watch-deps",
        "buildDepsTargetName": "build-deps",
        "typecheckTargetName": "typecheck"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "previewTargetName": "preview",
        "devTargetName": "dev",
        "serveTargetName": "serve",
        "serveStaticTargetName": "serve-static",
        "outputPath": "dist"
      },
      "exclude": ["examples/**", "apps/react-e2e/apps/**"]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint",
        "eslintConfig": "eslint.config.mjs"
      },
      "exclude": ["libs/oxlint/src/rules/fixtures/**"]
    },
    {
      "plugin": "./tools/tsgo.plugin.ts",
      "options": {
        "targetName": "typecheck"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      },
      "exclude": ["examples/**", "apps/react-e2e/apps/**"]
    }
  ],
  "targetDefaults": {
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "options": {
        "forwardAllArgs": false
      }
    },
    "test": {
      "dependsOn": ["^copy-assets"],
      "inputs": ["default", "^production"]
    },
    "build": {
      "inputs": ["production", "^production"]
    },
    "lint": {
      "options": {
        "command": "oxlint --no-error-on-unmatched-pattern -c $NX_WORKSPACE_ROOT/.oxlintrc.json {args.files} && eslint {args.files}",
        "forwardAllArgs": false
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/.oxlintrc.json",
        "{workspaceRoot}/libs/oxlint/src/**/*",
        {
          "externalDependencies": ["eslint", "oxlint"]
        }
      ]
    },
    "e2e-ci--**/*": {
      "dependsOn": ["^build"]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "."
      }
    },
    "launch": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "."
      }
    },
    "nx-release-publish": {
      "dependsOn": ["pkgcheck"]
    },
    "formal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/formal/src/cli.ts check --tier pr {projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/specs/**/*",
        "!{projectRoot}/specs/lean/**/*",
        "{projectRoot}/src/**/*.legality.json",
        "{workspaceRoot}/tools/formal/src/**/*",
        "{workspaceRoot}/tools/formal/toolchain.lock",
        { "runtime": "node tools/formal/src/cli.ts toolchain-id" }
      ],
      "outputs": ["{workspaceRoot}/out/reports/formal/{projectRoot}/pr"]
    },
    "formal:lean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/formal/src/cli.ts check --tier lean {projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/specs/lean/**/*",
        "{workspaceRoot}/tools/formal/src/**/*",
        "{workspaceRoot}/tools/formal/toolchain.lock",
        { "runtime": "node tools/formal/src/cli.ts toolchain-id" }
      ],
      "outputs": ["{workspaceRoot}/out/reports/formal/{projectRoot}/lean"]
    },
    "formal:nightly": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/formal/src/cli.ts nightly {projectRoot}"
      },
      "cache": false
    },
    "formal:logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/formal/src/cli.ts logs {projectName}"
      },
      "cache": false
    }
  },
  "generators": {
    "@nx/react": {
      "library": {
        "unitTestRunner": "vitest"
      }
    }
  },
  "nxCloudId": "687b39d7852b9a43a8bba201",
  "sync": {
    "applyChanges": true
  },
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/ci.yml", "{workspaceRoot}/.github/workflows/publish.yml"],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/*.test-d.*",
      "!{projectRoot}/vitest.config.*",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/specs/**/*"
    ]
  },
  "release": {
    "projects": ["tag:type:package"],
    "projectsRelationship": "fixed",
    "versionPlans": {
      "ignorePatternsForPlanCheck": ["**/*.spec.ts", "**/*.test.ts", "**/*.md"]
    },
    "version": {
      "preVersionCommand": "pnpm nx run-many -t build --projects=tag:type:package",
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    },
    "changelog": {
      "workspaceChangelog": {
        "file": "CHANGELOG.md",
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      },
      "projectChangelogs": {
        "file": "CHANGELOG.md",
        "renderOptions": {
          "authors": false,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    },
    "releaseTag": {
      "pattern": "v{version}"
    },
    "git": {
      "commitMessage": "chore(release): v{version}"
    }
  },
  "analytics": true
}
