{
  "name": "@taucad/tau-source",
  "description": "The AI-Native CAD Platform",
  "homepage": "https://github.com/taucad/tau",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev",
    "dev:ui": "nx run ui:dev:portless",
    "start": "nx run-many -t serve",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "mcp:browser": "npx -y @agentdeskai/browser-tools-mcp@1.2.0",
    "build": "nx run-many -t build",
    "format": "oxfmt",
    "format:check": "nx run scripts:validate-format",
    "$infra:comment": "The new `docker compose` command is not supported outside of Docker Desktop, so we use the old `docker-compose` command. Migrate after it's ported to the `docker` CLI.",
    "infra:up": "docker-compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker-compose -f infra/docker-compose.yml down",
    "infra:reset": "docker-compose -f infra/docker-compose.yml down -v && docker-compose -f infra/docker-compose.yml up -d",
    "infra:logs": "docker-compose -f infra/docker-compose.yml logs -f",
    "infra:logs:redis": "docker-compose -f infra/docker-compose.yml logs -f redis",
    "infra:logs:postgres": "docker-compose -f infra/docker-compose.yml logs -f postgres",
    "grafana:up": "docker-compose -f infra/docker-compose.yml up -d otel-lgtm",
    "grafana:down": "docker-compose -f infra/docker-compose.yml stop otel-lgtm",
    "grafana:logs": "docker-compose -f infra/docker-compose.yml logs -f otel-lgtm",
    "grafana:sync": "nx run api:grafana:sync",
    "db:generate": "nx run api:db-generate",
    "db:migrate": "nx run api:db-migrate",
    "db:studio": "nx run api:db-studio",
    "db:push": "nx run api:db-push",
    "db:drop": "nx run api:db-drop",
    "update-license-deps": "node --import tsx scripts/src/update-license-deps.mts",
    "license-deps:validate": "nx run scripts:validate-license-deps",
    "update-open-source-notices": "node --import tsx scripts/src/update-open-source-notices.mts",
    "registry:check": "nx run scripts:check-registry-dependencies",
    "runtime:npm-local-smoke": "nx run runtime:npm-local-smoke",
    "pkgcheck": "nx run-many -t pkgcheck",
    "repos": "node scripts/dist/repos.mjs",
    "repos:clone": "node scripts/dist/repos.mjs clone --all",
    "repos:sync": "node scripts/dist/repos.mjs sync --all",
    "repos:status": "node scripts/dist/repos.mjs status --all",
    "knip": "nx run scripts:validate-dead-code",
    "docs:validate": "nx run scripts:validate-frontmatter && node scripts/src/canvas-review.ts check",
    "canvas:review": "node scripts/src/canvas-review.ts",
    "canvas:dev": "vite --config scripts/src/canvas-vite.config.ts",
    "canvas:typecheck": "node scripts/src/canvas-typecheck.ts",
    "size:build": "node tools/size-build.mjs",
    "size:check": "cd node_modules/.cache/size-limit && size-limit",
    "prepare": "husky"
  },
