{
  "name": "agent-host",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/agent-host",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsdown --config-loader=tsx",
        "cwd": "{projectRoot}"
      }
    },
    "test:live": {
      "command": "vitest run --config vitest.live.config.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "test:browser": {
      "command": "vitest run --config vitest.browser.config.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
