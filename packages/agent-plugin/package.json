{
  "name": "@taucad/agent-plugin",
  "version": "0.1.0-beta.1",
  "description": "Tau CAD plugin for Codex and Claude Code: skills and the tau mcp launcher",
  "type": "module",
  "sideEffects": [
    "./src/launch.ts",
    "./dist/launch.mjs"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/agent-plugin"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/agent-plugin#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    ".codex-plugin",
    ".claude-plugin",
    "mcp",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "cad",
    "codex",
    "claude-code",
    "plugin",
    "mcp",
    "agent-skills",
    "geospec"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  }
}
