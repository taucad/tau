{
  "name": "@taucad/agent-plugin",
  "version": "0.1.0-beta.6",
  "description": "Tau CAD plugin for Codex and Claude Code: skills and the tau mcp launcher",
  "type": "module",
  "sideEffects": [
    "./src/launch.ts",
    "./dist/launch.mjs",
    "./src/doctor.ts",
    "./dist/doctor.mjs"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/agent-plugin"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/agent-plugin#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "assets",
    "dist",
    "dist-app",
    ".codex-plugin",
    ".claude-plugin",
    "mcp",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "cad",
    "codex",
    "claude-code",
    "plugin",
    "mcp",
    "agent-skills",
    "geospec"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#app/*.jsx": "./app/*.tsx",
    "#app/*.js": "./app/*.ts",
    "#app/*": "./app/*",
    "#e2e/*.js": "./e2e/*.ts",
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.1",
    "@taucad/chat": "workspace:*",
    "@taucad/mcp": "workspace:*",
    "@taucad/parameters": "workspace:*",
    "@taucad/project-core": "workspace:*",
    "@taucad/runtime": "workspace:*",
    "@taucad/types": "workspace:*",
    "@taucad/ui": "workspace:*",
    "@taucad/viewer": "workspace:*",
    "@taucad/workbench-panes": "workspace:*",
    "@vitejs/plugin-react": "catalog:",
    "@xstate/react": "7.0.0-alpha.3",
    "immer": "^10.2.0",
    "lucide-react": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "three": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "catalog:",
    "xstate": "catalog:",
    "zod": "catalog:"
  }
}
