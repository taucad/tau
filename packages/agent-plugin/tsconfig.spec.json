{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["node", "vite/client", "vitest/importMeta", "vitest"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "target": "ESNext"
  },
  "include": [
    "vitest.config.ts",
    "vitest.setup.ts",
    "tsdown.config.ts",
    "vite.app.config.ts",
    "vitest.hosts.config.ts",
    "scripts/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test-d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "e2e/**/*.ts"
  ]
}
