{
  "name": "@taucad/cli",
  "version": "0.1.0-beta.1",
  "description": "CLI for @taucad/runtime",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/cli"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "taucad": "./dist/bin/taucad.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cad",
    "cli",
    "typescript",
    "export",
    "glb",
    "stl",
    "step"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "taucad": "./dist/bin/taucad.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/runtime": "workspace:*",
    "citty": "catalog:",
    "consola": "catalog:"
  }
}
