{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/cli",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "stage-acp"],
      "options": {
        "command": "tsdown",
        "cwd": "{projectRoot}"
      }
    },
    "stage-acp": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "metadata": {
        "description": "Stage the pinned ACP adapters and their runtime closure into dist-acp, without the vendor binaries their optional dependencies install, as the desktop app stages them."
      },
      "inputs": [
        "{projectRoot}/scripts/stage-acp-adapters.mts",
        "{workspaceRoot}/tools/nx/src/runtime-closure.ts",
        "{workspaceRoot}/packages/host/src/acp/registry.ts",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/tools/pnpm/patches/**/*"
      ],
      "outputs": ["{projectRoot}/dist-acp"],
      "options": {
        "command": "node --import @oxc-node/core/register packages/cli/scripts/stage-acp-adapters.mts"
      }
    },
    "dev-host": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch --clear-screen=false --include 'packages/cli/src/**/*.ts' --include 'packages/host/src/**/*.ts' packages/cli/src/bin.ts serve --trust-projects",
        "env": {
          "TAU_CONFIG_DIR": "out/tau-host-dev",
          "TAU_HOST_RELAY_URL": "http://localhost:4000"
        },
        "forwardAllArgs": true
      }
    },
    "tau": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --import @oxc-node/core/register packages/cli/dist/bin/tau.mjs",
        "forwardAllArgs": true
      }
    },
    "test": {
      "dependsOn": [
        "build",
        "^copy-assets",
        {
          "projects": ["build123d"],
          "target": "seed"
        }
      ]
    },
    "test:native-darwin": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        "^copy-assets",
        {
          "projects": ["build123d"],
          "target": "seed"
        }
      ],
      "metadata": {
        "description": "Tier 4b of the native kernels on darwin-arm64 (charter D30, the native-darwin CI job): from an empty store, tau mcp and tau serve each prepare Build123d and PicoGK with real bytes and evaluate a real .py and .cs model to geometry. Kept off the default test target because it downloads about 210 MB and needs a darwin-arm64 host."
      },
      "options": {
        "cwd": "{workspaceRoot}/packages/cli",
        "command": "../../node_modules/.bin/vitest run --config vitest.config.ts src/commands/mcp.integration.test.ts src/commands/serve.integration.test.ts --testNamePattern 'tier 4b'",
        "env": {
          "TAU_NATIVE_DARWIN": "1",
          "TAU_E2E_CLI_BUILT": "true"
        }
      }
    },
    "test:ds3": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vitest run --root packages/cli src/tail-relay.integration.test.ts",
        "env": {
          "TAU_DS3_TAIL_RELAY": "1"
        }
      }
    }
  }
}
