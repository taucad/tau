{
  "name": "@taucad/converter",
  "version": "0.1.0-beta.0",
  "description": "Convert CAD files to other formats",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/converter"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cad",
    "converter",
    "stl",
    "dxf",
    "step",
    "iges",
    "usda",
    "usdz"
  ],
  "author": "Richard Fontein",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./formats": "./src/formats.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./formats": {
        "types": "./dist/formats.d.ts",
        "import": "./dist/formats.js",
        "default": "./dist/formats.js"
      }
    }
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@gltf-transform/core": "catalog:",
    "@gltf-transform/extensions": "catalog:",
    "@gltf-transform/functions": "catalog:",
    "@taucad/gltf-extensions": "workspace:*",
    "@taucad/types": "workspace:*",
    "assimpjs": "npm:@taulabs/assimpjs@0.0.19",
    "draco3dgltf": "^1.5.7",
    "occt-import-js": "^0.0.23",
    "rhino3dm": "^8.17.0"
  }
}
