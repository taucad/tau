{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tau.new/schemas/tau-cad-topology-v1.schema.json",
  "title": "TAU_cad_topology payload",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" },
      "maxItems": 1000000
    },
    "mechanism": { "$ref": "#/$defs/mechanism" }
  },
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "mechanism": {
      "description": "A @taucad/kinematics Mechanism in this glTF's vertex space: lengths in the vertices' unit, origins and axes in their frame, link components as components[].id values. This schema checks shape only; validateTauCadTopology also runs admitMechanism (joint tree, known link and degree-of-freedom ids, lower <= upper, perpendicular planar axes, sorted keyframes, acyclic couplings) and checks link components against components[].id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "units", "root", "links", "joints"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length", "angle"],
          "properties": {
            "length": { "enum": ["m", "mm"] },
            "angle": { "enum": ["rad", "deg"] }
          }
        },
        "root": { "type": "string" },
        "links": { "type": "object", "additionalProperties": { "$ref": "#/$defs/mechanismLink" } },
        "joints": { "type": "object", "additionalProperties": { "$ref": "#/$defs/joint" } },
        "couplings": { "type": "array", "items": { "$ref": "#/$defs/coupling" } },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/animation" } }
      }
    },
    "mechanismLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "vector3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "jointLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "number" },
        "upper": { "type": "number" }
      }
    },
    "joint": {
      "type": "object",
      "required": ["type", "parent", "child", "origin"],
      "properties": {
        "type": { "enum": ["fixed", "revolute", "prismatic", "cylindrical", "screw", "spherical", "planar"] },
        "parent": { "type": "string" },
        "child": { "type": "string" },
        "origin": { "$ref": "#/$defs/vector3" }
      },
      "oneOf": [
        { "properties": { "type": { "const": "fixed" } } },
        {
          "required": ["axis"],
          "properties": {
            "type": { "const": "revolute" },
            "axis": { "$ref": "#/$defs/vector3" },
            "limits": { "$ref": "#/$defs/jointLimits" }
          }
        },
        {
          "required": ["axis"],
          "properties": {
            "type": { "const": "prismatic" },
            "axis": { "$ref": "#/$defs/vector3" },
            "limits": { "$ref": "#/$defs/jointLimits" }
          }
        },
        {
          "required": ["axis"],
          "properties": {
            "type": { "const": "cylindrical" },
            "axis": { "$ref": "#/$defs/vector3" },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "angle": { "$ref": "#/$defs/jointLimits" },
                "distance": { "$ref": "#/$defs/jointLimits" }
              }
            }
          }
        },
        {
          "required": ["axis", "lead", "handedness"],
          "properties": {
            "type": { "const": "screw" },
            "axis": { "$ref": "#/$defs/vector3" },
            "lead": { "type": "number", "exclusiveMinimum": 0 },
            "handedness": { "enum": ["right", "left"] },
            "limits": { "$ref": "#/$defs/jointLimits" }
          }
        },
        {
          "properties": {
            "type": { "const": "spherical" },
            "limits": { "$ref": "#/$defs/jointLimits" }
          }
        },
        {
          "required": ["normal", "xAxis"],
          "properties": {
            "type": { "const": "planar" },
            "normal": { "$ref": "#/$defs/vector3" },
            "xAxis": { "$ref": "#/$defs/vector3" },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": { "$ref": "#/$defs/jointLimits" },
                "y": { "$ref": "#/$defs/jointLimits" },
                "angle": { "$ref": "#/$defs/jointLimits" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "coupling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "follower", "ratio"],
      "properties": {
        "driver": { "type": "string" },
        "follower": { "type": "string" },
        "ratio": { "type": "number", "not": { "const": 0 } },
        "offset": { "type": "number" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "duration", "keyframes"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "enum": ["none", "repeat", "pingPong"] },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time", "coordinates"],
            "properties": {
              "time": { "type": "number", "minimum": 0 },
              "coordinates": { "type": "object", "additionalProperties": { "type": "number" } }
            }
          }
        }
      }
    },
    "primitiveRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["nodeIndex", "meshIndex", "primitiveIndex"],
      "properties": {
        "nodeIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "meshIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "primitiveIndex": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "faceGroup": {
      "type": "object",
      "additionalProperties": true,
      "required": ["start", "count", "faceId"],
      "properties": {
        "start": { "$ref": "#/$defs/nonNegativeInteger" },
        "count": { "type": "integer", "minimum": 0, "multipleOf": 3 },
        "faceId": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "edgeGroup": {
      "type": "object",
      "additionalProperties": true,
      "required": ["start", "count", "edgeId"],
      "properties": {
        "start": { "$ref": "#/$defs/nonNegativeInteger" },
        "count": { "type": "integer", "minimum": 0, "multipleOf": 2 },
        "edgeId": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fidelity", "formats", "available"],
      "properties": {
        "fidelity": { "enum": ["mesh", "brep"] },
        "formats": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "available": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "kind", "selector"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "color": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 4,
          "maxItems": 4
        },
        "nodeIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "meshIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "parentId": { "type": "string", "minLength": 1 },
        "childIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "primitiveIndices": { "type": "array", "items": { "$ref": "#/$defs/nonNegativeInteger" } },
        "primitiveRefs": { "type": "array", "items": { "$ref": "#/$defs/primitiveRef" } },
        "faceGroups": { "type": "array", "items": { "$ref": "#/$defs/faceGroup" } },
        "edgeGroups": { "type": "array", "items": { "$ref": "#/$defs/edgeGroup" } },
        "sourceRefs": { "type": "object" },
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "hasPreciseTopology": { "type": "boolean" },
            "exports": { "type": "array", "items": { "$ref": "#/$defs/export" } }
          }
        }
      }
    }
  }
}
