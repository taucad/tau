{
  "name": "@taucad/native-process-core",
  "version": "0.1.0-beta.6",
  "description": "Shared native child-process lifecycle and workspace isolation primitives",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/core/native-process"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/core/native-process#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cad",
    "core",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./adopter": "./src/native-kernel-adopter.ts",
    "./store": "./src/store.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./adopter": {
        "types": "./dist/native-kernel-adopter.d.mts",
        "import": "./dist/native-kernel-adopter.mjs",
        "default": "./dist/native-kernel-adopter.mjs"
      },
      "./store": {
        "types": "./dist/store.d.mts",
        "import": "./dist/store.mjs",
        "default": "./dist/store.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "peerDependencies": {
    "@taucad/runtime": "^0.1.0-beta.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@taucad/runtime": "workspace:*",
    "@taucad/runtime-testing": "workspace:*",
    "zod": "catalog:"
  },
  "taucad": {
    "hostTarget": "node"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "catalog:"
  }
}
