{
  "name": "@taucad/project-core",
  "version": "0.1.0-beta.8",
  "description": "Tau project manifest schema and parsing",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/core/project"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/core/project#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cad",
    "core",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./revision-id": "./src/revision-id.ts",
    "./share-artifact": "./src/share-artifact.ts",
    "./share-direct": "./src/share-direct.ts",
    "./share-error": "./src/share-error.ts",
    "./share-locator": "./src/share-locator.ts",
    "./share-snapshot": "./src/share-snapshot.ts",
    "./package.json": "./package.json",
    "./identity": "./src/identity.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./revision-id": {
        "types": "./dist/revision-id.d.mts",
        "import": "./dist/revision-id.mjs",
        "default": "./dist/revision-id.mjs"
      },
      "./share-artifact": {
        "types": "./dist/share-artifact.d.mts",
        "import": "./dist/share-artifact.mjs",
        "default": "./dist/share-artifact.mjs"
      },
      "./share-direct": {
        "types": "./dist/share-direct.d.mts",
        "import": "./dist/share-direct.mjs",
        "default": "./dist/share-direct.mjs"
      },
      "./share-error": {
        "types": "./dist/share-error.d.mts",
        "import": "./dist/share-error.mjs",
        "default": "./dist/share-error.mjs"
      },
      "./share-locator": {
        "types": "./dist/share-locator.d.mts",
        "import": "./dist/share-locator.mjs",
        "default": "./dist/share-locator.mjs"
      },
      "./share-snapshot": {
        "types": "./dist/share-snapshot.d.mts",
        "import": "./dist/share-snapshot.mjs",
        "default": "./dist/share-snapshot.mjs"
      },
      "./package.json": "./package.json",
      "./identity": {
        "types": "./dist/identity.d.mts",
        "import": "./dist/identity.mjs",
        "default": "./dist/identity.mjs"
      }
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "taucad": {
    "hostTarget": "browser"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@taucad/xstate-testing": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  }
}
