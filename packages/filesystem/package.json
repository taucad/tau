{
  "name": "@taucad/filesystem",
  "version": "0.1.0-beta.1",
  "description": "Filesystem abstraction layer with watch-based reactivity for Tau (core / worker-facing; UI client facades live in @taucad/fs-client)",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/filesystem"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cad",
    "filesystem",
    "watch",
    "reactive"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend/index.ts",
    "./backend/node": "./src/backend/node/index.ts",
    "./composed-view": "./src/composed-view.ts",
    "./content-metadata": "./src/content-metadata.ts",
    "./path-registry": "./src/path-registry.ts",
    "./backend/stream-utils": "./src/backend/stream-utils.ts",
    "./content-ops": "./src/content-ops/index.ts",
    "./storage-root-key": "./src/storage-root-key.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./backend": {
        "types": "./dist/backend/index.d.mts",
        "import": "./dist/backend/index.mjs",
        "default": "./dist/backend/index.mjs"
      },
      "./backend/node": {
        "types": "./dist/backend/node/index.d.mts",
        "import": "./dist/backend/node/index.mjs",
        "default": "./dist/backend/node/index.mjs"
      },
      "./composed-view": {
        "types": "./dist/composed-view.d.mts",
        "import": "./dist/composed-view.mjs",
        "default": "./dist/composed-view.mjs"
      },
      "./content-metadata": {
        "types": "./dist/content-metadata.d.mts",
        "import": "./dist/content-metadata.mjs",
        "default": "./dist/content-metadata.mjs"
      },
      "./path-registry": {
        "types": "./dist/path-registry.d.mts",
        "import": "./dist/path-registry.mjs",
        "default": "./dist/path-registry.mjs"
      },
      "./backend/stream-utils": {
        "types": "./dist/backend/stream-utils.d.mts",
        "import": "./dist/backend/stream-utils.mjs",
        "default": "./dist/backend/stream-utils.mjs"
      },
      "./content-ops": {
        "types": "./dist/content-ops/index.d.mts",
        "import": "./dist/content-ops/index.mjs",
        "default": "./dist/content-ops/index.mjs"
      },
      "./storage-root-key": {
        "types": "./dist/storage-root-key.d.mts",
        "import": "./dist/storage-root-key.mjs",
        "default": "./dist/storage-root-key.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "nanoid": "catalog:",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@taucad/events": "workspace:*",
    "@taucad/memory": "workspace:*",
    "@taucad/nx": "workspace:*",
    "@taucad/types": "workspace:*",
    "@taucad/utils": "workspace:*",
    "fast-check": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/filesystem#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
