{
  "name": "@taucad/filesystem",
  "version": "0.1.0-beta.0",
  "description": "Filesystem abstraction layer with watch-based reactivity for Tau (core / worker-facing; UI client facades live in @taucad/fs-client)",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/filesystem"
  },
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cad",
    "filesystem",
    "watch",
    "reactive"
  ],
  "author": "Richard Fontein",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend/index.ts",
    "./bundled-types-mount": "./src/bundled-types-mount.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "default": "./dist/esm/index.js"
      },
      "./backend": {
        "types": "./dist/esm/backend/index.d.ts",
        "import": "./dist/esm/backend/index.js",
        "default": "./dist/esm/backend/index.js"
      },
      "./bundled-types-mount": {
        "types": "./dist/esm/bundled-types-mount.d.ts",
        "import": "./dist/esm/bundled-types-mount.js",
        "default": "./dist/esm/bundled-types-mount.js"
      }
    }
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/events": "workspace:*",
    "@taucad/memory": "workspace:*",
    "@taucad/types": "workspace:*",
    "@taucad/utils": "workspace:*",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "vitest": "4.1.5"
  }
}
