{
  "name": "filesystem",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/filesystem",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "test:authority-writer": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --config vitest.config.ts src/backend/node/authority-writer-lock.test.ts src/backend/node/authority-writer-host.test.ts src/backend/node/provider.test.ts --typecheck.enabled=false"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsdown",
        "cwd": "{projectRoot}"
      }
    }
  }
}
