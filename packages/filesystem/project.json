{
  "name": "filesystem",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/filesystem",
  "projectType": "library",
  "tags": ["scope:shared", "type:package", "ci:windows-unit"],
  "targets": {
    "test:authority-writer": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --config vitest.config.ts src/backend/node/authority-writer-lock.test.ts src/backend/node/authority-writer-host.test.ts src/backend/node/provider.test.ts --typecheck.enabled=false"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsdown",
        "cwd": "{projectRoot}"
      }
    },
    "formal:wide": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "The nightly-tier TLA+ configs under specs/ (DiscoveryIndex target-lost-wide), run on the schedule by formal-nightly.yml. Not named formal:nightly, which ci.yml runs in the merge queue for every affected project."
      },
      "options": {
        "command": "node tools/formal/src/cli.ts check --tier nightly packages/filesystem"
      }
    }
  }
}
