+                                                     double theRequestTolerance)
+    : myFace(theFace),
+      myFaceTolerance(0.0),
+      myRequestTolerance(theRequestTolerance)
+{
+}
+
+BRepExtrema_PreparedFaceCF::~BRepExtrema_PreparedFaceCF() = default;
+
+bool BRepExtrema_PreparedFaceCF::Matches(const TopoDS_Face& theFace,
+                                        double theRequestTolerance) const
+{
+  return myFace.IsEqual(theFace) &&
+         (mySurface.IsNull() ||
+          myFaceTolerance == BRep_Tool::Tolerance(theFace)) &&
+         myRequestTolerance == theRequestTolerance;
+}
