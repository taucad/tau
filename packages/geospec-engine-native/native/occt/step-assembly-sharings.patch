+// Returns the product definition of the first SDR (exact type) that uses theRep.
+// Walks the graph's sharing list in place: Interface_Graph::Sharings() copies it,
+// which is quadratic when every NAUO of a widely instanced part checks its rep.
+static occ::handle<StepBasic_ProductDefinition> sdrProductDefinition(
+  const Interface_Graph&                      theGraph,
+  const occ::handle<StepRepr_Representation>& theRep)
+{
+  const int aNum = theGraph.EntityNumber(theRep);
+  if (aNum <= 0)
+  {
+    return nullptr;
+  }
+  const occ::handle<Standard_Type> tSDR = STANDARD_TYPE(StepShape_ShapeDefinitionRepresentation);
+  for (NCollection_List<int>::Iterator anIter(theGraph.SharingTable()->Value(aNum)); anIter.More();
+       anIter.Next())
+  {
+    const occ::handle<Standard_Transient>& enti = theGraph.Entity(anIter.Value());
+    if (enti->DynamicType() == tSDR)
+    {
+      occ::handle<StepShape_ShapeDefinitionRepresentation> SDR =
+        occ::down_cast<StepShape_ShapeDefinitionRepresentation>(enti);
+      if (SDR->UsedRepresentation() == theRep)
+      {
+        const occ::handle<StepRepr_PropertyDefinition> aPD = SDR->Definition().PropertyDefinition();
+        if (aPD)
+        {
+          occ::handle<StepBasic_ProductDefinition> aProductDefinition =
+            aPD->Definition().ProductDefinition();
+          if (!aProductDefinition.IsNull())
+          {
+            return aProductDefinition;
+          }
+        }
+      }
+    }
+  }
+  return nullptr;
+}
