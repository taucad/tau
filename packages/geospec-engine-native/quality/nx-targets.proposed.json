{
  "check-coverage-gate": {
    "executor": "nx:run-commands",
    "cache": false,
    "options": {
      "cwd": ".",
      "command": "python3 -B packages/geospec-engine-native/quality/test_gate.py"
    }
  },
  "coverage-critical": {
    "executor": "nx:run-commands",
    "cache": false,
    "options": {
      "cwd": ".",
      "command": "python3 -B packages/geospec-engine-native/quality/gate.py --inventory-sha256 \"$GEOSPEC_COVERAGE_INVENTORY_SHA256\" --receipts out/reports/coverage/packages/geospec-engine-native/receipts.json"
    }
  }
}
