{
  "name": "@taucad/geospec-engine",
  "version": "0.1.0-beta.1",
  "description": "GeoSpec CLI and Node worker-pool host for the compiled GeoSpec engine",
  "type": "module",
  "sideEffects": [
    "./src/cli/main.ts",
    "./dist/cli/main.mjs",
    "./src/runner/node/native-pool-worker-entry.ts",
    "./dist/runner/node/native-pool-worker-entry.mjs"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/geospec-engine"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/geospec-engine#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "provenance.schema.json",
    "provenance.json"
  ],
  "keywords": [
    "cad",
    "geospec",
    "typescript"
  ],
  "bin": {
    "geospec": "./dist/cli/main.mjs"
  },
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./node-filesystem": "./src/runner/node/node-vm-filesystem.ts",
    "./native-pool/node": "./src/runner/node/native-pool-runner.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      "./node-filesystem": {
        "types": "./dist/runner/node/node-vm-filesystem.d.mts",
        "import": "./dist/runner/node/node-vm-filesystem.mjs",
        "default": "./dist/runner/node/node-vm-filesystem.mjs"
      },
      "./native-pool/node": {
        "types": "./dist/runner/node/native-pool-runner.d.mts",
        "import": "./dist/runner/node/native-pool-runner.mjs",
        "default": "./dist/runner/node/native-pool-runner.mjs"
      }
    }
  },
  "imports": {
    "#experiments/*.js": "./experiments/*.ts",
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/assimp": "workspace:*",
    "@taucad/brep": "workspace:*",
    "@taucad/esbuild": "workspace:*",
    "@taucad/geospec-engine-native": "workspace:*",
    "@taucad/gltf": "workspace:*",
    "@taucad/image": "workspace:*",
    "@taucad/jscad": "workspace:*",
    "@taucad/manifold": "workspace:*",
    "@taucad/middleware": "workspace:*",
    "@taucad/opencascade": "workspace:*",
    "@taucad/openrscad": "workspace:*",
    "@taucad/picovoxel": "workspace:*",
    "@taucad/replicad": "workspace:*",
    "@taucad/rhino": "workspace:*",
    "@taucad/runtime": "workspace:*",
    "@taucad/tscircuit": "workspace:*",
    "geospec": "workspace:*"
  },
  "devDependencies": {
    "@taucad/picogk": "workspace:*",
    "vitest": "catalog:"
  },
  "scripts": {
    "prepack": "node scripts/generate-provenance.mjs"
  },
  "peerDependencies": {
    "@taucad/picogk": "^0.1.0-beta.0"
  },
  "peerDependenciesMeta": {
    "@taucad/picogk": {
      "optional": true
    }
  }
}
