{
  "name": "geospec-engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/geospec-engine",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "build": {
      "options": {
        "command": "node --max-old-space-size=4096 ../../node_modules/tsdown/dist/run.mjs"
      }
    },
    "generate-provenance": {
      "command": "node scripts/generate-provenance.mjs",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"],
      "cache": false
    },
    "pkgcheck": {
      "dependsOn": ["generate-provenance", "^build", "pkgcheck-deps"]
    }
  }
}
