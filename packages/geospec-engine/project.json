{
  "name": "geospec-engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/geospec-engine",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "generate-provenance": {
      "command": "node scripts/generate-provenance.mjs",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"],
      "cache": false
    },
    "pkgcheck": {
      "dependsOn": ["generate-provenance", "^build", "pkgcheck-deps"]
    },
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/packages/geospec/agent/doctrine.md"]
    }
  }
}
