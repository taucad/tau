{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "composite": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/importMeta", "vitest"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "target": "ESNext"
  },
  "include": [
    "vitest.config.ts",
    "experiments/performance-lab/*.ts",
    "scripts/coverage-source-policy.test.mts",
    "scripts/generate-provenance.mjs",
    "tsdown.config.ts",
    "src/cli/cli.test.ts",
    "src/cli/cli.ts",
    "src/cli/main.ts",
    "src/cli/node-host-selection.test.ts",
    "src/cli/node-host.test.ts",
    "src/cli/node-host.ts",
    "src/cli/wire-value.test.ts",
    "src/cli/wire-value.ts",
    "src/model/default-runtime.test.ts",
    "src/model/default-runtime.ts",
    "src/package-metadata.test.ts",
    "src/provenance-script.test.ts",
    "src/runner/events.test.ts",
    "src/runner/events.ts",
    "src/runner/forensic.test.ts",
    "src/runner/forensic.ts",
    "src/runner/node/native-pool-runner.test.ts",
    "src/runner/node/native-pool-runner.ts",
    "src/runner/node/native-pool-worker-entry.test.ts",
    "src/runner/node/native-pool-worker-entry.ts",
    "src/runner/node/node-vm-filesystem.test.ts",
    "src/runner/node/node-vm-filesystem.ts",
    "src/runner/pool/pool.test.ts",
    "src/runner/pool/pool.ts",
    "src/runner/pool/shard-planner.test.ts",
    "src/runner/pool/shard-planner.ts",
    "src/runner/pool/timings.test.ts",
    "src/runner/pool/timings.ts",
    "src/runner/pool/transport.ts",
    "src/runner/pool/worker-host.test.ts",
    "src/runner/pool/worker-host.ts",
    "src/runner/serial.test.ts",
    "src/runner/serial.ts",
    "src/runner/testing/memory-filesystem.ts",
    "src/runner/types.ts"
