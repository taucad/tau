{
  "name": "geospec",
  "version": "0.1.0-beta.1",
  "description": "Geometry specification API for CAD models: DSL, selector language, diagnostics schema, and the native runner integration",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/geospec"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/geospec#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "agent",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cad",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agent/*": "./agent/*",
    "./engine": "./src/engine/index.ts",
    "./mesh": "./src/mesh/index.ts",
    "./model": "./src/model/index.ts",
    "./runner": "./src/runner/index.ts",
    "./runner/native": "./src/runner/native/index.ts",
    "./runner/worker": "./src/runner/worker/index.ts",
    "./package.json": "./package.json",
    "./assertion-client": "./src/assertion-client/index.ts",
    "./vitest": "./src/vitest/index.ts",
    "./config": "./src/config/index.ts",
    "./config/node": "./src/config/node/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./agent/*": "./agent/*",
      "./engine": {
        "types": "./dist/engine/index.d.mts",
        "import": "./dist/engine/index.mjs",
        "default": "./dist/engine/index.mjs"
      },
      "./mesh": {
        "types": "./dist/mesh/index.d.mts",
        "import": "./dist/mesh/index.mjs",
        "default": "./dist/mesh/index.mjs"
      },
      "./model": {
        "types": "./dist/model/index.d.mts",
        "import": "./dist/model/index.mjs",
        "default": "./dist/model/index.mjs"
      },
      "./runner": {
        "types": "./dist/runner/index.d.mts",
        "import": "./dist/runner/index.mjs",
        "default": "./dist/runner/index.mjs"
      },
      "./runner/native": {
        "types": "./dist/runner/native/index.d.mts",
        "import": "./dist/runner/native/index.mjs",
        "default": "./dist/runner/native/index.mjs"
      },
      "./runner/worker": {
        "types": "./dist/runner/worker/index.d.mts",
        "import": "./dist/runner/worker/index.mjs",
        "default": "./dist/runner/worker/index.mjs"
      },
      "./package.json": "./package.json",
      "./assertion-client": {
        "types": "./dist/assertion-client/index.d.mts",
        "import": "./dist/assertion-client/index.mjs",
        "default": "./dist/assertion-client/index.mjs"
      },
      "./vitest": {
        "types": "./dist/vitest/index.d.mts",
        "import": "./dist/vitest/index.mjs",
        "default": "./dist/vitest/index.mjs"
      },
      "./config": {
        "types": "./dist/config/index.d.mts",
        "import": "./dist/config/index.mjs",
        "default": "./dist/config/index.mjs"
      },
      "./config/node": {
        "types": "./dist/config/node/index.d.mts",
        "import": "./dist/config/node/index.mjs",
        "default": "./dist/config/node/index.mjs"
      }
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/esbuild": "workspace:*",
    "@taucad/project-core": "workspace:*",
    "@taucad/runtime": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gltf-transform/core": "catalog:"
  },
  "tau": {
    "skills": "./agent/skills.json"
  },
  "peerDependencies": {
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
