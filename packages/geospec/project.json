{
  "name": "geospec",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/geospec",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "test-m3-corpus": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test packages/geospec/host-tests/m3-corpus/corpus.test.mjs packages/geospec/host-tests/m3-corpus/profile-v3.test.mjs"
      }
    },
    "test-m3-installed-delivery": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 \"${GEOSPEC_M3_DELIVERY_DRIVER:?}\"",
        "forwardAllArgs": false
      }
    },
    "test-m3-independent-bindings": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test packages/geospec/host-tests/m3-corpus/independent-bindings.test.mjs",
        "forwardAllArgs": false
      }
    },
    "test-m3-verdicts": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node --test packages/geospec/host-tests/m2-browser/verdict-host.mjs",
          "node --test packages/geospec/host-tests/m3-corpus/verdict-host.mjs",
          "python3 -B packages/geospec/host-tests/m3-corpus/verdict_host_check.py"
        ],
        "parallel": false,
        "forwardAllArgs": false
      }
    }
  }
}
