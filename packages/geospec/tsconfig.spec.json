{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["node", "vitest/importMeta", "vitest"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "target": "ESNext",
    "paths": {
      "#experiments/*": ["./experiments/*"],
      "#*": ["./src/*"]
    }
  },
  "include": [
    "vitest.config.ts",
    "vitest.setup.ts",
    "tsdown.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test-d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "experiments/**/*.ts",
    "src/**/*.js",
    "src/**/*.jsx"
  ]
}
