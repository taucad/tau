{
  "name": "host",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/host",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "test:acp-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "One real tool turn through each selected pinned ACP adapter, against the operator's own Codex and Claude logins. Kept off the default test target because it spends their quota; a selected unavailable adapter fails explicitly."
      },
      "options": {
        "cwd": "{workspaceRoot}/packages/host",
        "command": "../../node_modules/.bin/vitest run --config vitest.config.ts src/acp/acp-live.integration.test.ts",
        "env": {
          "TAU_ACP_LIVE": "1"
        }
      }
    }
  }
}
