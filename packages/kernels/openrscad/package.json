{
  "name": "@taucad/openrscad",
  "version": "0.1.0-beta.0",
  "description": "OpenRSCAD Rust WebAssembly kernel for OpenSCAD language models",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/kernels/openrscad"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cad",
    "kernel",
    "openrscad"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./kernel": "./src/openrscad.kernel.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./kernel": {
        "types": "./dist/openrscad.kernel.d.mts",
        "import": "./dist/openrscad.kernel.mjs",
        "default": "./dist/openrscad.kernel.mjs"
      }
    }
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taulabs/openrscad-engine": "catalog:",
    "@taucad/runtime": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "jsdom": "catalog:",
    "jszip": "^3.10.1"
  }
}
