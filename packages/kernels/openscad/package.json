{
  "name": "@taucad/openscad",
  "version": "0.1.0-beta.0",
  "description": "OpenSCAD kernel for @taucad/runtime (GPL-2.0-or-later)",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/kernels/openscad"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cad",
    "openscad",
    "kernel",
    "wasm",
    "gpl"
  ],
  "author": "Richard Fontein",
  "license": "GPL-2.0-or-later",
  "exports": {
    ".": "./src/index.ts",
    "./kernel": "./src/openscad.kernel.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./kernel": {
        "types": "./dist/openscad.kernel.d.mts",
        "import": "./dist/openscad.kernel.mjs",
        "default": "./dist/openscad.kernel.mjs"
      }
    }
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "json-schema-default": "catalog:",
    "manifold-3d": "catalog:",
    "openscad-wasm-prebuilt": "catalog:"
  },
  "devDependencies": {
    "@taucad/runtime": "workspace:*",
    "geist": "catalog:"
  },
  "peerDependencies": {
    "@taucad/runtime": "workspace:^"
  }
}
