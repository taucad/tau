{
  "name": "@taucad/native-kernels",
  "version": "0.1.0-beta.6",
  "description": "The roster of native Tau kernels: adopters, plugin manifests and host-neutral payload-store composition",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/native-kernels"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/native-kernels#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cad",
    "native",
    "kernel",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./manifest": {
        "types": "./dist/manifest.d.mts",
        "import": "./dist/manifest.mjs",
        "default": "./dist/manifest.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "import": "./dist/node.mjs",
        "default": "./dist/node.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/build123d": "workspace:*",
    "@taucad/native-process-core": "workspace:*",
    "@taucad/picogk": "workspace:*"
  },
  "peerDependencies": {
    "@taucad/runtime": "^0.1.0-beta.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@taucad/runtime": "workspace:*",
    "@taucad/types": "workspace:*",
    "zod": "catalog:"
  },
  "taucad": {
    "hostTarget": "node"
  }
}
