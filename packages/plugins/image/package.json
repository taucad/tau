{
  "name": "@taucad/image",
  "version": "0.1.0-beta.0",
  "description": "Image import and export toolkit for @taucad/runtime",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/plugins/image"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/plugins/image#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cad",
    "plugin",
    "image"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./label": "./src/label.ts",
    "./svg": "./src/svg.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./label": {
        "types": "./dist/label.d.mts",
        "import": "./dist/label.mjs",
        "default": "./dist/label.mjs"
      },
      "./svg": {
        "types": "./dist/svg.d.mts",
        "import": "./dist/svg.mjs",
        "default": "./dist/svg.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "peerDependencies": {
    "@taucad/runtime": "^0.1.0-beta.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "nanoraster": "^0.4.1"
  },
  "devDependencies": {
    "@taucad/runtime": "workspace:*",
    "geist": "catalog:",
    "vite": "catalog:",
    "vitest-mock-extended": "catalog:",
    "zod": "catalog:"
  },
  "taucad": {
    "hostTarget": "browser"
  }
}
