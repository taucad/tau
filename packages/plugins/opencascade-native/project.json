{
  "name": "opencascade-native",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugins/opencascade-native",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "prepare-native": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/prepare-native.mjs",
        "{projectRoot}/rust/**/*",
        { "runtime": "node -p \"process.platform + '-' + process.arch\"" }
      ],
      "outputs": ["{projectRoot}/src/native/opencascade-native.node"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node prepare-native.mjs"
      }
    },
    "test": {
      "dependsOn": ["prepare-native"],
      "cache": false
    },
    "build": {
      "dependsOn": ["prepare-native"],
      "cache": false
    }
  }
}
