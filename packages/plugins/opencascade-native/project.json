{
  "name": "opencascade-native",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugins/opencascade-native",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "prepare-native": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node prepare-native.mjs"
      }
    },
    "test": {
      "dependsOn": ["prepare-native"],
      "cache": false
    },
    "build": {
      "dependsOn": ["prepare-native"],
      "cache": false
    }
  }
}
