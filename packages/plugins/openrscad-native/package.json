{
  "name": "@taucad/openrscad-native",
  "version": "0.1.0-beta.0",
  "description": "Native N-API OpenRSCAD kernel for Node hosts — same artifacts as @taucad/openrscad, without the WebAssembly startup cost",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/plugins/openrscad-native"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/plugins/openrscad-native#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cad",
    "plugin",
    "openrscad",
    "openscad",
    "napi",
    "native"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "peerDependencies": {
    "@taucad/runtime": "^0.1.0-beta.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@taucad/runtime": "workspace:*",
    "@taucad/runtime-testing": "workspace:*",
    "zod": "catalog:"
  },
  "taucad": {
    "hostTarget": "node"
  },
  "dependencies": {
    "@taucad/openrscad": "workspace:*",
    "@taulabs/openrscad-engine": "catalog:",
    "@taulabs/openrscad-engine-native": "link:../../../repos/openrscad/packages/npm-native"
  }
}
