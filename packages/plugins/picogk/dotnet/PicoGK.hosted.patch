+// SPDX-License-Identifier: Apache-2.0
+using System.Buffers.Binary;
+namespace PicoGK;
+// Validation only: the worker's existing PrototypeLayout remains the geometry owner.
+internal static class TauComputeLayoutBytes
+{
+    internal const int Header=64;
+    internal static int[] Validate(ReadOnlySpan<byte> bytes,ulong maximum)
+    {
+        if(bytes.Length<Header||(ulong)bytes.Length>maximum||!bytes[..8].SequenceEqual("PKLAY001"u8)||BinaryPrimitives.ReadUInt32LittleEndian(bytes[8..])!=1)
+            throw new ArgumentException("Compute layout version/length.");
+        var flags=BinaryPrimitives.ReadUInt32LittleEndian(bytes[12..]);if(flags>1)throw new ArgumentException("Compute layout flags.");
+        var lengths=new int[6];long values=0;
+        for(int i=0;i<6;i++){var count=BinaryPrimitives.ReadUInt32LittleEndian(bytes[(16+i*4)..]);if(count>int.MaxValue)throw new ArgumentException("Compute layout count.");lengths[i]=(int)count;values+=count;}
+        if(Header+values*4!=bytes.Length||lengths[0]%3!=0||lengths[1]!=lengths[0]||lengths[2]%3!=0||(lengths[3]!=0&&lengths[3]!=lengths[0]/3)||(lengths[4]!=0&&lengths[4]!=lengths[0]/3*2)||(lengths[5]!=0&&lengths[5]!=lengths[0]/3*4))throw new ArgumentException("Compute layout array shape.");
+        if(flags==0&&!bytes.Slice(40,24).SequenceEqual(new byte[24]))throw new ArgumentException("Compute layout unused stability.");
+        if(flags==1){for(int i=0;i<6;i++){var bits=BinaryPrimitives.ReadInt32LittleEndian(bytes[(40+i*4)..]);if(i==4){if(bits<0)throw new ArgumentException("Compute layout fan count.");}
+            else{var value=BitConverter.Int32BitsToSingle(bits);if(float.IsNaN(value)||value<0)throw new ArgumentException("Compute layout stability value.");}}}
+        var offset=Header;
+        for(int array=0;array<6;array++)for(int i=0;i<lengths[array];i++,offset+=4) {
+            var bits=BinaryPrimitives.ReadUInt32LittleEndian(bytes[offset..]);
+            if(array==2){if(bits>=lengths[0]/3)throw new ArgumentException("Compute layout topology index.");}
+            else if(array==3){if(bits>int.MaxValue)throw new ArgumentException("Compute layout source index.");}
+            else if(!float.IsFinite(BitConverter.UInt32BitsToSingle(bits)))throw new ArgumentException("Compute layout nonfinite geometry.");
+        }
+        return lengths;
+    }
+}
