+// SPDX-License-Identifier: Apache-2.0
+using System.Runtime.InteropServices;
+namespace PicoGK;
+public partial class Voxels
+{
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauVoxels_IsEmpty")]
+    private static extern int TauIsEmptyNative(LibHandle library, VoxHandle voxels, out int output);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauVoxels_IsEqual")]
+    private static extern int TauIsEqualNative(LibHandle library, VoxHandle voxels, VoxHandle other, out int output);
+    private bool TauIsEmpty()
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        try
+        {
+            var status = TauIsEmptyNative(lib.hThis, hThis, out var output);
+            TauCheckedCallbacks.Check(status, null, this);
+            return output != 0;
+        }
+        finally { GC.KeepAlive(this); }
+    }
+    private bool TauIsEqual(Voxels other)
+    {
+        ArgumentNullException.ThrowIfNull(other);
+        if (other.lib.hThis != lib.hThis) throw new PicoGKLibraryMismatchException();
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        ObjectDisposedException.ThrowIf(other.m_bDisposed, other);
+        try
+        {
+            var status = TauIsEqualNative(lib.hThis, hThis, other.hThis, out var output);
+            TauCheckedCallbacks.Check(status, null, this);
+            return output != 0;
+        }
+        finally { GC.KeepAlive(this); GC.KeepAlive(other); }
+    }
+}
