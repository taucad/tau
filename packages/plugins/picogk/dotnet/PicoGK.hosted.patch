+// SPDX-License-Identifier: Apache-2.0
+using System.Runtime.InteropServices;
+namespace PicoGK;
+public partial class Library
+{
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauLibrary_GetOwnedMemory")]
+    private static extern int TauOwnedMemoryNative(LibHandle library, int category, out long bytes);
+
+    private long TauOwnedMemoryBytes(int category)
+    {
+        var status = TauOwnedMemoryNative(hThis, category, out long bytes);
+        TauCheckOwnedMemoryStatus(status);
+        return bytes;
+    }
+
+    internal static void TauCheckOwnedMemoryStatus(int status, string owner = nameof(Library))
+    {
+        if (status == 0) return;
+        if (status == -3) throw new ObjectDisposedException(owner);
+        if (status == -1) throw new ArgumentException("Invalid owned-memory query or byte-count overflow.");
+        throw new InvalidOperationException($"Native owned-memory snapshot failed (status {status}).");
+    }
+}
+public partial class Voxels
+{
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauVoxels_GetOwnedMemory")]
+    private static extern int TauOwnedMemoryNative(LibHandle library, VoxHandle voxels, out long bytes);
+}
