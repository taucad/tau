         Queue<IViewerAction> m_oActions = new();
 
+        void EnqueueNativeAction(IViewerAction action)
+        {
+            try
+            {
+                lock (m_oActions)
+                {
+                    ObjectDisposedException.ThrowIf(m_bDisposed, this);
+                    m_oActions.Enqueue(action);
+                }
+            }
+            catch
+            {
+                if (action is AddGeometryAction captured) captured.Dispose();
+                throw;
+            }
+        }
+
+        System.Runtime.ExceptionServices.ExceptionDispatchInfo? ReleaseNativeActions()
+        {
+            System.Runtime.ExceptionServices.ExceptionDispatchInfo? failure = null;
+            while (m_oActions.Count > 0)
+            {
+                if (m_oActions.Dequeue() is not AddGeometryAction captured) continue;
+                try { captured.Dispose(); }
+                catch (Exception error) { failure ??= System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(error); }
+            }
+            return failure;
+        }
+
+        void ExecuteNativeAction(IViewerAction action)
+        {
+            System.Runtime.ExceptionServices.ExceptionDispatchInfo? failure = null;
+            try { action.Do(this); }
+            catch (Exception error) { failure = m_tauCallbackFailure ?? System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(error); }
+            failure ??= m_tauCallbackFailure;
+            if (action is AddGeometryAction captured)
+            {
+                try { captured.Dispose(); }
+                catch (Exception error) { failure ??= System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(error); }
+            }
+            if (failure is not null)
+            {
+                ReleaseNativeActions();
+                failure.Throw();
+            }
+        }
