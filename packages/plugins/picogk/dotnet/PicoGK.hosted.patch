+    }
+
+    private static string TauCsgOperation(int operation)=>operation switch {0=>"voxels.union",1=>"voxels.difference",2=>"voxels.intersection",_=>throw new ArgumentOutOfRangeException(nameof(operation))};
+    private void TauMutateCsg(Voxels operand,int operation)
+    {
+        if(lib.TauComputeReuse is {} reuse)reuse.MutateVoxels(new(TauCsgOperation(operation),"{}"),new[]{this,operand},()=>TauMutateCsgNativeOnly(operand,operation),expected=>TauMutateQualified(operand,operation,0,0,expected));
