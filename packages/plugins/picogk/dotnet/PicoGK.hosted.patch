+    }
+    private Voxels TauCreateCsg(Voxels operand,int operation)=>lib.TauComputeReuse is {} reuse?
+        reuse.EvaluateVoxels(new(TauCsgOperation(operation),"{}"),new[]{this,operand},()=>TauCreateCsgNativeOnly(operand,operation)):
