+using System.Buffers.Binary;
+using System.Security.Cryptography;
+using System.Text;
+namespace PicoGK;
+internal static class TauComputeStoredCodec
+{
+    internal const int HeaderBytes=64;
+    private static ReadOnlySpan<byte> Magic=>"PKC00001"u8;
+    private static uint Family(string codec)=>codec switch{"picogk.vdb-stream"=>0,"picogk.indexed-mesh"=>1,"picogk.bool"=>2,"picogk.layout"=>3,_=>throw new ArgumentException("Unknown private stored codec.")};
+    internal static byte[] Pack(byte[] body,string codec,ulong allowance,ulong maximumEncoded)
+    {
+        if((ulong)body.LongLength>maximumEncoded||maximumEncoded-(ulong)body.LongLength<HeaderBytes||body.LongLength+HeaderBytes>Array.MaxLength)
+            throw new ArgumentException("Stored compute envelope exceeds byte budget.");
+        if((codec is "picogk.bool" or "picogk.layout")&&allowance!=0)throw new ArgumentException("Boolean native allowance must be zero.");
+        var bytes=new byte[checked(body.Length+HeaderBytes)];Magic.CopyTo(bytes);
+        BinaryPrimitives.WriteUInt32LittleEndian(bytes.AsSpan(8),Family(codec));
+        BinaryPrimitives.WriteUInt64LittleEndian(bytes.AsSpan(16),(ulong)body.LongLength);
+        BinaryPrimitives.WriteUInt64LittleEndian(bytes.AsSpan(24),allowance);
+        SHA256.HashData(body).CopyTo(bytes,32);body.CopyTo(bytes,HeaderBytes);return bytes;
+    }
+    internal static (ReadOnlyMemory<byte> Body,ulong Allowance) Read(byte[] bytes,string codec,ulong maximumEncoded,ulong maximumNative)
+    {
+        if(bytes.Length<HeaderBytes||(ulong)bytes.LongLength>maximumEncoded||!bytes.AsSpan(0,8).SequenceEqual(Magic))throw new ArgumentException("Private stored envelope version/length.");
+        var data=bytes.AsSpan();var size=BinaryPrimitives.ReadUInt64LittleEndian(data[16..]);var native=BinaryPrimitives.ReadUInt64LittleEndian(data[24..]);
+        if(BinaryPrimitives.ReadUInt32LittleEndian(data[8..])!=Family(codec)||BinaryPrimitives.ReadUInt32LittleEndian(data[12..])!=0||size!=(ulong)(bytes.Length-HeaderBytes)||native>maximumNative||((codec is "picogk.bool" or "picogk.layout")&&native!=0))throw new ArgumentException("Private stored envelope flags/allowance.");
+        var body=bytes.AsMemory(HeaderBytes);var hash=SHA256.HashData(body.Span);
+        if(!hash.AsSpan().SequenceEqual(data.Slice(32,32)))throw new ArgumentException("Private stored envelope semantic SHA.");return (body,native);
+    }
+}
