+// SPDX-License-Identifier: Apache-2.0
+using System.Runtime.InteropServices;
+namespace PicoGK;
+
+[StructLayout(LayoutKind.Sequential)]
+internal struct TauSliceInfo
+{
+    internal int XOrigin, YOrigin, ZOrigin, XSize, YSize, ZSize, Width, Height;
+    internal float Background;
+    internal ulong Required;
+}
+internal static class TauSliceRead
+{
+    internal static ImageGrayScale Allocate(int width, int height)
+    {
+        var required = (long)width * height;
+        if (width < 0 || height < 0 || required > Array.MaxLength)
+            throw new ArgumentException("PicoGK slice capacity exceeds the managed array range.");
+        return new ImageGrayScale(new TauSliceInfo { Width = width, Height = height }, new float[checked((int)required)]);
+    }
+    internal static TauSliceInfo Fill(object owner, int mode, int slice, float fractionalSlice, ref ImageGrayScale image)
+    {
+        ArgumentNullException.ThrowIfNull(image);
+        var original = image;
+        var values = image.m_afValues;
+        ArgumentNullException.ThrowIfNull(values);
+        while (true)
+        {
+            TauSliceInfo info;
+            int status;
+            var pinned = GCHandle.Alloc(values, GCHandleType.Pinned);
+            try
+            {
+                status = owner switch
+                {
+                    Voxels voxels => voxels.TauReadSlice(mode, slice, fractionalSlice, pinned.AddrOfPinnedObject(), (ulong)values.LongLength, out info),
+                    ScalarField field => field.TauReadSlice(slice, pinned.AddrOfPinnedObject(), (ulong)values.LongLength, out info),
+                    _ => throw new ArgumentException("Unsupported PicoGK slice owner.", nameof(owner))
+                };
+            }
+            finally { pinned.Free(); }
+            if (status == 1)
+            {
+                if (info.Required <= (ulong)values.LongLength || info.Required > (ulong)Array.MaxLength)
+                    throw new ArgumentException("PicoGK slice capacity exceeds the managed array range.");
+                values = new float[checked((int)info.Required)];
+                continue;
+            }
+            TauCheckedCallbacks.Check(status, null, owner);
+            if (info.Width < 0 || info.Height < 0 || info.Required != (ulong)info.Width * (ulong)info.Height ||
+                info.Required > (ulong)values.LongLength)
+                throw new InvalidOperationException("PicoGK returned inconsistent slice dimensions.");
+            if (original.nWidth != info.Width || original.nHeight != info.Height ||
+                !ReferenceEquals(original.m_afValues, values))
+                image = new ImageGrayScale(info, values);
+            return info;
+        }
+    }
+}
+public abstract partial class Image
+{
+    // Internal slice adoption permits an empty image; authored constructors retain their validation.
+    internal Image(TauSliceInfo dimensions)
+    {
+        if (dimensions.Width < 0 || dimensions.Height < 0)
+            throw new ArgumentOutOfRangeException(nameof(dimensions));
+        nWidth = dimensions.Width;
+        nHeight = dimensions.Height;
+        eType = EType.GRAY;
+    }
+}
+public abstract partial class ImageGrayscaleAbstract
+{
+    internal ImageGrayscaleAbstract(TauSliceInfo dimensions) : base(dimensions) { }
+}
+public partial class ImageGrayScale
+{
+    // A coherent read may change dimensions while retaining sufficient caller-owned capacity.
+    internal ImageGrayScale(TauSliceInfo dimensions, float[] values) : base(dimensions)
+    {
+        m_afValues = values;
+    }
+}
+public partial class Voxels
+{
+    [DllImport(Config.strPicoGKLib, CallingConvention=CallingConvention.Cdecl, EntryPoint="TauVoxels_ReadSlice")]
+    private static extern int TauReadSliceNative(LibHandle library, VoxHandle voxels, int mode,
+        int slice, float fractionalSlice, IntPtr buffer, ulong capacity, out TauSliceInfo info);
+    private TauSliceInfo TauDimensions()
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        try
+        {
+            var status = TauReadSliceNative(lib.hThis, hThis, -1, 0, 0, IntPtr.Zero, 0, out var info);
+            TauCheckedCallbacks.Check(status, null, this);
+            return info;
+        }
+        finally { GC.KeepAlive(this); }
+    }
+    internal int TauReadSlice(int mode, int slice, float fractionalSlice, IntPtr buffer, ulong capacity, out TauSliceInfo info)
+        => TauReadSliceNative(lib.hThis, hThis, mode, slice, fractionalSlice, buffer, capacity, out info);
+    private TauSliceInfo TauFillSlice(int mode, int slice, float fractionalSlice, ref ImageGrayScale image)
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        try { return TauSliceRead.Fill(this, mode, slice, fractionalSlice, ref image); }
+        finally { GC.KeepAlive(this); }
+    }
+}
+public partial class ScalarField
+{
+    [DllImport(Config.strPicoGKLib, CallingConvention=CallingConvention.Cdecl, EntryPoint="TauScalarField_ReadSlice")]
+    private static extern int TauReadSliceNative(LibHandle library, ScalarFieldHandle field, int mode,
+        int slice, IntPtr buffer, ulong capacity, out TauSliceInfo info);
+    private TauSliceInfo TauDimensions()
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        try
+        {
+            var status = TauReadSliceNative(lib.hThis, hThis, -1, 0, IntPtr.Zero, 0, out var info);
+            TauCheckedCallbacks.Check(status, null, this);
+            return info;
+        }
+        finally { GC.KeepAlive(this); }
+    }
+    internal int TauReadSlice(int slice, IntPtr buffer, ulong capacity, out TauSliceInfo info)
+        => TauReadSliceNative(lib.hThis, hThis, 2, slice, buffer, capacity, out info);
+    private void TauFillSlice(int slice, ref ImageGrayScale image)
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        try { TauSliceRead.Fill(this, 2, slice, 0, ref image); }
+        finally { GC.KeepAlive(this); }
+    }
+}
