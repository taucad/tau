diff --git a/Library/LibraryHost.cs b/Library/LibraryHost.cs
new file mode 100644
--- /dev/null
+++ b/Library/LibraryHost.cs
@@ -0,0 +1,68 @@
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+
+namespace PicoGK
+{
+    /// <summary>
+    /// Host for the process-global lifecycle established by <see cref="Library.Go"/>.
+    /// The default PicoGK host remains the native viewer implementation.
+    /// </summary>
+    public interface ILibraryHost
+    {
+        /// <summary>Log path used when callers keep <see cref="Library.Go"/>'s default.</summary>
+        string DefaultLogFilePath { get; }
+
+        /// <summary>Run one PicoGK task with the arguments supplied to <see cref="Library.Go"/>.</summary>
+        void Run( float       fVoxelSizeMM,
+                  ThreadStart fnTask,
+                  string      strLogFilePath,
+                  bool        bEndAppWithTask,
+                  string      strWindowTitle,
+                  string      strLightsFile);
+    }
+
+    public partial class Library
+    {
+        /// <summary>
+        /// Temporarily route <see cref="Go"/> through a host supplied by an embedding application.
+        /// PicoGK supports one global library configuration, so host scopes cannot be nested.
+        /// </summary>
+        public static IDisposable UseHost(ILibraryHost xHost)
+        {
+            ArgumentNullException.ThrowIfNull(xHost);
+            lock (m_mtxLibraryHost)
+            {
+                if (m_xLibraryHost is not null)
+                    throw new InvalidOperationException("Cannot register more than one PicoGK library host");
+                m_xLibraryHost = xHost;
+            }
+            return new LibraryHostScope(xHost);
+        }
+
+        static ILibraryHost? xLibraryHost()
+        {
+            lock (m_mtxLibraryHost)
+                return m_xLibraryHost;
+        }
+
+        sealed class LibraryHostScope : IDisposable
+        {
+            public LibraryHostScope(ILibraryHost xHost) => m_xHost = xHost;
+
+            public void Dispose()
+            {
+                lock (m_mtxLibraryHost)
+                {
+                    if (ReferenceEquals(m_xLibraryHost, m_xHost))
+                        m_xLibraryHost = null;
+                }
+            }
+
+            readonly ILibraryHost m_xHost;
+        }
+
+        static readonly object m_mtxLibraryHost = new();
+        static ILibraryHost? m_xLibraryHost;
+    }
+}
diff --git a/Library/MeshIndexed.cs b/Library/MeshIndexed.cs
new file mode 100644
--- /dev/null
+++ b/Library/MeshIndexed.cs
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: Apache-2.0
+using System.Numerics;
+using System.Runtime.InteropServices;
+
+namespace PicoGK;
+
+public partial class Mesh
+{
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauMesh_CreateIndexed")]
+    private static extern int TauCreateIndexedNative(LibHandle library,
+        IntPtr positions, int positionCount, IntPtr indices, int indexCount, out MshHandle output);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauMesh_CreateCopy")]
+    private static extern int TauCreateCopyNative(LibHandle library, ulong snapshot, out MshHandle output);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauMesh_AppendIndexed")]
+    private static extern int TauAppendIndexedNative(LibHandle library, MshHandle target,
+        IntPtr positions, int positionCount, IntPtr indices, int indexCount);
+
+    // Native success transfers exactly one already-created handle. No empty native object or validity lookup.
+    private Mesh(Library library, MshHandle mesh)
+    {
+        lib = library;
+        hThis = mesh;
+    }
+
+    private static Mesh TauAdoptResult(Library library, int status, MshHandle result)
+    {
+        try
+        {
+            TauCheckMeshStatus(status);
+            if (result.Value == 0)
+                throw new InvalidOperationException("PicoGK bulk mesh creation returned an empty handle.");
+            return new Mesh(library, result);
+        }
+        catch
+        {
+            if (result.Value != 0) _Destroy(library.hThis, result);
+            throw;
+        }
+    }
+
+    // Raw internal copy is distinct from authored arithmetic, including an authored identity matrix.
+    internal Mesh TauCreateCopy()
+    {
+        using var capture = TauAcquireGeometry();
+        var status = TauCreateCopyNative(capture.Library.hThis, capture.Snapshot, out var output);
+        GC.KeepAlive(capture);
+        return TauAdoptResult(capture.Library, status, output);
+    }
+
+    private static Mesh TauCreateIndexed(Library library, float[] positions, uint[] indices)
+    {
+        GCHandle pinnedPositions = default;
+        GCHandle pinnedIndices = default;
+        try
+        {
+            pinnedPositions = GCHandle.Alloc(positions, GCHandleType.Pinned);
+            pinnedIndices = GCHandle.Alloc(indices, GCHandleType.Pinned);
+            var status = TauCreateIndexedNative(library.hThis, pinnedPositions.AddrOfPinnedObject(), positions.Length,
+                pinnedIndices.AddrOfPinnedObject(), indices.Length, out var output);
+            GC.KeepAlive(library);
+            return TauAdoptResult(library, status, output);
+        }
+        finally
+        {
+            if (pinnedIndices.IsAllocated) pinnedIndices.Free();
+            if (pinnedPositions.IsAllocated) pinnedPositions.Free();
+        }
+    }
+
+    private void TauAppendIndexed(Mesh source)
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        // Acquire/copy before the target gate: self-append is finite and opposite appends never nest owners.
+        using var capture = source.TauAcquireGeometry();
+        var positions = new float[capture.PositionCount];
+        var indices = new uint[capture.IndexCount];
+        capture.Copy(positions, indices);
+        GCHandle pinnedPositions = default;
+        GCHandle pinnedIndices = default;
+        try
+        {
+            pinnedPositions = GCHandle.Alloc(positions, GCHandleType.Pinned);
+            pinnedIndices = GCHandle.Alloc(indices, GCHandleType.Pinned);
+            lock (m_tauSnapshotGate)
+            {
+                ObjectDisposedException.ThrowIf(m_bDisposed, this);
+                TauCheckMeshStatus(TauAppendIndexedNative(lib.hThis, hThis,
+                    pinnedPositions.AddrOfPinnedObject(), positions.Length,
+                    pinnedIndices.AddrOfPinnedObject(), indices.Length));
+            }
+            GC.KeepAlive(this);
+        }
+        finally
+        {
+            if (pinnedIndices.IsAllocated) pinnedIndices.Free();
+            if (pinnedPositions.IsAllocated) pinnedPositions.Free();
+        }
+    }
+
+    private static void TauCheckMeshStatus(int status)
+    {
+        if (status == 0) return;
+        if (status == -3) throw new ObjectDisposedException(nameof(Mesh));
+        if (status == -1) throw new ArgumentException("PicoGK bulk mesh contains invalid geometry or counts.");
+        throw new InvalidOperationException($"PicoGK bulk mesh failed with native status {status}.");
+    }
+
+    private static void TauRequireFinite(Vector3 point, string name)
+    {
+        if (!float.IsFinite(point.X) || !float.IsFinite(point.Y) || !float.IsFinite(point.Z))
+            throw new ArgumentException("PicoGK mesh transform requires finite values.", name);
+    }
+
+    private static void TauRequireFinite(Matrix4x4 matrix, string name)
+    {
+        if (!float.IsFinite(matrix.M11) || !float.IsFinite(matrix.M12) || !float.IsFinite(matrix.M13) || !float.IsFinite(matrix.M14) ||
+            !float.IsFinite(matrix.M21) || !float.IsFinite(matrix.M22) || !float.IsFinite(matrix.M23) || !float.IsFinite(matrix.M24) ||
+            !float.IsFinite(matrix.M31) || !float.IsFinite(matrix.M32) || !float.IsFinite(matrix.M33) || !float.IsFinite(matrix.M34) ||
+            !float.IsFinite(matrix.M41) || !float.IsFinite(matrix.M42) || !float.IsFinite(matrix.M43) || !float.IsFinite(matrix.M44))
+            throw new ArgumentException("PicoGK mesh transform requires finite values.", name);
+    }
+}
diff --git a/Library/MeshPlacement.cs b/Library/MeshPlacement.cs
new file mode 100644
--- /dev/null
+++ b/Library/MeshPlacement.cs
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: Apache-2.0
+using System.Numerics;
+using System.Runtime.InteropServices;
+
+namespace PicoGK;
+
+internal readonly record struct TauMeshPlacement(ulong PrototypeGeneration, Matrix4x4 Matrix, bool IsPlaced, BBox3 Bounds);
+
+public partial class Mesh
+{
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauCapture_GetPlacement")]
+    private static extern int TauGetPlacementNative(LibHandle library, ulong snapshot,
+        out ulong prototypeGeneration, out Matrix4x4 matrix, int matrixCapacity, out int placed, out BBox3 bounds);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauCapture_CopyPrototype")]
+    private static extern int TauCopyPrototypeNative(LibHandle library, ulong snapshot,
+        IntPtr positions, int positionCapacity, IntPtr indices, int indexCapacity);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauMesh_CreatePlacedIndexed")]
+    private static extern int TauCreatePlacedNative(LibHandle library, ulong snapshot,
+        in Matrix4x4 matrix, int matrixCount, IntPtr positions, int positionCount,
+        IntPtr indices, int indexCount, out MshHandle output);
+
+    // Read once from the live actual lease. Consumers key canonical source arrays by this root
+    // generation and keep capture.Generation separately for actual mutation/layout state.
+    internal static TauMeshPlacement TauReadPlacement(TauGeometryCapture capture)
+    {
+        TauCheckMeshStatus(TauGetPlacementNative(capture.Library.hThis, capture.Snapshot,
+            out var generation, out var matrix, 16, out var placed, out var bounds));
+        if (generation == 0 || (placed != 0 && placed != 1))
+            throw new InvalidOperationException("PicoGK returned invalid immutable placement metadata.");
+        if (!TauFinitePlacement(matrix))
+            throw new InvalidOperationException("PicoGK returned invalid immutable placement matrix.");
+        return new(generation, matrix, placed == 1, bounds);
+    }
+
+    // A null index buffer explicitly requests positions only during nested construction proof.
+    // Add-time admission requests both buffers only on a unique prototype cache miss.
+    internal static void TauCopyPrototype(TauGeometryCapture capture, float[] positions, uint[]? indices = null)
+    {
+        if (positions.Length != capture.PositionCount || (indices is not null && indices.Length != capture.IndexCount))
+            throw new ArgumentException("Prototype buffers must match the immutable geometry counts.");
+        GCHandle pinnedPositions = default;
+        GCHandle pinnedIndices = default;
+        try
+        {
+            pinnedPositions = GCHandle.Alloc(positions, GCHandleType.Pinned);
+            if (indices is not null) pinnedIndices = GCHandle.Alloc(indices, GCHandleType.Pinned);
+            TauCheckMeshStatus(TauCopyPrototypeNative(capture.Library.hThis, capture.Snapshot,
+                pinnedPositions.AddrOfPinnedObject(), positions.Length,
+                indices is null ? IntPtr.Zero : pinnedIndices.AddrOfPinnedObject(), indices?.Length ?? 0));
+        }
+        finally
+        {
+            if (pinnedIndices.IsAllocated) pinnedIndices.Free();
+            if (pinnedPositions.IsAllocated) pinnedPositions.Free();
+        }
+    }
+
+    private Mesh TauCreateTransformed(Func<Vector3, Vector3> transform, Matrix4x4 step, bool actualUsesMatrix = false)
+    {
+        using var capture = TauAcquireGeometry();
+        var positions = new float[capture.PositionCount];
+        var indices = new uint[capture.IndexCount];
+        capture.Copy(positions, indices);
+        var placement = TauReadPlacement(capture);
+        // Vector3.Transform ignores these four homogeneous entries. Its actual XYZ arithmetic
+        // stays unchanged; placement expresses that same affine XYZ map.
+        step.M14 = 0; step.M24 = 0; step.M34 = 0; step.M44 = 1;
+        var rootMatrix = placement.IsPlaced ? placement.Matrix * step : step;
+        var eligible = TauFinitePlacement(rootMatrix);
+        float[]? rootPositions = null;
+        if (eligible && placement.IsPlaced)
+        {
+            rootPositions = new float[positions.Length];
+            TauCopyPrototype(capture, rootPositions);
+        }
+        for (var index = 0; index < positions.Length; index += 3)
+        {
+            var source = new Vector3(positions[index], positions[index + 1], positions[index + 2]);
+            var actual = transform(source);
+            if (!float.IsFinite(actual.X) || !float.IsFinite(actual.Y) || !float.IsFinite(actual.Z))
+                throw new ArgumentException("PicoGK mesh transform returned a nonfinite vertex.");
+            // A first matrix transform already evaluates the canonical map as its actual arithmetic.
+            if (eligible && (!actualUsesMatrix || placement.IsPlaced))
+            {
+                var root = rootPositions is null ? source :
+                    new Vector3(rootPositions[index], rootPositions[index + 1], rootPositions[index + 2]);
+                eligible = TauSameBits(actual, Vector3.Transform(root, rootMatrix));
+            }
+            positions[index] = actual.X;
+            positions[index + 1] = actual.Y;
+            positions[index + 2] = actual.Z;
+        }
+        // Qualification is conservative. A failed proof keeps every actual authored float and
+        // index, and simply becomes a new prototype; it never rejects valid authored geometry.
+        return eligible ? TauCreatePlaced(capture, rootMatrix, positions, indices) :
+            TauCreateIndexed(capture.Library, positions, indices);
+    }
+
+    private static Mesh TauCreatePlaced(TauGeometryCapture capture, Matrix4x4 matrix, float[] positions, uint[] indices)
+    {
+        GCHandle pinnedPositions = default;
+        GCHandle pinnedIndices = default;
+        try
+        {
+            pinnedPositions = GCHandle.Alloc(positions, GCHandleType.Pinned);
+            pinnedIndices = GCHandle.Alloc(indices, GCHandleType.Pinned);
+            var status = TauCreatePlacedNative(capture.Library.hThis, capture.Snapshot, matrix, 16,
+                pinnedPositions.AddrOfPinnedObject(), positions.Length,
+                pinnedIndices.AddrOfPinnedObject(), indices.Length, out var output);
+            return TauAdoptResult(capture.Library, status, output);
+        }
+        finally
+        {
+            if (pinnedIndices.IsAllocated) pinnedIndices.Free();
+            if (pinnedPositions.IsAllocated) pinnedPositions.Free();
+        }
+    }
+
+    private static bool TauSameBits(Vector3 a, Vector3 b) =>
+        BitConverter.SingleToInt32Bits(a.X) == BitConverter.SingleToInt32Bits(b.X) &&
+        BitConverter.SingleToInt32Bits(a.Y) == BitConverter.SingleToInt32Bits(b.Y) &&
+        BitConverter.SingleToInt32Bits(a.Z) == BitConverter.SingleToInt32Bits(b.Z);
+
+    private static bool TauFinitePlacement(Matrix4x4 matrix) =>
+        float.IsFinite(matrix.M11) && float.IsFinite(matrix.M12) && float.IsFinite(matrix.M13) && matrix.M14 == 0 &&
+        float.IsFinite(matrix.M21) && float.IsFinite(matrix.M22) && float.IsFinite(matrix.M23) && matrix.M24 == 0 &&
+        float.IsFinite(matrix.M31) && float.IsFinite(matrix.M32) && float.IsFinite(matrix.M33) && matrix.M34 == 0 &&
+        float.IsFinite(matrix.M41) && float.IsFinite(matrix.M42) && float.IsFinite(matrix.M43) && matrix.M44 == 1;
+
+    private static Matrix4x4 TauMirrorPlacement(Vector3 point, Vector3 normal)
+    {
+        var x = 2f * normal.X; var y = 2f * normal.Y; var z = 2f * normal.Z;
+        var distance = 2f * Vector3.Dot(point, normal);
+        return new(1f - x * normal.X, -x * normal.Y, -x * normal.Z, 0,
+            -y * normal.X, 1f - y * normal.Y, -y * normal.Z, 0,
+            -z * normal.X, -z * normal.Y, 1f - z * normal.Z, 0,
+            distance * normal.X, distance * normal.Y, distance * normal.Z, 1);
+    }
+}
