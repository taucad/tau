+// SPDX-License-Identifier: Apache-2.0
+using System.Text;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+namespace PicoGK;
+
+internal static class TauComputeActionKeys
+{
+    private const int MaximumFragmentBytes=65536;
+    internal static Func<TauComputeCall,IReadOnlyList<TauComputeOperand>,string> FromFragments(
+        string producerCanonical,string environmentCanonical,JsonElement actualProducer,JsonElement actualEnvironment)
+    {
+        ValidateFragment(producerCanonical,actualProducer);ValidateFragment(environmentCanonical,actualEnvironment);
+        return (call,inputs)=> {
+            var codec=call.Operation switch {
+                "voxels.sign-equal"=>"picogk.bool",
+                "mesh.capture" or "mesh.transform"=>"picogk.indexed-mesh",
+                "mesh.normals" or "mesh.uv"=>"picogk.layout",
+                "voxels.empty" or "voxels.sphere" or "voxels.capsule" or "voxels.lattice" or "voxels.mesh" or "voxels.duplicate" or
+                "voxels.union" or "voxels.intersection" or "voxels.difference" or "voxels.offset" or
+                "voxels.double-offset" or "voxels.triple-offset" or "voxels.render-mesh" or "voxels.render-lattice" or "voxels.smooth" or "voxels.trim" or
+                "voxels.project-z-slice" or "vdb.asset"=>"picogk.vdb-stream",
+                _=>throw new ArgumentException("Unknown private compute operation.")};
+            if(inputs.Count>2)throw new ArgumentException("Invalid private operand arity.");
+            foreach(var input in inputs)if((input.Kind!="action"&&input.Kind!="content")||
+                (input.Role!="left"&&input.Role!="right"&&input.Role!="source")||!Regex.IsMatch(input.Digest,"^sha256:[0-9a-f]{64}$"))
+                    throw new ArgumentException("Invalid private operand identity.");
+            if(Encoding.UTF8.GetByteCount(call.CanonicalArguments)>MaximumFragmentBytes)throw new ArgumentException("Compute arguments exceed bound.");
+            // Argument fragments come only from the known internal operation builders.
+            using var arguments=JsonDocument.Parse(call.CanonicalArguments,new(){MaxDepth=32});
+            ValidateArguments(call.Operation,arguments.RootElement,inputs);
+            var operands=string.Join(",",inputs.Select(input=>"{\"digest\":\""+input.Digest+"\",\"kind\":\""+input.Kind+"\",\"role\":\""+input.Role+"\"}"));
+            return "{\"arguments\":"+call.CanonicalArguments+",\"codec\":{\"id\":\""+codec+"\",\"version\":\"2\"},\"environment\":"+
+                environmentCanonical+",\"inputs\":["+operands+"],\"namespace\":\"picogk.operation.v1\",\"operation\":\""+call.Operation+
+                "\",\"producer\":"+producerCanonical+",\"schemaVersion\":1}";
+        };
+    }
+    private static void ValidateArguments(string operation,JsonElement arguments,IReadOnlyList<TauComputeOperand> inputs)
+    {
+        if(arguments.ValueKind!=JsonValueKind.Object)throw new ArgumentException("Compute argument shape.");
+        var names=operation switch {
+            "voxels.empty" or "voxels.lattice" or "vdb.asset"=>new[]{"narrowBand","voxelSize"},
+            "voxels.sphere"=>new[]{"center","narrowBand","radius","voxelSize"},
+            "voxels.capsule"=>new[]{"end","narrowBand","radiusEnd","radiusStart","start","voxelSize"},
+            "voxels.mesh"=>new[]{"narrowBand","radius","shell","voxelSize"},
+            "voxels.offset" or "voxels.triple-offset" or "voxels.smooth"=>new[]{"distance"},
+            "voxels.double-offset"=>new[]{"first","second"},"voxels.trim"=>new[]{"max","min"},
+            "voxels.project-z-slice"=>new[]{"end","start"},"mesh.transform"=>arguments.GetProperty("algorithm").GetString() switch {
+                "matrix"=>new[]{"algorithm","matrix"},"scale-offset"=>new[]{"algorithm","offset","scale"},"mirror"=>new[]{"algorithm","normal","point"},_=>throw new ArgumentException("Compute transform algorithm.")},
+            "mesh.normals" or "mesh.uv"=>new[]{"algorithm","baked","source"},_=>Array.Empty<string>()};
+        var properties=arguments.EnumerateObject().ToArray();
+        if(properties.Length!=names.Length||properties.Select(property=>property.Name).Distinct(StringComparer.Ordinal).Count()!=properties.Length||properties.Any(property=>!names.Contains(property.Name,StringComparer.Ordinal)))throw new ArgumentException("Compute argument fields.");
+        float Float(JsonElement value){var bits=value.GetString();if(bits is null||!Regex.IsMatch(bits,"^[0-9a-f]{8}$")||!uint.TryParse(bits,System.Globalization.NumberStyles.HexNumber,System.Globalization.CultureInfo.InvariantCulture,out var number)||!float.IsFinite(BitConverter.UInt32BitsToSingle(number)))throw new ArgumentException("Compute finite float bits.");return BitConverter.UInt32BitsToSingle(number);}
+        foreach(var property in properties) {
+            if(property.Name=="narrowBand"){if(!property.Value.TryGetUInt32(out _))throw new ArgumentException("Compute narrow band.");}
+            else if(property.Name=="shell"){if(property.Value.ValueKind!=JsonValueKind.True&&property.Value.ValueKind!=JsonValueKind.False)throw new ArgumentException("Compute shell flag.");}
+            else if(property.Name=="algorithm"){if(property.Value.ValueKind!=JsonValueKind.String||property.Value.GetString()!.Length==0)throw new ArgumentException("Compute layout algorithm.");}
+            else if(property.Value.ValueKind==JsonValueKind.Array){var count=property.Name is "matrix" or "baked" or "source"?16:3;if(property.Value.GetArrayLength()!=count)throw new ArgumentException("Compute vector/matrix shape.");foreach(var value in property.Value.EnumerateArray())_=Float(value);}
+            else {var value=Float(property.Value);if(property.Name=="voxelSize"&&value<=0||property.Name.StartsWith("radius",StringComparison.Ordinal)&&value<0)throw new ArgumentException("Compute native factory setting.");}
+        }
+        var none=operation is "voxels.empty" or "voxels.sphere" or "voxels.capsule";
+        var binary=operation is "voxels.union" or "voxels.intersection" or "voxels.difference" or "voxels.sign-equal" or "voxels.render-mesh" or "voxels.render-lattice";
+        var roles=none?Array.Empty<string>():binary?new[]{"left","right"}:new[]{"source"};
+        if(inputs.Count!=roles.Length||inputs.Where((input,index)=>input.Role!=roles[index]).Any())throw new ArgumentException("Compute ordered operand roles.");
+    }
+    internal static ulong IdentityCharge(string producerCanonical,string environmentCanonical)=>checked(256UL+2UL*(ulong)(producerCanonical.Length+environmentCanonical.Length));
+    private static void ValidateFragment(string fragment,JsonElement actual)
+    {
+        if(Encoding.UTF8.GetByteCount(fragment)>MaximumFragmentBytes)throw new ArgumentException("Compute canonical fragment bound.");
+        using var parsed=JsonDocument.Parse(fragment,new(){MaxDepth=32});
+        if(!JsonElement.DeepEquals(parsed.RootElement,actual))throw new ArgumentException("Compute canonical fragment equivalence.");
+        // Core canonicalization authority and actual pinned producer/environment checks
+        // run in the TS request/result owner; fragments alone never supply authority.
+    }
+}
