diff --git a/Library/CheckedCallbacks.cs b/Library/CheckedCallbacks.cs
new file mode 100644
--- /dev/null
+++ b/Library/CheckedCallbacks.cs
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: Apache-2.0
+using System.Numerics;
+using System.Runtime.ExceptionServices;
+using System.Runtime.InteropServices;
+
+namespace PicoGK;
+
+internal static class TauCheckedCallbacks
+{
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    internal delegate int Sdf(in Vector3 point, out float distance);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    internal delegate int Scalar(in Vector3 point, float value);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    internal delegate int Vector(in Vector3 point, in Vector3 value);
+
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "Tau_Voxels_RenderImplicitChecked")]
+    internal static extern int Render(LibHandle library, VoxHandle voxels, in BBox3 bounds, Sdf callback);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "Tau_Voxels_IntersectImplicitChecked")]
+    internal static extern int Intersect(LibHandle library, VoxHandle voxels, Sdf callback);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "Tau_ScalarField_TraverseActiveChecked")]
+    internal static extern int TraverseScalar(LibHandle library, ScalarFieldHandle field, Scalar callback);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "Tau_VectorField_TraverseActiveChecked")]
+    internal static extern int TraverseVector(LibHandle library, VectorFieldHandle field, Vector callback);
+
+    internal static void Check(int status, ExceptionDispatchInfo? error, object owner)
+    {
+        // Never unwind a managed exception through OpenVDB/C++. Restore the exact first error here.
+        error?.Throw();
+        if (status == 0) return;
+        if (status == -3) throw new ObjectDisposedException(owner.GetType().Name);
+        if (status == -1) throw new ArgumentException("PicoGK callback operation received invalid bounds or input.");
+        throw new InvalidOperationException($"PicoGK callback operation failed with native status {status}.");
+    }
+}
+
+public partial class Voxels
+{
+    private void TauRenderImplicit(IImplicit implicitFunction, in BBox3 bounds, bool intersect)
+    {
+        ArgumentNullException.ThrowIfNull(implicitFunction);
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        ExceptionDispatchInfo? failure = null;
+        TauCheckedCallbacks.Sdf callback = (in Vector3 point, out float distance) =>
+        {
+            distance = 0;
+            if (failure is not null) return 1;
+            try
+            {
+                distance = implicitFunction.fSignedDistance(point);
+                return 0;
+            }
+            catch (Exception error)
+            {
+                failure = ExceptionDispatchInfo.Capture(error);
+                return 1;
+            }
+        };
+        var status = intersect
+            ? TauCheckedCallbacks.Intersect(lib.hThis, hThis, callback)
+            : TauCheckedCallbacks.Render(lib.hThis, hThis, bounds, callback);
+        GC.KeepAlive(callback);
+        TauCheckedCallbacks.Check(status, failure, this);
+    }
+}
+
+public partial class ScalarField
+{
+    private void TauTraverseActive(ITraverseScalarField traversal)
+    {
+        ArgumentNullException.ThrowIfNull(traversal);
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        ExceptionDispatchInfo? failure = null;
+        TauCheckedCallbacks.Scalar callback = (in Vector3 point, float value) =>
+        {
+            if (failure is not null) return 1;
+            try { traversal.InformActiveValue(point, value); return 0; }
+            catch (Exception error) { failure = ExceptionDispatchInfo.Capture(error); return 1; }
+        };
+        var status = TauCheckedCallbacks.TraverseScalar(lib.hThis, hThis, callback);
+        GC.KeepAlive(callback);
+        TauCheckedCallbacks.Check(status, failure, this);
+    }
+}
+
+public partial class VectorField
+{
+    private void TauTraverseActive(ITraverseVectorField traversal)
+    {
+        ArgumentNullException.ThrowIfNull(traversal);
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        ExceptionDispatchInfo? failure = null;
+        TauCheckedCallbacks.Vector callback = (in Vector3 point, in Vector3 value) =>
+        {
+            if (failure is not null) return 1;
+            try { traversal.InformActiveValue(point, value); return 0; }
+            catch (Exception error) { failure = ExceptionDispatchInfo.Capture(error); return 1; }
+        };
+        var status = TauCheckedCallbacks.TraverseVector(lib.hThis, hThis, callback);
+        GC.KeepAlive(callback);
+        TauCheckedCallbacks.Check(status, failure, this);
+    }
+}
diff --git a/Library/GeometryCapture.cs b/Library/GeometryCapture.cs
new file mode 100644
--- /dev/null
+++ b/Library/GeometryCapture.cs
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: Apache-2.0
+using System.Runtime.InteropServices;
+
+namespace PicoGK;
+
+// Private host bridge. A lease pins one validated native generation, never the caller's mutable handle.
+internal sealed class TauGeometryCapture : IDisposable
+{
+    internal Library Library { get; }
+    internal ulong Generation { get; }
+    internal int PositionCount { get; }
+    internal int IndexCount { get; }
+    internal ColorFloat Color { get; }
+    internal ulong Snapshot { get { ObjectDisposedException.ThrowIf(snapshot == 0, this); return snapshot; } }
+    private ulong snapshot;
+
+    private TauGeometryCapture(Library library, ulong snapshot, ulong generation,
+        int positionCount, int indexCount, ColorFloat color)
+    {
+        Library = library;
+        this.snapshot = snapshot;
+        Generation = generation;
+        PositionCount = positionCount;
+        IndexCount = indexCount;
+        Color = color;
+    }
+
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauCapture_Acquire")]
+    private static extern int AcquireNative(LibHandle library, int kind, long source,
+        out ulong snapshot, out ulong generation, out int positions, out int indices, out ColorFloat color);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauCapture_Copy")]
+    private static extern int CopyNative(LibHandle library, ulong snapshot,
+        IntPtr positions, int positionCapacity, IntPtr indices, int indexCapacity);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauCapture_Release")]
+    private static extern int ReleaseNative(LibHandle library, ulong snapshot);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauCapture_Counters")]
+    private static extern int CountersNative(LibHandle library, [Out] ulong[] counters, int capacity);
+
+    internal static TauGeometryCapture Acquire(Library library, int kind, long source, object identity)
+    {
+        var status = AcquireNative(library.hThis, kind, source,
+            out var snapshot, out var generation, out var positions, out var indices, out var color);
+        GC.KeepAlive(identity);
+        Check(status, identity.GetType().Name);
+        try
+        {
+            if (snapshot == 0 || generation == 0 || positions < 0 || positions % 3 != 0 || indices < 0 ||
+                indices % (kind == 2 ? 2 : 3) != 0)
+                throw new InvalidOperationException("PicoGK returned invalid immutable capture metadata.");
+            return new TauGeometryCapture(library, snapshot, generation, positions, indices, color);
+        }
+        catch
+        {
+            _ = ReleaseNative(library.hThis, snapshot);
+            throw;
+        }
+    }
+
+    internal void Copy(float[] positions, uint[] indices)
+    {
+        ObjectDisposedException.ThrowIf(snapshot == 0, this);
+        if (positions.Length != PositionCount || indices.Length != IndexCount)
+            throw new ArgumentException("Capture buffers must match the immutable geometry counts.");
+        GCHandle pinnedPositions = default;
+        GCHandle pinnedIndices = default;
+        try
+        {
+            pinnedPositions = GCHandle.Alloc(positions, GCHandleType.Pinned);
+            pinnedIndices = GCHandle.Alloc(indices, GCHandleType.Pinned);
+            Check(CopyNative(Library.hThis, snapshot, pinnedPositions.AddrOfPinnedObject(), positions.Length,
+                pinnedIndices.AddrOfPinnedObject(), indices.Length), nameof(TauGeometryCapture));
+        }
+        finally
+        {
+            if (pinnedIndices.IsAllocated) pinnedIndices.Free();
+            if (pinnedPositions.IsAllocated) pinnedPositions.Free();
+        }
+    }
+
+    internal static ulong[] Counters(Library library)
+    {
+        var counters = new ulong[5];
+        Check(CountersNative(library.hThis, counters, counters.Length), nameof(Library));
+        return counters;
+    }
+
+    public void Dispose()
+    {
+        var handle = snapshot;
+        snapshot = 0;
+        if (handle == 0) return;
+        var status = ReleaseNative(Library.hThis, handle);
+        // Library teardown owns all remaining native leases; a late managed release is idempotent.
+        if (status != -3) Check(status, nameof(TauGeometryCapture));
+    }
+
+    private static void Check(int status, string owner)
+    {
+        if (status == 0) return;
+        if (status == -3) throw new ObjectDisposedException(owner);
+        if (status == -1) throw new ArgumentException("PicoGK immutable capture contains invalid geometry or counts.");
+        throw new InvalidOperationException($"PicoGK immutable capture failed with native status {status}.");
+    }
+}
+
+public partial class Mesh
+{
+    internal TauGeometryCapture TauAcquireGeometry()
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        return TauGeometryCapture.Acquire(lib, 0, hThis.Value, this);
+    }
+}
+
+public partial class Voxels
+{
+    internal TauGeometryCapture TauAcquireGeometry()
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        return TauGeometryCapture.Acquire(lib, 1, hThis.Value, this);
+    }
+}
+
+public partial class PolyLine
+{
+    internal TauGeometryCapture TauAcquireGeometry()
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        return TauGeometryCapture.Acquire(lib, 2, hThis.Value, this);
+    }
+}
