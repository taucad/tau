--- /dev/null
+++ b/Library/SurfaceNormals.cs
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: Apache-2.0
+using System.Buffers;
+using System.Numerics;
+using System.Runtime.ExceptionServices;
+using System.Runtime.InteropServices;
+
+namespace PicoGK;
+
+public partial class VectorField
+{
+    private const int TauNormalBatchCapacity = 256;
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate int TauNormalBatch(uint count, IntPtr normals, IntPtr values, IntPtr keep);
+
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauVectorField_CreateSurfaceNormals")]
+    private static extern int TauCreateNormalsNative(LibHandle library, VoxHandle voxels, float threshold,
+        TauNormalBatch callback, out VectorFieldHandle output, out VdbMetaHandle metadata);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "Metadata_Destroy")]
+    private static extern void TauDestroyNormalMetadata(LibHandle library, VdbMetaHandle metadata);
+
+    private VectorField(Library library, VectorFieldHandle handle, FieldMetadata metadata)
+    {
+        lib = library;
+        hThis = handle;
+        m_oMetadata = metadata;
+    }
+
+    internal static VectorField TauExtractSurfaceNormals(Voxels source, float threshold,
+        Vector3 direction, float tolerance, Vector3 scale)
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        if (direction != Vector3.Zero) direction = Vector3.Normalize(direction);
+        var buffer = ArrayPool<float>.Shared.Rent(TauNormalBatchCapacity * 6);
+        byte[]? selectionBuffer = null;
+        try
+        {
+            var keep = selectionBuffer = ArrayPool<byte>.Shared.Rent(TauNormalBatchCapacity);
+            ExceptionDispatchInfo? failure = null;
+            TauNormalBatch callback = (count, normals, values, selection) =>
+            {
+                if (failure is not null) return 1;
+                try
+                {
+                    if (count == 0 || count > TauNormalBatchCapacity)
+                        throw new InvalidOperationException("Invalid internal surface-normal batch size.");
+                    var length = checked((int)count * 3);
+                    Marshal.Copy(normals, buffer, 0, length);
+                    for (var i = 0; i < count; ++i)
+                    {
+                        var offset = i * 3;
+                        var normal = new Vector3(buffer[offset], buffer[offset + 1], buffer[offset + 2]);
+                        keep[i] = 0;
+                        if (direction != Vector3.Zero && float.Abs(1 - Vector3.Dot(normal, direction)) > tolerance) continue;
+                        var value = normal * scale;
+                        buffer[TauNormalBatchCapacity * 3 + offset] = value.X;
+                        buffer[TauNormalBatchCapacity * 3 + offset + 1] = value.Y;
+                        buffer[TauNormalBatchCapacity * 3 + offset + 2] = value.Z;
+                        keep[i] = 1;
+                    }
+                    Marshal.Copy(buffer, TauNormalBatchCapacity * 3, values, length);
+                    Marshal.Copy(keep, 0, selection, (int)count);
+                    return 0;
+                }
+                catch (Exception error)
+                {
+                    failure = ExceptionDispatchInfo.Capture(error);
+                    return 1;
+                }
+            };
+            VectorFieldHandle handle = default;
+            VdbMetaHandle metadataHandle = default;
+            FieldMetadata? metadata = null;
+            try
+            {
+                var status = TauCreateNormalsNative(source.lib.hThis, source.hThis, threshold, callback,
+                    out handle, out metadataHandle);
+                TauCheckedCallbacks.Check(status, failure, source);
+                if (handle.Value == 0 || metadataHandle.Value == IntPtr.Zero)
+                    throw new InvalidOperationException("Surface-normal extraction returned incomplete ownership.");
+                metadata = new FieldMetadata(source.lib, metadataHandle);
+                return new VectorField(source.lib, handle, metadata);
+            }
+            catch (Exception error)
+            {
+                var original = ExceptionDispatchInfo.Capture(error);
+                try
+                {
+                    try
+                    {
+                        if (metadata is not null) metadata.Dispose();
+                        else if (metadataHandle.Value != IntPtr.Zero) TauDestroyNormalMetadata(source.lib.hThis, metadataHandle);
+                    }
+                    finally
+                    {
+                        if (handle.Value != 0) _Destroy(source.lib.hThis, handle);
+                    }
+                }
+                catch { /* Preserve the first failure while releasing both owners. */ }
+                original.Throw();
+                throw;
+            }
+            finally
+            {
+                GC.KeepAlive(callback);
+                GC.KeepAlive(source);
+            }
+        }
+        finally
+        {
+            ArrayPool<float>.Shared.Return(buffer, clearArray: true);
+            if (selectionBuffer is not null) ArrayPool<byte>.Shared.Return(selectionBuffer, clearArray: true);
+        }
+    }
+}
+
+public partial class ScalarField
+{
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauScalarField_CountActiveValues")]
+    private static extern int TauCountActiveNative(LibHandle library, ScalarFieldHandle field, out int count);
+
+    internal int TauCountActiveValues()
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        try
+        {
+            var status = TauCountActiveNative(lib.hThis, hThis, out var count);
+            TauCheckedCallbacks.Check(status, null, this);
+            return count;
+        }
+        finally { GC.KeepAlive(this); }
+    }
+}
diff --git a/Library/VoxelsCsg.cs b/Library/VoxelsCsg.cs
new file mode 100644
--- /dev/null
+++ b/Library/VoxelsCsg.cs
@@ -0,0 +1,53 @@
+using System.Runtime.InteropServices;
+
+namespace PicoGK;
+
+public partial class Voxels
+{
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauVoxels_CreateCsg")]
+    private static extern int TauCreateCsgNative(LibHandle library, VoxHandle left, VoxHandle right,
+        int operation, out VoxHandle output, out VdbMetaHandle metadata);
+
+    private Voxels(Library library, VoxHandle handle, FieldMetadata metadata)
+    {
+        lib = library;
+        hThis = handle;
+        m_oMetadata = metadata;
+    }
+
+    private Voxels TauCreateCsg(Voxels operand, int operation)
+    {
+        ArgumentNullException.ThrowIfNull(operand);
+        if (operand.lib.hThis != lib.hThis) throw new PicoGKLibraryMismatchException();
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        ObjectDisposedException.ThrowIf(operand.m_bDisposed, operand);
+        VoxHandle handle = default;
+        VdbMetaHandle metadataHandle = default;
+        FieldMetadata? metadata = null;
+        try
+        {
+            var status = TauCreateCsgNative(lib.hThis, hThis, operand.hThis, operation, out handle, out metadataHandle);
+            if (status == -3) throw new ObjectDisposedException(nameof(Voxels));
+            if (status == -1) throw new ArgumentException("Invalid functional CSG input.");
+            if (status != 0) throw new InvalidOperationException($"Functional CSG failed with status {status}.");
+            if (handle.Value == 0 || metadataHandle.Value == IntPtr.Zero) throw new InvalidOperationException("Functional CSG returned incomplete ownership.");
+            metadata = new FieldMetadata(lib, metadataHandle);
+            return new Voxels(lib, handle, metadata);
+        }
+        catch
+        {
+            if (metadata != null) metadata.Dispose();
+            else if (metadataHandle.Value != IntPtr.Zero) TauDestroyCsgMetadata(lib.hThis, metadataHandle);
+            if (handle.Value != 0) _Destroy(lib.hThis, handle);
+            throw;
+        }
+        finally
+        {
+            GC.KeepAlive(this);
+            GC.KeepAlive(operand);
+        }
+    }
+
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "Metadata_Destroy")]
+    private static extern void TauDestroyCsgMetadata(LibHandle library, VdbMetaHandle metadata);
+}
