diff --git a/Library/LibraryHost.cs b/Library/LibraryHost.cs
new file mode 100644
index 000000000..6c0ed9460
--- /dev/null
+++ b/Library/LibraryHost.cs
@@ -0,0 +1,68 @@
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+
+namespace PicoGK
+{
+    /// <summary>
+    /// Host for the process-global lifecycle established by <see cref="Library.Go"/>.
+    /// The default PicoGK host remains the native viewer implementation.
+    /// </summary>
+    public interface ILibraryHost
+    {
+        /// <summary>Log path used when callers keep <see cref="Library.Go"/>'s default.</summary>
+        string DefaultLogFilePath { get; }
+
+        /// <summary>Run one PicoGK task with the arguments supplied to <see cref="Library.Go"/>.</summary>
+        void Run( float       fVoxelSizeMM,
+                  ThreadStart fnTask,
+                  string      strLogFilePath,
+                  bool        bEndAppWithTask,
+                  string      strWindowTitle,
+                  string      strLightsFile);
+    }
+
+    public partial class Library
+    {
+        /// <summary>
+        /// Temporarily route <see cref="Go"/> through a host supplied by an embedding application.
+        /// PicoGK supports one global library configuration, so host scopes cannot be nested.
+        /// </summary>
+        public static IDisposable UseHost(ILibraryHost xHost)
+        {
+            ArgumentNullException.ThrowIfNull(xHost);
+            lock (m_mtxLibraryHost)
+            {
+                if (m_xLibraryHost is not null)
+                    throw new InvalidOperationException("Cannot register more than one PicoGK library host");
+                m_xLibraryHost = xHost;
+            }
+            return new LibraryHostScope(xHost);
+        }
+
+        static ILibraryHost? xLibraryHost()
+        {
+            lock (m_mtxLibraryHost)
+                return m_xLibraryHost;
+        }
+
+        sealed class LibraryHostScope : IDisposable
+        {
+            public LibraryHostScope(ILibraryHost xHost) => m_xHost = xHost;
+
+            public void Dispose()
+            {
+                lock (m_mtxLibraryHost)
+                {
+                    if (ReferenceEquals(m_xLibraryHost, m_xHost))
+                        m_xLibraryHost = null;
+                }
+            }
+
+            readonly ILibraryHost m_xHost;
+        }
+
+        static readonly object m_mtxLibraryHost = new();
+        static ILibraryHost? m_xLibraryHost;
+    }
+}
diff --git a/Library/MeshReadback.cs b/Library/MeshReadback.cs
new file mode 100644
index 000000000..686b54008
--- /dev/null
+++ b/Library/MeshReadback.cs
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: Apache-2.0
+using System.Numerics;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+
+[assembly: InternalsVisibleTo("Tau.PicoGK.Worker")]
+[assembly: InternalsVisibleTo("Tau.PicoGK.Worker.Tests")]
+
+namespace PicoGK;
+
+public partial class Mesh
+{
+    private readonly object m_tauSnapshotGate = new();
+    private static int m_tauBulkAvailable;
+
+    [DllImport("tau-picogk-readback", CallingConvention = CallingConvention.Cdecl, EntryPoint = "Mesh_GetVertices")]
+    private static extern int TauGetVertices(LibHandle library, MshHandle mesh, IntPtr buffer, int capacity);
+    [DllImport("tau-picogk-readback", CallingConvention = CallingConvention.Cdecl, EntryPoint = "Mesh_GetTriangles")]
+    private static extern int TauGetTriangles(LibHandle library, MshHandle mesh, IntPtr buffer, int capacity);
+
+    // Private host integration: no new model-author API. Synchronizes with managed mesh mutation
+    // and disposal for one consistent snapshot, including when an older library needs element reads.
+    internal (float[] Positions, uint[] Indices) TauCopyGeometry(bool allowBulk = true)
+    {
+        lock (m_tauSnapshotGate)
+        {
+            ObjectDisposedException.ThrowIf(m_bDisposed, this);
+            var vertexCount = nVertexCount();
+            var triangleCount = nTriangleCount();
+            if (vertexCount < 0 || triangleCount < 0) throw new InvalidOperationException("PicoGK returned a negative mesh count.");
+            var positions = new float[checked(vertexCount * 3)];
+            var indices = new uint[checked(triangleCount * 3)];
+            var copied = false;
+            if (allowBulk && System.Threading.Volatile.Read(ref m_tauBulkAvailable) >= 0)
+            {
+                var verticesHandle = GCHandle.Alloc(positions, GCHandleType.Pinned);
+                GCHandle trianglesHandle = default;
+                try
+                {
+                    trianglesHandle = GCHandle.Alloc(indices, GCHandleType.Pinned);
+                    if (TauGetVertices(lib.hThis, hThis, verticesHandle.AddrOfPinnedObject(), vertexCount) != vertexCount ||
+                        TauGetTriangles(lib.hThis, hThis, trianglesHandle.AddrOfPinnedObject(), triangleCount) != triangleCount)
+                        throw new InvalidOperationException("PicoGK bulk readback returned inconsistent mesh counts.");
+                    System.Threading.Volatile.Write(ref m_tauBulkAvailable, 1);
+                    copied = true;
+                }
+                catch (Exception error) when (error is EntryPointNotFoundException or DllNotFoundException)
+                {
+                    System.Threading.Volatile.Write(ref m_tauBulkAvailable, -1);
+                }
+                finally { if (trianglesHandle.IsAllocated) trianglesHandle.Free(); verticesHandle.Free(); }
+            }
+            if (!copied)
+            {
+                for (var vertex = 0; vertex < vertexCount; vertex++)
+                {
+                    var value = vecVertexAt(vertex);
+                    positions[vertex * 3] = value.X; positions[vertex * 3 + 1] = value.Y; positions[vertex * 3 + 2] = value.Z;
+                }
+                for (var triangle = 0; triangle < triangleCount; triangle++)
+                {
+                    var value = oTriangleAt(triangle);
+                    indices[triangle * 3] = checked((uint)value.A);
+                    indices[triangle * 3 + 1] = checked((uint)value.B);
+                    indices[triangle * 3 + 2] = checked((uint)value.C);
+                }
+            }
+            foreach (var index in indices)
+                if (index >= vertexCount) throw new InvalidOperationException("PicoGK readback returned an out-of-range triangle index.");
+            foreach (var value in positions)
+                if (!float.IsFinite(value)) throw new InvalidOperationException("PicoGK readback returned a nonfinite vertex.");
+            return (positions, indices);
+        }
+    }
+}
