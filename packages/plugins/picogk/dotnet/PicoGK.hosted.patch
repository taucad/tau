+using System.Runtime.InteropServices;
+namespace PicoGK;
+
+public partial class OpenVdbFile
+{
+    private const int TauVoxelFieldKind = 0;
+    private const int TauScalarFieldKind = 1;
+    private const int TauVectorFieldKind = 2;
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "TauVdbFile_GetField")]
+    private static extern int TauGetFieldNative(LibHandle library, VdbHandle file, int index, int kind,
+        out ulong output, out VdbMetaHandle metadata);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "Metadata_Destroy")]
+    private static extern void TauDestroyLoadedMetadata(LibHandle library, VdbMetaHandle metadata);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "Voxels_Destroy")]
+    private static extern void TauDestroyLoadedVoxels(LibHandle library, ulong field);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "ScalarField_Destroy")]
+    private static extern void TauDestroyLoadedScalar(LibHandle library, ulong field);
+    [DllImport(Config.strPicoGKLib, CallingConvention = CallingConvention.Cdecl, EntryPoint = "VectorField_Destroy")]
+    private static extern void TauDestroyLoadedVector(LibHandle library, ulong field);
+    private static void TauDestroyLoadedField(LibHandle library, int kind, ulong field)
+    {
+        if (kind == 0) TauDestroyLoadedVoxels(library, field);
+        else if (kind == 1) TauDestroyLoadedScalar(library, field);
+        else TauDestroyLoadedVector(library, field);
+    }
+    private void TauGetField(int index, int kind, out ulong field, out VdbMetaHandle metadata)
+    {
+        ObjectDisposedException.ThrowIf(m_bDisposed, this);
+        if (index < 0 || index >= nFieldCount()) throw new ArgumentOutOfRangeException();
+        try
+        {
+            var status = TauGetFieldNative(lib.hThis, hThis, index, kind, out field, out metadata);
+            TauCheckedCallbacks.Check(status, null, this);
+            if (field != 0 && metadata.Value == IntPtr.Zero)
+            {
+                TauDestroyLoadedField(lib.hThis, kind, field);
+                throw new InvalidOperationException("Loaded field returned incomplete ownership.");
+            }
+        }
+        finally { GC.KeepAlive(this); }
+    }
+    private void TauReleaseFailedLoadedField(int kind, ulong field, FieldMetadata? metadata, VdbMetaHandle rawMetadata)
+    {
+        try
+        {
+            try
+            {
+                if (metadata is not null) metadata.Dispose();
+                else if (rawMetadata.Value != IntPtr.Zero) TauDestroyLoadedMetadata(lib.hThis, rawMetadata);
+            }
+            finally { TauDestroyLoadedField(lib.hThis, kind, field); }
+        }
+        catch { /* Retain the original constructor failure after attempting both releases. */ }
+    }
+}
