<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <UseMonoRuntime>true</UseMonoRuntime>
    <OutputType>Exe</OutputType>
    <AssemblyName>Tau.PicoGK.Worker</AssemblyName>
    <RootNamespace>Tau.PicoGK.Worker</RootNamespace>
    <DefineConstants>$(DefineConstants);PICOGK_BROWSER</DefineConstants>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Runtime-authored IL is covered by explicit retention and browser conformance, not static trim analysis. Keep these diagnostics visible. -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2072;IL2075</WarningsNotAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
    <WasmBuildNative>true</WasmBuildNative>
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <WasmEnableThreads Condition="'$(WasmEnableThreads)' == ''">false</WasmEnableThreads>
    <DefineConstants Condition="'$(WasmEnableThreads)' == 'true'">$(DefineConstants);PICOGK_BROWSER_THREADS</DefineConstants>
    <EmccInitialHeapSize>268435456</EmccInitialHeapSize>
    <EmccMaximumHeapSize>4294967296</EmccMaximumHeapSize>
    <EmccStackSize>8388608</EmccStackSize>
  </PropertyGroup>
  <ItemGroup>
    <!-- Both environments compile the same compiler, protocol, capture and mesh writer. -->
    <Compile Include="../Tau.PicoGK.Worker/*.cs" />
    <Content Include="main.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="$(PicoGKProject)" AdditionalProperties="DefineConstants=PICOGK_BROWSER" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(TauPicoGKRoslynRoot)/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(TauPicoGKRoslynRoot)/Microsoft.CodeAnalysis.CSharp.dll" />
    <NativeFileReference Include="$(TauPicoGKArchiveRoot)/picogk.26.2.a" />
    <NativeFileReference Include="$(TauPicoGKArchiveRoot)/float-trig.o" />
    <NativeFileReference Include="$(TauPicoGKArchiveRoot)/libopenvdb.a" />
    <NativeFileReference Include="$(TauPicoGKArchiveRoot)/libtbb.a" />
    <NativeFileReference Include="$(TauPicoGKArchiveRoot)/libblosc.a" />
    <NativeFileReference Include="$(TauPicoGKArchiveRoot)/libz.a" />
  </ItemGroup>
  <Import Project="$(TauPicoGKRetentionProps)" Condition="Exists('$(TauPicoGKRetentionProps)')" />
  <Target Name="ValidateBrowserHostInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(PicoGKProject)')" Text="Provide the qualified browser PicoGK project via PicoGKProject." />
    <Error Condition="!Exists('$(TauPicoGKRetentionProps)')" Text="Provide the qualified AuthoringRetention.props via TauPicoGKRetentionProps." />
    <Error Condition="!Exists('$(TauPicoGKRoslynRoot)/Microsoft.CodeAnalysis.dll')" Text="Provide the patched Roslyn assemblies via TauPicoGKRoslynRoot." />
    <Error Condition="!Exists('$(TauPicoGKRoslynRoot)/Microsoft.CodeAnalysis.CSharp.dll')" Text="The patched C# compiler assembly is missing." />
    <Error Condition="!Exists('$(TauPicoGKArchiveRoot)/picogk.26.2.a')" Text="Provide a verified matching browser archive via TauPicoGKArchiveRoot." />
  </Target>
</Project>
