+        for (int64_t row = 0; row < info.height; ++row) for (int64_t column = 0; column < info.width; ++column) {
+            const int32_t x = mode == 0 ? plane : int32_t(int64_t(bounds.min().x()) + column);
+            const int32_t y = mode == 0 ? int32_t(int64_t(bounds.min().y()) + column) :
+                mode == 1 ? plane : int32_t(scalar ? int64_t(bounds.min().y()) + row : int64_t(bounds.max().y()) - row);
+            const int32_t z = mode >= 2 ? plane : int32_t(int64_t(bounds.max().z()) - row);
+            buffer[n++] = access.getValue(openvdb::Coord(x, y, z));
+        }
+        reads = n;
+    }
