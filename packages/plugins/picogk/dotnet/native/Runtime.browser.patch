+static int32_t TauGetVdbField(PKINSTANCE library, PKVDBFILE file, int32_t index,
+    TauVdbFieldKind kind, uint64_t* output, PKMETADATA* metadata) noexcept {
+    if (output) *output = 0;
+    if (metadata) *metadata = 0;
+    // Without output, publish only the file grid's own metadata (SaveToFile stamps it).
+    if ((!output && !metadata) || (output && output == metadata) || index < 0 ||
+        kind < TauVdbFieldKind::Voxels || kind > TauVdbFieldKind::Vector) return -1;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto source = owner->m_oVdbFiles.roGet(file);
+        if (index >= source->nGridCount()) throw std::invalid_argument("VDB field index is out of range");
+        auto grid = source->TauGridAt(index);
+        auto state = TauStateFor(grid);
+        std::lock_guard<std::recursive_mutex> lock(state->gate);
+        if (kind == TauVdbFieldKind::Vector) {
+            if (!grid->isType<Vec3SGrid>()) return;
+        } else {
+            if (!grid->isType<FloatGrid>() ||
+                (kind == TauVdbFieldKind::Voxels && grid->getGridClass() != GRID_LEVEL_SET)) return;
+        }
+        if (!TauHasSupportedGridTransform(*grid))
+            throw std::invalid_argument("VDB field has an unsupported transformation");
+        const char* className = kind == TauVdbFieldKind::Voxels ? "Voxels"
+            : kind == TauVdbFieldKind::Scalar ? "ScalarField" : "VectorField";
+        if (!output) {
+            auto fileMetadata = std::make_shared<VdbMeta>(grid, state);
+            const auto metadataHandle = owner->m_oVdbMetas.hAdd(std::move(fileMetadata));
+            try {
+                grid->insertMeta("PicoGK.Class", openvdb::StringMetadata(className));
+            } catch (...) {
+                owner->m_oVdbMetas.bDestroy(metadataHandle);
+                throw;
+            }
+            *metadata = metadataHandle;
+            return;
+        }
+        // Hand out a deep copy (MI5): an edit of the result never reaches the file or
+        // another result. Identical content keeps the file grid's generation until either changes.
+        auto copy = grid->deepCopyGrid();
+        auto copyState = TauStateFor(copy);
+        if (state->cacheable) copyState->generation = state->generation;
+        const auto publish = [&](auto field, auto& handles) {
+            std::shared_ptr<VdbMeta> resultMetadata;
+            if (metadata) {
+                resultMetadata = std::make_shared<VdbMeta>(copy, copyState);
+            }
+            const auto handle = handles.hAdd(std::move(field));
+            PKMETADATA metadataHandle = 0;
+            try {
+                if (metadata) metadataHandle = owner->m_oVdbMetas.hAdd(std::move(resultMetadata));
+                // Tag only after both owners exist: installed insertMeta copies before
+                // replacement and map insertion has the strong failure guarantee.
+                if (metadata) {
+                    copy->insertMeta("PicoGK.Class", openvdb::StringMetadata(className));
+                    grid->insertMeta("PicoGK.Class", openvdb::StringMetadata(className));
+                }
+                *output = handle;
+                if (metadata) *metadata = metadataHandle;
+            } catch (...) {
+                if (metadataHandle) owner->m_oVdbMetas.bDestroy(metadataHandle);
+                handles.bDestroy(handle);
+                throw;
+            }
+        };
+        if (kind == TauVdbFieldKind::Voxels) {
+            auto value = std::make_shared<Voxels>(gridPtrCast<FloatGrid>(copy), PICOGK_VOXEL_DEFAULTNARROWBAND, copyState);
+            value->TauBindCounters(owner->m_tauCounters);
+            publish(std::move(value), owner->m_oVoxels);
+        }
+        else if (kind == TauVdbFieldKind::Scalar)
+            publish(std::make_shared<ScalarField>(gridPtrCast<FloatGrid>(copy), copyState), owner->m_oScalarFields);
+        else
+            publish(std::make_shared<VectorField>(gridPtrCast<Vec3SGrid>(copy), copyState), owner->m_oVectorFields);
+    });
+}
