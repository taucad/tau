+// Serialize the immutable admitted hold once while this Go Library still lives.
+PICOGK_API int32_t TauCompute_EncodeGrid(PKINSTANCE library,uint64_t snapshot,uint64_t maximumEncoded,uint64_t maximumNative,
+    uint64_t* encodedBytes,uint64_t* nativeBytes) noexcept {
+    if(encodedBytes) *encodedBytes=0;if(nativeBytes) *nativeBytes=0;
+    if(!encodedBytes||!nativeBytes||encodedBytes==nativeBytes||maximumEncoded>uint64_t(INT64_MAX)||maximumNative>uint64_t(INT64_MAX)) return -1;
+    return TauCheckedInvoke([&] {
+        auto owner=Library::oLib().roGetInstance(library);auto value=owner->m_tauCaptures.roGet(snapshot);
+        std::lock_guard<std::recursive_mutex> hold(value->computeGate);
+        if(value->computeKind<0) throw std::invalid_argument("not a compute capture");
+        if(value->computeBytes.empty()) {
+            if(!value->computeGrid) throw std::invalid_argument("empty compute capture");
+            if(maximumNative<=sizeof(TauCapturedGeometry))throw std::length_error("compute export native budget");
+            const auto held=uint64_t(value->nMemUsage());
+            if(held>=maximumNative)throw std::length_error("compute export overlap budget");
+            const auto limit=std::min(maximumEncoded,maximumNative-held);
+            auto bytes=TauEncodeGrid(value->computeGrid,size_t(limit),value->computeKind,value->narrowBand,size_t(maximumNative-held));
+            value->computeBytes=std::move(bytes);value->computeGrid.reset();
+        }
+        if(uint64_t(value->nMemUsage())>maximumNative)throw std::length_error("compute export retained native budget");
+        if(value->computeBytes.size()>maximumEncoded) throw std::length_error("compute encoded budget");
+        *encodedBytes=value->computeBytes.size();*nativeBytes=uint64_t(value->nMemUsage());
+    });
+}
