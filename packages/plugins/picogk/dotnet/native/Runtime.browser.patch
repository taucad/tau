+    bool TauImplicitBoundsValid(const BBox3& bounds) const {
+        std::lock_guard<std::recursive_mutex> owner(m_tauObjectGate);
+        std::lock_guard<std::recursive_mutex> state(m_tauState->gate);
+        const float size = static_cast<float>(oVoxelSize());
+        if (!std::isfinite(size) || size <= 0 || m_nSdfNarrowBand < 0) return false;
+        const double low = static_cast<double>(INT32_MIN) + m_nSdfNarrowBand;
+        const double high = static_cast<double>(INT32_MAX) - m_nSdfNarrowBand - 1;
+        for (float coordinate : {bounds.vecMin.X, bounds.vecMin.Y, bounds.vecMin.Z,
+                                  bounds.vecMax.X, bounds.vecMax.Y, bounds.vecMax.Z}) {
+            const float voxel = coordinate / size;
+            if (!std::isfinite(voxel)) return false;
+            const double rounded = std::round(static_cast<double>(voxel));
+            if (rounded < low || rounded > high) return false;
+        }
+        return true;
+    }
