+}
+PICOGK_API void Voxels_GetSurfaceNormal(PKINSTANCE library, PKVOXELS voxels,
+    const PKVector3* point, PKVector3* output) {
+    int32_t hit = 0;
+    if (!output) return;
+    Vector3 observed(0,0,0);
+    if (TauVoxels_SurfaceQuery(library, voxels, 1, point, nullptr, &hit, &observed) == 0) *output = observed;
+}
+PICOGK_API bool Voxels_bClosestPointOnSurface(PKINSTANCE library, PKVOXELS voxels,
+    const PKVector3* point, PKVector3* output) {
+    int32_t hit = 0;
+    if (!output) return false;
+    Vector3 observed(0,0,0);
+    if (TauVoxels_SurfaceQuery(library, voxels, 2, point, nullptr, &hit, &observed) != 0 || !hit) return false;
+    *output = observed;
+    return true;
+}
+PICOGK_API bool Voxels_bRayCastToSurface(PKINSTANCE library, PKVOXELS voxels,
+    const PKVector3* point, const PKVector3* direction, PKVector3* output) {
+    int32_t hit = 0;
+    if (!output) return false;
+    Vector3 observed(0,0,0);
+    if (TauVoxels_SurfaceQuery(library, voxels, 3, point, direction, &hit, &observed) != 0 || !hit) return false;
