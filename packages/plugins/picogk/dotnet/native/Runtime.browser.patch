+// SPDX-License-Identifier: Apache-2.0
+#ifndef PICOGK_GRID_STATE_H
+#define PICOGK_GRID_STATE_H
+#include <openvdb/openvdb.h>
+#include <openvdb/tools/Interpolation.h>
+#include <openvdb/tools/RayIntersector.h>
+#include "PicoGKMesh.h"
+#include <mutex>
+#include <unordered_map>
+#include <array>
+#include <limits>
+namespace PicoGK {
+// The scalar-coordinate API implements only a positive uniform scale about the world origin.
+inline bool TauHasSupportedGridTransform(const openvdb::GridBase& grid) {
+    const auto& transform = grid.transform();
+    if (!transform.isLinear()) return false;
+    const auto origin = transform.indexToWorld(openvdb::Vec3d(0, 0, 0));
+    const auto x = transform.indexToWorld(openvdb::Vec3d(1, 0, 0));
+    const auto y = transform.indexToWorld(openvdb::Vec3d(0, 1, 0));
+    const auto z = transform.indexToWorld(openvdb::Vec3d(0, 0, 1));
+    if (origin != openvdb::Vec3d(0, 0, 0) || !std::isfinite(x.x()) || x.x() <= 0 ||
+        x != openvdb::Vec3d(x.x(), 0, 0) || y != openvdb::Vec3d(0, x.x(), 0) ||
+        z != openvdb::Vec3d(0, 0, x.x())) return false;
+    const float size = static_cast<float>(x.x());
+    return std::isfinite(size) && size > 0 && std::isfinite(1.f / size);
+}
+struct TauCaptureCounters {
+    std::atomic<uint64_t> surfaceBuilds{0};
+    std::atomic<uint64_t> surfaceHits{0};
+    std::atomic<uint64_t> activeBoundsBuilds{0};
+    std::atomic<uint64_t> activeBoundsHits{0};
+    std::atomic<uint64_t> sliceValueReads{0};
+    std::atomic<uint64_t> projectionRegions{0};
+    std::atomic<uint64_t> projectionColumns{0};
+    std::atomic<uint64_t> projectionUpdates{0};
+    std::atomic<uint64_t> propertyCorrections{0};
+    std::atomic<uint64_t> propertyHits{0};
+    std::atomic<uint64_t> volumeMeasures{0};
+    std::atomic<uint64_t> emptyBuilds{0};
+    std::atomic<uint64_t> emptyHits{0};
+    std::atomic<uint64_t> equalityRegions{0};
+    std::atomic<uint64_t> closestValueReads{0};
+    std::atomic<uint64_t> rayAccelerationBuilds{0};
+    std::atomic<uint64_t> rayAccelerationHits{0};
+};
+struct TauSurfaceGeneration {
+    uint64_t identity = TauNextGeneration();
+    std::recursive_mutex gate;
+    Mesh::Ptr surface;
+    // One adaptive display surface, keyed by its adaptivity bits and relax flag; replaced on key change.
+    Mesh::Ptr adaptiveSurface;
+    uint32_t adaptiveBits = 0;
+    bool adaptiveRelax = false;
+    openvdb::CoordBBox activeBounds;
+    bool activeBoundsReady = false;
+    // ponytail: one completed setting keeps storage bounded; revisit only on measured multi-setting contention.
+    uint32_t correctedVoxelSizeBits = 0;
+    float correctedVolume = 0;
+    bool correctedPropertiesReady = false;
+    std::atomic<uint8_t> emptyResult{0}; // 0 uncomputed, 1 empty, 2 active negative value.
+};
+// A ray stencil retains references into its grid. Keep this slot per grid, never
+// in the generation shared by independent deep clones. The state gate serializes scratch; intersection invokes no author callback.
+struct TauRayAcceleration {
+    openvdb::FloatGrid::Ptr grid;
+    openvdb::tools::LevelSetRayIntersector<openvdb::FloatGrid> intersector;
+    explicit TauRayAcceleration(openvdb::FloatGrid::Ptr source)
+        : grid(std::move(source)), intersector(*grid) {}
+};
+struct TauGridState;
+struct TauGridRegistry {
+    std::mutex gate;
+    std::unordered_map<const openvdb::GridBase*, std::weak_ptr<TauGridState>> states;
+};
+inline TauGridRegistry& TauGrids() { static auto* registry = new TauGridRegistry(); return *registry; }
+struct TauGridState {
+    const openvdb::GridBase* key;
+    std::recursive_mutex gate;
+    std::shared_ptr<TauSurfaceGeneration> generation = std::make_shared<TauSurfaceGeneration>();
+    std::unique_ptr<TauRayAcceleration> ray;
+    uint64_t metadataIdentity = TauNextGeneration();
+    bool cacheable = true;
+    std::shared_ptr<TauCaptureCounters> counters;
+    explicit TauGridState(const openvdb::GridBase* value) : key(value) {}
+    ~TauGridState() {
+        auto& registry = TauGrids(); std::lock_guard<std::mutex> lock(registry.gate);
+        auto found = registry.states.find(key);
+        if (found != registry.states.end() && found->second.expired()) registry.states.erase(found);
+    }
+};
+inline std::shared_ptr<TauGridState> TauStateFor(const openvdb::GridBase::Ptr& grid, bool trusted = true) {
+    std::shared_ptr<TauGridState> state;
+    {
+        auto& registry = TauGrids();
+        std::lock_guard<std::mutex> lock(registry.gate);
+        auto& slot = registry.states[grid.get()];
+        state = slot.lock();
+        if (!state) {
+            state = std::make_shared<TauGridState>(grid.get());
+            state->cacheable = trusted;
+            slot = state;
+        }
+    }
+    // A retained raw alias permanently demotes this owner. Release the registry
+    // before taking state.gate: callbacks already holding that gate can register grids.
+    if (!trusted) {
+        std::lock_guard<std::recursive_mutex> lock(state->gate);
+        state->cacheable = false;
+        state->ray.reset();
+    }
+    return state;
+}
+// Caller holds state.gate. A retained clone/extraction holder keeps its old identity and surface.
+inline void TauAccountGridState(TauOwnedMemory& memory, const std::shared_ptr<TauGridState>& state) {
+    if (!memory.Retain(state, TauOwnedMemory::Kind::State)) return;
+    std::lock_guard<std::recursive_mutex> owner(state->gate);
+    memory.Add(sizeof(TauGridState));
+    if (state->ray) { // BoxStencil owns eight scalar values in addition to its inline vector/accessor.
+        memory.Add(sizeof(TauRayAcceleration) + openvdb::math::BoxStencil<openvdb::FloatGrid>::SIZE * sizeof(float));
+        memory.Grid(state->ray->grid); }
+    if (memory.Retain(state->counters, TauOwnedMemory::Kind::Object)) memory.Add(sizeof(TauCaptureCounters));
+    auto generation = state->generation;
+    if (memory.Retain(generation, TauOwnedMemory::Kind::Generation)) {
+        std::lock_guard<std::recursive_mutex> surface(generation->gate);
+        memory.Add(sizeof(TauSurfaceGeneration)); memory.Object(generation->surface);
+        memory.Object(generation->adaptiveSurface);
+    }
+}
+inline void TauAdvanceGridGeneration(TauGridState& state) {
+    if (state.generation.use_count() == 1) {
+        // Identity exhaustion must fail before invalidating a surface or changing the old revision.
+        const auto identity = TauNextGeneration();
+        state.generation->surface.reset();
+        state.generation->adaptiveSurface.reset();
+        state.generation->activeBoundsReady = false;
+        state.generation->correctedPropertiesReady = false;
+        state.generation->emptyResult.store(0, std::memory_order_release);
+        state.generation->identity = identity;
+    } else {
+        state.generation = std::make_shared<TauSurfaceGeneration>();
+    }
+    state.ray.reset(); // Release registered accessor/grid pin before any tree mutation.
+}
+// Caller holds the grid state gate; immutable clone generations may share the result.
+template<class TGrid>
+inline openvdb::CoordBBox TauActiveBounds(const std::shared_ptr<TGrid>& grid,
+    const std::shared_ptr<TauGridState>& state) {
+    if (!state->cacheable) {
+        if (state->counters) ++state->counters->activeBoundsBuilds;
+        return grid->evalActiveVoxelBoundingBox();
+    }
+    auto generation = state->generation;
+    std::lock_guard<std::recursive_mutex> lock(generation->gate);
+    if (!generation->activeBoundsReady) {
+        const auto bounds = grid->evalActiveVoxelBoundingBox();
+        generation->activeBounds = bounds;
+        generation->activeBoundsReady = true;
+        if (state->counters) ++state->counters->activeBoundsBuilds;
+    } else if (state->counters) ++state->counters->activeBoundsHits;
+    return generation->activeBounds;
+}
+inline bool TauHasCachedGridRead(const std::shared_ptr<TauGridState>& state) {
+    auto generation = state->generation;
+    std::lock_guard<std::recursive_mutex> lock(generation->gate);
+    return bool(state->ray) || bool(generation->surface) || bool(generation->adaptiveSurface) || generation->activeBoundsReady || generation->correctedPropertiesReady || generation->emptyResult.load(std::memory_order_acquire) != 0;
+}
+class TauGridMutation {
+    std::shared_ptr<TauGridState> state;
+    std::unique_lock<std::recursive_mutex> lock;
+public:
+    explicit TauGridMutation(std::shared_ptr<TauGridState> value) : state(std::move(value)), lock(state->gate) {
+        TauAdvanceGridGeneration(*state);
+    }
+    TauGridMutation(std::shared_ptr<TauGridState> value, std::unique_lock<std::recursive_mutex> acquired)
+        : state(std::move(value)), lock(std::move(acquired)) {
+        if (!lock.owns_lock() || lock.mutex() != &state->gate)
+            throw std::invalid_argument("mutation lock does not own grid state");
+        TauAdvanceGridGeneration(*state);
+    }
+    void Unlock() { lock.unlock(); }
+    void Lock() { lock.lock(); }
+    void Retarget(std::shared_ptr<TauGridState> current) {
+        if (current == state) return;
+        if (TauHasCachedGridRead(state)) TauAdvanceGridGeneration(*state);
+        lock.unlock(); state = std::move(current);
+        lock = std::unique_lock<std::recursive_mutex>(state->gate);
+        TauAdvanceGridGeneration(*state);
+    }
+    std::shared_ptr<TauGridState> State() const { return state; }
+    ~TauGridMutation() {
+        if (!lock.owns_lock()) lock.lock();
+        // A reentrant callback may have captured an intermediate revision. Never retain that
+        // intermediate surface as the completed operation's generation, including on failure.
+        try {
+            if (TauHasCachedGridRead(state)) TauAdvanceGridGeneration(*state);
+        } catch (...) { state->cacheable = false; }
+    }
+};
+// Caller holds owner/state gates. Mode -1 observes dimensions, 0/1/2 reads X/Y/Z,
+// and mode 3 reads interpolated Z. Scalar rows ascend Y; voxel rows descend.
+inline int TauReadFloatSlice(const openvdb::FloatGrid::Ptr& grid,
+    const std::shared_ptr<TauGridState>& state, bool scalar, int32_t mode,
+    int32_t slice, float fractionalSlice, float* buffer, uint64_t capacity, TauSliceInfo& info) {
