+        std::lock_guard<std::recursive_mutex> hold(value->computeGate);
+        if(value->computeKind<0||value->computeBytes.empty()||capacity!=value->computeBytes.size()) throw std::invalid_argument("compute byte buffer length");
+        std::memcpy(output,value->computeBytes.data(),size_t(capacity));
+    });
+}
