+// Once-per-input revision content identity. Serialize under the shared state gate;
+// no deep snapshot and no caller/native pointer survives this checked synchronous call.
+PICOGK_API int32_t TauCompute_CaptureContent(PKINSTANCE library,int32_t kind,uint64_t object,
+    uint64_t geometry,uint64_t metadata,uint64_t maximumEncoded,uint64_t maximumNative,
+    uint64_t* snapshot,uint64_t* nativeBytes) noexcept {
+    if(snapshot)*snapshot=0;if(nativeBytes)*nativeBytes=0;
+    if(!snapshot||!nativeBytes||snapshot==nativeBytes||maximumEncoded>uint64_t(INT64_MAX)||maximumNative>uint64_t(INT64_MAX))return -1;
+    bool bypass=false;
+    const auto status=TauCheckedInvoke([&] {
+        auto owner=Library::oLib().roGetInstance(library);auto source=TauReadComputeSource(owner,kind,object);
+        std::lock_guard<std::recursive_mutex> state(source.state->gate);
+        if(!source.state->cacheable||source.state->generation->identity!=geometry||source.state->metadataIdentity!=metadata){bypass=true;return;}
+        auto value=std::make_shared<TauCapturedGeometry>();value->generation=geometry;value->metadataIdentity=metadata;
+        value->computeKind=kind;value->narrowBand=source.band;
+        if(maximumNative<=sizeof(TauCapturedGeometry)){bypass=true;return;}
+        const auto limit=std::min(maximumEncoded,maximumNative-sizeof(TauCapturedGeometry));
+        value->computeBytes=TauEncodeGrid(source.grid,size_t(limit),kind,source.band,size_t(maximumNative-sizeof(TauCapturedGeometry)));
+        const auto bytes=value->nMemUsage();if(uint64_t(bytes)>maximumNative){bypass=true;return;}
+        const auto handle=owner->m_tauCaptures.hAddWithIdentity(value,TauNextGeneration());
+        *snapshot=handle;*nativeBytes=uint64_t(bytes);
+    });
+    return status?status:bypass?1:0;
+}
