+// Immutable copies retain COW vector backing without retaining the source handle/library.
+static int32_t TauCapturePositionCount(const TauCapturedGeometry& value) {
+    const auto size = value.mesh ? value.mesh->vVertices().size() : value.line->vVertices().size();
+    if (size > static_cast<size_t>(INT32_MAX / 3)) throw std::overflow_error("capture position count");
+    return static_cast<int32_t>(size * 3);
+}
+static int32_t TauCaptureIndexCount(const TauCapturedGeometry& value) {
+    const auto elements = value.mesh ? value.mesh->vTriangles().size() :
+        (value.line->vVertices().empty() ? 0 : value.line->vVertices().size() - 1);
+    const auto width = value.mesh ? size_t(3) : size_t(2);
+    if (elements > static_cast<size_t>(INT32_MAX) / width) throw std::overflow_error("capture index count");
+    return static_cast<int32_t>(elements * width);
+}
+PICOGK_API int32_t TauCapture_Acquire(PKINSTANCE library, int32_t kind, uint64_t object,
+    uint64_t* snapshot, uint64_t* generation, int32_t* positions, int32_t* indices, PKColorFloat* color) {
+    if (!snapshot || !generation || !positions || !indices || !color) return -1;
+    *snapshot = 0; *generation = 0; *positions = 0; *indices = 0;
+    try {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto result = std::make_shared<TauCapturedGeometry>();
+        result->kind = kind; result->identity = object;
+        if (kind == 0) {
+            result->mesh = owner->m_oMeshes.roGet(object)->TauCapture();
+            result->generation = result->mesh->TauGeneration();
+        } else if (kind == 1) {
+            auto captured = owner->m_oVoxels.roGet(object)->TauCaptureSurface(
+                owner->m_tauMeshAdaptivity.load(), owner->m_tauMeshRelax.load());
+            result->mesh = std::move(captured.first); result->generation = captured.second;
+        } else if (kind == 2) {
+            result->line = owner->m_oPolyLines.roGet(object)->TauCapture();
+            result->generation = result->line->TauGeneration();
+        } else return -1;
+        const auto positionCount = TauCapturePositionCount(*result);
+        const auto indexCount = TauCaptureIndexCount(*result);
+        if (result->mesh ? !result->mesh->TauValidate() : !result->line->TauValidate()) return -1;
+        const auto handle = owner->m_tauCaptures.hAddWithIdentity(result, TauNextGeneration());
+        *snapshot = handle; *generation = result->generation; *positions = positionCount; *indices = indexCount;
+        *color = result->line ? result->line->clrLines() : ColorFloat{1, 1, 1, 1};
+        ++owner->m_tauCaptureAcquires;
+        return 0;
+    } catch (const std::out_of_range&) { return -3; }
+      catch (const std::invalid_argument&) { return -1; }
+      catch (const std::overflow_error&) { return -1; }
+      catch (...) { return -2; }
+}
