+    template<class TBatch>
+    static Ptr TauCreateSurfaceNormals(Voxels& voxels, float destinationSize, float threshold, TBatch batch) {
+        auto source = voxels.TauPinGrid();
+        std::lock_guard<std::recursive_mutex> state(source.state->gate);
+        const auto generation = source.state->generation->identity;
+        const auto voxelSize = source.grid->voxelSize();
+        if (!TauHasSupportedGridTransform(*source.grid) ||
+            !std::isfinite(destinationSize) || destinationSize <= 0 || !std::isfinite(1.f / destinationSize))
+            throw std::invalid_argument("invalid normal field voxel transform");
+        const VoxelSize sourceSize(static_cast<float>(voxelSize.x()));
+        const VoxelSize targetSize(destinationSize);
+        const auto coordinate = [](const Vector3& position, VoxelSize size, bool stencil) {
+            for (auto value : {position.X, position.Y, position.Z}) {
+                const double rounded = std::round(size.fToVoxels(value));
+                const double margin = stencil ? 1 : 0;
+                if (!std::isfinite(value) || !std::isfinite(rounded) ||
+                    rounded < double(std::numeric_limits<int32_t>::min()) + margin ||
+                    rounded > double(std::numeric_limits<int32_t>::max()) - margin)
+                    throw std::invalid_argument("normal field coordinate exceeds native range");
+            }
+            return size.xyzToVoxels(position);
+        };
+        auto result = std::make_shared<VectorField>(destinationSize);
+        auto output = result->m_roGrid->getAccessor();
+        math::GradStencil stencil(*source.grid);
+        constexpr uint32_t capacity = 256;
+        std::array<float, capacity * 3> positions{};
+        std::array<float, capacity * 3> normals{}, values{};
+        std::array<uint8_t, capacity> keep{};
+        uint32_t count = 0;
+        const auto flush = [&] {
+            if (count == 0) return;
+            batch(count, normals.data(), values.data(), keep.data());
+            if (source.state->generation->identity != generation)
+                throw std::invalid_argument("source changed during internal normal batch");
+            for (uint32_t i = 0; i < count; ++i) {
+                if (keep[i] > 1) throw std::invalid_argument("invalid normal batch selection");
+                if (!keep[i]) continue;
+                const auto xyz = coordinate(Vector3(positions[i * 3], positions[i * 3 + 1], positions[i * 3 + 2]), targetSize, false);
+                output.setValue(openvdb::Coord(xyz.X, xyz.Y, xyz.Z),
+                    openvdb::Vec3s(values[i * 3], values[i * 3 + 1], values[i * 3 + 2]));
+            }
+            count = 0;
+        };
+        for (auto value = source.grid->cbeginValueOn(); value; ++value) {
+            if (std::abs(value.getValue()) > threshold) continue;
+            const auto xyz = value.getCoord();
+            const Vector3 position = sourceSize.vecToMM(Coord(xyz.x(), xyz.y(), xyz.z()));
+            // Preserve the managed traversal -> mm -> native query roundtrip.
+            const auto query = coordinate(position, sourceSize, true);
+            stencil.moveTo(openvdb::Coord(query.X, query.Y, query.Z));
+            auto normal = stencil.gradient();
+            normal.normalize();
+            positions[count * 3] = position.X;
+            positions[count * 3 + 1] = position.Y;
+            positions[count * 3 + 2] = position.Z;
+            normals[count * 3] = normal.x();
+            normals[count * 3 + 1] = normal.y();
+            normals[count * 3 + 2] = normal.z();
+            if (++count == capacity) flush();
+        }
+        flush();
+        return result;
+    }
