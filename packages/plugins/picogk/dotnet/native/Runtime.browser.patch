+PICOGK_API int32_t TauCapture_Copy(PKINSTANCE library, uint64_t snapshot,
+    float* positions, int32_t positionCapacity, uint32_t* indices, int32_t indexCapacity) {
+    if (positionCapacity < 0 || indexCapacity < 0) return -1;
+    try {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto source = owner->m_tauCaptures.roGet(snapshot);
+        const auto pCount = TauCapturePositionCount(*source), iCount = TauCaptureIndexCount(*source);
+        if (positionCapacity < pCount || indexCapacity < iCount || (pCount && !positions) || (iCount && !indices)) return -1;
+        const auto& vertices = source->mesh ? source->mesh->vVertices() : source->line->vVertices();
+        for (size_t i = 0; i < vertices.size(); ++i) {
+            positions[i * 3] = vertices[i].X; positions[i * 3 + 1] = vertices[i].Y; positions[i * 3 + 2] = vertices[i].Z;
+        }
+        if (source->mesh) {
+            const auto& triangles = source->mesh->vTriangles();
+            for (size_t i = 0; i < triangles.size(); ++i) {
+                indices[i * 3] = static_cast<uint32_t>(triangles[i].A);
+                indices[i * 3 + 1] = static_cast<uint32_t>(triangles[i].B);
+                indices[i * 3 + 2] = static_cast<uint32_t>(triangles[i].C);
+            }
+        } else {
+            for (size_t i = 0; i + 1 < vertices.size(); ++i) { indices[i * 2] = static_cast<uint32_t>(i); indices[i * 2 + 1] = static_cast<uint32_t>(i + 1); }
+        }
+        ++owner->m_tauCaptureCopies;
+        return 0;
+    } catch (const std::out_of_range&) { return -3; }
+      catch (const std::overflow_error&) { return -1; }
+      catch (...) { return -2; }
+}
