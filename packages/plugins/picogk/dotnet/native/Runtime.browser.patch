+namespace {
+// Tau: one managed transition per z-row. The callback fills distances[0, count) in order and reports in
+// *completed how many it filled, also when it stops (nonzero). Values are checked in that same order, so a
+// nonfinite or stopped row writes exactly the voxels the per-voxel adapter wrote before failing.
+struct TauBatchSdfSampler {
+    TauCheckedSdfBatch callback;
+    void operator()(const PKVector3* points, float* values, size_t count, size_t& sampled) const {
+        if (count > size_t(INT32_MAX)) throw std::overflow_error("implicit row exceeds int32");
+        int32_t completed = 0;
+        const int32_t status = callback(points, values, int32_t(count), &completed);
+        if (completed < 0 || size_t(completed) > count) throw std::invalid_argument("invalid SDF batch count");
+        for (; sampled < size_t(completed); sampled++)
+            if (!std::isfinite(values[sampled])) throw std::invalid_argument("nonfinite SDF callback value");
+        if (status != 0) throw TauCallbackStopped{};
+        if (sampled != count) throw std::invalid_argument("incomplete SDF batch");
+    }
+};
+}
