+                    openvdb::tools::BoxSampler::getValues(data, access, openvdb::Coord(int32_t(x), int32_t(y), plane));
+                    reads += 8;
+                } else {
+                    for (int j = 0; j < 2; ++j) for (int k = 0; k < 2; ++k) {
+                        data[0][j][k] = data[1][j][k];
