diff --git a/Source/PicoGKCaptureIdentity.h b/Source/PicoGKCaptureIdentity.h
new file mode 100644
index 000000000..17f0325ca
--- /dev/null
+++ b/Source/PicoGKCaptureIdentity.h
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef PICOGK_CAPTURE_IDENTITY_H
+#define PICOGK_CAPTURE_IDENTITY_H
+#include <atomic>
+#include <cstdint>
+#include <stdexcept>
+namespace PicoGK {
+inline uint64_t TauAllocateGeneration(std::atomic<uint64_t>& next) {
+    auto value = next.load(std::memory_order_relaxed);
+    for (;;) {
+        if (value == UINT64_MAX) throw std::overflow_error("PicoGK generation exhausted");
+        if (next.compare_exchange_weak(value, value + 1, std::memory_order_relaxed)) return value + 1;
+    }
+}
+inline uint64_t TauNextGeneration() {
+    static std::atomic<uint64_t> next{0};
+    return TauAllocateGeneration(next);
+}
+}
+#endif
