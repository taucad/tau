+    void TauCalculateProperties(float libraryVoxelSize, bool includeVolume, float& volume, BBox3& bounds) const {
+        if (!std::isfinite(libraryVoxelSize) || libraryVoxelSize <= 0)
+            throw std::invalid_argument("invalid property voxel size");
+        std::lock_guard<std::recursive_mutex> owner(m_tauObjectGate);
+        std::lock_guard<std::recursive_mutex> state(m_tauState->gate);
+        auto generation = m_tauState->generation;
+        std::lock_guard<std::recursive_mutex> lock(generation->gate);
+        const auto surface = TauSurfaceLocked();
+        const auto observedBounds = surface->oBBox();
+        float observedVolume = 0;
+        if (includeVolume) {
+            const auto sizeBits = std::bit_cast<uint32_t>(libraryVoxelSize);
+            if (m_tauState->cacheable && generation->correctedPropertiesReady &&
+                generation->correctedVoxelSizeBits == sizeBits) {
+                observedVolume = generation->correctedVolume;
+                if (m_tauState->counters) ++m_tauState->counters->propertyHits;
+            } else {
+                if (m_tauState->counters) ++m_tauState->counters->propertyCorrections;
+                // Preserve mesh -> fresh default-band library grid -> volume arithmetic.
+                {
+                    Voxels corrected(VoxelSize(libraryVoxelSize), PICOGK_VOXEL_DEFAULTNARROWBAND);
+                    corrected.TauBindCounters(m_tauState->counters);
+                    corrected.TauRenderCapturedMesh(*surface, m_roGrid.get());
+                    observedVolume = corrected.fCalculateVolume();
+                }
+                if (m_tauState->cacheable) {
+                    generation->correctedVoxelSizeBits = sizeBits;
+                    generation->correctedVolume = observedVolume;
+                    generation->correctedPropertiesReady = true;
+                }
+            }
+        }
+        bounds = observedBounds;
+        volume = observedVolume;
+    }
