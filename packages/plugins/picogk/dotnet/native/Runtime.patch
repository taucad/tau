+PICOGK_API int32_t TauMesh_CreatePlacedIndexed(PKINSTANCE library, uint64_t snapshot,
+    const float* matrix, int32_t matrixCount, const float* positions, int32_t positionCount,
+    const uint32_t* indices, int32_t indexCount, PKMESH* output) {
+    if (!output) return -1;
+    *output = 0;
+    if (!matrix || matrixCount != 16) return -1;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto capture = owner->m_tauCaptures.roGet(snapshot);
+        if (!capture->mesh) throw std::invalid_argument("placement requires a frozen mesh capture");
+        auto mesh = Mesh::TauCreateIndexed(positions, positionCount, indices, indexCount);
+        mesh->TauSetPlacement(*capture->mesh, matrix);
+        *output = owner->m_oMeshes.hAdd(mesh);
+    });
+}
+PICOGK_API int32_t TauMesh_AppendIndexed(PKINSTANCE library, PKMESH target,
+    const float* positions, int32_t positionCount, const uint32_t* indices, int32_t indexCount) {
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        owner->m_oMeshes.roGet(target)->TauAppendIndexed(positions, positionCount, indices, indexCount);
+    });
+}
+
+// One retained library/object lookup and a typed contiguous copy. The managed
+// counts are copied from one retained immutable generation per call. Multi-call
+// transactions use the capture-token ABI, not separate mutable-handle reads.
+PICOGK_API int32_t Tau_Mesh_GetVertices(PKINSTANCE hLib, PKMESH hMesh,
+                                      PKVector3* pBuffer, int32_t nCapacity) noexcept
+{
+    if (pBuffer == nullptr || nCapacity <= 0) return 0;
+    static_assert(std::is_nothrow_copy_assignable_v<Vector3>);
+    try
+    {
+        // Resolve everything before writing. Typed assignment cannot throw.
+        auto roLib = Library::oLib().roGetInstance(hLib);
+        auto roMesh = roLib->m_oMeshes.roGet(hMesh)->TauCapture();
+        const auto& vertices = roMesh->vVertices();
+        const auto count = std::min(vertices.size(), static_cast<size_t>(nCapacity));
+        std::copy_n(vertices.begin(), count, pBuffer);
+        return static_cast<int32_t>(count);
+    }
+    catch (...) { return -1; }
+}
+
+PICOGK_API int32_t Tau_Mesh_GetTriangles(PKINSTANCE hLib, PKMESH hMesh,
+                                       PKTriangle* pBuffer, int32_t nCapacity) noexcept
+{
+    if (pBuffer == nullptr || nCapacity <= 0) return 0;
+    static_assert(std::is_nothrow_copy_assignable_v<Triangle>);
+    try
+    {
+        // Resolve everything before writing. Typed assignment cannot throw.
+        auto roLib = Library::oLib().roGetInstance(hLib);
+        auto roMesh = roLib->m_oMeshes.roGet(hMesh)->TauCapture();
+        const auto& triangles = roMesh->vTriangles();
+        const auto count = std::min(triangles.size(), static_cast<size_t>(nCapacity));
+        std::copy_n(triangles.begin(), count, pBuffer);
+        return static_cast<int32_t>(count);
+    }
+    catch (...) { return -1; }
+}
+
+// Private checked logical ownership snapshot; failures never cross the C boundary or masquerade as zero bytes.
+PICOGK_API int32_t TauLibrary_GetOwnedMemory(PKINSTANCE library, int32_t category, int64_t* bytes) noexcept {
+    if (!bytes) return -1;
+    *bytes = 0;
+    try { auto owner = Library::oLib().roGetInstance(library); *bytes = owner->TauOwnedBytes(category); return 0; }
+    catch (const std::out_of_range&) { return -3; }
+    catch (const std::invalid_argument&) { return -1; }
+    catch (const std::overflow_error&) { return -1; }
+    catch (...) { return -2; }
+}
+
+PICOGK_API int32_t TauVoxels_GetOwnedMemory(PKINSTANCE library, PKVOXELS voxels, int64_t* bytes) noexcept {
+    if (!bytes) return -1;
+    *bytes = 0;
+    try {
+        auto owner = Library::oLib().roGetInstance(library);
+        TauOwnedMemory memory; memory.Object(owner->m_oVoxels.roGet(voxels));
+        *bytes = memory.Bytes(); return 0;
+    } catch (const std::out_of_range&) { return -3; }
+      catch (const std::overflow_error&) { return -1; }
+      catch (...) { return -2; }
+}
+
+PICOGK_API int32_t TauVoxels_CreateCsg(PKINSTANCE library, PKVOXELS left, PKVOXELS right,
+    int32_t operation, PKVOXELS* output, PKMETADATA* metadata) noexcept {
+    if (output) *output = 0;
+    if (metadata) *metadata = 0;
+    if (!output || !metadata || output == metadata || operation < 0 || operation > 2) return -1;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto lhs = owner->m_oVoxels.roGet(left);
+        auto rhs = owner->m_oVoxels.roGet(right);
+        auto result = Voxels::TauCreateCsg(*lhs, *rhs, operation);
+        auto grid = result->TauPinGrid();
+        grid.grid->insertMeta("PicoGK.Class", openvdb::StringMetadata("Voxels"));
+        auto resultMetadata = std::make_shared<VdbMeta>(grid.grid, grid.state);
+        const auto voxelHandle = TauAddVoxels(owner, result);
+        try {
+            const auto metadataHandle = owner->m_oVdbMetas.hAdd(std::move(resultMetadata));
+            *output = voxelHandle;
+            *metadata = metadataHandle;
+        } catch (...) {
+            owner->m_oVoxels.bDestroy(voxelHandle);
+            throw;
+        }
+    });
+}
