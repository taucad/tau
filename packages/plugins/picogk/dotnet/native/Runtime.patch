+PICOGK_API int32_t TauVoxels_MutateCsg(PKINSTANCE library, PKVOXELS target,
+    PKVOXELS source, int32_t operation) noexcept {
+    if (operation < 0 || operation > 2) return -1;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto left = owner->m_oVoxels.roGet(target);
+        auto right = owner->m_oVoxels.roGet(source);
+        if (operation == 0) left->BoolAdd(*right);
+        else if (operation == 1) left->BoolSubtract(*right);
+        else left->BoolIntersect(*right);
+    });
