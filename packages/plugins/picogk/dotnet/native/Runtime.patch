+inline size_t TauBloscBlock(const char* data,size_t encoded,size_t expected,TauComputeBound& bound,bool delayedMetadata=false) {
+    if(encoded<BLOSC_MIN_HEADER_LENGTH)throw std::invalid_argument("compute Blosc header length");
+    size_t raw=0,compressed=0,block=0;blosc_cbuffer_sizes(data,&raw,&compressed,&block);
+    const bool padded=delayedMetadata&&expected>48&&expected<128&&raw==128;
+    if(compressed!=encoded||(raw!=expected&&!padded)||(raw&&block>raw)||block==0)throw std::invalid_argument("compute Blosc size identity");
+    size_t validated=0;
+    if(blosc_cbuffer_validate(data,encoded,&validated)!=0||validated!=raw)throw std::invalid_argument("compute Blosc invalid buffer");
+    // blosc.c:1748/1920 uses three block workspaces plus <=4*typesize.
+    // Both VDB readers call decompress_ctx with one thread; block<=raw above.
+    bound.Scratch(encoded+8*raw+2*BLOSC_MAX_OVERHEAD+65536);return raw;
