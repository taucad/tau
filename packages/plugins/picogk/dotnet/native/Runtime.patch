+        // intermediate surface as the completed operation's generation, including on failure.
+        try {
+            if (TauHasCachedGridRead(state)) TauAdvanceGridGeneration(*state);
+        } catch (...) { state->cacheable = false; }
+    }
+};
+// Caller holds owner/state gates. Mode -1 observes dimensions, 0/1/2 reads X/Y/Z,
+// and mode 3 reads interpolated Z. Scalar rows ascend Y; voxel rows descend.
+inline int TauReadFloatSlice(const openvdb::FloatGrid::Ptr& grid,
+    const std::shared_ptr<TauGridState>& state, bool scalar, int32_t mode,
+    int32_t slice, float fractionalSlice, float* buffer, uint64_t capacity, TauSliceInfo& info) {
+    if (mode < -1 || mode > 3 || (scalar && mode != -1 && mode != 2))
+        throw std::invalid_argument("invalid slice mode");
+    const auto bounds = TauActiveBounds(grid, state);
+    info.xOrigin = bounds.min().x(); info.yOrigin = bounds.min().y(); info.zOrigin = bounds.min().z();
+    const auto extent = [&](int axis) -> int32_t {
+        if (bounds.empty()) return 0;
+        const int64_t size = int64_t(bounds.max()[axis]) - bounds.min()[axis] + 1;
+        if (size > std::numeric_limits<int32_t>::max()) throw std::overflow_error("slice dimension exceeds int32");
+        return static_cast<int32_t>(size);
+    };
+    info.xSize = extent(0); info.ySize = extent(1); info.zSize = extent(2);
+    info.background = grid->background();
+    if (mode == -1) return 0;
+    info.width = mode == 0 ? info.ySize : info.xSize;
+    info.height = mode >= 2 ? info.ySize : info.zSize;
+    info.required = uint64_t(info.width) * uint64_t(info.height);
+    int32_t plane = 0;
+    double sampleZ = 0;
+    if (mode == 3 && !std::isfinite(fractionalSlice))
+        throw std::invalid_argument("nonfinite interpolated slice");
+    if (bounds.empty()) return 0;
+    if (mode == 3) {
+        // Preserve the legacy float addition before promotion into Vec3R.
+        sampleZ = fractionalSlice + bounds.min().z();
+        const double base = std::floor(sampleZ);
+        if (!std::isfinite(fractionalSlice) || !std::isfinite(sampleZ) ||
+            base < std::numeric_limits<int32_t>::min() || base >= std::numeric_limits<int32_t>::max() ||
+            (!bounds.empty() && (bounds.max().x() == std::numeric_limits<int32_t>::max() ||
+                bounds.max().y() == std::numeric_limits<int32_t>::max())))
+            throw std::invalid_argument("interpolated slice exceeds native coordinate range");
+        plane = static_cast<int32_t>(base);
+    } else if (!bounds.empty()) {
+        const int64_t observed = int64_t(bounds.min()[mode]) + slice;
+        if (observed < std::numeric_limits<int32_t>::min() || observed > std::numeric_limits<int32_t>::max())
+            throw std::invalid_argument("slice exceeds native coordinate range");
+        plane = static_cast<int32_t>(observed);
+    }
+    if (capacity < info.required) return 1;
+    if (info.required && !buffer) throw std::invalid_argument("null slice buffer");
+    if (bounds.empty()) return 0;
+    auto access = grid->getConstAccessor();
+    uint64_t n = 0;
+    uint64_t reads = 0;
+    if (mode == 3) {
+        const openvdb::Vec3R weights(0, 0, sampleZ - plane);
+        for (int64_t y = bounds.max().y(); y >= bounds.min().y(); --y) {
+            float data[2][2][2];
+            for (int64_t x = bounds.min().x(); x <= bounds.max().x(); ++x) {
+                if (x == bounds.min().x()) {
+                    openvdb::tools::BoxSampler::getValues(data, access, openvdb::Coord(int32_t(x), int32_t(y), plane));
+                    reads += 8;
+                } else {
+                    for (int j = 0; j < 2; ++j) for (int k = 0; k < 2; ++k) {
+                        data[0][j][k] = data[1][j][k];
+                        data[1][j][k] = access.getValue(openvdb::Coord(int32_t(x + 1), int32_t(y + j), plane + k));
+                    }
+                    reads += 4;
+                }
+                buffer[n++] = openvdb::tools::BoxSampler::trilinearInterpolation(data, weights);
+            }
+        }
+    } else {
+        for (int64_t row = 0; row < info.height; ++row) for (int64_t column = 0; column < info.width; ++column) {
+            const int32_t x = mode == 0 ? plane : int32_t(int64_t(bounds.min().x()) + column);
+            const int32_t y = mode == 0 ? int32_t(int64_t(bounds.min().y()) + column) :
+                mode == 1 ? plane : int32_t(scalar ? int64_t(bounds.min().y()) + row : int64_t(bounds.max().y()) - row);
+            const int32_t z = mode >= 2 ? plane : int32_t(int64_t(bounds.max().z()) - row);
+            buffer[n++] = access.getValue(openvdb::Coord(x, y, z));
+        }
+        reads = n;
+    }
+    if (state->counters) state->counters->sliceValueReads += reads;
+    return 0;
+}
