diff --git a/Source/PicoGKGridState.h b/Source/PicoGKGridState.h
new file mode 100644
index 000000000..003a09e3c
--- /dev/null
+++ b/Source/PicoGKGridState.h
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef PICOGK_GRID_STATE_H
+#define PICOGK_GRID_STATE_H
+#include <openvdb/openvdb.h>
+#include "PicoGKMesh.h"
+#include <mutex>
+#include <unordered_map>
+#include <array>
+#include <limits>
+namespace PicoGK {
+struct TauCaptureCounters {
+    std::atomic<uint64_t> surfaceBuilds{0};
+    std::atomic<uint64_t> surfaceHits{0};
+};
+struct TauSurfaceGeneration {
+    uint64_t identity = TauNextGeneration();
+    std::recursive_mutex gate;
+    Mesh::Ptr surface;
+};
+struct TauGridState;
+struct TauGridRegistry {
+    std::mutex gate;
+    std::unordered_map<const openvdb::GridBase*, std::weak_ptr<TauGridState>> states;
+};
+inline TauGridRegistry& TauGrids() { static auto* registry = new TauGridRegistry(); return *registry; }
+struct TauGridState {
+    const openvdb::GridBase* key;
+    std::recursive_mutex gate;
+    std::shared_ptr<TauSurfaceGeneration> generation = std::make_shared<TauSurfaceGeneration>();
+    bool cacheable = true;
+    std::shared_ptr<TauCaptureCounters> counters;
+    explicit TauGridState(const openvdb::GridBase* value) : key(value) {}
+    ~TauGridState() {
+        auto& registry = TauGrids(); std::lock_guard<std::mutex> lock(registry.gate);
+        auto found = registry.states.find(key);
+        if (found != registry.states.end() && found->second.expired()) registry.states.erase(found);
+    }
+};
+inline std::shared_ptr<TauGridState> TauStateFor(const openvdb::GridBase::Ptr& grid, bool trusted = true) {
+    auto& registry = TauGrids(); std::lock_guard<std::mutex> lock(registry.gate);
+    auto& slot = registry.states[grid.get()];
+    if (auto state = slot.lock()) return state;
+    auto state = std::make_shared<TauGridState>(grid.get()); state->cacheable = trusted; slot = state; return state;
+}
+class TauGridMutation {
+    std::shared_ptr<TauGridState> state;
+    std::unique_lock<std::recursive_mutex> lock;
+public:
+    explicit TauGridMutation(std::shared_ptr<TauGridState> value) : state(std::move(value)), lock(state->gate) {
+        state->generation = std::make_shared<TauSurfaceGeneration>();
+    }
+    void Unlock() { lock.unlock(); }
+    void Lock() { lock.lock(); }
+    void Retarget(std::shared_ptr<TauGridState> current) {
+        if (current == state) return;
+        if (state->generation->surface) state->generation = std::make_shared<TauSurfaceGeneration>();
+        lock.unlock(); state = std::move(current);
+        lock = std::unique_lock<std::recursive_mutex>(state->gate);
+        state->generation = std::make_shared<TauSurfaceGeneration>();
+    }
+    std::shared_ptr<TauGridState> State() const { return state; }
+    ~TauGridMutation() {
+        if (!lock.owns_lock()) lock.lock();
+        // A reentrant callback may have captured an intermediate revision. Never retain that
+        // intermediate surface as the completed operation's generation, including on failure.
+        if (state->generation->surface) {
+            try { state->generation = std::make_shared<TauSurfaceGeneration>(); }
+            catch (...) { state->cacheable = false; }
+        }
+    }
+};
+using TauTraversalKey = std::array<int64_t, 6>;
+inline TauTraversalKey TauActiveKey(const openvdb::Coord& xyz, unsigned depth, bool afterRegion) {
+    const int64_t high = std::numeric_limits<int64_t>::max();
+    auto offset = [&](unsigned shift, unsigned bits) -> int64_t {
+        const unsigned mask = (1u << bits) - 1;
+        return ((static_cast<uint32_t>(xyz.x()) >> shift & mask) << (2 * bits)) |
+               ((static_cast<uint32_t>(xyz.y()) >> shift & mask) << bits) |
+               (static_cast<uint32_t>(xyz.z()) >> shift & mask);
+    };
+    return {xyz.x() & ~4095, xyz.y() & ~4095, xyz.z() & ~4095,
+        depth == 0 && afterRegion ? high : offset(7, 5),
+        depth <= 1 && afterRegion ? high : offset(3, 4),
+        depth <= 2 && afterRegion ? high : offset(0, 3)};
+}
+template<class TGrid, class TCallback>
+inline void TauTraverseValues(const typename TGrid::Ptr& grid, const std::shared_ptr<TauGridState>& state, TCallback callback) {
+    using Upper = typename TGrid::TreeType::RootNodeType::ChildNodeType;
+    using Lower = typename Upper::ChildNodeType;
+    using Leaf = typename Lower::ChildNodeType;
+    static_assert(Upper::TOTAL == 12 && Lower::TOTAL == 7 && Leaf::TOTAL == 3);
+    std::unique_lock<std::recursive_mutex> lock(state->gate);
+    auto iterator = grid->cbeginValueOn();
+    while (iterator) {
+        const auto location = iterator.getCoord();
+        const auto value = iterator.getValue();
+        const auto generation = state->generation->identity;
+        const auto end = TauActiveKey(location, iterator.getDepth(), true);
+        lock.unlock(); callback(location, value); lock.lock();
+        if (generation == state->generation->identity) ++iterator;
+        else {
+            // ponytail: mutating callbacks restart O(M) to avoid invalidated native iterators;
+            // add a tree cursor seek only if those workloads make this O(M^2) path material.
+            iterator = grid->cbeginValueOn();
+            while (iterator && TauActiveKey(iterator.getCoord(), iterator.getDepth(), false) <= end) ++iterator;
+        }
+    }
+}
+
+}
+#endif
