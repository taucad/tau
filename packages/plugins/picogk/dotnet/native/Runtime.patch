+    auto resource = std::make_shared<MeshGeometry>(*m_roShaderProgMeshPoly, std::move(snapshot));
+    m_oMeshGeometry.emplace(generation, resource); return resource;
+}
+void Viewer::RetireGeometry(uint64_t generation, bool line) {
+    if (!generation) return;
+    if (line) {
+        const auto entry = m_oLineGeometry.find(generation);
+        if (entry != m_oLineGeometry.end() && entry->second.use_count() == 1) m_oLineGeometry.erase(entry);
+    } else {
+        const auto entry = m_oMeshGeometry.find(generation);
+        if (entry != m_oMeshGeometry.end() && entry->second.use_count() == 1) m_oMeshGeometry.erase(entry);
+    }
+}
+std::shared_ptr<Viewer::LineGeometry> Viewer::roLineGeometry(PolyLine::Ptr snapshot) {
+    const auto generation = snapshot->TauGeneration();
+    auto found = m_oLineGeometry.find(generation);
+    if (found != m_oLineGeometry.end()) return found->second;
+    auto resource = std::make_shared<LineGeometry>(*m_roShaderProgMeshPoly, std::move(snapshot));
+    m_oLineGeometry.emplace(generation, resource); return resource;
+}
+
+void Viewer::AddCaptured(int32_t groupID, int64_t library, int64_t identity, int32_t kind,
+                         Mesh::Ptr mesh, PolyLine::Ptr line) {
+    if ((kind == 2 ? !line || mesh : !mesh || line) || kind < 0 || kind > 2)
+        throw std::invalid_argument("captured viewer geometry kind");
+    glfwMakeContextCurrent(m_pTheWindow);
+    auto group = roGroupAt(groupID);
+    if (kind == 1 && mesh->vVertices().empty()) { RemoveVoxels(library, identity); RequestUpdate(); return; }
+    if (kind == 2 && line->vVertices().empty()) { RemovePolyLine(library, identity); RequestUpdate(); return; }
+    const auto generation = kind == 2 ? line->TauGeneration() : mesh->TauGeneration();
+    const auto oldGeneration = kind == 2 ? group->LineGeneration(library, identity) :
+        group->MeshGeneration(library, identity, kind == 0 ? Group::ObjectKind::Mesh : Group::ObjectKind::Voxels);
+    try {
+        if (kind == 0) group->AddMesh(library, identity, roMeshGeometry(std::move(mesh)));
+        else if (kind == 1) group->AddVoxels(library, identity, roMeshGeometry(std::move(mesh)));
+        else group->AddPolyLine(library, identity, roLineGeometry(std::move(line)));
+    } catch (...) { RetireGeometry(generation, kind == 2); throw; }
+    RetireGeometry(oldGeneration, kind == 2);
+    for (const auto& entry : m_oGroups) {
+        if (entry.second == group) continue;
+        const auto displaced = kind == 2 ? entry.second->LineGeneration(library, identity) :
+            entry.second->MeshGeneration(library, identity, kind == 0 ? Group::ObjectKind::Mesh : Group::ObjectKind::Voxels);
+        if (!displaced) continue;
+        if (kind == 0) entry.second->RemoveMesh(library, identity);
+        else if (kind == 1) entry.second->RemoveVoxels(library, identity);
+        else entry.second->RemovePolyLine(library, identity);
+        RetireGeometry(displaced, kind == 2);
+    }
+    RecalcNeeded(); RequestUpdate();
+}
