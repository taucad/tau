+// Hash/producer checks precede this call in the managed/session owner. No live handles cross Go.
+PICOGK_API int32_t TauCompute_ImportGrid(PKINSTANCE library,const char* input,uint64_t size,
+    uint64_t maximumEncoded,uint64_t maximumNative,int32_t expectedKind,
+    uint64_t* output,PKMETADATA* metadata,uint64_t* nativeBytes) noexcept {
+    if(output) *output=0;if(metadata) *metadata=0;if(nativeBytes) *nativeBytes=0;
+    if(!output||!metadata||!nativeBytes||output==metadata||output==nativeBytes||metadata==nativeBytes||
+        !input||size>uint64_t(INT64_MAX)||maximumEncoded>uint64_t(INT64_MAX)||maximumNative>uint64_t(INT64_MAX)) return -1;
+    return TauCheckedInvoke([&] {
+        auto owner=Library::oLib().roGetInstance(library);
+        int32_t kind=-1,band=-1;
+        auto grid=TauDecodeGrid(input,size_t(size),size_t(maximumEncoded),size_t(maximumNative),&kind,&band);
+        if(kind!=expectedKind||!TauHasSupportedGridTransform(*grid)) throw std::invalid_argument("compute field profile mismatch");
+        auto state=TauStateFor(grid);
+        auto meta=std::make_shared<VdbMeta>(grid,state);
+        const auto publish=[&](auto field,auto& handles) {
+            TauOwnedMemory memory;memory.Object(field);memory.Object(meta);
+            const auto bytes=memory.Bytes();
+            if(uint64_t(bytes)>maximumNative) throw std::length_error("compute retained native budget");
+            const auto handle=handles.hAdd(std::move(field));
+            try {auto metaHandle=owner->m_oVdbMetas.hAdd(meta);*output=handle;*metadata=metaHandle;*nativeBytes=uint64_t(bytes);}
+            catch(...) {handles.bDestroy(handle);throw;}
+        };
+        if(kind==0) {
+            auto value=TauComputeVoxelAccess::Adopt(gridPtrCast<FloatGrid>(grid),band,state);
+            value->TauBindCounters(owner->m_tauCounters);publish(std::move(value),owner->m_oVoxels);
+        } else if(kind==1) publish(std::make_shared<ScalarField>(gridPtrCast<FloatGrid>(grid),state),owner->m_oScalarFields);
+        else publish(std::make_shared<VectorField>(gridPtrCast<Vec3SGrid>(grid),state),owner->m_oVectorFields);
+    });
+}
+
+// Actual miss receipt, not a managed-reference gate. A stale key leaves inputs untouched.
+PICOGK_API int32_t TauCompute_MutateVoxels(PKINSTANCE library,uint64_t target,uint64_t operand,
+    int32_t operation,float first,float second,const uint64_t* expected,int32_t expectedCount,uint64_t* result) noexcept {
+    if(result){result[0]=0;result[1]=0;}
+    if(!expected||!result||expected==result||operation<0||operation>6||
+        expectedCount!=(operation<3?4:2)||!std::isfinite(first)||!std::isfinite(second))return -1;
+    bool bypass=false;
+    const auto status=TauCheckedInvoke([&]{
+        auto owner=Library::oLib().roGetInstance(library);auto output=owner->m_oVoxels.roGet(target);
+        auto source=operation<3?owner->m_oVoxels.roGet(operand):Voxels::Ptr{};
+        bypass=!output->TauComputeMutate(source.get(),operation,first,second,expected,result);
+    });
+    return status?status:bypass?1:0;
+}
+
+// Qualified in-place families preserve the target header (metadata/transform) exactly.
+PICOGK_API int32_t TauCompute_ApplyVoxelTree(PKINSTANCE library,uint64_t target,int32_t prototypeKind,uint64_t prototype,
+    uint64_t operand,const uint64_t* expected,int32_t expectedCount,uint64_t maximumTemporary,uint64_t* result) noexcept {
+    if(result){result[0]=0;result[1]=0;}
+    if(!expected||!result||expected==result||(expectedCount!=2&&expectedCount!=4)||(prototypeKind!=0&&prototypeKind!=1)||
+       (prototypeKind==0&&target==prototype)||maximumTemporary>uint64_t(INT64_MAX))return -1;
+    bool bypass=false;
+    const auto status=TauCheckedInvoke([&]{
+        auto owner=Library::oLib().roGetInstance(library);auto output=owner->m_oVoxels.roGet(target);
+        auto source=expectedCount==4?owner->m_oVoxels.roGet(operand):Voxels::Ptr{};
+        if(prototypeKind==1){auto hold=owner->m_tauCaptures.roGet(prototype);std::lock_guard<std::recursive_mutex> lock(hold->computeGate);
+            if(hold->computeKind!=0||!hold->computeGrid)throw std::invalid_argument("cache capture cannot apply voxels");
+            bypass=!output->TauComputeApplyTree(gridPtrCast<FloatGrid>(hold->computeGrid),hold->narrowBand,source.get(),expected,maximumTemporary,result);
+        }else{auto resident=owner->m_oVoxels.roGet(prototype);auto pin=resident->TauPinGrid();std::lock_guard<std::recursive_mutex> lock(pin.state->gate);
+            if(!pin.state->cacheable){bypass=true;return;}
+            bypass=!output->TauComputeApplyTree(pin.grid,resident->TauNarrowBand(),source.get(),expected,maximumTemporary,result);
+        }
+    });
+    return status?status:bypass?1:0;
+}
+
+PICOGK_API int32_t TauCompute_ClonePrototype(PKINSTANCE library,uint64_t prototype,uint64_t maximumNative,
+    uint64_t* output,PKMETADATA* metadata,uint64_t* nativeBytes) noexcept {
+    if(output)*output=0;if(metadata)*metadata=0;if(nativeBytes)*nativeBytes=0;
+    if(!output||!metadata||!nativeBytes||output==metadata||output==nativeBytes||metadata==nativeBytes||maximumNative>uint64_t(INT64_MAX))return -1;
+    return TauCheckedInvoke([&]{
+        auto owner=Library::oLib().roGetInstance(library);auto source=owner->m_oVoxels.roGet(prototype);auto pin=source->TauPinGrid();
+        std::lock_guard<std::recursive_mutex> state(pin.state->gate);
+        TauOwnedMemory estimate;estimate.Object(source);estimate.Add(sizeof(VdbMeta));
+        if(uint64_t(estimate.Bytes())>maximumNative)throw std::length_error("compute warm clone budget");
+        auto grid=deepCopyTypedGrid<FloatGrid>(pin.grid);auto ownedState=TauStateFor(grid);
+        auto value=TauComputeVoxelAccess::Adopt(grid,source->TauNarrowBand(),ownedState);value->TauBindCounters(owner->m_tauCounters);
+        auto meta=std::make_shared<VdbMeta>(value->TauGrid(),value->TauState());TauOwnedMemory actual;actual.Object(value);actual.Object(meta);
+        if(uint64_t(actual.Bytes())>maximumNative)throw std::length_error("compute warm clone retained budget");
+        const auto handle=owner->m_oVoxels.hAdd(value);
+        try{const auto metaHandle=owner->m_oVdbMetas.hAdd(meta);*output=handle;*metadata=metaHandle;*nativeBytes=actual.Bytes();}
+        catch(...){owner->m_oVoxels.bDestroy(handle);throw;}
+    });
+}
+
+PICOGK_API int32_t TauCompute_PrimitiveIdentity(PKINSTANCE library,int32_t kind,uint64_t source,uint64_t* generation)noexcept {
+    if(generation)*generation=0;if(!generation||(kind!=3&&kind!=4))return -1;
+    return TauCheckedInvoke([&]{auto owner=Library::oLib().roGetInstance(library);
+        *generation=kind==3?owner->m_oMeshes.roGet(source)->TauGeneration():owner->m_oLattices.roGet(source)->TauGeneration();});
+}
+PICOGK_API int32_t TauCompute_CaptureOwnedBytes(PKINSTANCE library,uint64_t snapshot,uint64_t* bytes)noexcept {
+    if(bytes)*bytes=0;if(!bytes)return -1;
+    return TauCheckedInvoke([&]{auto owner=Library::oLib().roGetInstance(library);auto hold=owner->m_tauCaptures.roGet(snapshot);*bytes=uint64_t(hold->nMemUsage());});
+}
+PICOGK_API int32_t TauCompute_CaptureLatticeContent(PKINSTANCE library,uint64_t source,uint64_t generation,uint64_t maximumEncoded,uint64_t maximumNative,
+    uint64_t* snapshot,uint64_t* nativeBytes)noexcept {
+    if(snapshot)*snapshot=0;if(nativeBytes)*nativeBytes=0;
+    if(!snapshot||!nativeBytes||snapshot==nativeBytes||maximumEncoded>uint64_t(INT64_MAX)||maximumNative>uint64_t(INT64_MAX))return -1;
+    bool bypass=false;const auto status=TauCheckedInvoke([&]{
+        auto owner=Library::oLib().roGetInstance(library);auto lattice=owner->m_oLattices.roGet(source);
+        if(maximumNative<=sizeof(TauCapturedGeometry)){bypass=true;return;}
+        auto bytes=lattice->TauComputeContent(generation,maximumEncoded,maximumNative-sizeof(TauCapturedGeometry));
+        if(bytes.empty()){bypass=true;return;}
+        auto hold=std::make_shared<TauCapturedGeometry>();hold->computeKind=4;hold->generation=generation;hold->computeBytes=std::move(bytes);
+        const auto charge=uint64_t(hold->nMemUsage());if(charge>maximumNative){bypass=true;return;}
+        const auto handle=owner->m_tauCaptures.hAddWithIdentity(hold,TauNextGeneration());*snapshot=handle;*nativeBytes=charge;
+    });return status?status:bypass?1:0;
+}
+
+PICOGK_API int32_t TauCompute_GridDecodeAllowance(PKINSTANCE library,uint64_t snapshot,uint64_t maximumNative,uint64_t* allowance)noexcept {
+    if(allowance)*allowance=0;if(!allowance||maximumNative>uint64_t(INT64_MAX)||maximumNative<4096)return -1;
+    return TauCheckedInvoke([&]{auto owner=Library::oLib().roGetInstance(library);auto hold=owner->m_tauCaptures.roGet(snapshot);
+        std::lock_guard<std::recursive_mutex> lock(hold->computeGate);
+        if(hold->computeKind<0||hold->computeKind>2||hold->computeBytes.empty())throw std::invalid_argument("compute VDB stored body required");
+        *allowance=TauPreflightEnvelope(hold->computeBytes.data(),hold->computeBytes.size(),hold->computeBytes.size(),maximumNative-4096).peak+4096;
+    });
+}
+
+PICOGK_API int32_t TauCompute_ImportMesh(PKINSTANCE library,const char* bytes,uint64_t size,uint64_t maximumNative,uint64_t* output,uint64_t* nativeBytes)noexcept {
+    if(output)*output=0;if(nativeBytes)*nativeBytes=0;
+    if(!output||!nativeBytes||output==nativeBytes||size>uint64_t(INT64_MAX)||maximumNative>uint64_t(INT64_MAX))return -1;
+    return TauCheckedInvoke([&]{auto owner=Library::oLib().roGetInstance(library);auto mesh=TauDecodeMeshBody(bytes,size_t(size),maximumNative);
+        const auto charge=uint64_t(mesh->nMemUsage());const auto handle=owner->m_oMeshes.hAdd(mesh);*output=handle;*nativeBytes=charge;});
+}
+PICOGK_API int32_t TauCompute_CloneMeshCapture(PKINSTANCE library,uint64_t snapshot,uint64_t maximumNative,uint64_t* output)noexcept {
+    if(output)*output=0;if(!output||maximumNative>uint64_t(INT64_MAX))return -1;
+    return TauCheckedInvoke([&]{auto owner=Library::oLib().roGetInstance(library);auto hold=owner->m_tauCaptures.roGet(snapshot);
+        if(!hold->mesh)throw std::invalid_argument("compute mesh capture required");
+        if(uint64_t(hold->mesh->nMemUsage())+sizeof(Mesh)>maximumNative)throw std::length_error("compute mesh clone budget");
+        auto clone=std::make_shared<Mesh>(*hold->mesh);*output=owner->m_oMeshes.hAdd(clone);});
+}
+
+PICOGK_API int32_t TauCompute_RenderPrimitive(PKINSTANCE library,uint64_t target,int32_t sourceKind,uint64_t source,const uint64_t* expected,int32_t expectedCount,uint64_t* result)noexcept {
+    if(result){result[0]=0;result[1]=0;}if(!expected||!result||expected==result||expectedCount!=4||(sourceKind!=3&&sourceKind!=4))return -1;
+    bool bypass=false;const auto status=TauCheckedInvoke([&]{auto owner=Library::oLib().roGetInstance(library);auto output=owner->m_oVoxels.roGet(target);
+        if(sourceKind==3)bypass=!output->TauComputeRenderMesh(*owner->m_oMeshes.roGet(source),expected,result);
+        else bypass=!output->TauComputeRenderLattice(*owner->m_oLattices.roGet(source),expected,result);});return status?status:bypass?1:0;
+}
+PICOGK_API int32_t TauCompute_ApplyPrimitiveTree(PKINSTANCE library,uint64_t target,int32_t prototypeKind,uint64_t prototype,
+    int32_t sourceKind,uint64_t source,const uint64_t* expected,int32_t expectedCount,uint64_t maximumTemporary,uint64_t* result)noexcept {
+    if(result){result[0]=0;result[1]=0;}if(!expected||!result||expected==result||expectedCount!=4||(sourceKind!=3&&sourceKind!=4)||(prototypeKind!=0&&prototypeKind!=1)||(prototypeKind==0&&target==prototype)||maximumTemporary>uint64_t(INT64_MAX))return -1;
+    bool bypass=false;const auto status=TauCheckedInvoke([&]{auto owner=Library::oLib().roGetInstance(library);auto output=owner->m_oVoxels.roGet(target);
+        const auto apply=[&](FloatGrid::Ptr grid,int band){if(sourceKind==3)bypass=!output->TauComputeApplyPrimitive(grid,band,*owner->m_oMeshes.roGet(source),expected,maximumTemporary,result);
+            else bypass=!output->TauComputeApplyPrimitive(grid,band,*owner->m_oLattices.roGet(source),expected,maximumTemporary,result);};
+        if(prototypeKind==1){auto hold=owner->m_tauCaptures.roGet(prototype);std::lock_guard<std::recursive_mutex> lock(hold->computeGate);
+            if(hold->computeKind!=0||!hold->computeGrid)throw std::invalid_argument("compute primitive apply voxel capture");apply(gridPtrCast<FloatGrid>(hold->computeGrid),hold->narrowBand);
+        }else{auto resident=owner->m_oVoxels.roGet(prototype);auto pin=resident->TauPinGrid();std::lock_guard<std::recursive_mutex> lock(pin.state->gate);
+            if(!pin.state->cacheable){bypass=true;return;}apply(pin.grid,resident->TauNarrowBand());}});return status?status:bypass?1:0;
+}
+
+PICOGK_API int32_t TauCompute_ImportFile(PKINSTANCE library,const char* bytes,uint64_t size,uint64_t maximumEncoded,
+    uint64_t maximumNative,int32_t asset,uint64_t* output,uint64_t* nativeBytes) noexcept {
+    if(output)*output=0;if(nativeBytes)*nativeBytes=0;
+    if(!output||!nativeBytes||output==nativeBytes||size>SIZE_MAX||maximumEncoded>SIZE_MAX||maximumNative>uint64_t(INT64_MAX)||(asset!=0&&asset!=1))return -1;
+    return TauCheckedInvoke([&]{auto owner=Library::oLib().roGetInstance(library);
+        auto grids=asset?TauDecodeAsset(bytes,size,maximumEncoded,maximumNative):TauDecodeFile(bytes,size,maximumEncoded,maximumNative);
+        auto file=std::make_shared<VdbFile>(grids,true);TauOwnedMemory actual;actual.Object(file);
+        if(uint64_t(actual.Bytes())>maximumNative)throw std::length_error("compute file retained budget");
+        *output=owner->m_oVdbFiles.hAdd(file);*nativeBytes=uint64_t(actual.Bytes());
+    });
+}
+PICOGK_API int32_t TauCompute_CaptureFile(PKINSTANCE library,uint64_t file,uint64_t maximumEncoded,uint64_t maximumNative,
+    uint64_t* snapshot,uint64_t* nativeBytes,uint64_t* allowance) noexcept {
+    if(snapshot)*snapshot=0;if(nativeBytes)*nativeBytes=0;if(allowance)*allowance=0;
+    if(!snapshot||!nativeBytes||!allowance||snapshot==nativeBytes||snapshot==allowance||nativeBytes==allowance||maximumEncoded>SIZE_MAX||maximumNative>uint64_t(INT64_MAX))return -1;
+    return TauCheckedInvoke([&]{auto owner=Library::oLib().roGetInstance(library);auto source=owner->m_oVdbFiles.roGet(file);
+        if(maximumNative<=sizeof(TauCapturedGeometry))throw std::length_error("compute file capture budget");
+        auto value=std::make_shared<TauCapturedGeometry>();value->computeKind=5;
+        value->computeBytes=source->TauEncodeOwned([&](const auto& grids){return TauEncodeFile(grids,maximumEncoded,maximumNative-sizeof(TauCapturedGeometry));});
+        const auto checked=TauPreflightFile(value->computeBytes.data(),value->computeBytes.size(),maximumEncoded,maximumNative);
+        const auto bytes=uint64_t(value->nMemUsage());if(bytes>maximumNative)throw std::length_error("compute file capture retained budget");
+        *snapshot=owner->m_tauCaptures.hAddWithIdentity(value,TauNextGeneration());*nativeBytes=bytes;*allowance=checked.peak;
+    });
+}
+
+PICOGK_API int32_t TauCompute_FileDecodeAllowance(const char* bytes,uint64_t size,uint64_t maximumNative,uint64_t* allowance) noexcept {
+    if(allowance)*allowance=0;if(!allowance||size>SIZE_MAX||maximumNative>uint64_t(INT64_MAX))return -1;
+    return TauCheckedInvoke([&]{*allowance=TauPreflightFile(bytes,size,size,maximumNative).peak;});
+}
