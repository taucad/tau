+    bool TauComputeMutate(Voxels* source,int32_t operation,float first,float second,
+        const uint64_t* expected,uint64_t* result) {
+        std::unique_lock<std::recursive_mutex> targetObject(m_tauObjectGate,std::defer_lock);
+        std::unique_lock<std::recursive_mutex> sourceObject;
+        if(source&&source!=this){sourceObject=std::unique_lock<std::recursive_mutex>(source->m_tauObjectGate,std::defer_lock);std::lock(targetObject,sourceObject);}else targetObject.lock();
+        std::unique_lock<std::recursive_mutex> targetState(m_tauState->gate,std::defer_lock),sourceState;
+        if(source&&source->m_tauState!=m_tauState){sourceState=std::unique_lock<std::recursive_mutex>(source->m_tauState->gate,std::defer_lock);std::lock(targetState,sourceState);}else targetState.lock();
