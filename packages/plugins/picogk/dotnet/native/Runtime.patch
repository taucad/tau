+PICOGK_API int32_t TauMesh_CreateCopy(PKINSTANCE library, uint64_t snapshot, PKMESH* output) {
+    if (!output) return -1;
+    *output = 0;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto capture = owner->m_tauCaptures.roGet(snapshot);
+        if (!capture->mesh) throw std::invalid_argument("copy requires a frozen mesh capture");
+        *output = owner->m_oMeshes.hAdd(capture->mesh->TauCapture());
+    });
+}
+PICOGK_API int32_t TauCapture_GetPlacement(PKINSTANCE library, uint64_t snapshot,
+    uint64_t* prototypeGeneration, float* matrix, int32_t matrixCapacity, int32_t* placed, PKBBox3* bounds) {
+    if (!prototypeGeneration || !matrix || matrixCapacity < 16 || !placed || !bounds) return -1;
+    *prototypeGeneration = 0; *placed = 0;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto capture = owner->m_tauCaptures.roGet(snapshot);
+        if (!capture->mesh) throw std::invalid_argument("placement requires a frozen mesh capture");
+        uint64_t generation = 0;
+        *placed = capture->mesh->TauGetPlacement(generation, matrix) ? 1 : 0;
+        *bounds = capture->mesh->oBBox();
+        *prototypeGeneration = generation;
+    });
+}
+PICOGK_API int32_t TauCapture_CopyPrototype(PKINSTANCE library, uint64_t snapshot,
+    float* positions, int32_t positionCapacity, uint32_t* indices, int32_t indexCapacity) {
+    if (positionCapacity < 0 || indexCapacity < 0) return -1;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto capture = owner->m_tauCaptures.roGet(snapshot);
+        if (!capture->mesh) throw std::invalid_argument("prototype requires a frozen mesh capture");
+        auto prototype = capture->mesh->TauPrototypeCapture();
+        TauCapturedGeometry source; source.mesh = prototype;
+        const auto pCount = TauCapturePositionCount(source), iCount = TauCaptureIndexCount(source);
+        if (positionCapacity < pCount || (pCount && !positions) ||
+            ((indices || indexCapacity) && (indexCapacity < iCount || (iCount && !indices))))
+            throw std::invalid_argument("prototype buffers are too small");
+        const auto& vertices = prototype->vVertices();
+        const auto& triangles = prototype->vTriangles();
+        for (size_t i = 0; i < vertices.size(); ++i) {
+            positions[i*3] = vertices[i].X; positions[i*3+1] = vertices[i].Y; positions[i*3+2] = vertices[i].Z;
+        }
+        if (indices) for (size_t i = 0; i < triangles.size(); ++i) {
+            indices[i*3] = static_cast<uint32_t>(triangles[i].A);
+            indices[i*3+1] = static_cast<uint32_t>(triangles[i].B);
+            indices[i*3+2] = static_cast<uint32_t>(triangles[i].C);
+        }
+        ++owner->m_tauCaptureCopies;
+    });
