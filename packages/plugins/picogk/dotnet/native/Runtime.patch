+inline void TauValues(TauComputeCursor& input,size_t count,uint32_t active,size_t width,uint32_t compression,TauComputeBound& bound) {
+    const auto flag=input.Read<uint8_t>();if(flag>6)throw std::invalid_argument("compute value mask flag");
