+            (source&&(!source->m_tauState->cacheable||source->m_tauState->generation->identity!=expected[2]||source->m_tauState->metadataIdentity!=expected[3])))return false;
+        if(operation<3){if(!source)throw std::invalid_argument("compute binary operand required");TauMutateCsg(*source,operation);}
+        else if(operation==3)Offset(first);
+        else if(operation==4)DoubleOffset(first,second);
+        else if(operation==5)TripleOffset(first);
