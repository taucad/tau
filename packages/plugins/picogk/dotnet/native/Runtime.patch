+PICOGK_API int32_t TauVoxels_IsEmpty(PKINSTANCE library, PKVOXELS voxels, int32_t* output) noexcept {
+    if (!output) return -1;
+    *output = 0;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto source = owner->m_oVoxels.roGet(voxels);
+        *output = source->bIsEmpty() ? 1 : 0;
+    });
+}
+PICOGK_API int32_t TauVoxels_IsEqual(PKINSTANCE library, PKVOXELS voxels, PKVOXELS other, int32_t* output) noexcept {
+    if (!output) return -1;
+    *output = 0;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto source = owner->m_oVoxels.roGet(voxels);
+        auto compare = owner->m_oVoxels.roGet(other);
+        *output = source->bIsEqual(*compare) ? 1 : 0;
+    });
+}
+
+PICOGK_API int32_t TauVoxels_SurfaceQuery(PKINSTANCE library, PKVOXELS voxels, int32_t mode,
+    const PKVector3* point, const PKVector3* direction, int32_t* hit, PKVector3* output) noexcept {
+    const Vector3 input = point ? *point : Vector3(0,0,0);
+    const Vector3 rayDirection = direction ? *direction : Vector3(0,0,0);
+    if (hit) *hit = 0;
+    if (output) *output = Vector3(0,0,0);
+    if (!point || !hit || !output || mode < 0 || mode > 3 || (mode == 3 && !direction)) return -1;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto source = owner->m_oVoxels.roGet(voxels);
+        Vector3 observed(0,0,0);
+        bool found;
+        if (mode == 0) found = source->bIsInside(input);
+        else if (mode == 1) { source->GetSurfaceNormal(input, &observed); found = true; }
+        else if (mode == 2) found = source->bFindClosestPointOnSurface(input, &observed);
+        else found = source->bRayCastToSurface(input, rayDirection, &observed);
+        *output = observed;
+        *hit = found ? 1 : 0;
+    });
+}
