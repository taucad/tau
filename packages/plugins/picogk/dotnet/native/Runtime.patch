+namespace {
+struct TauCallbackStopped {};
+template<class T> struct TauCheckedScope {
+    static thread_local T current;
+    T previous;
+    explicit TauCheckedScope(T callback): previous(current) { current = callback; }
+    ~TauCheckedScope() { current = previous; }
+};
+template<class T> thread_local T TauCheckedScope<T>::current = nullptr;
+float TauSdfAdapter(const PKVector3* point) {
+    float value = 0;
+    if (TauCheckedScope<TauCheckedSdf>::current(point, &value)) throw TauCallbackStopped{};
+    if (!std::isfinite(value)) throw std::invalid_argument("nonfinite SDF callback value");
+    return value;
+}
+void TauScalarAdapter(const PKVector3* point, float value) {
+    if (TauCheckedScope<TauCheckedScalar>::current(point, value)) throw TauCallbackStopped{};
+}
+void TauVectorAdapter(const PKVector3* point, const PKVector3* value) {
+    if (TauCheckedScope<TauCheckedVector>::current(point, value)) throw TauCallbackStopped{};
+}
+template<class T> int32_t TauCheckedInvoke(T operation) noexcept {
+    try { operation(); return 0; }
+    catch (const TauCallbackStopped&) { return -4; }
+    catch (const std::out_of_range&) { return -3; }
+    catch (const std::invalid_argument&) { return -1; }
+    catch (const std::overflow_error&) { return -1; }
+    catch (...) { return -2; }
+}
