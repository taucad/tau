+    // Caller holds owner, state and generation gates. Returned surface remains immutable.
+    Mesh::Ptr TauSurfaceLocked() const {
+        auto generation = m_tauState->generation;
+        if (!m_tauState->cacheable) {
+            if (m_tauState->counters) ++m_tauState->counters->surfaceBuilds;
+            return TauBuildSurface();
+        }
+        if (!generation->surface) {
+            if (m_tauState->counters) ++m_tauState->counters->surfaceBuilds;
+            generation->surface = TauBuildSurface();
