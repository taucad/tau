+bool ViewerManager::Poll(PKVIEWER handle) {
+    RequireOwnerThread();
+    auto owner = roGet(handle);
+    {
+        std::unique_lock lock(m_mtx);
+        if (m_bPolling) throw std::invalid_argument("reentrant native viewer polling");
+        m_bPolling = true;
+    }
+    // ImGui's frame and GLFW's chained callback both outlive individual author callbacks.
+    // Keep closing entries alive until the outer frame/event pump returns.
+    bool alive;
+    try { alive = owner->bPoll(); }
+    catch (...) {
+        { std::unique_lock lock(m_mtx); m_bPolling = false; }
+        DrainPendingClose(); throw;
+    }
+    { std::unique_lock lock(m_mtx); m_bPolling = false; }
+    DrainPendingClose();
+    return alive;
+}
+
+std::shared_ptr<Viewer> ViewerManager::roGet(PKVIEWER handle) {
+    RequireOwnerThread(); DrainPendingClose();
+    std::shared_lock lock(m_mtx);
+    for (const auto& entry : m_oViewers)
+        if (entry.second->hHandle() == handle && !entry.second->bClosing()) return entry.second;
+    throw std::out_of_range("viewer handle is closed");
+}
