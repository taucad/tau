diff --git a/Source/PicoGKOwnedMemory.h b/Source/PicoGKOwnedMemory.h
new file mode 100644
--- /dev/null
+++ b/Source/PicoGKOwnedMemory.h
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef PICOGK_OWNED_MEMORY_H
+#define PICOGK_OWNED_MEMORY_H
+#include <openvdb/openvdb.h>
+#include <openvdb/Metadata.h>
+#include <unordered_set>
+#include <vector>
+#include <memory>
+#include <limits>
+#include <stdexcept>
+#include <cstdint>
+namespace PicoGK {
+// One query's retained ownership graph. This is logical owned storage, not allocator/RSS accounting.
+class TauOwnedMemory {
+public:
+    enum class Kind { Object, Backing, Grid, Tree, MetadataMap, Metadata, Transform, Map, State, Generation, Table };
+private:
+    struct Key {
+        const void* address;
+        Kind kind;
+        bool operator==(const Key& other) const { return address == other.address && kind == other.kind; }
+    };
+    struct Hash {
+        size_t operator()(const Key& value) const {
+            return std::hash<const void*>{}(value.address) ^ (static_cast<size_t>(value.kind) << 1);
+        }
+    };
+    std::unordered_set<Key, Hash> visited;
+    std::vector<std::shared_ptr<const void>> retained;
+    uint64_t bytes = 0;
+    template<class... T> static size_t KnownSize(const openvdb::Metadata& value) {
+        size_t result = 0;
+        ((dynamic_cast<const T*>(&value) ? result = sizeof(T) : result), ...);
+        return result;
+    }
+    static uint64_t StringStorage(const std::string& value, const void* owner, size_t ownerSize) {
+        const auto data = reinterpret_cast<uintptr_t>(value.data());
+        const auto start = reinterpret_cast<uintptr_t>(owner);
+        return data >= start && data - start < ownerSize ? 0 : uint64_t(value.capacity()) + 1;
+    }
+public:
+    void Add(uint64_t value) {
+        if (value > uint64_t(INT64_MAX) - bytes) throw std::overflow_error("owned memory exceeds int64 range");
+        bytes += value;
+    }
+    void Array(size_t capacity, size_t width) {
+        if (width && capacity > uint64_t(INT64_MAX) / width) throw std::overflow_error("owned array exceeds int64 range");
+        Add(uint64_t(capacity) * width);
+    }
+    int64_t Bytes() const { return static_cast<int64_t>(bytes); }
+    template<class T> bool Retain(const std::shared_ptr<T>& value, Kind kind) {
+        if (!value || !visited.insert({value.get(), kind}).second) return false;
+        // Keep every visited address alive through the query, including replaced COW backing.
+        retained.push_back(value);
+        return true;
+    }
+    template<class T> void Object(const std::shared_ptr<T>& value) {
+        if (Retain(value, Kind::Object)) value->TauAccountMemory(*this);
+    }
+    void Metadata(const openvdb::MetaMap& map) {
+        // The owning Grid/standalone MetaMap has already been retained; this tag counts its entries once.
+        if (!visited.insert({&map, Kind::MetadataMap}).second) return;
+        for (auto it = map.beginMeta(); it != map.endMeta(); ++it) {
+            Add(sizeof(openvdb::MetaMap::MetadataMap::value_type));
+            Add(StringStorage(it->first, &*it, sizeof(*it)));
+            const auto& value = it->second;
+            if (!Retain(value, Kind::Metadata)) continue;
+            if (auto text = dynamic_cast<const openvdb::StringMetadata*>(value.get())) {
+                Add(sizeof(*text)); Add(StringStorage(text->value(), text, sizeof(*text)));
+            } else if (auto unknown = dynamic_cast<const openvdb::UnknownMetadata*>(value.get())) {
+                Add(sizeof(*unknown)); Array(unknown->value().capacity(), sizeof(uint8_t));
+                // UnknownMetadata's private type-name heap and custom metadata internals are opaque.
+            } else {
+                const auto known = KnownSize<openvdb::BoolMetadata, openvdb::DoubleMetadata,
+                    openvdb::FloatMetadata, openvdb::HalfMetadata, openvdb::Int32Metadata,
+                    openvdb::Int64Metadata, openvdb::Vec2DMetadata, openvdb::Vec2IMetadata,
+                    openvdb::Vec2SMetadata, openvdb::Vec3DMetadata, openvdb::Vec3IMetadata,
+                    openvdb::Vec3SMetadata, openvdb::Vec4DMetadata, openvdb::Vec4IMetadata,
+                    openvdb::Vec4SMetadata, openvdb::Mat4SMetadata, openvdb::Mat4DMetadata>(*value);
+                Add(known ? known : sizeof(openvdb::Metadata) + uint64_t(value->size()));
+            }
+        }
+    }
+    void Grid(const openvdb::GridBase::ConstPtr& grid) {
+        if (!Retain(grid, Kind::Grid)) return;
+        // All native built-in Grid<TreeT> owners have this same pointer-only derived layout.
+        static_assert(sizeof(openvdb::FloatGrid) == sizeof(openvdb::Vec3SGrid));
+        Add(sizeof(openvdb::FloatGrid));
+        const auto tree = grid->constBaseTreePtr();
+        if (Retain(tree, Kind::Tree)) Add(tree->memUsage());
+        Metadata(*grid);
+        const auto transform = grid->transformPtr();
+        if (Retain(transform, Kind::Transform)) {
+            Add(sizeof(openvdb::math::Transform));
+            const auto map = transform->baseMap();
+            if (Retain(map, Kind::Map)) {
+                size_t size = sizeof(openvdb::math::MapBase);
+#define TAU_MAP_SIZE(T) if (dynamic_cast<const openvdb::math::T*>(map.get())) size = sizeof(openvdb::math::T);
+                TAU_MAP_SIZE(AffineMap) TAU_MAP_SIZE(ScaleMap) TAU_MAP_SIZE(TranslationMap)
+                TAU_MAP_SIZE(ScaleTranslateMap) TAU_MAP_SIZE(UniformScaleMap)
+                TAU_MAP_SIZE(UniformScaleTranslateMap) TAU_MAP_SIZE(UnitaryMap) TAU_MAP_SIZE(NonlinearFrustumMap)
+#undef TAU_MAP_SIZE
+                Add(size);
+            }
+        }
+    }
+    void MetaRoot(const openvdb::MetaMap::Ptr& map) {
+        // Metadata_hFrom* holds a shared GridBase owner, not merely an embedded metadata view.
+        if (auto grid = std::dynamic_pointer_cast<openvdb::GridBase>(map)) Grid(grid);
+        else if (Retain(map, Kind::Object)) { Add(sizeof(openvdb::MetaMap)); Metadata(*map); }
+    }
+};
+}
+#endif
