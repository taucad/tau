+// One retained library/object lookup and a typed contiguous copy. The managed
+// counts are copied from one retained immutable generation per call. Multi-call
+// transactions use the capture-token ABI, not separate mutable-handle reads.
+PICOGK_API int32_t Tau_Mesh_GetVertices(PKINSTANCE hLib, PKMESH hMesh,
+                                      PKVector3* pBuffer, int32_t nCapacity) noexcept
+{
+    if (pBuffer == nullptr || nCapacity <= 0) return 0;
+    static_assert(std::is_nothrow_copy_assignable_v<Vector3>);
+    try
+    {
+        // Resolve everything before writing. Typed assignment cannot throw.
+        auto roLib = Library::oLib().roGetInstance(hLib);
+        auto roMesh = roLib->m_oMeshes.roGet(hMesh)->TauCapture();
+        const auto& vertices = roMesh->vVertices();
+        const auto count = std::min(vertices.size(), static_cast<size_t>(nCapacity));
+        std::copy_n(vertices.begin(), count, pBuffer);
+        return static_cast<int32_t>(count);
+    }
+    catch (...) { return -1; }
+}
