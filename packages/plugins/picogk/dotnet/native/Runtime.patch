+PICOGK_API int32_t TauVoxels_CreateCsg(PKINSTANCE library, PKVOXELS left, PKVOXELS right,
+    int32_t operation, PKVOXELS* output, PKMETADATA* metadata) noexcept {
+    if (output) *output = 0;
+    if (metadata) *metadata = 0;
+    if (!output || !metadata || output == metadata || operation < 0 || operation > 2) return -1;
+    return TauCheckedInvoke([&] {
+        auto owner = Library::oLib().roGetInstance(library);
+        auto lhs = owner->m_oVoxels.roGet(left);
+        auto rhs = owner->m_oVoxels.roGet(right);
+        auto result = Voxels::TauCreateCsg(*lhs, *rhs, operation);
+        auto grid = result->TauPinGrid();
+        grid.grid->insertMeta("PicoGK.Class", openvdb::StringMetadata("Voxels"));
+        auto resultMetadata = std::make_shared<VdbMeta>(grid.grid, grid.state);
+        const auto voxelHandle = TauAddVoxels(owner, result);
+        try {
+            const auto metadataHandle = owner->m_oVdbMetas.hAdd(std::move(resultMetadata));
+            *output = voxelHandle;
+            *metadata = metadataHandle;
+        } catch (...) {
+            owner->m_oVoxels.bDestroy(voxelHandle);
+            throw;
+        }
+    });
+}
