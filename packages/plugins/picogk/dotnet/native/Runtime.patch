+                    openvdb::Int64Metadata, openvdb::Vec2DMetadata, openvdb::Vec2IMetadata,
+                    openvdb::Vec2SMetadata, openvdb::Vec3DMetadata, openvdb::Vec3IMetadata,
+                    openvdb::Vec3SMetadata, openvdb::Vec4DMetadata, openvdb::Vec4IMetadata,
+                    openvdb::Vec4SMetadata, openvdb::Mat4SMetadata, openvdb::Mat4DMetadata>(*value);
