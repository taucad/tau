+            openvdb::tools::CsgUnionOp<Tree> op(right.m_roGrid->constTree(), openvdb::DeepCopy());
+            nodes.foreachTopDown(op);
+        } else if (operation == 1) {
+            openvdb::tools::CsgDifferenceOp<Tree> op(right.m_roGrid->constTree(), openvdb::DeepCopy());
+            nodes.foreachTopDown(op);
+        } else {
