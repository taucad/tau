+inline Mesh::Ptr TauDecodeMeshBody(const char* bytes,size_t size,uint64_t maximumNative) {
+    const auto body=TauPreflightMeshBody(bytes,size,maximumNative);
+    const auto positions=[&](size_t offset){std::vector<Vector3> values;values.reserve(body.vertices);
