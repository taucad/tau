+        if(count>bound.maximum/width)throw std::length_error("compute delayed metadata count");
+        const size_t expected=size_t(count)*width;
+        if(encoded) {
+            const auto raw=TauBloscBlock(value.Take(encoded),encoded,expected,bound,true);
+            // DelayedLoadMetadata.cc padMask/padCompressedSize round through float;
+            // charge the actual pinned reservation and all bounded header/meta copies.
+            const auto capacity=size_t(std::ceil(float(raw+BLOSC_MAX_OVERHEAD+1)/float(width)))*width;
+            if(capacity<raw+BLOSC_MAX_OVERHEAD)throw std::invalid_argument("compute delayed metadata padding");
+            bound.Add(8*(std::max(expected,capacity)+256));
+        } else {bound.Add(8*(expected+256));value.Take(expected);}
+    };
