+    if (m_nInstanceBuffer) glDeleteBuffers(1, &m_nInstanceBuffer);
+    m_nInstanceBuffer = 0; m_nInstanceCapacity = 0;
+    std::vector<DrawBinding>().swap(m_vDrawBindings);
+    std::vector<Matrix4x4>().swap(m_vInstanceMatrices);
+}
+void Viewer::Group::BuildDrawBindings() {
+    if (!m_bInstancesDirty) return;
+    m_vDrawBindings.clear(); m_vInstanceMatrices.clear();
+    for (const auto& [key, occurrence] : m_oViewMeshes) {
+        auto* geometry = occurrence->m_roGeometry.get();
+        if (!geometry->buffer) continue;
+        const auto matrix = ObjectMatrix(m_mat, occurrence->m_mat);
+        const bool reflected = Reflected(matrix);
+        const auto first = m_vInstanceMatrices.size();
+        if (first >= static_cast<size_t>(INT32_MAX))
+            throw std::overflow_error("viewer exceeds GL instance count");
+        m_vInstanceMatrices.push_back(matrix);
+        if (!m_vDrawBindings.empty() && m_vDrawBindings.back().geometry == geometry &&
+            m_vDrawBindings.back().reflected == reflected) ++m_vDrawBindings.back().count;
+        else m_vDrawBindings.push_back({geometry, first, 1, reflected});
+    }
+    const bool instanced = std::any_of(m_vDrawBindings.begin(), m_vDrawBindings.end(),
+        [](const auto& binding) { return binding.count > 1; });
+    if (instanced) {
+        if (!m_nInstanceBuffer) glGenBuffers(1, &m_nInstanceBuffer);
+        glBindBuffer(GL_ARRAY_BUFFER, m_nInstanceBuffer);
+        const auto size = m_vInstanceMatrices.size() * sizeof(Matrix4x4);
+        if (size > m_nInstanceCapacity) {
+            glBufferData(GL_ARRAY_BUFFER, size, m_vInstanceMatrices.data(), GL_DYNAMIC_DRAW);
+            if (glGetError() != GL_NO_ERROR) {
+                glBindBuffer(GL_ARRAY_BUFFER, 0);
+                throw std::runtime_error("unable to allocate instance buffer");
+            }
+            m_nInstanceCapacity = size;
+        } else glBufferSubData(GL_ARRAY_BUFFER, 0, size, m_vInstanceMatrices.data());
+        glBindBuffer(GL_ARRAY_BUFFER, 0);
+        if (glGetError() != GL_NO_ERROR) throw std::runtime_error("unable to upload instance buffer");
+    } else if (m_nInstanceBuffer) {
+        glDeleteBuffers(1, &m_nInstanceBuffer); m_nInstanceBuffer = 0; m_nInstanceCapacity = 0;
+    }
+    m_bInstancesDirty = false;
+}
+void Viewer::Group::Draw(const ShaderProgMeshPoly& shader) {
+    if (!m_bVisible) return;
+    for (auto& entry : m_oViewPolyLines) entry.second->Draw(shader, m_sMaterial, m_mat);
+    BuildDrawBindings();
+    for (const auto& binding : m_vDrawBindings) {
+        const bool instanced = binding.count > 1;
+        shader.SetValues(instanced ? Matrix4x4() : m_vInstanceMatrices[binding.first],
+            m_sMaterial.clr, m_sMaterial.fMetallic, m_sMaterial.fRoughness,
+            m_bWarnOverhang, m_fWarningOverhang, m_fErrorOverhang);
+        shader.SetInstanced(instanced);
+        glFrontFace(binding.reflected ? GL_CW : GL_CCW);
+        GlBind bind(*binding.geometry->buffer);
+        if (instanced) {
+            binding.geometry->buffer->BindInstanceMatrices(m_nInstanceBuffer, binding.first * sizeof(Matrix4x4));
+            glDrawElementsInstanced(GL_TRIANGLES, binding.geometry->buffer->nIndexCount(), GL_UNSIGNED_INT, nullptr, binding.count);
+            binding.geometry->buffer->ClearInstanceMatrices();
+        } else glDrawElements(GL_TRIANGLES, binding.geometry->buffer->nIndexCount(), GL_UNSIGNED_INT, nullptr);
+    }
+    shader.SetInstanced(false); glFrontFace(GL_CCW);
     CHECKGLERRORS;
 }
+BBox3 Viewer::Group::oCalculateBBox() const {
+    BBox3 bounds;
+    for (const auto& entry : m_oViewPolyLines)
+        IncludeTransformed(bounds, entry.second->m_oBBox, ObjectMatrix(m_mat, entry.second->m_mat));
+    for (const auto& entry : m_oViewMeshes)
+        IncludeTransformed(bounds, entry.second->m_oBBox, ObjectMatrix(m_mat, entry.second->m_mat));
+    return bounds;
+}
 
