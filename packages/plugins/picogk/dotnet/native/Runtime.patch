+        std::unique_lock<std::recursive_mutex> leftObject(left.m_tauObjectGate, std::defer_lock);
+        std::unique_lock<std::recursive_mutex> rightObject(right.m_tauObjectGate, std::defer_lock);
+        if (&left == &right) leftObject.lock();
+        else std::lock(leftObject, rightObject);
+        std::unique_lock<std::recursive_mutex> leftState(left.m_tauState->gate, std::defer_lock);
+        std::unique_lock<std::recursive_mutex> rightState(right.m_tauState->gate, std::defer_lock);
+        if (left.m_tauState == right.m_tauState) leftState.lock();
+        else std::lock(leftState, rightState);
