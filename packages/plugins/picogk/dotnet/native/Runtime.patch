+// SPDX-License-Identifier: Apache-2.0
+#ifndef PICOGK_CAPTURE_H
+#define PICOGK_CAPTURE_H
+#include "PicoGKMesh.h"
+#include "PicoGKPolyLine.h"
+namespace PicoGK {
+struct TauCapturedGeometry {
+    Mesh::Ptr mesh;
+    PolyLine::Ptr line;
+    uint64_t generation = 0;
+    int32_t kind = -1;
+    uint64_t identity = 0;
+    uint64_t metadataIdentity = 0;
+    int32_t computeKind = -1;
+    int32_t narrowBand = -1;
+    openvdb::GridBase::Ptr computeGrid;
+    std::vector<char> computeBytes;
+    mutable std::recursive_mutex computeGate;
+    void TauAccountMemory(TauOwnedMemory& memory) const {
+        memory.Add(sizeof(TauCapturedGeometry)); memory.Object(mesh); memory.Object(line);
+        std::lock_guard<std::recursive_mutex> hold(computeGate);
+        memory.Grid(computeGrid); memory.Array(computeBytes.capacity(), sizeof(char));
+    }
+    int64_t nMemUsage() const { TauOwnedMemory memory; TauAccountMemory(memory); return memory.Bytes(); }
+};
+}
+#endif
