<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs outside Tau with the .NET 10 SDK: restore in locked mode, then `dotnet run`, which opens PicoGK's viewer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The PicoGK release Tau's picogk kernel runs; packages.lock.json pins it and its dependencies by hash. -->
    <PackageReference Include="PicoGK" Version="2.3.0" />
  </ItemGroup>

</Project>
