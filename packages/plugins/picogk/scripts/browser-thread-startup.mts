import { createHash } from 'node:crypto';
import { z } from 'zod';

const replacement = 'ENVIRONMENT_IS_WORKER = dotnet_replacements.ENVIRONMENT_IS_WORKER;';
const initialization = 'Module.__dotnet_runtime.initializeReplacements(dotnet_replacements);';
const before = `${replacement}\n    ${initialization}`;
const after = `${initialization}\n    ${replacement}`;

/**
 * Correct the pinned Mono/Emscripten replacement order for a runtime owned by a dedicated worker.
 * Mono's sidecar detection updates the replacement; reading it first misidentifies the runtime owner.
 * This only changes staged generated bytes, never the installed workload.
 * @param source - The generated native JavaScript module from the admitted workload.
 * @returns Corrected source, refusing an unrecognized or already patched workload.
 */
export const patchBrowserThreadStartup = (source: string): string => {
  const ready = 'onFinishedLoading(worker);';
  if (source.split(before).length !== 2 || source.split(ready).length !== 2) {
    throw new Error('The qualified .NET worker startup sequence changed.');
  }
  // Emscripten 6 no longer writes this flag, but the pinned Mono pool still reads it.
  // Set it before the load promise resolves so Mono chooses an initialized worker.
  return source.replace(before, after).replace(ready, `worker.loaded = true; ${ready}`);
};

/**
 * Deliver runtime-owner mailbox notifications as worker messages while retaining atomic pthread notifications.
 * An idle dedicated owner can stall on WebKit's atomic promise delivery. Emscripten's message fallback
 * also needs to recognize the owner as a local recipient instead of forwarding it into the pthread pool.
 * @param source - Generated native glue from the admitted workload.
 * @returns Corrected mailbox routing, refusing changed or already patched input.
 */
export const patchBrowserThreadMailbox = (source: string): string => {
  const wait = 'if (!waitAsyncPolyfilled) {\n    // Wait on';
  const route = 'if (d.targetThread) {';
  if (source.split(wait).length !== 2 || source.split(route).length !== 2) {
    throw new Error('The qualified .NET worker mailbox sequence changed.');
  }
  return source
    .replace(wait, 'if (!waitAsyncPolyfilled && ENVIRONMENT_IS_PTHREAD) {\n    // Wait on')
    .replace(route, 'if (d.targetThread && d.targetThread !== _pthread_self()) {');
};

const workerBootstrapStart = 'Me&&async function(){(function(){const e=new MessageChannel';
const workerBootstrapLoaded =
  'self.dispatchEvent(new MessageEvent("message",{data:{cmd:1,handlers:Fe.handlers,wasmMemory:Fe.wasmMemory,wasmModule:Fe.wasmModule}})),Fe}()';

/**
 * Hold the messages a pool worker receives while its bootstrap is still loading, and deliver them once it can act.
 * Mono's pool hands a new pthread to a worker that has not finished loading when no loaded worker is free,
 * and posts the start message at once. Until the native glue installs its handler, nothing listens on the
 * worker, so Firefox drops that message and the pthread never runs: oneTBB then does all its work on the
 * calling thread. Emscripten's own load message stays undelivered as before, because the bootstrap sends the
 * load itself. Held messages are redelivered in arrival order on a later task, as they would have arrived.
 * @param bootstrap - Generated dotnet.js from the admitted workload.
 * @returns The bootstrap with its worker branch holding early messages, refusing a changed or patched workload.
 */
export const patchBrowserThreadWorkerMessages = (bootstrap: string): string => {
  if (bootstrap.split(workerBootstrapStart).length !== 2 || bootstrap.split(workerBootstrapLoaded).length !== 2) {
    throw new Error('The qualified .NET worker bootstrap sequence changed.');
  }
  const hold =
    'const earlyMessages=[],holdEarlyMessage=e=>{1!==e.data?.cmd&&(earlyMessages.push(e),e.stopImmediatePropagation())};' +
    'self.addEventListener("message",holdEarlyMessage);';
  const release =
    'setTimeout(()=>{self.removeEventListener("message",holdEarlyMessage);' +
    'for(const e of earlyMessages)self.dispatchEvent(new MessageEvent("message",{data:e.data,ports:[...e.ports]}))}),Fe}()';
  return bootstrap
    .replace(workerBootstrapStart, workerBootstrapStart.replace('{(function', `{${hold}(function`))
    .replace(workerBootstrapLoaded, workerBootstrapLoaded.replace(/,Fe\}\(\)$/u, `,${release}`));
};

const configSchema = z.looseObject({
  resources: z.looseObject({
    hash: z.string(),
    jsModuleRuntime: z.array(z.looseObject({ name: z.string().regex(/^dotnet\.runtime\.[\w-]+\.js$/u) })).length(1),
    jsModuleNative: z.array(z.looseObject({ name: z.string().regex(/^dotnet\.native\.[\w-]+\.js$/u) })).length(1),
  }),
});

/**
 * Give the patched executable a new content filename and update Mono's embedded resource configuration.
 * @param bootstrap - Generated dotnet.js containing its embedded configuration.
 * @param native - Patched native module text.
 * @param kind - The native glue or managed runtime module being rebound.
 * @returns Bootstrap bytes and the renamed executable to stage in the immutable inventory.
 */
export const bindBrowserThreadStartup = (
  bootstrap: string,
  native: string,
  kind: 'native' | 'runtime' = 'native',
): { bootstrap: string; name: string } => {
  const embedded = /\/\*json-start\*\/([\s\S]*?)\/\*json-end\*\//u.exec(bootstrap)?.[1];
  if (!embedded) {
    throw new Error('The qualified .NET bootstrap configuration is missing.');
  }
  const config = configSchema.parse(JSON.parse(embedded));
  const name = `dotnet.${kind}.${createHash('sha256').update(native).digest('hex').slice(0, 16)}.js`;
  config.resources[kind === 'native' ? 'jsModuleNative' : 'jsModuleRuntime'][0]!.name = name;
  // The resource-set identity includes the original inventory hash and the changed executable name.
  config.resources.hash = `sha256-${createHash('sha256').update(JSON.stringify(config.resources)).digest('base64')}`;
  return { bootstrap: bootstrap.replace(embedded, JSON.stringify(config)), name };
};

/**
 * Match the jiterpreter shared-memory import limit to this host's 4 GiB WASM memory.
 * The pinned runtime otherwise hardcodes 2 GiB and silently falls back after a LinkError.
 * @param source - Generated managed runtime JavaScript from the admitted workload.
 * @returns Corrected import limit, refusing a changed workload.
 */
export const patchBrowserThreadMemory = (source: string): string => {
  const before = 'this.appendULeb(256),this.appendULeb(32768)';
  if (source.split(before).length !== 2) {
    throw new Error('The qualified .NET shared-memory import limit changed.');
  }
  return source.replace(before, 'this.appendULeb(256),this.appendULeb(65536)');
};

/**
 * The generated module names this bootstrap loads, as its own embedded configuration records them.
 * @param bootstrap - Generated dotnet.js containing its embedded configuration.
 * @returns The native glue and managed runtime file names, refusing a changed workload.
 */
export const browserThreadModuleNames = (bootstrap: string): { native: string; runtime: string } => {
  const embedded = /\/\*json-start\*\/([\s\S]*?)\/\*json-end\*\//u.exec(bootstrap)?.[1];
  if (!embedded) {
    throw new Error('The qualified .NET bootstrap configuration is missing.');
  }
  const config = configSchema.parse(JSON.parse(embedded));
  return {
    native: config.resources.jsModuleNative[0]!.name,
    runtime: config.resources.jsModuleRuntime[0]!.name,
  };
};

/**
 * Apply every qualified threaded-startup correction to one published runtime, in one place.
 *
 * Each correction is one caller's business as much as the other's: the parity apps a measurement
 * runs and the bundle the product ships have to be the same threaded runtime, or a qualified figure
 * would not describe the shipped path. An unpatched threaded build starts and runs geometry, and
 * then its idle runtime owner stalls on the first awaited interop call, which looks like a defect
 * somewhere else entirely.
 * @param input - The generated bootstrap and the two modules it names.
 * @returns The rebound bootstrap and each patched module under the content name it is served at.
 */
export const patchBrowserThreadRuntime = (input: {
  bootstrap: string;
  native: string;
  runtime: string;
}): { bootstrap: string; modules: Map<string, string> } => {
  const native = patchBrowserThreadMailbox(patchBrowserThreadStartup(input.native));
  const boundNative = bindBrowserThreadStartup(patchBrowserThreadWorkerMessages(input.bootstrap), native);
  const runtime = patchBrowserThreadMemory(input.runtime);
  const boundRuntime = bindBrowserThreadStartup(boundNative.bootstrap, runtime, 'runtime');
  return {
    bootstrap: boundRuntime.bootstrap,
    modules: new Map([
      [boundNative.name, native],
      [boundRuntime.name, runtime],
    ]),
  };
};
