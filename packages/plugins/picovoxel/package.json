{
  "name": "@taucad/picovoxel",
  "version": "0.1.0-beta.0",
  "description": "Picovoxel WebAssembly voxel and implicit geometry kernel",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/plugins/picovoxel"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/plugins/picovoxel#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist", "vendor", "LICENSE", "README.md", "CHANGELOG.md"],
  "keywords": ["cad", "plugin", "picovoxel"],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/geometry-core": "workspace:*",
    "picovoxel": "file:./vendor/picovoxel-0.1.0.tgz",
    "three": "catalog:"
  },
  "peerDependencies": {
    "@taucad/runtime": "^0.1.0-beta.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@taucad/esbuild": "workspace:*",
    "@taucad/middleware": "workspace:*",
    "@taucad/runtime": "workspace:*",
    "@taucad/runtime-testing": "workspace:*",
    "zod": "catalog:"
  },
  "taucad": {
    "hostTarget": "browser"
  }
}
