{
  "name": "@taucad/rolldown",
  "version": "0.1.0-beta.0",
  "description": "Native Node and WASM browser Rolldown bundler plugin for Tau",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/plugins/rolldown"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/plugins/rolldown#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cad",
    "plugin",
    "rolldown"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "peerDependencies": {
    "@taucad/runtime": "^0.1.0-beta.0"
  },
  "dependencies": {
    "@taucad/bundler-core": "workspace:*",
    "@rolldown/browser": "catalog:",
    "uint8array-extras": "catalog:"
  },
  "optionalDependencies": {
    "rolldown": "catalog:"
  },
  "devDependencies": {
    "@taucad/esbuild": "workspace:*",
    "@taucad/runtime": "workspace:*",
    "@taucad/runtime-testing": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "replicad": "catalog:",
    "vitest": "catalog:"
  },
  "taucad": {
    "hostTarget": "browser"
  }
}
