{
  "name": "smlibpy",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugins/smlibpy",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "generate-tau-plugin": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": ".",
