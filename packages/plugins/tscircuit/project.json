{
  "name": "tscircuit",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugins/tscircuit",
  "projectType": "library",
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsdown && tsdown -c tsdown.engine.ts",
        "cwd": "packages/plugins/tscircuit"
      }
    },
    "check-vendored-licenses": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node check-vendored-licenses.mjs",
        "cwd": "packages/plugins/tscircuit"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["^nx-release-publish", "tscircuit:pkgcheck", "tscircuit:check-vendored-licenses"]
    }
  },
  "tags": ["scope:shared", "type:package"]
}
