exampleSketch = startSketchOn(XZ)
  |> startProfile(at = [0, 0])
  |> angledLine(
    angle = 60deg,
    length = 10,
    tag = $thing,
  )
  |> tangentialArc(angle = -120deg, radius = 5)
  |> angledLine(
    angle = -60deg,
    length = segLen(thing),
  )
  |> close()

example = extrude(exampleSketch, length = 5)
