@settings(kclVersion = 1.0)

exampleSketch = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  |> line(end = [0, 5])
  |> line(end = [5, 0])
  |> line(end = [0, -5])
  |> close()
  |> subtract2d(tool =circle( center = [1, 1], radius = .25 ))
  |> subtract2d(tool =circle( center = [1, 4], radius = .25 ))

example = extrude(exampleSketch, length = 1)
