// Sweep a square edge along a path
square = startSketchOn(XY)
  |> startProfile(at = [-100, 200])
  |> line(end = [200, 0])
  |> line(end = [0, -200])
  |> line(end = [-200, 0])
 |> close()

path = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  |> line(end = [100, 0])
  |> tangentialArc(end = [107, -48])

sweep(square, path, bodyType = SURFACE)
