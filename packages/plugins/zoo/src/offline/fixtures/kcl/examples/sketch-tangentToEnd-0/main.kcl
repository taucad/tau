// Horizontal pill.
pillSketch = startSketchOn(XZ)
  |> startProfile(at = [0, 0])
  |> line(end = [20, 0])
  |> tangentialArc(end = [0, 10], tag = $arc1)
  |> angledLine(
    angle = tangentToEnd(arc1),
    length = 20,
  )
  |> tangentialArc(end = [0, -10])
  |> close()

pillExtrude = extrude(pillSketch, length = 10)
