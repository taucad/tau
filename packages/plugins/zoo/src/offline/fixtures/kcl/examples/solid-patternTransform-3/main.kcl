fn cube(length, center) {
  l = length/2
  x = center[0]
  y = center[1]
  p0 = [-l + x, -l + y]
  p1 = [-l + x,  l + y]
  p2 = [ l + x,  l + y]
  p3 = [ l + x, -l + y]

  return startSketchOn(XY)
  |> startProfile(at = p0)
  |> line(endAbsolute = p1)
  |> line(endAbsolute = p2)
  |> line(endAbsolute = p3)
  |> line(endAbsolute = p0)
  |> close()
  |> extrude(length = length)
}

width = 20
fn transform(@i) {
  return {
    translate = [0, 0, -i * width],
    rotation = {
      angle = 90deg * i,
      // Rotate around the overall scene's origin.
      origin = "global",
    }
  }
}
myCubes =
  cube(length = width, center = [100,100])
  |> patternTransform(instances = 4, transform = transform)
