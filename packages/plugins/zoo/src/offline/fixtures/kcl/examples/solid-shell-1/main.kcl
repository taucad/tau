// Remove the start face for the extrusion.
firstSketch = startSketchOn(-XZ)
    |> startProfile(at = [-12, 12])
    |> line(end = [24, 0])
    |> line(end = [0, -24])
    |> line(end = [-24, 0])
    |> close()
    |> extrude(length = 6)

// Remove the start face for the extrusion.
shell(
    firstSketch,
    faces = [START],
    thickness = 0.25,
)
