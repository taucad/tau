// Mirror an un-closed sketch across the Y axis.
sketch001 = startSketchOn(XZ)
    |> startProfile(at = [0, 10])
    |> line(end = [15, 0])
    |> line(end = [-7, -3])
    |> line(end = [9, -1])
    |> line(end = [-8, -5])
    |> line(end = [9, -3])
    |> line(end = [-8, -3])
    |> line(end = [9, -1])
    |> line(end = [-19, -0])
    |> mirror2d(axis = Y)

example = extrude(sketch001, length = 10)
