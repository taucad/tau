// Mirror a un-closed sketch across an edge.
helper001 = startSketchOn(XZ)
 |> startProfile(at = [0, 0])
 |> line(end = [0, 10], tag = $edge001)

sketch001 = startSketchOn(XZ)
    |> startProfile(at = [0, 8.5])
    |> line(end = [20, -8.5])
    |> line(end = [-20, -8.5])
    |> mirror2d(axis = edge001)

