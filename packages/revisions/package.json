{
  "name": "@taucad/revisions",
  "version": "0.0.1",
  "description": "Host-neutral revision port with native-Git and browser adapters for Tau",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/revisions"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/revisions#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cad",
    "typescript",
    "revisions",
    "git"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./package.json": "./package.json",
    "./project-revisions-machine": "./src/project-revisions.machine.ts",
    "./turn-machine": "./src/turn.machine.ts",
    "./checkout-machine": "./src/checkout.machine.ts",
    "./restore-machine": "./src/restore.machine.ts",
    "./checkouts-machine": "./src/checkouts.machine.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./node": {
        "types": "./dist/node/index.d.mts",
        "import": "./dist/node/index.mjs",
        "default": "./dist/node/index.mjs"
      },
      "./package.json": "./package.json",
      "./project-revisions-machine": {
        "types": "./dist/project-revisions.machine.d.mts",
        "import": "./dist/project-revisions.machine.mjs",
        "default": "./dist/project-revisions.machine.mjs"
      },
      "./turn-machine": {
        "types": "./dist/turn.machine.d.mts",
        "import": "./dist/turn.machine.mjs",
        "default": "./dist/turn.machine.mjs"
      },
      "./checkout-machine": {
        "types": "./dist/checkout.machine.d.mts",
        "import": "./dist/checkout.machine.mjs",
        "default": "./dist/checkout.machine.mjs"
      },
      "./restore-machine": {
        "types": "./dist/restore.machine.d.mts",
        "import": "./dist/restore.machine.mjs",
        "default": "./dist/restore.machine.mjs"
      },
      "./checkouts-machine": {
        "types": "./dist/checkouts.machine.d.mts",
        "import": "./dist/checkouts.machine.mjs",
        "default": "./dist/checkouts.machine.mjs"
      }
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/filesystem": "workspace:*",
    "isomorphic-git": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "xstate": "^5.0.0"
  },
  "devDependencies": {
    "xstate": "catalog:"
  }
}
