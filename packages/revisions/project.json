{
  "name": "revisions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/revisions",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsdown",
        "cwd": "{projectRoot}"
      }
    },
    "formal:nightly": {},
    "test": {
      "inputs": [
        "default",
        "^production",
        "serviceEnvironment",
        "{workspaceRoot}/packages/agent-host/specs/lean/corpus/pull-records.{trace,expected}"
      ]
    }
  }
}
