{
  "name": "revisions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/revisions",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsdown",
        "cwd": "{projectRoot}"
      }
    },
    "formal:nightly": {},
    "test": {
      "inputs": [
        "default",
        "^production",
        "serviceEnvironment",
        "{workspaceRoot}/packages/agent-host/specs/lean/corpus/pull-records.{trace,expected}"
      ]
    },
    "test:shard-1": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["copy-assets", "^copy-assets"],
      "inputs": [
        "default",
        "^production",
        "serviceEnvironment",
        "{workspaceRoot}/packages/agent-host/specs/lean/corpus/pull-records.{trace,expected}"
      ],
      "outputs": ["{workspaceRoot}/out/test-results/{projectName}/test-shard-1.outcomes.jsonl"],
      "metadata": {
        "description": "Shard 1 of 3 of revisions:test for the CI test lanes: the files test-shards.test-utils.ts deals to it by measured seconds (test-shards.test.seconds.json). The 3 shards together run every file of revisions:test exactly once (test-shards.test.ts); revisions:test itself still runs them all."
      },
      "options": {
        "cwd": "{projectRoot}",
        "command": "../../node_modules/.bin/vitest run --config test-shards.test.config.ts --shard=1/3"
      }
    },
    "test:shard-2": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["copy-assets", "^copy-assets"],
      "inputs": [
        "default",
        "^production",
        "serviceEnvironment",
        "{workspaceRoot}/packages/agent-host/specs/lean/corpus/pull-records.{trace,expected}"
      ],
      "outputs": ["{workspaceRoot}/out/test-results/{projectName}/test-shard-2.outcomes.jsonl"],
      "metadata": {
        "description": "Shard 2 of 3 of revisions:test for the CI test lanes: the files test-shards.test-utils.ts deals to it by measured seconds (test-shards.test.seconds.json). The 3 shards together run every file of revisions:test exactly once (test-shards.test.ts); revisions:test itself still runs them all."
      },
      "options": {
        "cwd": "{projectRoot}",
        "command": "../../node_modules/.bin/vitest run --config test-shards.test.config.ts --shard=2/3"
      }
    },
    "test:shard-3": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["copy-assets", "^copy-assets"],
      "inputs": [
        "default",
        "^production",
        "serviceEnvironment",
        "{workspaceRoot}/packages/agent-host/specs/lean/corpus/pull-records.{trace,expected}"
      ],
      "outputs": ["{workspaceRoot}/out/test-results/{projectName}/test-shard-3.outcomes.jsonl"],
      "metadata": {
        "description": "Shard 3 of 3 of revisions:test for the CI test lanes: the files test-shards.test-utils.ts deals to it by measured seconds (test-shards.test.seconds.json). The 3 shards together run every file of revisions:test exactly once (test-shards.test.ts); revisions:test itself still runs them all."
      },
      "options": {
        "cwd": "{projectRoot}",
        "command": "../../node_modules/.bin/vitest run --config test-shards.test.config.ts --shard=3/3"
      }
    },
    "check-writer-corpus": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "G2 (testing policy 13.1, revisions rule 21): every ui@* and desktop@* release tag and the working tree have their writer pinned in src/provenance/corpus/writers/ as that writer writes. Needs the release tags and full history (the release gate's writer-corpus lane checks out with fetch-depth 0)."
      },
      "options": {
        "command": "node packages/revisions/scripts/pin-writer-corpus.ts --check",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
