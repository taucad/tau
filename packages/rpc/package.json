{
  "name": "@taucad/rpc",
  "version": "0.1.0-beta.1",
  "description": "Typed RPC channel primitives for postMessage-style transports",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/rpc"
  },
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/rpc#readme",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cad",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bridge/index.ts",
    "./codec/msgpack": "./src/codec/msgpack.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./bridge": {
        "types": "./dist/bridge/index.d.mts",
        "import": "./dist/bridge/index.mjs",
        "default": "./dist/bridge/index.mjs"
      },
      "./codec/msgpack": {
        "types": "./dist/codec/msgpack.d.mts",
        "import": "./dist/codec/msgpack.mjs",
        "default": "./dist/codec/msgpack.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@msgpack/msgpack": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "zod": "catalog:"
  }
}
