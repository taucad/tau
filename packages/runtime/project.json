{
  "name": "runtime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/runtime",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "implicitDependencies": ["units"],
  "targets": {
    "build": {
      "dependsOn": ["^build"]
    },
    "audit-public-surface": {
      "command": "node --import @oxc-node/core/register scripts/audit-public-surface.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/audit-public-surface.mts",
        "{projectRoot}/src/index.ts",
        "{projectRoot}/src/client/runtime-client.ts",
        "{projectRoot}/src/vite/index.ts"
      ]
    },
    "npm-local-smoke": {
      "command": "node scripts/src/check-pack-install.ts packages/runtime",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
