{
  "name": "runtime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/runtime",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "implicitDependencies": ["units"],
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "options": {
        "command": "tsdown",
        "cwd": "{projectRoot}"
      }
    },
    "build-observability-bench": {
      "command": "tsdown -c tsdown.bench.config.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"],
      "cache": false
    },
    "observability-bench": {
      "command": "node node_modules/.cache/runtime-bench/observability-bench.mjs",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "full": {
          "args": "--mode=full"
        },
        "calibrate": {
          "args": "--mode=calibrate --samples=60"
        }
      },
      "dependsOn": ["build-observability-bench"],
      "cache": false
    },
    "audit-public-surface": {
      "command": "node --import @oxc-node/core/register scripts/audit-public-surface.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/audit-public-surface.mts",
        "{projectRoot}/src/index.ts",
        "{projectRoot}/src/client/runtime-document-client-core.ts",
        "{projectRoot}/tsconfig.lib.json",
        "{projectRoot}/src/vite/index.ts"
      ]
    },
    "npm-local-smoke": {
      "command": "node scripts/src/check-pack-install.ts packages/runtime packages/plugins/middleware",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
