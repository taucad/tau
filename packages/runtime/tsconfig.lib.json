{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "./out-tsc/lib",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "target": "ESNext"
  },
  "include": ["src/**/*.ts", "package.json", "src/nextjs/package-assets-loader.mjs"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
