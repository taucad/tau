{
  "name": "@taucad/skills",
  "version": "0.0.1",
  "description": "Tau CAD agent skill bundles for replicad, JSCAD, Manifold, OpenCascade, build123d, PicoGK, OpenSCAD, KCL and GeoSpec",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/skills"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/skills#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cad",
    "agent",
    "skills",
    "llm",
    "claude",
    "mcp",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./resources": "./src/resources.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./resources": {
        "types": "./dist/resources.d.mts",
        "import": "./dist/resources.mjs",
        "default": "./dist/resources.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "bin": {
    "taucad-skills": "./dist/cli.mjs"
  },
  "dependencies": {
    "@taucad/build123d": "workspace:*",
    "@taucad/jscad": "workspace:*",
    "@taucad/manifold": "workspace:*",
    "@taucad/opencascade": "workspace:*",
    "@taucad/openrscad": "workspace:*",
    "@taucad/picogk": "workspace:*",
    "@taucad/replicad": "workspace:*",
    "@taucad/zoo": "workspace:*",
    "geospec": "workspace:*"
  }
}
