{
  "name": "@taucad/testing",
  "version": "0.1.0-beta.0",
  "description": "Geometry analysis, grading, and test utilities for @taucad packages",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/testing"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cad",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./geometry": "./src/geometry/index.ts",
    "./tau": "./src/tau.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./geometry": {
        "types": "./dist/geometry/index.d.mts",
        "import": "./dist/geometry/index.mjs",
        "default": "./dist/geometry/index.mjs"
      },
      "./tau": {
        "types": "./dist/tau.d.mts",
        "import": "./dist/tau.mjs",
        "default": "./dist/tau.mjs"
      }
    }
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "geospec": "workspace:*"
  },
  "devDependencies": {
    "@taucad/openscad": "workspace:*",
    "@taucad/runtime": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  }
}
