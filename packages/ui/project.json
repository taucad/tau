{
  "name": "taucad-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui",
  "projectType": "library",
  "tags": ["scope:shared", "type:package"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/ui/app/**/*.tsx",
        "{workspaceRoot}/apps/libs/ui-kit/src/**/*.tsx",
        "{workspaceRoot}/apps/libs/chat-ui/src/**/*.tsx",
        "{workspaceRoot}/apps/libs/project-workspace/src/**/*.tsx",
        "{workspaceRoot}/apps/libs/ui-core/src/**/*.tsx",
        "reactEventLayer"
      ]
    },
    "typecheck": {
      "inputs": ["default", "^production", "reactEventLayer"]
    }
  }
}
