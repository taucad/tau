{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/lib",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "target": "ESNext",
    "paths": {
      // Unlike package.json#imports (`#*.js` -> `./src/*.ts`), a path alias also finds the
      // `.tsx` components behind `#components/*.js`. It applies to every file in this
      // program, so a dependency compiled from source must not share a `#` subpath here.
      "#*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/*.test-d.ts", "src/**/*.spec.tsx", "src/**/*.test.tsx"]
}
