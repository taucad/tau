{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["node", "vitest/importMeta", "vitest"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "target": "ESNext",
    "paths": {
      // Unlike package.json#imports (`#*.js` -> `./src/*.ts`), a path alias also finds the
      // `.tsx` components behind `#components/*.js`. It applies to every file in this
      // program, so a dependency compiled from source must not share a `#` subpath here.
      "#*": ["./src/*"]
    }
  },
  "include": [
    "vitest.config.ts",
    "vitest.setup.ts",
    "tsdown.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test-d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx"
  ]
}
