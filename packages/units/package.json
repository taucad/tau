{
  "name": "@taucad/units",
  "version": "0.1.0-beta.0",
  "description": "Units of measurement and conversions",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/units"
  },
  "main": "./dist/types/index.mjs",
  "types": "./dist/types/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "units",
    "measurement",
    "conversion"
  ],
  "author": "Richard Fontein",
  "license": "MIT",
  "exports": {
    ".": "./src/types/index.ts",
    "./constants": "./src/constants/index.ts",
    "./converter": "./src/converter/index.ts",
    "./parser": "./src/parser/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.mts",
        "import": "./dist/types/index.mjs",
        "default": "./dist/types/index.mjs"
      },
      "./constants": {
        "types": "./dist/constants/index.d.mts",
        "import": "./dist/constants/index.mjs",
        "default": "./dist/constants/index.mjs"
      },
      "./converter": {
        "types": "./dist/converter/index.d.mts",
        "import": "./dist/converter/index.mjs",
        "default": "./dist/converter/index.mjs"
      },
      "./parser": {
        "types": "./dist/parser/index.d.mts",
        "import": "./dist/parser/index.mjs",
        "default": "./dist/parser/index.mjs"
      }
    }
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  }
}
