{
  "name": "@taucad/utils",
  "version": "0.1.0-beta.0",
  "description": "Tau shared utilities (ID generation, path, file, schema, dispose)",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "utils",
    "cad"
  ],
  "author": "Richard Fontein",
  "license": "MIT",
  "exports": {
    "./id": "./src/id.utils.ts",
    "./path": "./src/path.utils.ts",
    "./file": "./src/file.utils.ts",
    "./import": "./src/import.utils.ts",
    "./schema": "./src/schema.utils.ts",
    "./dispose": "./src/dispose.utils.ts",
    "./error": "./src/error.utils.ts",
    "./cache": "./src/cache.utils.ts",
    "./hash": "./src/hash.utils.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./id": {
        "types": "./dist/id.utils.d.ts",
        "import": "./dist/id.utils.js",
        "default": "./dist/id.utils.js"
      },
      "./path": {
        "types": "./dist/path.utils.d.ts",
        "import": "./dist/path.utils.js",
        "default": "./dist/path.utils.js"
      },
      "./file": {
        "types": "./dist/file.utils.d.ts",
        "import": "./dist/file.utils.js",
        "default": "./dist/file.utils.js"
      },
      "./import": {
        "types": "./dist/import.utils.d.ts",
        "import": "./dist/import.utils.js",
        "default": "./dist/import.utils.js"
      },
      "./schema": {
        "types": "./dist/schema.utils.d.ts",
        "import": "./dist/schema.utils.js",
        "default": "./dist/schema.utils.js"
      },
      "./dispose": {
        "types": "./dist/dispose.utils.d.ts",
        "import": "./dist/dispose.utils.js",
        "default": "./dist/dispose.utils.js"
      },
      "./error": {
        "types": "./dist/error.utils.d.ts",
        "import": "./dist/error.utils.js",
        "default": "./dist/error.utils.js"
      },
      "./cache": {
        "types": "./dist/cache.utils.d.ts",
        "import": "./dist/cache.utils.js",
        "default": "./dist/cache.utils.js"
      },
      "./hash": {
        "types": "./dist/hash.utils.d.ts",
        "import": "./dist/hash.utils.js",
        "default": "./dist/hash.utils.js"
      }
    }
  },
  "dependencies": {
    "@taucad/json-schema": "workspace:*",
    "@taucad/types": "workspace:*",
    "cdn-resolve": "catalog:"
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  }
}
