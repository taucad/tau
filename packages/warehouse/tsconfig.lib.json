{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/lib",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "target": "ESNext"
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "scripts/**/*.mts", "definitions/**/*.ts", "parts/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "parts/**/*.geospec.ts",
    "definitions/**/*.geospec.ts",
    "definitions/**/*.test.ts",
    "definitions/**/*.test-d.ts"
  ]
}
