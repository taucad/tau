{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/lib",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "target": "ESNext",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.vitest.browser.config.ts",
    "src/**/*.test-utils.ts",
    "src/**/*.test-utils.tsx"
  ]
}
