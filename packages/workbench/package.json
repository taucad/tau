{
  "name": "@taucad/workbench",
  "version": "0.0.1",
  "description": "Portable workbench records and agent skill",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "packages/workbench"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/packages/workbench#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "agent",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cad",
    "typescript"
  ],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agent/*": "./agent/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./agent/*": "./agent/*",
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "peerDependencies": {
    "@taucad/camera": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "catalog:",
    "@taucad/camera": "workspace:*",
    "@taucad/runtime": "workspace:*",
    "zod": "catalog:"
  },
  "tau": {
    "skills": "./agent/skills.json"
  }
}
