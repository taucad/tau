{
  "name": "scripts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "scripts/src",
  "projectType": "library",
  "tags": ["scope:tooling", "type:scripts"],
  "targets": {
    "validate-frontmatter": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-frontmatter.ts"
      }
    },
    "validate-project-names": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-project-names.ts"
      }
    },
    "validate-tsgo-runtime-references": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-tsgo-runtime-references.ts"
      }
    },
    "validate-quickstart-budget": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-quickstart-budget.ts"
      }
    },
    "validate-license-partitions": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-license-partitions.ts"
      }
    },
    "audit-singular-render-output": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/audit-singular-render-output.ts"
      }
    },
    "pdf-to-md": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/pdf-to-md.ts"
      }
    },
    "text-to-md": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/text-to-md.ts"
      }
    },
    "html-to-md": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/html-to-md.ts"
      }
    },
    "bake-hero-glb": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx scripts/src/bake-hero-glb.mts"
      }
    }
  }
}
