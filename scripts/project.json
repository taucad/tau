{
  "name": "scripts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "scripts/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:tool"],
  "targets": {
    "validate-agent-config": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/src/validate-agent-config.ts"
      }
    },
    "populate-ui-env": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --import @oxc-node/core/register scripts/src/populate-env.ts apps/ui/.env.example apps/ui/.env"
      }
    },
    "validate-frontmatter": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-frontmatter.ts"
      }
    },
    "validate-workspace-root": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-workspace-root.ts"
      }
    },
    "validate-project-names": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-project-names.ts"
      }
    },
    "validate-project-tags": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-project-tags.ts"
      }
    },
    "validate-timeouts": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --root packages/agent-host src/test/timeout-inventory.test.ts"
      }
    },
    "validate-tsgo-runtime-references": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-tsgo-runtime-references.ts"
      }
    },
    "validate-quickstart-budget": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-quickstart-budget.ts"
      }
    },
    "validate-prose": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./node_modules/.bin/vale --config apps/docs/.vale.ini apps/docs/content",
        "cwd": "."
      }
    },
    "validate-license-partitions": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-license-partitions.ts"
      }
    },
    "validate-format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxfmt --check"
      }
    },
    "validate-dead-code": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NX_DAEMON=false knip --max-issues 317"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/plugins/*/README.md",
        "{workspaceRoot}/packages/core/*/README.md",
        "{workspaceRoot}/packages/plugins/*/src/index.ts",
        "{workspaceRoot}/packages/core/*/src/index.ts",
        "{workspaceRoot}/**/*"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Suites that launch Playwright Chromium or run Pandoc (canvas Vite config, HTML reference capture). Named test:e2e so `nx affected -t test:e2e` selects them on the CI lane that installs Chromium and Pandoc."
      },
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "../node_modules/.bin/vitest run",
        "env": {
          "TAU_SCRIPTS_BROWSER_TESTS": "true"
        }
      }
    },
    "validate-license-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx scripts/src/update-license-deps.mts --check"
      }
    },
    "validate-open-source-notices": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx scripts/src/update-open-source-notices.mts --check"
      }
    },
    "prepare-geospec-test-consumer": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "cache-core",
            "project-core",
            "units",
            "parameters",
            "runtime",
            "bundler-core",
            "esbuild",
            "geospec",
            "geospec-engine",
            "camera",
            "spatial",
            "geometry-core",
            "occt-core",
            "openrscad",
            "assimp",
            "brep",
            "gltf",
            "image",
            "jscad",
            "manifold",
            "middleware",
            "opencascade",
            "picovoxel",
            "replicad",
            "tscircuit",
            "rhino",
            "tscircuit",
            "rpc",
            "kinematics",
            "filesystem",
            "revisions",
            "picogk",
            "native-process-core"
          ]
        }
      ],
      "options": {
        "command": "node scripts/src/prepare-geospec-test-consumer.ts \"${GEOSPEC_NATIVE_ASSEMBLY_ROOT:?Supply the reviewed ASSEMBLY_ROOT}\" out/artifacts/geospec-test-consumer/receipt.json",
        "forwardAllArgs": false
      }
    },
    "check-geospec-test-consumer": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test scripts/src/prepare-geospec-test-consumer.check.ts",
        "forwardAllArgs": false
      }
    },
    "plan-geospec-ci": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/src/plan-geospec-ci.ts"
      }
    },
    "validate-grafana": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/validate-grafana.ts", "{workspaceRoot}/infra/grafana/**/*"],
      "options": {
        "command": "node scripts/src/validate-grafana.ts"
      }
    },
    "validate-workflows": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/validate-workflows.ts"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "true"
      },
      "dependsOn": [
        {
          "target": "validate-*"
        }
      ],
      "cache": false
    },
    "check-registry-dependencies": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/check-registry-dependencies.ts"
      }
    },
    "check-release-projects": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/check-release-projects.ts"
      }
    },
    "check-pack-install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/check-pack-install.ts"
      },
      "dependsOn": [
        {
          "target": "build",
          "projects": ["tag:type:package"]
        }
      ]
    },
    "release-gate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "true"
      },
      "dependsOn": [
        {
          "target": "validate"
        },
        {
          "target": "check-*"
        },
        {
          "target": "pkgcheck",
          "projects": ["tag:type:package"]
        },
        {
          "target": "test",
          "projects": ["tag:type:package", "tag:type:lib"]
        },
        {
          "target": "typecheck",
          "projects": ["tag:type:package", "tag:type:lib"]
        },
        {
          "target": "lint",
          "projects": ["tag:type:package", "tag:type:lib"]
        },
        {
          "target": "audit-public-surface",
          "projects": ["*"]
        },
        {
          "target": "readme-quickstart",
          "projects": ["*"]
        }
      ],
      "cache": false
    },
    "audit-singular-render-output": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/audit-singular-render-output.ts"
      }
    },
    "pdf-to-md": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/pdf-to-md.ts"
      }
    },
    "text-to-md": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/text-to-md.ts"
      }
    },
    "html-to-md": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/src/html-to-md.ts"
      }
    },
    "bake-hero-glb": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx scripts/src/bake-hero-glb.mts"
      }
    },
    "validate-agent-lanes": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test .agents/skills/codex-lanes/scripts/lanes.test.mjs"
      }
    },
    "native-renderer-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config scripts/native-renderer-spike/vitest.config.mts"
      }
    },
    "native-renderer-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/native-renderer-spike/build.mts"
      }
    },
    "native-renderer-benchmark": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --import tsx scripts/native-renderer-spike/benchmark.mts"
      }
    }
  }
}
