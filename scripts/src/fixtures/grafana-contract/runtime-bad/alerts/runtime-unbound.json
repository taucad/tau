{
  "title": "seeded-runtime",
  "interval": 60,
  "rules": [
    {
      "uid": "seeded-absent-unconditioned",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "model": {
            "expr": "absent_over_time(tau_telemetry_ingest_entries_total{app=~\".*\",disposition=\"recorded\"}[30m])"
          }
        }
      ]
    },
    {
      "uid": "seeded-loki-dashboard-selector",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "loki",
          "model": {
            "expr": "sum(count_over_time({service_name=~\"$service\"} | json | event=\"runtime.operation\" [5m]))"
          }
        }
      ]
    },
    {
      "uid": "seeded-storage-exporters",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "model": {
            "expr": "max(tau_mirror_copy_lag_seconds{app=~\".*mirror.*\",service_name=\"tau-api\"}) > 900 or sum(tau_git_leases_active{app=~\".*storage.*\",service_name=\"tau-storage\"}) > 0 or sum(fly_instance_up{app=~\".*storage.*\"}) < 2"
          }
        }
      ]
    },
    {
      "uid": "seeded-fly-unbound",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "model": {
            "expr": "sum(fly_instance_up{}) < 2"
          }
        }
      ]
    }
  ]
}
