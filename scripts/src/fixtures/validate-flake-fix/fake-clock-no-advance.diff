 import { expect, it, vi } from 'vitest';

 it('flushes after the delay', async () => {
+  vi.useFakeTimers();
   const flush = vi.fn();
   debounce(flush, 50)();
+  await new Promise((resolve) => setTimeout(resolve, 100));
   expect(flush).toHaveBeenCalledTimes(1);
 });
