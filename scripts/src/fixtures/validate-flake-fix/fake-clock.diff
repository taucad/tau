--- a/apps/ui/src/debounce.test.ts
+++ b/apps/ui/src/debounce.test.ts
@@
 import { expect, it, vi } from 'vitest';

 it('flushes once after the delay', () => {
+  vi.useFakeTimers();
   const flush = vi.fn();
   debounce(flush, 50)();
+  setTimeout(() => debounce(flush, 50)(), 10);
+  vi.advanceTimersByTime(100);
   expect(flush).toHaveBeenCalledTimes(1);
+  vi.useRealTimers();
 });
