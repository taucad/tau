diff --git a/dist/development/chunk-62JRHF6Z.mjs b/dist/development/chunk-62JRHF6Z.mjs
index 43c3c5eae20fb44356130bd8b37ecc277ffdb62a..ca6a7451ae6edeaddb2a859deab96eaeb88f2452 100644
--- a/dist/development/chunk-62JRHF6Z.mjs
+++ b/dist/development/chunk-62JRHF6Z.mjs
@@ -8718,7 +8718,16 @@ async function loadRouteModule(route, routeModulesCache) {
     import.meta.hot) {
       throw error;
     }
-    window.location.reload();
+    // tau patch (TAU-UI-S): during a navigation the URL still names the page being
+    // left, so reloading it drops the user back there. Load the destination
+    // instead; anything else (hydration, a non-GET submission) still reloads.
+    let tauRouter = window.__reactRouterDataRouter;
+    let tauNavigation = tauRouter && tauRouter.state.navigation;
+    if (tauNavigation && tauNavigation.location && (!tauNavigation.formMethod || tauNavigation.formMethod.toUpperCase() === "GET")) {
+      window.location.assign(tauRouter.createHref(tauNavigation.location));
+    } else {
+      window.location.reload();
+    }
     return new Promise(() => {
     });
   }
