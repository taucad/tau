{
  "name": "@taucad/vitest-ci",
  "version": "0.0.1",
  "description": "Shared Vitest reporter list, CI test outcome recorder and recorded retry for every Tau test target",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "exports": {
    ".": "./src/test-reporters.ts",
    "./outcome-reporter": "./src/outcome-reporter.ts",
    "./quarantine": "./src/quarantine.ts",
    "./quarantine-verdict": "./src/quarantine-verdict.ts",
    "./retry-policy": "./src/retry-policy.ts",
    "./package.json": "./package.json"
  }
}
