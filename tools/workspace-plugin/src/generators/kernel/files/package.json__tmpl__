{
  "name": "<%= importPath %>",
  "version": "0.1.0-beta.0",
  "description": "<%= description %>",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "kernels/<%= name %>"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist", "README.md"],
  "keywords": ["cad", "kernel", "<%= name %>"],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./kernel": "./src/<%= name %>.kernel.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./kernel": {
        "types": "./dist/<%= name %>.kernel.d.mts",
        "import": "./dist/<%= name %>.kernel.mjs",
        "default": "./dist/<%= name %>.kernel.mjs"
      }
    }
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "dependencies": {
    "@taucad/runtime": "workspace:*",
    "zod": "catalog:"
  }
}
