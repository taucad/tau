import { describe, expect, it } from 'vitest';
import { createMockKernelRuntime, resolveRuntimePluginDefinition } from '@taucad/runtime/testing';
import { <%= propertyName %> } from '#<%= name %>.kernel.js';

// Scaffolded smoke test. It drives every stubbed lifecycle method so the package
// ships green. As you implement the kernel, grow these into real cases — prefer
// the worker-level helpers (`createTestWorker`, `getTestParameters`,
// `createTestGeometry`, `createGeometryTestHelpers`) and assert geometry naming
// per `docs/policy/geometry-naming-policy.md`.
describe('<%= className %>Kernel', () => {
  it('exposes the factory with the expected id and extensions', () => {
    const plugin = <%= propertyName %>();
    expect(plugin.id).toBe('<%= name %>');
    expect(plugin.extensions).toContain('ts');
  });

  it('implements the kernel lifecycle (stub — replace as you build)', async () => {
    const definition = await resolveRuntimePluginDefinition('kernel', <%= propertyName %>());
    const runtime = createMockKernelRuntime();
    const input = { filePath: '/project/model.ts', basePath: '/project' };
    const context = await definition.initialize({}, runtime);

    await expect(definition.getDependencies(input, runtime, context)).resolves.toEqual({
      resolved: [],
      unresolved: [],
    });

    const parameters = await definition.getParameters(input, runtime, context);
    expect(parameters.success).toBe(true);

    const geometry = await definition.createGeometry({ ...input, parameters: {}, options: {} }, runtime, context);
    expect(geometry).toBeDefined();

    const exported = await definition.exportGeometry({ format: 'glb', nativeHandle: '', options: {} }, runtime, context);
    expect(exported.success).toBe(false);
  });
});
