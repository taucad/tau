/**
 * `<%= importPath %>` — TODO: one-line kernel description.
 *
 * Scaffolded stub. Implement each lifecycle method below, then grow the suite in
 * `<%= name %>.kernel.test.ts`. Follow `docs/policy/geometry-naming-policy.md` and
 * the `new-kernel` skill for the full authoring contract (schemas, native handles,
 * geometry naming, Monaco types, catalog metadata).
 *
 * @public
 * @module
 */

import { z } from 'zod';
import type { KernelPluginFactory } from '@taucad/runtime/kernel';
import {
  createEmptyGltfGeometry,
  createKernelError,
  createKernelSuccess,
  defineKernel,
  finalizeRenderOutput,
} from '@taucad/runtime/kernel';

/** Render-time options. TODO: add tessellation/quality controls this kernel honours. */
export const <%= propertyName %>RenderSchema = z.object({});

/** Per-format export options. TODO: add every format this kernel can export. */
export const <%= propertyName %>ExportSchemas = {
  glb: z.object({}),
  gltf: z.object({}),
};

type <%= className %>FormatMap = {
  [Format in keyof typeof <%= propertyName %>ExportSchemas]: z.input<(typeof <%= propertyName %>ExportSchemas)[Format]>;
};
type <%= className %>RenderOptions = z.input<typeof <%= propertyName %>RenderSchema>;

/**
 * `<%= propertyName %>` kernel plugin factory.
 *
 * The explicit {@link KernelPluginFactory} annotation keeps the emitted `.d.ts`
 * portable (avoids TS2742 from inferring internal runtime types).
 *
 * @public
 */
export const <%= propertyName %>: KernelPluginFactory<'<%= name %>', <%= className %>FormatMap, <%= className %>RenderOptions> =
  defineKernel({
  id: '<%= name %>',
  // TODO: source file extensions this kernel handles (e.g. ['scad'], ['ts', 'js']).
  extensions: ['ts', 'js'],
  name: '<%= className %>Kernel',
  version: '0.1.0',
  renderSchema: <%= propertyName %>RenderSchema,
  exportSchemas: <%= propertyName %>ExportSchemas,

  async initialize() {
    // TODO: load the engine (WASM/SDK) and register built-in modules via
    // `runtime.bundler.registerModule(name, { code, version })`. The returned
    // object becomes the per-render `context` passed to the methods below.
    return {};
  },

  async getDependencies() {
    // TODO: resolve the model's import graph — usually
    // `runtime.bundler.resolveDependencies(entryPath)` for JS/TS kernels.
    return { resolved: [], unresolved: [] };
  },

  async getParameters() {
    // TODO: extract `defaultParameters` + a JSON schema from the model source.
    return createKernelSuccess({
      defaultParameters: {},
      jsonSchema: { type: 'object', properties: {}, additionalProperties: false },
    });
  },

  async createGeometry() {
    // TODO: bundle + execute the user model, tessellate, and return glTF
    // artifacts plus a `nativeHandle` for re-export. Route generated names
    // through the helpers named in `docs/policy/geometry-naming-policy.md`.
    return finalizeRenderOutput({ artifacts: [createEmptyGltfGeometry()], nativeHandle: '' });
  },

  async exportGeometry() {
    // TODO: export from the `nativeHandle` for each supported format.
    return createKernelError([
      { message: 'TODO: implement <%= name %> exportGeometry', code: 'RUNTIME', severity: 'error' },
    ]);
  },
});
