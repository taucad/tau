{
  "name": "<%= importPath %>",
  "version": "0.0.1",
  "description": "<%= description %>",
  "type": "module",
  "sideEffects": false,
  "private": <%- private %>,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "<%= scope %>/<%= name %>"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/<%= scope %>/<%= name %>#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
<% if (typeof build === 'undefined' || build) { -%>
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist", "LICENSE", "README.md"],
<% } -%>
  "keywords": ["cad", "typescript"],
  "author": "Richard Fontein",
  "license": "<%= license %>",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
<% if (typeof build === 'undefined' || build) { -%>
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
<% } -%>
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  }<% if (typeof react !== 'undefined' && react) { %>,
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }<% } %>
}
