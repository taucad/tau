# <%= importPath %>

<%= description %>

```typescript
import { plugin<% for (const capability of capabilities) { %>, <%= capability.factoryName %><% } %> } from '<%= importPath %>';

const selected = plugin();
<% for (const capability of capabilities) { %>
const direct<%= capability.role[0].toUpperCase() + capability.role.slice(1) %> = <%= capability.factoryName %>();
