{
  "name": "<%= importPath %>",
  "version": "0.1.0-beta.0",
  "description": "<%= description %>",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "<%= scope %>/<%= name %>"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/<%= scope %>/<%= name %>#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist", <% if (nativeLanguage) { %>"tau-plugin.json", <% } %>"LICENSE", "README.md", "CHANGELOG.md"],
  "keywords": ["cad", "plugin", "<%= name %>"],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",<% if (nativeLanguage) { %>
    "./native": "./src/native.ts",
    "./tau-plugin.json": "./tau-plugin.json",<% } %>
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },<% if (nativeLanguage) { %>
      "./native": {
        "types": "./dist/native.d.mts",
        "import": "./dist/native.mjs",
        "default": "./dist/native.mjs"
      },
      "./tau-plugin.json": "./tau-plugin.json",<% } %>
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
<% if (nativeLanguage) { %>  "dependencies": {
    "@taucad/native-process-core": "workspace:*"<% if (nativeLanguage === 'python') { %>,
    "@taucad/python-kernel-core": "workspace:*"<% } %>
  },
<% } %>  "peerDependencies": {
    "@taucad/runtime": "^0.1.0-beta.0"<% if (usesZod) { %>,
    "zod": "^4.1.0"<% } %>
  },
  "devDependencies": {
    "@taucad/runtime": "workspace:*"<% if (usesZod) { %>,
    "zod": "catalog:"<% } %>
  },
  "taucad": {
    "hostTarget": "<%= hostTarget %>"
  }
}
