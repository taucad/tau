{
  "name": "<%= importPath %>",
  "version": "0.1.0-beta.0",
  "description": "<%= description %>",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/tau.git",
    "directory": "<%= scope %>/<%= name %>"
  },
  "homepage": "https://github.com/taucad/tau/tree/main/<%= scope %>/<%= name %>#readme",
  "bugs": {
    "url": "https://github.com/taucad/tau/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist", "LICENSE", "README.md", "CHANGELOG.md"],
  "keywords": ["cad", "plugin", "<%= name %>"],
  "author": "Richard Fontein",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepublishOnly": "pnpm --workspace-root nx run <%= name %>:pkgcheck"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "peerDependencies": {
    "@taucad/runtime": "^0.1.0"
  },
  "devDependencies": {
    "@taucad/runtime": "workspace:*"
  },
  "taucad": {
    "hostTarget": "<%= hostTarget %>"
  }
}
