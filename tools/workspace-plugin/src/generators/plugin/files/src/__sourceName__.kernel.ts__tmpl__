import {
  createKernelParameterDeclaration,
  createKernelSuccess,
  defineKernel,
} from '@taucad/runtime/kernel';

/** `<%= name %>` kernel capability. @public */
export const <%= alias %>Kernel = defineKernel({
  id: '<%= name %>',
  extensions: [],
  name: '<%= alias %>Kernel',
  version: '1.0.0',
  // TODO: Declare offered views/exports and implement render/write for this backend.
  views: {},
  exports: {},
  async initialize() {
    return {};
  },
  async resolve({ entryPath }) {
    return { resolved: [entryPath], unresolved: [] };
  },
  async describe() {
    return createKernelSuccess({
      parameters: createKernelParameterDeclaration(
        {},
        { type: 'object', properties: {}, additionalProperties: false },
        { id: 'urn:taucad:<%= name %>:parameters', name: '<%= alias %>Parameters' },
      ),
    });
  },
  async evaluate() {
    return { handle: undefined };
  },
});
