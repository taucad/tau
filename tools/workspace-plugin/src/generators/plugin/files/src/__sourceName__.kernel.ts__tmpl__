import { createKernelError, createKernelSuccess, defineKernel } from '@taucad/runtime/kernel';

/** `<%= name %>` kernel capability. @public */
export const <%= alias %>Kernel = defineKernel({
  id: '<%= name %>',
  extensions: [],
  name: '<%= alias %>Kernel',
  version: '1.0.0',
  exportFormats: {},
  async initialize() {
    return {};
  },
  async getDependencies() {
    return { resolved: [], unresolved: [] };
  },
  async getParameters() {
