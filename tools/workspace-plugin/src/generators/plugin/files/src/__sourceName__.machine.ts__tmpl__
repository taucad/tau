import { defineConfiguration } from '@taucad/runtime/configuration';
import { defineMachine } from '@taucad/runtime/machine';
import type { MachineManifest } from '@taucad/runtime/machine';
import { z } from 'zod';

const bindingConfiguration = defineConfiguration({
  id: '<%= name %>.machine.binding',
  version: '1.0.0',
  schema: z.object({ logicalId: z.string() }),
  ui: { version: 1, rjsf: {} },
});

const submissionConfiguration = defineConfiguration({
  id: '<%= name %>.machine.submission',
  version: '1.0.0',
  schema: z.object({ copies: z.number().int().positive().default(1) }),
  ui: { version: 1, rjsf: {} },
});

const manifest: MachineManifest = {
  version: 2,
  identity: {
    typeId: '<%= name %>.generic',
    vendor: '<%= name %>',
    model: '<%= name %>',
    displayName: '<%= alias %>Machine',
    qualifiedFirmware: [],
  },
  technology: 'additive.fff',
  geometry: {
    unit: 'mm',
    buildVolume: { x: 200, y: 200, z: 200 },
    enclosure: { outer: { x: 300, y: 300, z: 400 }, enclosed: false, doors: [] },
    kinematics: 'cartesian-bedslinger',
    bedMotion: 'y',
    origin: 'front-left',
    toolheadHome: { x: 1, y: 1, z: 200 },
    materialSystemMount: 'none',
  },
  toolhead: {
    filamentDiameter: { value: 1.75, unit: 'mm' },
    nozzles: [
      {
        id: 'nozzle-0.4',
        diameter: { value: 0.4, unit: 'mm' },
        maximumTemperature: { value: 260, unit: 'Cel' },
        material: 'stainless',
      },
    ],
  },
  bed: { maximumTemperature: { value: 100, unit: 'Cel' }, plates: [{ id: 'smooth', label: 'Smooth plate' }] },
  chamber: { enclosed: false, heated: false, light: false, fans: [] },
  materialSystem: { units: 0, slotsPerUnit: 0, externalSpool: true, drying: false },
  camera: { stills: false },
  storage: { removable: false },
  network: { lanMode: true, cloud: false },
  speedProfiles: [],
  actions: [],
  observations: [],
  slicing: {
    recommended: {
      layerHeight: { value: 0.2, unit: 'mm' },
      walls: 2,
      infillPercent: 15,
      nozzleTemperature: { value: 210, unit: 'Cel' },
      bedTemperature: { value: 60, unit: 'Cel' },
    },
    presets: [
      { id: 'fast', label: 'Fast', layerHeight: { value: 0.28, unit: 'mm' } },
      { id: 'standard', label: 'Standard', layerHeight: { value: 0.2, unit: 'mm' } },
      { id: 'fine', label: 'Fine', layerHeight: { value: 0.12, unit: 'mm' } },
    ],
  },
};

/** `<%= name %>` physical-machine capability. @public */
export const <%= alias %>Machine = defineMachine({
  id: '<%= name %>',
  name: '<%= alias %>Machine',
  version: '1.0.0',
  protocolVersion: 1,
  vendor: '<%= name %>',
  technologies: ['custom'],
  accepts: [
    {
      contract: { id: 'manufacturing.toolpath.custom', version: 1 },
      mediaType: 'application/octet-stream',
      requiredMembers: [],
      payloadSelection: 'single',
      technology: 'custom',
    },
  ],
  manifest,
  bindingConfiguration,
  submissionConfiguration,
  async *discover(input) {
    void input.configuration.logicalId;
    yield* [];
  },
  async connect(input) {
    void input.configuration.logicalId;
    throw new Error('TODO: implement <%= name %> machine connection');
  },
});
