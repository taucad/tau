<% if (hostTarget === 'browser') { %>
import { builtinModules } from 'node:module';
import { readFileSync, readdirSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
<% } %>
<% if (nativeLanguage) { %>import { nativeDeploymentOf } from '@taucad/native-process-core/adopter';
<% } %>import { describe, expect, it } from 'vitest';

import { plugin, <%= alias %><% if (nativeLanguage) { %>, <%= alias %>Native<% } %> } from '#index.js';
<% if (nativeLanguage) { %>
// A closure holding exactly the launch set, which the deployment maps to the options of an explicit `closure`.
const closureOptions = <%= alias %>Native.optionsFromClosure({
  package: '<%= importPath %>',
  dependency: 'engine',
  root: '/store/closures/sha256/fixture',
  closureIntegrity: 'sha256-AAAA',
  files: <%= alias %>Native.launchSet([]).map((path) => ({ path, byteLength: 1, sha256: '0'.repeat(64), mode: 0o644 })),
});
<% } %>

describe('<%= importPath %>', () => {
  it('binds the mechanical plugin alias to the package-named factory', () => {
    expect(<%= alias %>).toBe(plugin);
  });

  it('exports the named plugin', async () => {
    const { plugin: importedPlugin } = await import('#index.js');
    expect(importedPlugin).toBe(plugin);
    const { capabilities } = plugin(<% if (nativeLanguage) { %>{ kernels: { default: { closure: closureOptions } } }<% } %>);
    expect(capabilities.kernels.map(({ id }) => id)).toEqual([<% for (const capability of capabilities.filter(({ role }) => role === 'kernel')) { %>'<%= name %>'<% } %>]);
    expect(capabilities.middleware.map(({ id }) => id)).toEqual([<% for (const capability of capabilities.filter(({ role }) => role === 'middleware')) { %>'<%= name %>'<% } %>]);
    expect(capabilities.bundlers.map(({ id }) => id)).toEqual([<% for (const capability of capabilities.filter(({ role }) => role === 'bundler')) { %>'<%= name %>'<% } %>]);
    expect(capabilities.transcoders.map(({ id }) => id)).toEqual([<% for (const capability of capabilities.filter(({ role }) => role === 'transcoder')) { %>'<%= name %>'<% } %>]);
    expect(capabilities.jobs.map(({ id }) => id)).toEqual([<% for (const capability of capabilities.filter(({ role }) => role === 'job')) { %>'<%= name %>'<% } %>]);
    expect(capabilities.machines.map(({ id }) => id)).toEqual([<% for (const capability of capabilities.filter(({ role }) => role === 'machine')) { %>'<%= name %>'<% } %>]);
  });

<% if (nativeLanguage) { %>
  it('maps a closure holding its launch set to options its deployment accepts', () => {
    expect(<%= alias %>Native.package).toBe('<%= importPath %>');
    expect(<%= alias %>Native.optionsSchema.safeParse(closureOptions).error).toBeUndefined();
  });

  it('carries its deployment on every kernel registration, so listing the plugin is the whole integration', () => {
    const { capabilities } = plugin();
    expect(capabilities.kernels.map((kernel) => nativeDeploymentOf(kernel))).toEqual([<%= alias %>Native]);
  });

<% } %>
<% if (hostTarget === 'browser') { %>
  it('keeps native, Python, and Node-only payloads out of browser source', () => {
    const sourceDirectory = dirname(fileURLToPath(import.meta.url));
    const nodeBuiltins = new Set([...builtinModules, ...builtinModules.map((name) => `node:${name}`)]);
    // Mirrors `nodeOnlyDependencies` in tools/pkgcheck-metadata.ts, the single source; a
    // published package must not import from `tools/`, so the list is copied, not shared.
    const nodeOnlyPackages = new Set([
      'better-sqlite3',
      'bufferutil',
      'canvas',
      'fs-extra',
      'node-fetch',
      'node-gyp-build',
      'sharp',
      'utf-8-validate',
      'ws',
    ]);
    const offenders = readdirSync(sourceDirectory, { encoding: 'utf8', recursive: true })
      .filter((name) => name.endsWith('.ts') && !name.includes('.test'))
      .flatMap((name) => {
        // Comments are prose, not payload: a doc comment naming `import('ws')` is not an import.
        // `import type` is erased before the bundle exists, so it is not payload either.
        const source = readFileSync(join(sourceDirectory, name), 'utf8')
          .replaceAll(/\/\*[\S\s]*?\*\//g, '')
          .replaceAll(/^\s*\/\/.*$/gm, '')
          .replaceAll(/^\s*(?:import|export)\s+type\s[^;]*;/gm, '');

        return [...source.matchAll(/(?:from\s+|import\s*\(\s*|import\s+)["']([^"']+)["']/g)]
          .map((match) => match[1]!)
          .filter(
            (specifier) =>
              nodeBuiltins.has(specifier) ||
              nodeOnlyPackages.has(specifier) ||
              specifier.includes('-native') ||
              specifier.includes('-python'),
          )
          .map((specifier) => `${name}: ${specifier}`);
      });

    expect(offenders).toEqual([]);
  });
<% } %>
});
